{
  "app-id": "io.github.diode701.NyaaPaper",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "nyaa-paper",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=ipc",
    "--device=dri",
    "--own-name=org.nyaa.Paper",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--filesystem=~/.local/share/Steam/steamapps/workshop/content/431960:ro",
    "--filesystem=~/.local/share/Steam/steamapps/common/wallpaper_engine:ro",
    "--filesystem=~/Pictures:create",
    "--filesystem=xdg-config/nyaa-paper:create"
  ],
  "modules": [
    "linux-wallpaperengine.json",
    {
      "name": "nyaa-paperd",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/nyaa-paperd/cargo",
          "PATH": "/usr/lib/sdk/rust-stable/bin:/usr/bin:/bin"
        }
      },
      "build-commands": [
        "cargo --offline build --release --manifest-path daemon/Cargo.toml",
        "install -Dm755 daemon/target/release/nyaa-paperd /app/bin/nyaa-paperd"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/diode701/nyaapaper.git",
          "commit": "a5b3dcbd5f24cd872375aac014919dcf5589f34b"
        },
        "cargo-sources.json"
      ]
    },
    {
      "name": "nyaa-paper",
      "buildsystem": "simple",
      "build-commands": [
        "cmake -S gui -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/app -DNYAA_BUILD_TESTS=OFF",
        "cmake --build build",
        "cmake --install build",
        "install -Dm755 packaging/nyaa-paper /app/bin/nyaa-paper",
        "install -Dm644 packaging/flatpak/io.github.diode701.NyaaPaper.desktop /app/share/applications/io.github.diode701.NyaaPaper.desktop",
        "install -Dm644 packaging/flatpak/io.github.diode701.NyaaPaper.metainfo.xml /app/share/metainfo/io.github.diode701.NyaaPaper.metainfo.xml",
        "install -Dm644 packaging/flatpak/io.github.diode701.NyaaPaper.png /app/share/icons/hicolor/512x512/apps/io.github.diode701.NyaaPaper.png",
        "install -Dm644 gui/resources/fonts/JetBrainsMono-OFL.txt /app/share/licenses/io.github.diode701.NyaaPaper/fonts/OFL.txt",
        "install -Dm644 packaging/flatpak/licenses/mpv/LICENSE.GPL /app/share/licenses/io.github.diode701.NyaaPaper/mpv/LICENSE.GPL",
        "install -Dm644 packaging/flatpak/licenses/mpv/LICENSE.LGPL /app/share/licenses/io.github.diode701.NyaaPaper/mpv/LICENSE.LGPL",
        "install -Dm644 packaging/flatpak/licenses/glu/SGI-B-1.1.txt /app/share/licenses/io.github.diode701.NyaaPaper/glu/SGI-B-1.1.txt",
        "install -Dm644 packaging/flatpak/licenses/glu/SGI-B-2.0.txt /app/share/licenses/io.github.diode701.NyaaPaper/glu/SGI-B-2.0.txt",
        "install -Dm644 packaging/flatpak/licenses/glu/MIT.txt /app/share/licenses/io.github.diode701.NyaaPaper/glu/MIT.txt",
        "install -Dm644 packaging/flatpak/licenses/glm/copying.txt /app/share/licenses/io.github.diode701.NyaaPaper/glm/copying.txt"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/diode701/nyaapaper.git",
          "commit": "a5b3dcbd5f24cd872375aac014919dcf5589f34b"
        }
      ]
    }
  ]
}
