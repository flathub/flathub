<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.devculi.castsound</id>
  <launchable type="desktop-id">com.devculi.castsound.desktop</launchable>

  <name>CastSound</name>
  <summary>Stream audio between your computer and phone</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://castsound.app/terms</project_license>

  <developer id="app.castsound">
    <name>Devculi</name>
  </developer>

  <url type="homepage">https://castsound.app</url>
  <url type="help">https://castsound.app</url>
  <url type="contact">https://castsound.app</url>

  <icon type="stock">com.devculi.castsound</icon>

  <description>
    <p>
      CastSound turns your phone into a wireless speaker or microphone for your computer.
      Stream audio in real time with low latency over your local network.
    </p>
    <p>Features:</p>
    <ul>
      <li>Use your phone as a PC speaker or microphone</li>
      <li>Bi-directional combined audio streaming</li>
      <li>Cross-platform desktop app for Linux</li>
      <li>Simple pairing and deep-link support</li>
    </ul>
  </description>

