{
  "app-id": "io.github.greykaizen.tur",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.node20"
  ],
  "command": "tur",
  "finish-args": [
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--share=ipc",
    "--device=dri",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--filesystem=xdg-download"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/node20/bin",
    "env": {
      "CARGO_HOME": "/run/build/tur-tauri/cargo",
      "CARGO_NET_OFFLINE": "true",
      "npm_config_nodedir": "/usr/lib/sdk/node20"
    }
  },
  "modules": [
    "shared-modules/libayatana-appindicator/libayatana-appindicator-gtk3.json",
    {
      "name": "tur-tauri",
      "buildsystem": "simple",
      "build-commands": [
        "yarn install --offline --frozen-lockfile --non-interactive",
        "node_modules/.bin/tauri build --no-bundle",
        "install -Dm755 src-tauri/target/release/tur /app/bin/tur",
        "install -Dm644 src-tauri/icons/128x128.png /app/share/icons/hicolor/128x128/apps/io.github.greykaizen.tur.png",
        "install -Dm644 src-tauri/icons/32x32.png /app/share/icons/hicolor/32x32/apps/io.github.greykaizen.tur.png",
        "install -Dm644 src-tauri/icons/icon.png /app/share/icons/hicolor/512x512/apps/io.github.greykaizen.tur.png",
        "install -Dm644 packaging/flatpak/io.github.greykaizen.tur.desktop /app/share/applications/io.github.greykaizen.tur.desktop",
        "install -Dm644 packaging/flatpak/io.github.greykaizen.tur.metainfo.xml /app/share/metainfo/io.github.greykaizen.tur.metainfo.xml"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/greykaizen/tur-tauri",
          "tag": "v0.5.1",
          "commit": "3571dcbeee2644ed0fc922567d58b985568a3ccd"
        },
        "node-sources.json",
        "cargo-sources.json",
        {
          "type": "file",
          "path": "yarn.lock"
        },
        {
          "type": "inline",
          "dest-filename": ".yarnrc",
          "contents": "yarn-offline-mirror \"./flatpak-node/yarn-mirror\"\nyarn-offline-mirror-pruning false\n"
        }
      ]
    }
  ]
}