[Desktop Entry]
Type=Application
Name=Inkdrop
GenericName=Markdown Notes
Comment=Take notes in Markdown and keep them organised
Exec=inkdrop %U
Icon=app.inkdrop.Inkdrop
Terminal=false
StartupNotify=true
StartupWMClass=inkdrop
Categories=Office;Utility;TextEditor;
Keywords=markdown;notes;note-taking;notebook;editor;writing;
MimeType=x-scheme-handler/inkdrop;
