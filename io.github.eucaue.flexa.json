{
    "id": "io.github.eucaue.flexa",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "flexa",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-data/icons:create",
        "--filesystem=xdg-documents"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a",
        "/lib/python3.*/site-packages/numpy/*/tests",
        "/lib/python3.*/site-packages/numpy/tests",
        "/lib/python3.*/site-packages/mesonpy",
        "/lib/python3.*/site-packages/meson_python-*",
        "/lib/python3.*/site-packages/pyproject_metadata",
        "/lib/python3.*/site-packages/pyproject_metadata-*"
    ],
    "modules": [
        {
            "name": "imagemagick",
            "buildsystem": "autotools",
            "config-opts": [
                "--prefix=/app",
                "--disable-static",
                "--without-perl",
                "--without-x",
                "--enable-shared"
            ],
            "post-install": [
                "install -Dm0644 LICENSE -t ${FLATPAK_DEST}/share/licenses/io.github.eucaue.flexa/imagemagick/"
            ],
            "cleanup": [
                "/bin/Magick++-config",
                "/bin/MagickCore-config",
                "/bin/MagickWand-config",
                "/include",
                "/lib/pkgconfig"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/ImageMagick/ImageMagick/releases/download/7.1.2-34/ImageMagick-7.1.2-34.tar.xz",
                    "sha256": "55fe0ec246245b46c429f9e6bc65294ad4a78a66b88abd9817971ca157856323",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/ImageMagick/ImageMagick/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name == \"ImageMagick-\" + $version + \".tar.xz\") | .browser_download_url",
                        "timestamp-query": ".published_at"
                    }
                }
            ]
        },
        {
            "name": "python3-win2xcur",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pyproject-metadata==0.12.1\" --no-build-isolation",
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"meson-python==0.22.1\" --no-build-isolation",
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"win2xcur==0.2.1\" --no-build-isolation"
            ],
            "post-install": [
                "install -Dm0644 LICENSE -t ${FLATPAK_DEST}/share/licenses/io.github.eucaue.flexa/python3-win2xcur/"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/quantum5/win2xcur/c8a390b79456a45104fe42133b9d7eb4ce7c8638/LICENSE",
                    "sha256": "3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986",
                    "dest-filename": "LICENSE"
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/b9/8e/d883718e872abc214ba053f60f7e6edc2abd5ffbd1544beb01a9c92ddd3c/pyproject_metadata-0.12.1-py3-none-any.whl",
                    "sha256": "f7162d580a96386a8eb096da06215f981f547d1490f03055ef99e323bc2da427",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "pyproject-metadata",
                        "packagetype": "bdist_wheel"
                    }
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/96/62/0c1cf20fe158b0e623e78acbf5fb6de5f1410a408f65f727e4090497627b/meson_python-0.22.1-py3-none-any.whl",
                    "sha256": "258fde948cf45aab5df23fcc9e17a9050ee73d4e1002fe6cf86519f61c414778",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "meson-python",
                        "packagetype": "bdist_wheel"
                    }
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/d0/ad/fed0499ce6a338d2a03ebae59cd15093910c8875328855781952abf6c2fe/numpy-2.4.6.tar.gz",
                    "sha256": "f3a3570c4a2a16746ac2c31a7c7c7b0c186b95ce902e33db6f28094ed7387dda",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "numpy"
                    }
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/66/60/ca84d0e7937d0fa62e338e2ea3b69e99bdb01f337b6e88b561e12cc40dca/wand-0.7.1-py3-none-any.whl",
                    "sha256": "2c0d611c76b88c8947ad79b8d1ab994388ae6c8b795e54c0e46af431c84b81e4",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "wand",
                        "packagetype": "bdist_wheel"
                    }
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/2f/39/caa9bd69b2e1ace3a83d7de1b61986d6204f25ea30a4db8b36aa19d7938d/win2xcur-0.2.1-py3-none-any.whl",
                    "sha256": "0a3d23168b1700b46276d420ae9b7e374749ddbd02665dd4fb067f90ff66f2c5",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "win2xcur",
                        "packagetype": "bdist_wheel"
                    }
                }
            ]
        },
        {
            "name": "flexa",
            "buildsystem": "meson",
            "builddir": true,
            "config-opts": [
                "--libdir=lib"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/eucaue/flexa.git",
                    "tag": "v1.2.9",
                    "commit": "b2901c3ef87f599d4679f9d79a933b804c7a90a8"
                }
            ]
        }
    ]
}
