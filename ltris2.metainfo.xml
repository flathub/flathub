        <name>Michael Speck</name>
    </developer>
    <!-- The summary and description copied from: https://build.opensuse.org/package/show/games/ltris2 -->
    <summary>Tetris clone with multiplayer and CPU opponents</summary>
    <description>
        <p>
            LTris2 is a highly configurable, polished, HD-screen ready Tetris clone.
            It offers the well-known Classic game, a funny game type Figures
            (a new figure each level, suddenly appearing tiles and lines), and
            multiplayer against up to two CPU players or human versus human.
        </p>
    </description>
    <launchable type="desktop-id">ltris2.desktop</launchable>
