<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.aiche.Desktop</id>

  <name>AICHE Desktop</name>
  <summary>Audio transcription and text enhancement</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>LicenseRef-proprietary=https://aiche.app/terms</project_license>

  <description>
    <p>
      AICHE Desktop records audio from your microphone, transcribes it, and lets
      you enhance the resulting text. It keeps a searchable history, a personal
      dictionary for domain vocabulary, and a Voice Code mode for live dictation.
    </p>
    <p>Features:</p>
    <ul>
      <li>One-click audio recording and transcription</li>
      <li>Text enhancement with adjustable levels</li>
      <li>Voice Code: live speech-to-text over a WebSocket connection</li>
      <li>Personal dictionary for domain-specific vocabulary</li>
      <li>History with search, filters, and a calendar view</li>
      <li>Smart Insert: send transcription to the focused window through the desktop portal</li>
      <li>Global hotkeys for recording and mute</li>
    </ul>
  </description>

  <launchable type="desktop-id">app.aiche.Desktop.desktop</launchable>

  <url type="homepage">https://aiche.app</url>
  <url type="bugtracker">https://github.com/AICHE-app/linux-releases/issues</url>

  <developer id="app.aiche">
