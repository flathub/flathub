{
  "id": "app.byquan.DevSuite",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "devsuite",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "devsuite",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 bin/devsuite /app/bin/devsuite",
        "mkdir -p /app/share",
        "cp -r share/applications share/metainfo share/icons /app/share/",
        "install -Dm644 THIRD-PARTY-LICENSES.txt /app/share/licenses/app.byquan.DevSuite/THIRD-PARTY-LICENSES.txt"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.byquan.app/devsuite/devsuite-linux-0.1.2-x86_64.tar.xz",
          "sha256": "02cb6b5f71666da340e130307a919a49a3ad3df3a35b464a94fb6bac7176120f",
          "only-arches": [
            "x86_64"
          ]
        }
      ]
    }
  ]
}
