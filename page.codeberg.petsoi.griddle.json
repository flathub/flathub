{
    "id": "page.codeberg.petsoi.griddle",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "griddle",
    "finish-args": [
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=ipc"
    ],
    "modules": [
        {
            "name": "griddle",
            "buildsystem": "meson",
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-stable/bin",
                "env": {
                    "CARGO_HOME": "/run/build/griddle/cargo",
                    "CARGO_OFFLINE": "1"
                }
            },
            "sources": [
                {
                    "type": "git",
                    "url": "https://codeberg.org/petsoi/griddle.git",
                    "tag": "v0.3.2",
                    "commit": "02e7ba7b2d952ebf2ab0750f09190661cb8a2cbf"
                },
                "cargo-sources.json"
            ]
        }
    ]
}