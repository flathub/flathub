{
  "app-id": "cc.docking.Docking",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "docking",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--device=dri",
    "--talk-name=org.freedesktop.Notifications",
    "--system-talk-name=org.freedesktop.NetworkManager"
  ],
  "modules": [
    {
      "name": "libwnck",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dgtk_doc=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libwnck/43/libwnck-43.3.tar.xz",
          "sha256": "6af8ac41a8f067ade1d3caaed254a83423b5f61ad3f7a460fcacbac2e192bdf7"
        }
      ]
    },
    "python3-dependencies.json",
    {
      "name": "docking",
      "buildsystem": "simple",
      "build-commands": [
        "python3 -m ensurepip --upgrade || true",
        "bash tools/i18n.sh --compile",
        "python3 -m pip install --prefix=/app --no-build-isolation --no-deps .",
        "mv /app/bin/docking /app/bin/docking-real",
        "install -Dm755 /dev/stdin /app/bin/docking <<'EOF'\n#!/bin/sh\nset -eu\nif [ \"${XDG_SESSION_TYPE:-}\" = \"wayland\" ] || [ -n \"${WAYLAND_DISPLAY:-}\" ]; then\n  export GDK_BACKEND=x11\nfi\nexec /app/bin/docking-real \"$@\"\nEOF",
        "install -Dm644 packaging/flatpak/cc.docking.Docking.desktop /app/share/applications/cc.docking.Docking.desktop",
        "install -Dm644 packaging/flatpak/cc.docking.Docking.metainfo.xml /app/share/metainfo/cc.docking.Docking.metainfo.xml",
        "install -Dm644 packaging/flatpak/hicolor.index.theme /app/share/icons/hicolor/index.theme",
        "for size in 16 24 32 48 64 128 256 512; do install -Dm644 \"packaging/deb/icons/hicolor/${size}x${size}/apps/org.docking.Docking.png\" \"/app/share/icons/hicolor/${size}x${size}/apps/cc.docking.Docking.png\"; install -Dm644 \"packaging/deb/icons/hicolor/${size}x${size}/apps/org.docking.Docking.png\" \"/app/share/icons/hicolor/${size}x${size}/apps/org.docking.Docking.png\"; install -Dm644 \"packaging/deb/icons/hicolor/${size}x${size}/apps/org.docking.Docking.png\" \"/app/share/icons/hicolor/${size}x${size}/apps/org.docking.docking.png\"; done",
        "install -Dm644 packaging/deb/icons/hicolor/symbolic/apps/org.docking.Docking-symbolic.svg /app/share/icons/hicolor/symbolic/apps/cc.docking.Docking-symbolic.svg",
        "install -Dm644 packaging/deb/icons/hicolor/symbolic/apps/org.docking.Docking-symbolic.svg /app/share/icons/hicolor/symbolic/apps/org.docking.Docking-symbolic.svg",
        "install -Dm644 packaging/deb/icons/hicolor/symbolic/apps/org.docking.Docking-symbolic.svg /app/share/icons/hicolor/symbolic/apps/org.docking.docking-symbolic.svg"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/edumucelli/docking/archive/baa0db15bf19dd5d5fc0ee3913f2ba232a837946.tar.gz",
          "sha256": "92280690522b7ec817e6b134e10f50b141382d32d1776c0c04f25bc10df1cb9b"
        }
      ]
    }
  ]
}
