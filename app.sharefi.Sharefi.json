{
  "app-id": "app.sharefi.Sharefi",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "26.08",
  "command": "sharefi",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "iproute2",
      "buildsystem": "simple",
      "build-commands": [
        "./configure",
        "make -j$FLATPAK_BUILDER_N_JOBS SUBDIRS='lib ip'",
        "install -Dm755 ip/ip /app/bin/ip"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-7.2.0.tar.xz",
          "sha256": "4c2fa124c2cf0afd7ca34d1eeacba6ba048a56f6374e2aab93dafbdbd4eea9c0"
        }
      ]
    },
    {
      "name": "iputils",
      "buildsystem": "meson",
      "config-opts": [
        "-DBUILD_MANS=false",
        "-DBUILD_HTML_MANS=false",
        "-DUSE_IDN=false",
        "-DUSE_GETTEXT=false",
        "-DUSE_CAP=false",
        "-DNO_SETCAP_OR_SUID=true",
        "-DSKIP_TESTS=true"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/iputils/iputils/archive/refs/tags/20250605.tar.gz",
          "sha256": "19e680c9eef8c079da4da37040b5f5453763205b4edfb1e2c114de77908927e4"
        }
      ]
    },
    {
      "name": "sharefi",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/sharefi",
        "cp -a --reflink=auto sharefi-app/. /app/sharefi/",
        "install -Dm755 sharefi-wrapper.sh /app/bin/sharefi",
        "install -Dm644 app.sharefi.Sharefi.desktop /app/share/applications/app.sharefi.Sharefi.desktop",
        "install -Dm644 app.sharefi.Sharefi.metainfo.xml /app/share/metainfo/app.sharefi.Sharefi.metainfo.xml",
        "install -Dm644 app.sharefi.Sharefi.png /app/share/icons/hicolor/512x512/apps/app.sharefi.Sharefi.png"
      ],
      "sources": [
        {
          "type": "script",
          "dest-filename": "sharefi-wrapper.sh",
          "commands": [
            "exec zypak-wrapper /app/sharefi/sharefi \"$@\""
          ]
        },
        {
          "type": "archive",
          "only-arches": ["x86_64"],
          "url": "https://github.com/lucafornerone/sharefi-electron/releases/download/v1.0.4/sharefi-1.0.4.tar.gz",
          "sha256": "c9cb13a46c7a34eca327f4edded86985e177a97467b593e5bfd7fc6be8ed6e02",
          "dest": "sharefi-app"
        },
        {
          "type": "archive",
          "only-arches": ["aarch64"],
          "url": "https://github.com/lucafornerone/sharefi-electron/releases/download/v1.0.4/sharefi-1.0.4-arm64.tar.gz",
          "sha256": "438b7f2424bab9a556aafac7d586b65c5195c5a12ebea78a909f0f65d2cac332",
          "dest": "sharefi-app"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/lucafornerone/sharefi-electron/refs/tags/v1.0.4/dist/release/build/flatpak/app.sharefi.Sharefi.desktop",
          "sha256": "c4a5f27f1739e5c101d9b02bd17891c27985999d8bb466f5b9d8a70d59697430"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/lucafornerone/sharefi-electron/refs/tags/v1.0.4/dist/release/build/flatpak/app.sharefi.Sharefi.metainfo.xml",
          "sha256": "ee75ad0415175213e8965f7aad634a7100c53741921c2a666b4ac9345c782b4f"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/lucafornerone/sharefi-electron/refs/tags/v1.0.4/dist/release/build/flatpak/app.sharefi.Sharefi.png",
          "sha256": "9be2ef13ccec9db45ff23b2955841198948cb594676bab8947ed446afb087d25"
        }
      ]
    }
  ]
}