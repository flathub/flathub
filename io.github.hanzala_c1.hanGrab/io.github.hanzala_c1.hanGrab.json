{
    "id": "io.github.hanzala_c1.hanGrab",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "base": "io.qt.PySide.BaseApp",
    "base-version": "6.10",
    "command": "ytgrab",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--share=network",
        "--filesystem=xdg-download"
    ],
    "add-extensions": {
        "org.freedesktop.Platform.ffmpeg-full": {
            "directory": "lib/ffmpeg",
            "version": "25.08",
            "add-ld-path": "."
        }
    },
    "modules": [
        {
            "name": "ffmpeg-ext",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/lib/ffmpeg",
                "mkdir -p /app/bin",
                "ln -sf /app/lib/ffmpeg/ffmpeg /app/bin/ffmpeg"
            ]
        },
        {
            "name": "hangrab",
            "buildsystem": "simple",
            "build-options": {
                "build-args": [
                    "--share=network"
                ]
            },
            "build-commands": [
                "pip3 install --prefix=/app yt-dlp",
                "install -Dm644 main.py /app/bin/main.py",
                "cp -r src /app/bin/src",
                "install -Dm755 ytgrab-launcher.sh /app/bin/ytgrab",
                "install -Dm644 io.github.hanzala_c1.hanGrab.desktop /app/share/applications/io.github.hanzala_c1.hanGrab.desktop",
                "install -Dm644 io.github.hanzala_c1.hanGrab.metainfo.xml /app/share/metainfo/io.github.hanzala_c1.hanGrab.metainfo.xml",
                "install -Dm644 icon-256.png /app/share/icons/hicolor/256x256/apps/io.github.hanzala_c1.hanGrab.png",
                "install -Dm644 icon-48.png /app/share/icons/hicolor/48x48/apps/io.github.hanzala_c1.hanGrab.png",
                "install -Dm644 icon-32.png /app/share/icons/hicolor/32x32/apps/io.github.hanzala_c1.hanGrab.png"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/hanzala-c1/hanGrab.git",
                    "tag": "v1.0.0"
                },
                {
                    "type": "file",
                    "path": "ytgrab-launcher.sh"
                },
                {
                    "type": "file",
                    "path": "io.github.hanzala_c1.hanGrab.desktop"
                },
                {
                    "type": "file",
                    "path": "io.github.hanzala_c1.hanGrab.metainfo.xml"
                }
            ]
        }
    ]
}