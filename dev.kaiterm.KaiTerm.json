{
  "id": "dev.kaiterm.KaiTerm",
  "command": "kaiterm",
  "separate-locales": false,
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "finish-args": [
    "--device=dri",
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "kaiterm",
      "buildsystem": "simple",
      "build-commands": [
        "cp -ar app-electron ${FLATPAK_DEST}/kaiterm",
        "install -Dm755 kaiterm ${FLATPAK_DEST}/bin/kaiterm",
        "install -Dm644 ${FLATPAK_ID}.metainfo.xml ${FLATPAK_DEST}/share/metainfo/${FLATPAK_ID}.metainfo.xml",
        "install -Dm644 ${FLATPAK_ID}.desktop ${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop",
        "install -Dm644 ${FLATPAK_ID}.png ${FLATPAK_DEST}/share/icons/hicolor/512x512/apps/${FLATPAK_ID}.png"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/kaiterm-dev/KaiTerm/releases/download/v1.0.1/KaiTerm-Linux-1.0.1-x64.tar.gz",
          "sha256": "3d348b14cd6c93d0f3c8fde9ffedcc1be2a11ec27fb97fa4f3181ab088913428",
          "dest": "app-electron"
        },
        {
          "type": "script",
          "dest-filename": "kaiterm",
          "commands": [
            "exec zypak-wrapper /app/kaiterm/kaiterm \"$@\""
          ]
        },
        {
          "type": "file",
          "path": "dev.kaiterm.KaiTerm.desktop"
        },
        {
          "type": "file",
          "path": "dev.kaiterm.KaiTerm.png"
        },
        {
          "type": "file",
          "path": "dev.kaiterm.KaiTerm.metainfo.xml"
        }
      ]
    }
  ]
}
