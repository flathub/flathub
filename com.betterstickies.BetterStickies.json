{
  "app-id": "com.betterstickies.BetterStickies",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "betterstickies",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--device=dri",
    "--socket=pulseaudio",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.kde.KWin",
    "--filesystem=xdg-desktop:ro",
    "--filesystem=xdg-documents:ro",
    "--filesystem=xdg-download:ro",
    "--filesystem=xdg-pictures:ro"
  ],
  "modules": [
    {
      "name": "betterstickies",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 apply_extra /app/bin/apply_extra",
        "install -Dm755 betterstickies-wrapper /app/bin/betterstickies",
        "install -Dm644 com.betterstickies.BetterStickies.desktop /app/share/applications/com.betterstickies.BetterStickies.desktop",
        "install -Dm644 com.betterstickies.BetterStickies.metainfo.xml /app/share/metainfo/com.betterstickies.BetterStickies.metainfo.xml",
        "install -Dm644 icons/icon-512.png /app/share/icons/hicolor/512x512/apps/com.betterstickies.BetterStickies.png",
        "install -Dm644 icons/icon-256.png /app/share/icons/hicolor/256x256/apps/com.betterstickies.BetterStickies.png",
        "install -Dm644 icons/icon-128.png /app/share/icons/hicolor/128x128/apps/com.betterstickies.BetterStickies.png",
        "install -Dm644 icons/icon-64.png /app/share/icons/hicolor/64x64/apps/com.betterstickies.BetterStickies.png"
      ],
      "sources": [
        {
          "type": "extra-data",
          "filename": "BetterStickies.tar.gz",
          "url": "https://github.com/HimaSphere/BetterStickies/releases/download/v1.4.0/BetterStickies_Free_1.4.0-x86_64.tar.gz",
          "sha256": "1ccfee461f2fc8f5ba6262c0c94f1445a60d31e11138040005c28b1c1e89b8a1",
          "size": 82705332,
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/HimaSphere/BetterStickies/releases/latest",
            "version-query": ".tag_name | sub(\"^v\"; \"\")",
            "url-query": ".assets[] | select(.name | test(\"Free.*x86_64.tar.gz$\")) | .browser_download_url"
          }
        },
        {
          "type": "script",
          "dest-filename": "apply_extra",
          "commands": [
            "mkdir -p betterstickies",
            "tar xf BetterStickies.tar.gz -C betterstickies",
            "rm -f BetterStickies.tar.gz"
          ]
        },
        {
          "type": "script",
          "dest-filename": "betterstickies-wrapper",
          "commands": [
            "export QT_QPA_PLATFORM=xcb",
            "export QT_IM_MODULE=ibus",
            "exec /app/extra/betterstickies/AppRun \"$@\""
          ]
        },
        {
          "type": "file",
          "path": "com.betterstickies.BetterStickies.desktop"
        },
        {
          "type": "file",
          "path": "com.betterstickies.BetterStickies.metainfo.xml"
        },
        {
          "type": "file",
          "path": "icons/icon-512.png",
          "dest": "icons"
        },
        {
          "type": "file",
          "path": "icons/icon-256.png",
          "dest": "icons"
        },
        {
          "type": "file",
          "path": "icons/icon-128.png",
          "dest": "icons"
        },
        {
          "type": "file",
          "path": "icons/icon-64.png",
          "dest": "icons"
        }
      ]
    }
  ]
}
