{
  "app-id": "com.betterstickies.BetterStickies",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "betterstickies",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=x11",
    "--device=dri",
    "--socket=pulseaudio",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--filesystem=xdg-desktop:ro",
    "--filesystem=xdg-documents:ro",
    "--filesystem=xdg-download:ro",
    "--filesystem=xdg-pictures:ro"
  ],
  "modules": [
    {
      "name": "betterstickies",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a betterstickies /app/betterstickies",
        "install -Dm755 betterstickies-wrapper /app/bin/betterstickies",
        "install -Dm644 betterstickies/usr/share/applications/com.betterstickies.BetterStickies.desktop /app/share/applications/com.betterstickies.BetterStickies.desktop",
        "desktop-file-edit --set-key=Exec --set-value=betterstickies /app/share/applications/com.betterstickies.BetterStickies.desktop",
        "install -Dm644 betterstickies/usr/share/metainfo/com.betterstickies.BetterStickies.metainfo.xml /app/share/metainfo/com.betterstickies.BetterStickies.metainfo.xml",
        "for size in 64 128 256 512; do install -Dm644 betterstickies/usr/share/icons/hicolor/${size}x${size}/apps/com.betterstickies.BetterStickies.png /app/share/icons/hicolor/${size}x${size}/apps/com.betterstickies.BetterStickies.png; done"
      ],
      "sources": [
        {
          "type": "archive",
          "only-arches": ["x86_64"],
          "url": "https://github.com/HimaSphere/BetterStickies/releases/download/v1.4.2/BetterStickies_Free_1.4.2-x86_64.tar.gz",
          "sha256": "80010eb8e02acd3ab09004d6f41eb69c02e93b7f733da7ad3e28214fcf03c62d",
          "dest": "betterstickies",
          "strip-components": 0,
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/HimaSphere/BetterStickies/releases?per_page=100",
            "version-query": "[.[] | select((.draft or .prerelease) | not) | select(any(.assets[]; .name | test(\"^BetterStickies_Free_.*-x86_64[.]tar[.]gz$\")))] | first | .tag_name | sub(\"^v\"; \"\")",
            "url-query": "[.[] | select((.draft or .prerelease) | not) | .assets[] | select(.name | test(\"^BetterStickies_Free_.*-x86_64[.]tar[.]gz$\"))] | first | .browser_download_url"
          }
        },
        {
          "type": "archive",
          "only-arches": ["aarch64"],
          "url": "https://github.com/HimaSphere/BetterStickies/releases/download/v1.4.2/BetterStickies_Free_1.4.2-aarch64.tar.gz",
          "sha256": "127a00f9f5e1a8ae5fadc346fe0614bfc7fe90de56f8abf2c95d18461d95f979",
          "dest": "betterstickies",
          "strip-components": 0,
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/HimaSphere/BetterStickies/releases?per_page=100",
            "version-query": "[.[] | select((.draft or .prerelease) | not) | select(any(.assets[]; .name | test(\"^BetterStickies_Free_.*-aarch64[.]tar[.]gz$\")))] | first | .tag_name | sub(\"^v\"; \"\")",
            "url-query": "[.[] | select((.draft or .prerelease) | not) | .assets[] | select(.name | test(\"^BetterStickies_Free_.*-aarch64[.]tar[.]gz$\"))] | first | .browser_download_url"
          }
        },
        {
          "type": "script",
          "dest-filename": "betterstickies-wrapper",
          "commands": [
            "export QT_QPA_PLATFORM=xcb",
            "export QT_IM_MODULE=ibus",
            "exec /app/betterstickies/AppRun \"$@\""
          ]
        }
      ]
    }
  ]
}
