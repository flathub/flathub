{
    "app-id": "io.github.bigbigmdm.imsprog",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "IMSProg",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=all",
        "--socket=session-bus",
        "--share=network"
    ],
    "modules": [
        {
            "name": "libftdi",
            "buildsystem": "cmake",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_INSTALL_PREFIX=/app",
                "-DLIBFTDI_STATIC_LIBS=OFF",
                "-DFTDI_EEPROM=OFF",
                "-DLIB_SUFFIX="
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.intra2net.com/en/developer/libftdi/download/libftdi1-1.5.tar.bz2",
                    "sha256": "7c7091e9c86196148bd41177b4590dccb1510bfe6cea5bf7407ff194482eb049"
                }
            ]
        },
        {
            "name": "imsprog-programmer",
            "buildsystem": "cmake",
            "subdir": "IMSProg_programmer",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_INSTALL_PREFIX=/app"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/bigbigmdm/IMSProg/archive/refs/tags/v1.9.2.tar.gz",
                    "sha256": "228fac1dac14bc096b85f57bd1acf7b1fc1d1215aaae021c8708420597fe8d36"
                },
                {
                    "type": "patch",
                    "path": "udevdir.patch"
                }
            ]
        },
        {
            "name": "imsprog-editor",
            "buildsystem": "cmake",
            "subdir": "IMSProg_editor",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_INSTALL_PREFIX=/app"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/bigbigmdm/IMSProg/archive/refs/tags/v1.9.2.tar.gz",
                    "sha256": "228fac1dac14bc096b85f57bd1acf7b1fc1d1215aaae021c8708420597fe8d36"
                }
            ]
        },
        {
            "name": "imsprog-database-update",
            "buildsystem": "cmake",
            "subdir": "IMSProg_database_update",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_INSTALL_PREFIX=/app"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/bigbigmdm/IMSProg/archive/refs/tags/v1.9.2.tar.gz",
                    "sha256": "228fac1dac14bc096b85f57bd1acf7b1fc1d1215aaae021c8708420597fe8d36"
                }
            ]
        }
    ]
}
