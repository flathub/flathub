<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.vangs.VangsApp</id>
  <name>Vangs App</name>
  <summary>Digital Wardrobe, Fashion Ecosystem &amp; Marketplace</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://www.vangs.app/terms</project_license>
  <developer id="app.vangs">
    <name>Vangs App</name>
  </developer>

  <description>
    <p>
      Vangs App is the unified fashion platform for cataloging your digital wardrobe, building outfits, connecting across the fashion network, and exploring curated pieces.
    </p>
    <p>
      Designed for desktop performance on Linux with multi-window workspaces, native Wayland and X11 support, instant wardrobe filtering, and seamless synchronization across all 11 Vangs App ecosystem hubs.
    </p>
    <ul>
      <li>Catalog your wardrobe with detailed garment measurements, care labels, and outfit combinations</li>
      <li>Explore the marketplace and curated thrift collections including Vangarments</li>
      <li>Collaborate via real-time messaging, rich entity cards, and shared vaults</li>
      <li>Switch effortlessly across 6 + 1 adaptive themes including Vangs, Midnight OLED, and Graphite</li>
    </ul>
  </description>

  <launchable type="desktop-id">app.vangs.VangsApp.desktop</launchable>

  <provides>
    <id>com.vvdassociation.vangs.desktop</id>
    <binary>vangs-app</binary>
  </provides>

  <url type="homepage">https://www.vangs.app</url>
  <url type="help">https://www.vangs.app/support</url>
  <url type="faq">https://www.vangs.app/support</url>
  <url type="contact">https://www.vangs.app/support</url>

  <screenshots>
    <screenshot type="default">
      <caption>Vangs App Digital Wardrobe &amp; Fashion Ecosystem</caption>
      <image>https://storage.googleapis.com/vangarments-storage/releases/linux/screenshots/vangs-app-desktop.png</image>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#fff7d7</color>
    <color type="primary" scheme_preference="dark">#00132d</color>
  </branding>

  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
  </categories>

  <keywords>
    <keyword>fashion</keyword>
    <keyword>wardrobe</keyword>
    <keyword>outfits</keyword>
    <keyword>marketplace</keyword>
    <keyword>vangs</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <requires>
    <display_length compare="ge">360</display_length>
    <internet>always</internet>
  </requires>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="money-purchasing">intense</content_attribute>
  </content_rating>

  <releases>
    <release version="1.3.0" date="2026-11-02">
      <description>
        <p>Linux Store release featuring Flathub and Snap Store support, Wayland/X11 hardware acceleration, multi-window workspaces, and deep-link protocol handling.</p>
      </description>
    </release>
  </releases>
</component>
