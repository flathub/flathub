{
    "id": "net.dzqdzq.DesktopFilesEditor",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "desktop-files-editor",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-data/applications:create",
        "--filesystem=host-os:ro",
        "--filesystem=/var/lib/flatpak/exports/share/applications:ro",
        "--filesystem=xdg-data/flatpak/exports/share/applications:ro",
        "--filesystem=xdg-data/icons:ro",
        "--filesystem=/var/lib/flatpak/exports/share/icons:ro",
        "--filesystem=xdg-data/flatpak/exports/share/icons:ro",
        "--filesystem=/var/lib/flatpak/app:ro",
        "--filesystem=xdg-data/flatpak/app:ro"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "blueprint-compiler",
            "buildsystem": "meson",
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/blueprint-compiler",
                    "tag": "v0.22.2",
                    "commit": "ed35ac74de0c1bb1f5e852410b97edd1f08904c9"
                }
            ]
        },
        {
            "name": "desktop-files-editor",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/MathieuMarthy/desktop-files-editor.git",
                    "tag": "v0.1.0",
                    "commit": "5ab4af6bcb134b925d0e59763d22f3d3c06d6b93"
                }
            ]
        }
    ]
}