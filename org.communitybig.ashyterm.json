{
    "app-id": "org.communitybig.ashyterm",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "ashyterm",
    "rename-icon": "ashyterm",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--filesystem=host",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake",
        "/share/man",
        "/share/doc",
        "/share/gir-1.0",
        "/share/vala",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "fast_float",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DFASTFLOAT_TEST=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/fastfloat/fast_float/archive/refs/tags/v8.2.5.tar.gz",
                    "sha256": "17c7fb14499fcf42c3f5d143df0fbe22172e92749ec5f75ef13224005421a654"
                }
            ]
        },
        {
            "name": "simdutf",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DSIMDUTF_TESTS=OFF",
                "-DSIMDUTF_TOOLS=OFF",
                "-DBUILD_SHARED_LIBS=ON"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/simdutf/simdutf/archive/refs/tags/v9.0.0.tar.gz",
                    "sha256": "fd2ce975f29809a975a8da8843cfb3a7265af3f71be548f199d23cf65e101764"
                }
            ]
        },
        {
            "name": "vte",
            "buildsystem": "meson",
            "config-opts": [
                "-Dgtk3=false",
                "-Dgtk4=true",
                "-Dgir=true",
                "-Dvapi=false",
                "-Dglade=false",
                "-Ddocs=false",
                "-Dapp=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/vte/0.84/vte-0.84.1.tar.xz",
                    "sha256": "aca1caa8478aebcdbb1d67897fb3511eb7601debae6810e16a15b6fa25f31ac8"
                }
            ]
        },
        {
            "name": "sshpass",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://downloads.sourceforge.net/project/sshpass/sshpass/1.10/sshpass-1.10.tar.gz",
                    "sha256": "ad1106c203cbb56185ca3bad8c6ccafca3b4064696194da879f81c8d7bdfeeda"
                }
            ]
        },
        {
            "name": "rsync",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-md2man"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.samba.org/ftp/rsync/src/rsync-3.5.1.tar.gz",
                    "sha256": "c55f9c9dc10fb8bec397b399a0fdded53cc9a2d8e30891bb0d63724d25c37bef"
                }
            ]
        },
        "python3-dependencies.json",
        {
            "name": "ashyterm",
            "buildsystem": "simple",
            "build-commands": [
                "install -d /app/share/ashyterm",
                "cp -a src/ashyterm /app/share/ashyterm/",
                "install -Dm755 ashyterm-flatpak /app/bin/ashyterm",
                "install -Dm644 usr/share/applications/org.communitybig.ashyterm.desktop /app/share/applications/org.communitybig.ashyterm.desktop",
                "install -Dm644 usr/share/icons/hicolor/scalable/apps/ashyterm.svg /app/share/icons/hicolor/scalable/apps/ashyterm.svg",
                "for locale in usr/share/locale/*/LC_MESSAGES/ashyterm.mo; do install -Dm644 \"$locale\" \"/app/${locale#usr/}\"; done",
                "install -Dm644 org.communitybig.ashyterm.metainfo.xml /app/share/metainfo/org.communitybig.ashyterm.metainfo.xml",
                "install -Dm644 LICENSE /app/share/licenses/ashyterm/LICENSE"
            ],
            "sources": [
                {
                    "type": "git",
                    "tag": "26.11.09-2057",
                    "url": "https://github.com/big-comm/ashyterm.git",
                    "commit": "27d228dcefa3c1725c0966a813b21914da6ebd54"
                },
                {
                    "type": "file",
                    "path": "ashyterm-flatpak"
                },
                {
                    "type": "file",
                    "path": "org.communitybig.ashyterm.metainfo.xml"
                }
            ]
        }
    ]
}
