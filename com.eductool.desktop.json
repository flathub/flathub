{
  "app-id": "com.eductool.desktop",
  "runtime": "org.gnome.Platform",
  "runtime-version": "45",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.node18",
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "eductool",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--share=network",
    "--filesystem=host"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/node18/bin:/usr/lib/sdk/rust-stable/bin",
    "env": {
      "RUST_BACKTRACE": "1"
    }
  },
  "modules": [
    {
      "name": "eductool",
      "buildsystem": "simple",
      "build-commands": [
        "npm install",
        "npm run tauri build -- --bundles bst",
        "install -Dm755 src-tauri/target/release/eductool /app/bin/eductool",
        "install -Dm644 metadata/org.eductool.EducTool.appdata.xml /app/share/metainfo/org.eductool.EducTool.appdata.xml"
      ],
      "sources": [
      {
            "type": "git",
            "url": "https://gitlab.com/devmr/eductool-desktop-tauri.git",
            "tag": "v0.13.0"
       }
      ]
    }
  ]
}