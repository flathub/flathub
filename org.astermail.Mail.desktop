[Desktop Entry]
Type=Application
Name=Aster Mail
GenericName=Email Client
Comment=End-to-end encrypted, quantum-safe email
Exec=aster-mail-desktop %u
Icon=org.astermail.Mail
Terminal=false
Categories=Network;Email;
Keywords=email;mail;encrypted;pgp;privacy;
MimeType=x-scheme-handler/mailto;x-scheme-handler/aster;
StartupNotify=true
StartupWMClass=aster-mail-desktop
