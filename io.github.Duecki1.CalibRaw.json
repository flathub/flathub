{
    "app-id": "io.github.Duecki1.CalibRaw",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "calibraw",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--filesystem=xdg-pictures",
        "--filesystem=xdg-run/discord-ipc-0",
        "--filesystem=xdg-run/app/com.discordapp.Discord:create"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake",
        "/share/man",
        "*.a",
        "*.la"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
        "env": {
            "CARGO_HOME": "/run/build/calibraw/cargo",
            "LIBCLANG_PATH": "/usr/lib/sdk/llvm22/lib",
            "CALIBRAW_REQUIRE_LENSFUN": "1",
            "CALIBRAW_BUNDLED_ONNX_RUNTIME": "/app/lib/libonnxruntime.so",
            "CALIBRAW_BUNDLED_ONNX_RUNTIME_VERSION": "1.30.0",
            "CALIBRAW_SOURCE_REVISION": "9f648e41e47d974ee8a99fc325fa1f6d676bfa09",
            "CALIBRAW_DISCORD_APPLICATION_ID": "1542956929222058124",
            "SOURCE_DATE_EPOCH": "1791333712"
        }
    },
    "modules": [
        {
            "name": "libraw",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-static",
                "--disable-examples"
            ],
            "post-install": [
                "install -Dm644 COPYRIGHT /app/share/licenses/io.github.Duecki1.CalibRaw/libraw/COPYRIGHT",
                "install -Dm644 LICENSE.LGPL /app/share/licenses/io.github.Duecki1.CalibRaw/libraw/LICENSE.LGPL",
                "install -Dm644 LICENSE.CDDL /app/share/licenses/io.github.Duecki1.CalibRaw/libraw/LICENSE.CDDL"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/LibRaw/LibRaw/archive/b860248a89d9082b8e0a1e202e516f46af9adb29.tar.gz",
                    "sha256": "f5da1e522ea195b54b30f3ff105ef2193daa04ea165dea825b4d6fe9d886395b"
                },
                {
                    "type": "script",
                    "dest-filename": "autogen.sh",
                    "commands": [
                        "autoreconf --install --force"
                    ]
                }
            ]
        },
        {
            "name": "lensfun",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_INSTALL_LIBDIR=lib",
                "-DBUILD_STATIC=OFF",
                "-DBUILD_TESTS=OFF",
                "-DBUILD_LENSTOOL=OFF",
                "-DBUILD_DOC=OFF",
                "-DINSTALL_PYTHON_MODULE=OFF",
                "-DINSTALL_HELPER_SCRIPTS=OFF"
            ],
            "post-install": [
                "install -Dm644 ../docs/lgpl-3.0.txt /app/share/licenses/io.github.Duecki1.CalibRaw/lensfun/lgpl-3.0.txt",
                "install -Dm644 ../docs/gpl-3.0.txt /app/share/licenses/io.github.Duecki1.CalibRaw/lensfun/gpl-3.0.txt",
                "install -Dm644 ../docs/cc-by-sa-3.0.txt /app/share/licenses/io.github.Duecki1.CalibRaw/lensfun/cc-by-sa-3.0.txt"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/lensfun/lensfun/archive/refs/tags/v0.3.4.tar.gz",
                    "sha256": "dafb39c08ef24a0e2abd00d05d7341b1bf1f0c38bfcd5a4c69cf5f0ecb6db112"
                }
            ]
        },
        "onnxruntime-module.json",
        {
            "name": "calibraw",
            "buildsystem": "simple",
            "build-commands": [
                "python3 packaging/flatpak/generate-licenses.py",
                "cargo build --offline --locked --release -p calibraw-ui --bin calibraw -p calibraw-cli --bin calibraw-develop-export",
                "install -Dm755 \"${CARGO_TARGET_DIR:-target}/release/calibraw\" /app/bin/calibraw",
                "install -Dm755 \"${CARGO_TARGET_DIR:-target}/release/calibraw-develop-export\" /app/bin/calibraw-develop-export",
                "install -Dm644 packaging/linux/io.github.Duecki1.CalibRaw.desktop /app/share/applications/io.github.Duecki1.CalibRaw.desktop",
                "install -Dm644 packaging/linux/io.github.Duecki1.CalibRaw.metainfo.xml /app/share/metainfo/io.github.Duecki1.CalibRaw.metainfo.xml",
                "install -Dm644 packaging/icons/calibraw.svg /app/share/icons/hicolor/scalable/apps/io.github.Duecki1.CalibRaw.svg",
                "install -Dm644 packaging/icons/calibraw-256.png /app/share/icons/hicolor/256x256/apps/io.github.Duecki1.CalibRaw.png",
                "install -Dm644 COPYING /app/share/licenses/io.github.Duecki1.CalibRaw/COPYING",
                "install -Dm644 THIRD_PARTY_NOTICES.md /app/share/licenses/io.github.Duecki1.CalibRaw/THIRD_PARTY_NOTICES.md",
                "install -Dm644 data/wb_presets.json.license /app/share/licenses/io.github.Duecki1.CalibRaw/wb_presets.json.license",
                "install -Dm644 THIRD_PARTY_LICENSES.md /app/share/licenses/io.github.Duecki1.CalibRaw/THIRD_PARTY_LICENSES.md"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/Duecki1/CalibRaw.git",
                    "commit": "9f648e41e47d974ee8a99fc325fa1f6d676bfa09"
                },
                "cargo-sources.json"
            ]
        }
    ]
}
