#!/bin/sh
set -e

# Base directories
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
APP_DATA_DIR="$XDG_DATA_HOME/modloader64"
APP_CONFIG_DIR="$XDG_CONFIG_HOME/modloader64"

mkdir -p "$APP_DATA_DIR" "$APP_CONFIG_DIR"
CREATED_CONFIG=0

# Initialize user writable data directories from template if not present
if [ ! -d "$APP_DATA_DIR/ModLoader" ]; then
    mkdir -p "$APP_DATA_DIR/ModLoader"
    if [ -d "/app/lib/modloader64/ModLoader-template" ]; then
        cp -rn /app/lib/modloader64/ModLoader-template/* "$APP_DATA_DIR/ModLoader/" 2>/dev/null || true
    fi
fi

# Ensure ModLoader64-config.json exists with proper case and no implicit launch target.
if [ ! -f "$APP_DATA_DIR/ModLoader/ModLoader64-config.json" ]; then
    if [ -f "$APP_DATA_DIR/ModLoader/modloader64-config.json" ]; then
        cp "$APP_DATA_DIR/ModLoader/modloader64-config.json" "$APP_DATA_DIR/ModLoader/ModLoader64-config.json"
        CREATED_CONFIG=1
    elif [ -f "/app/lib/modloader64/ModLoader-template/modloader64-config.json" ]; then
        cp "/app/lib/modloader64/ModLoader-template/modloader64-config.json" "$APP_DATA_DIR/ModLoader/ModLoader64-config.json"
        CREATED_CONFIG=1
    fi
fi

if [ -f "$APP_DATA_DIR/ModLoader/ModLoader64-config.json" ]; then
    APP_DATA_DIR="$APP_DATA_DIR" CREATED_CONFIG="$CREATED_CONFIG" python3 - <<'PY'
import json
import os

config_path = os.path.join(os.environ["APP_DATA_DIR"], "ModLoader", "ModLoader64-config.json")
created_config = os.environ.get("CREATED_CONFIG") == "1"
try:
    with open(config_path, "r", encoding="utf-8") as config_file:
        config = json.load(config_file)
    modloader_config = config.setdefault("ModLoader64", {})
    configured_rom = str(modloader_config.get("rom", ""))
    rom_path = os.path.join(os.environ["APP_DATA_DIR"], "ModLoader", "roms", configured_rom)
    stale_default_rom = configured_rom == "Legend of Zelda, The - Ocarina of Time (U) (V1.0) [!].z64" and not os.path.exists(rom_path)
    if created_config or stale_default_rom:
        modloader_config["rom"] = ""
        modloader_config["patch"] = ""
        modloader_config["isServer"] = False
        modloader_config["isClient"] = False
        with open(config_path, "w", encoding="utf-8") as config_file:
            json.dump(config, config_file, indent=2)
except Exception:
    pass
PY
fi

# Repair older installs that copied a broken modloader64_api symlink.
# Use the packaged template copy when user data is missing or still symlinked.
API_USER_DIR="$APP_DATA_DIR/ModLoader/node_modules/modloader64_api"
API_TEMPLATE_DIR="/app/lib/modloader64/ModLoader-template/node_modules/modloader64_api"
if [ -d "/app/lib/modloader64/ModLoader-template/node_modules" ]; then
    mkdir -p "$APP_DATA_DIR/ModLoader/node_modules"
    if [ -L "$API_USER_DIR" ] || [ ! -e "$API_USER_DIR" ]; then
        rm -rf "$API_USER_DIR"
        cp -a "$API_TEMPLATE_DIR" "$API_USER_DIR"
    fi
fi

# Some legacy user-data copies may keep an unpatched module-alias package.
# The core expects global["module-alias"]["moduleAliases"] to exist.
MODULE_ALIAS_USER_DIR="$APP_DATA_DIR/ModLoader/node_modules/module-alias"
MODULE_ALIAS_TEMPLATE_DIR="/app/lib/modloader64/ModLoader-template/node_modules/module-alias"
if [ ! -d "$MODULE_ALIAS_USER_DIR" ] && [ -d "$MODULE_ALIAS_TEMPLATE_DIR" ]; then
    cp -a "$MODULE_ALIAS_TEMPLATE_DIR" "$MODULE_ALIAS_USER_DIR"
fi
if [ -f "$MODULE_ALIAS_USER_DIR/index.js" ] && ! grep -Fq 'global["module-alias"]' "$MODULE_ALIAS_USER_DIR/index.js"; then
    cat >> "$MODULE_ALIAS_USER_DIR/index.js" <<'EOF'

global["module-alias"] = {};
global["module-alias"]["moduleAliases"] = moduleAliases;
EOF
fi

# Disable runtime auto-updates for Flatpak distribution (managed via Flathub)
if [ ! -f "$APP_DATA_DIR/ModLoader64-GUI-config.json" ]; then
    cat << 'EOF' > "$APP_DATA_DIR/ModLoader64-GUI-config.json"
{
  "showAdvancedTab": false,
  "automaticUpdates": false
}
EOF
fi

# Ensure emulator plugins and libraries are linked / accessible
mkdir -p "$APP_DATA_DIR/ModLoader/emulator"
if [ -d "$APP_DATA_DIR/ModLoader/emulator/emulator" ]; then
    cp -a "$APP_DATA_DIR/ModLoader/emulator/emulator/." "$APP_DATA_DIR/ModLoader/emulator/" 2>/dev/null || true
    rm -rf "$APP_DATA_DIR/ModLoader/emulator/emulator"
fi
if [ -d "/app/lib/modloader64/ModLoader-template/emulator" ]; then
    cp -an /app/lib/modloader64/ModLoader-template/emulator/. "$APP_DATA_DIR/ModLoader/emulator/" 2>/dev/null || true
fi
# Replace the legacy prebuilt audio addon, which requires unavailable libnode.so.64.
AUDIO_USER_ADDON="$APP_DATA_DIR/ModLoader/emulator/sfml_audio.node"
AUDIO_TEMPLATE_ADDON="/app/lib/modloader64/ModLoader-template/emulator/sfml_audio.node"
if [ -f "$AUDIO_TEMPLATE_ADDON" ] && { [ ! -f "$AUDIO_USER_ADDON" ] || grep -aFq 'libnode.so.64' "$AUDIO_USER_ADDON"; }; then
    cp -f "$AUDIO_TEMPLATE_ADDON" "$AUDIO_USER_ADDON"
fi
# Replace the legacy emulator addon linked against libGLEW.so.2.2.
EMU_USER_ADDON="$APP_DATA_DIR/ModLoader/emulator/ml64_emu_addon.node"
EMU_TEMPLATE_ADDON="/app/lib/modloader64/ModLoader-template/emulator/ml64_emu_addon.node"
if [ -f "$EMU_TEMPLATE_ADDON" ] && { [ ! -f "$EMU_USER_ADDON" ] || grep -aFq 'libGLEW.so.2.2' "$EMU_USER_ADDON"; }; then
    cp -f "$EMU_TEMPLATE_ADDON" "$EMU_USER_ADDON"
fi
for plugin in mupen64plus-audio-sdl.so mupen64plus-input-sdl.so mupen64plus-rsp-hle.so mupen64plus-video-gliden64.so; do
    if [ -f "/app/lib/modloader64/ModLoader-template/emulator/$plugin" ]; then
        cp -f "/app/lib/modloader64/ModLoader-template/emulator/$plugin" "$APP_DATA_DIR/ModLoader/emulator/$plugin"
    fi
done
for plugin in /app/lib/modloader64/emulator/*; do
    if [ -f "$plugin" ] && [ ! -e "$APP_DATA_DIR/ModLoader/emulator/$(basename "$plugin")" ]; then
        ln -sf "$plugin" "$APP_DATA_DIR/ModLoader/emulator/$(basename "$plugin")"
    fi
done

# Electron 8 does not support native Wayland; ensure DISPLAY is set for Xwayland/X11
if [ -z "$DISPLAY" ] && [ -n "$XDG_RUNTIME_DIR" ] && [ -S "/tmp/.X11-unix/X0" -o -d "/tmp/.X11-unix" ]; then
    export DISPLAY="${DISPLAY:-:0}"
fi

cd "$APP_DATA_DIR"

# Launch Electron application via zypak-wrapper for sandbox compatibility
exec zypak-wrapper /app/lib/modloader64/gui/node_modules/electron/dist/electron /app/lib/modloader64/gui/app "$@"
