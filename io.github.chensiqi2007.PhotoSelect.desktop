[Desktop Entry]
Name=PhotoSelect Desktop
Comment=Zero-Import, Millisecond-level RAW+JPG Culling Platform
Exec=photoselect-desktop %U
Icon=io.github.chensiqi2007.PhotoSelect
Terminal=false
Type=Application
Categories=Graphics;Photography;Viewer;
StartupNotify=true
MimeType=image/jpeg;image/png;image/webp;image/x-canon-cr2;image/x-canon-cr3;image/x-sony-arw;image/x-nikon-nef;image/x-fuji-raf;image/x-panasonic-rw2;image/x-olympus-orf;image/x-adobe-dng;
