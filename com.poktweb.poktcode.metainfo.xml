<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.poktweb.poktcode</id>
  <name>PoktCode</name>
  <summary>AI-powered, extensible desktop IDE</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.poktweb">
    <name>PoktWeb</name>
  </developer>
  <description>
    <p>
      PoktCode is a desktop IDE based on Eclipse Theia, with its own branding,
      dedicated theme, and Pokt Agent integrated through Theia AI.
    </p>
    <p>
      It supports local models (Ollama) and OpenAI-compatible APIs, with privacy
      defaults and telemetry disabled out of the box.
    </p>
    <p>
      The Providers screen lets you connect free and paid AI backends, manage API
      keys and OAuth logins, and choose models for chat, image, and video workflows.
    </p>
  </description>
  <launchable type="desktop-id">com.poktweb.poktcode.desktop</launchable>
  <url type="homepage">https://github.com/poktweb/poktcode-releases</url>
  <url type="bugtracker">https://github.com/poktweb/poktcode-releases/issues</url>
  <url type="vcs-browser">https://github.com/poktweb/poktcode-releases</url>
  <categories>
    <category>Development</category>
    <category>IDE</category>
  </categories>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/poktweb/poktcode-releases/main/screenshots/welcome.png</image>
      <caption>Welcome screen with Pokt Agent shortcuts</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/poktweb/poktcode-releases/main/screenshots/providers.png</image>
      <caption>AI Providers catalog and connection status</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/poktweb/poktcode-releases/main/screenshots/pokt-agent.png</image>
      <caption>Pokt Agent chat alongside the editor</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.1.0" date="2026-11-07">
      <description>
        <p>First public Flatpak release with Pokt Agent, Providers catalog, and privacy defaults.</p>
      </description>
    </release>
  </releases>
</component>
