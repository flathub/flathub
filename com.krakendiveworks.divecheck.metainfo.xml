<!-- AppStream metadata for the Linux stores (Flathub reads it directly; the
     Snap Store takes its listing from snapcraft.yaml). Screenshots are served
     from the public releases repository. -->
<component type="desktop-application">
  <id>com.krakendiveworks.divecheck</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://krakendiveworks.com/divecheck-terms-of-use/</project_license>

  <name>DiveCheck by Kraken DiveWorks</name>
  <summary>Scuba logbook, gear service tracking, checklists and gas blending</summary>

  <developer id="com.krakendiveworks">
    <name>Kraken DiveWorks, LLC</name>
  </developer>

  <description>
    <p>
      DiveCheck keeps a diver's records in one place: the dive log, the gear and
      its service history, pre-dive checklists, certifications and the gas
      blending math.
    </p>
    <ul>
      <li>Log dives by hand or import them from UDDF, Subsurface, Garmin .fit and CSV files</li>
      <li>Equipment locker with service schedules, including rebreather and oxygen sensor tracking</li>
      <li>Checklists for open circuit and rebreather diving, with timers</li>
      <li>Nitrox and trimix blending, MOD, best mix and weighting calculators</li>
      <li>Certifications wallet, Emergency Action Plans and a Diver Medical ID</li>
      <li>Reports and statistics across your logbook</li>
      <li>Backup to your own Google Drive or OneDrive</li>
    </ul>
    <p>
      DiveCheck needs a subscription, bought in the DiveCheck app on an iPhone,
      iPad, Mac or Android phone. On Linux you sign in with the same Google,
      Apple or Microsoft account to unlock it; nothing is sold on Linux.
    </p>
    <p>
      DiveCheck is a reference tool. Always verify against your dive computer
      and your training.
    </p>
  </description>

  <launchable type="desktop-id">com.krakendiveworks.divecheck.desktop</launchable>

  <url type="homepage">https://krakendiveworks.com/divecheck-app/</url>
  <url type="help">https://krakendiveworks.com/divecheck-support/</url>
  <url type="contact">https://krakendiveworks.com/divecheck-support/</url>

