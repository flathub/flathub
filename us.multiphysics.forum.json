{
  "app-id": "us.multiphysics.forum",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "forum",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=network"
  ],
  "modules": [
    {
      "name": "forum-deb-unpacker",
      "buildsystem": "simple",
      "build-commands": [
        "ar x forum.deb",
        "tar xf data.tar.xz || tar xf data.tar.zst",
        "mkdir -p /app/bin /app/share/applications /app/share/doc/forum-multiphysics",
        "cp usr/bin/forum /app/bin/forum",
        "chmod +x /app/bin/forum",
        "if [ -d usr/share/doc/forum-multiphysics ]; then cp -r usr/share/doc/forum-multiphysics/* /app/share/doc/forum-multiphysics/ || true; fi",
        "echo '[Desktop Entry]' > /app/share/applications/us.multiphysics.forum.desktop",
        "echo 'Type=Application' >> /app/share/applications/us.multiphysics.forum.desktop",
        "echo 'Name=FORUM Multiphysics' >> /app/share/applications/us.multiphysics.forum.desktop",
        "echo 'Exec=forum' >> /app/share/applications/us.multiphysics.forum.desktop",
        "echo 'Categories=Science;Education;' >> /app/share/applications/us.multiphysics.forum.desktop"
      ],
      "sources": [
        {
          "type": "extra-data",
          "filename": "forum.deb",
          "url": "https://multiphysics.us",
          "sha256": "f23eb006915d4d119234787498735aa5b24ed46cc27b197030920811c9288d40",
          "size": 11954164
        }
      ]
    }
  ]
}
