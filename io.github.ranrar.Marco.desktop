[Desktop Entry]
Version=1.0
Type=Application
Name=Marco
GenericName=Markdown Editor
Comment=Marco is a fast and lightweight markdown editor
Exec=markdowncomposer %F
Icon=io.github.ranrar.Marco
Terminal=false
# Lets Polo hand a document to Marco over org.freedesktop.Application.Open,
# starting Marco if it is not already running. GApplication exports that
# interface for free, but the bus can only activate a name it has a service
# file for -- Flatpak does NOT synthesise one from this key, so the manifest
# installs io.github.ranrar.Marco.service alongside this file. Both are needed.
DBusActivatable=true
StartupNotify=true
StartupWMClass=io.github.ranrar.Marco
Categories=Office;TextEditor;GTK;
Keywords=markdown;editor;text;writing;
MimeType=text/markdown;text/x-markdown;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=markdowncomposer
