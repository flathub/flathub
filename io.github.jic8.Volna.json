{
  "id": "io.github.jic8.Volna",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "volna",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio",
    "--filesystem=xdg-music:ro",
    "--own-name=org.mpris.MediaPlayer2.Volna"
  ],
  "modules": [
    {
      "name": "volna",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/volna/cargo",
          "CARGO_NET_OFFLINE": "true",
          "VOLNA_LOCALEDIR": "/app/share/locale"
        }
      },
      "build-commands": [
        "cargo --offline build --release --locked",
        "install -Dm755 target/release/volna -t /app/bin/",
        "for lang in $(cat po/LINGUAS); do install -d /app/share/locale/$lang/LC_MESSAGES && msgfmt po/$lang.po -o /app/share/locale/$lang/LC_MESSAGES/volna.mo; done",
        "install -Dm644 data/io.github.jic8.Volna.desktop -t /app/share/applications/",
        "install -Dm644 data/io.github.jic8.Volna.metainfo.xml -t /app/share/metainfo/",
        "install -Dm644 data/icons/hicolor/scalable/apps/io.github.jic8.Volna.svg -t /app/share/icons/hicolor/scalable/apps/",
        "install -Dm644 data/icons/hicolor/symbolic/apps/io.github.jic8.Volna-symbolic.svg -t /app/share/icons/hicolor/symbolic/apps/",
        "install -Dm644 LICENSE -t /app/share/licenses/io.github.jic8.Volna/"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/jic8/volna.git",
          "tag": "v0.1.0",
          "commit": "befa22c95342e45cafe6e6f3142c1c58790afb01"
        },
        "cargo-sources.json"
      ]
    }
  ]
}