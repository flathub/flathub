[Desktop Entry]
Version=1.0
Type=Application
Name=NoNetChat
GenericName=Peer-to-peer messenger
GenericName[fr]=Messagerie pair à pair
Comment=Chat with nearby devices over Bluetooth and local networks
Comment[fr]=Communiquez à proximité par Bluetooth et sur le réseau local
Exec=nonetchat
TryExec=nonetchat
Icon=com.nonetchat.NoNetChat
Terminal=false
StartupNotify=true
# Classe X11 du binaire Linux 0.3.0 d'origine, distincte de l'identifiant Flatpak.
StartupWMClass=com.nonetchat.app
DBusActivatable=false
Categories=Network;InstantMessaging;
Keywords=chat;messenger;offline;Bluetooth;WebRTC;LAN;
Keywords[fr]=discussion;messagerie;hors ligne;Bluetooth;WebRTC;réseau local;
