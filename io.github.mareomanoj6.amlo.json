{
  "app-id": "io.github.mareomanoj6.amlo",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "command": "amlo",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=com.canonical.AppMenu.Registrar",
    "--own-name=org.mpris.MediaPlayer2.io.github.mareomanoj6.amlo"
  ],
  "modules": [
    "python3-yt-dlp.json",
    "libayatana-appindicator-gtk3.json",
    {
      "name": "amlo",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 amlo.py /app/bin/amlo",
        "cp -r data audio ui tray assets /app/bin/",
        "cp -r sounds /app/bin/sounds",
        "install -Dm644 io.github.mareomanoj6.amlo.desktop /app/share/applications/io.github.mareomanoj6.amlo.desktop",
        "install -Dm644 assets/amlo.png /app/share/icons/hicolor/256x256/apps/io.github.mareomanoj6.amlo.png",
        "install -Dm644 assets/amlo_tray_v2.png /app/share/icons/hicolor/64x64/apps/io.github.mareomanoj6.amlo.png",
        "install -Dm644 assets/amlo_24.png /app/share/icons/hicolor/24x24/apps/io.github.mareomanoj6.amlo.png",
        "install -Dm644 io.github.mareomanoj6.amlo.metainfo.xml /app/share/metainfo/io.github.mareomanoj6.amlo.metainfo.xml"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/mareomanoj6/amlo.git",
          "tag": "v1.0.0",
          "commit": "a547392713f7efd6c39b2678e982c8237a6c2866"
        }
      ]
    }
  ]
}
