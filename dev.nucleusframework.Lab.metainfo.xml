<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.nucleusframework.Lab</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Nucleus Lab</name>
  <summary>Explore the Nucleus desktop APIs</summary>
  <developer id="dev.nucleusframework">
    <name>Nucleus</name>
  </developer>

  <description>
    <p>Nucleus Lab is the companion app of Nucleus, a toolkit for shipping native JVM desktop applications. Each page of the Lab drives one platform integration live, so you can see how it behaves on your own desktop before using it in an app.</p>
    <p>Among the integrations it covers:</p>
    <ul>
      <li>Desktop notifications, launcher badges and progress</li>
      <li>Dark mode, accent color and high contrast detection</li>
      <li>Global shortcuts, media controls and the share sheet</li>
      <li>Location, spell checking and speech recognition</li>
      <li>Window decorations, tabs and docked panels</li>
      <li>In-app updates delivered by Flathub</li>
    </ul>
  </description>

