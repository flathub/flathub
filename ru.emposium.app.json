{
  "app-id": "ru.emposium.app",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "emposium",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets"
  ],
  "modules": [
    {
      "name": "emposium",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 bin/emposium /app/bin/emposium",
        "install -Dm644 ru.emposium.app.desktop /app/share/applications/ru.emposium.app.desktop",
        "install -Dm644 emposium.png /app/share/icons/hicolor/256x256/apps/ru.emposium.app.png",
        "install -Dm644 ru.emposium.app.metainfo.xml /app/share/metainfo/ru.emposium.app.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/emposium/LICENSE",
        "install -Dm644 THIRD-PARTY-NOTICES.txt /app/share/licenses/emposium/THIRD-PARTY-NOTICES.txt"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://api.emposium.ru/v1/releases/0.6.2/downloads/linux-tar",
          "sha256": "941d4ac426cb09d9b5dbe35ef8b734bae45241a99efcfdb3a92cdec5a7762b58"
        }
      ]
    }
  ]
}
