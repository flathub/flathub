[Desktop Entry]
Type=Application
Name=Shoebill Text Editor
GenericName=Text and Code Editor
Comment=Fast, lightweight text and code editor with syntax highlighting for more than 300 languages
Exec=shoebill %F
Icon=app.shoebill_editor.Shoebill
Terminal=false
Categories=Utility;TextEditor;Development;Office;
MimeType=text/plain;text/markdown;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/html;text/css;text/csv;text/xml;application/json;application/xml;application/x-shellscript;
Keywords=editor;text;code;notepad;
StartupNotify=true
