{
    "app-id": "io.github.masatn2026.ImageViewer",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "imageviewer",
    "finish-args": [
        "--share=ipc",
        "--device=dri",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--filesystem=xdg-pictures",
        "--filesystem=xdg-download"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "inih",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DINI_BUILD_TESTS=OFF",
                "-DINI_BUILD_EXAMPLES=OFF",
                "-DINI_INSTALL=ON"
            ],
            "post-install": [
                "mkdir -p /app/lib/cmake/inih",
                "cp -r /app/include/* /app/include/ || true"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/benhoyt/inih/archive/refs/tag/r58.tar.gz",
                    "sha256": ""
                }
            ],
            "name": "exiv2",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "env": {
                    "CMAKE_PREFIX_PATH": "/app"
                }
            },
            "config-opts": [
                "-DEXIV2_BUILD_SAMPLES=OFF",
                "-DEXIV2_BUILD_UNIT_TESTS=OFF",
                "-DEXIV2_BUILD_EXIV2_COMMAND=OFF",
                "-DEXIV2_ENABLE_INIH=OFF",
                "-DEXIV2_ENABLE_BROTLI=OFF",
                "-DCMAKE_PREFIX_PATH=/app"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/Exiv2/exiv2/archive/refs/tags/v0.28.3.tar.gz",
                    "sha256": "1315e17d454bf4da3cc0edb857b1d2c143670f3485b537d0f946d9ed31d87b70"
                }
            ]
        },
        {
            "name": "gexiv2",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gexiv2/0.16/gexiv2-0.16.0.tar.xz",
                    "sha256": "d96f895f24539f966f577b2bb2489ae84f8232970a8d0c064e4a007474a77bbb"
                }
            ]
        },
        {
            "name": "imageviewer",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/masatn2026/imageviewer.git",
                    "tag": "0.2.3",
                    "commit": "c014f335ab26bbdc1fc2a527d71f6d4ca89e9964"
                }
            ]
        }
    ]
}
