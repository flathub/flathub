#!/bin/sh
# myna-testbed-wrapper (Flatpak): myna-testbed CLI launcher.
# Adapted from myna-snap/scripts/myna-testbed-wrapper.
set -eu
BACKEND_DIR="${XDG_RUNTIME_DIR}/myna"
for arg in "$@"; do
    case "$arg" in
        --socket | --backend-dir) exec /app/bin/myna-testbed "$@" ;;
    esac
done
exec /app/bin/myna-testbed --backend-dir "$BACKEND_DIR" "$@"
