#!/usr/bin/env python3
"""Download and extract NVIDIA cuBLAS CUDA 12 runtime libraries into user data directory."""

import os
import sys
import tempfile
import urllib.request
import zipfile
from pathlib import Path

# PyPI wheel for nvidia-cublas-cu12 (CUDA 12.9)
CUBLAS_WHEEL_URL = (
    "https://files.pythonhosted.org/packages/cb/c0/0a517bfe63ccd3b92eb254d264e28fca3c7cab75d07daea315250fb1bf73/"
    "nvidia_cublas_cu12-12.9.2.10-py3-none-manylinux_2_27_x86_64.whl"
)


def main():
    base_dir = os.environ.get("XDG_DATA_HOME")
    if not base_dir:
        base_dir = Path.home() / ".local" / "share"
    else:
        base_dir = Path(base_dir)

    target_dir = base_dir / "myna" / "cuda" / "lib"
    target_dir.mkdir(parents=True, exist_ok=True)

    cublas_so = target_dir / "libcublas.so.12"
    if cublas_so.exists() and cublas_so.stat().st_size > 0:
        print(f"CUDA libraries already present in {target_dir}")
        return 0

    print(f"Downloading CUDA cuBLAS runtime libraries to {target_dir}...")
    with tempfile.NamedTemporaryFile(suffix=".whl", delete=False) as tmp:
        tmp_path = tmp.name

    try:
        urllib.request.urlretrieve(CUBLAS_WHEEL_URL, tmp_path)
        print("Extracting cuBLAS shared libraries...")
        with zipfile.ZipFile(tmp_path, "r") as z:
            for member in z.namelist():
                if ("lib/" in member) and (member.endswith(".so") or ".so." in member):
                    filename = os.path.basename(member)
                    if filename:
                        target_file = target_dir / filename
                        with z.open(member) as src, open(target_file, "wb") as dst:
                            dst.write(src.read())
                        print(f"Extracted {filename}")
        print("CUDA libraries setup complete.")
        return 0
    except Exception as e:
        print(f"Error downloading CUDA libraries: {e}", file=sys.stderr)
        return 1
    finally:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)


if __name__ == "__main__":
    sys.exit(main())
