<!-- AppStream metainfo for the Flatpak (and usable by the .deb, installed to
     /usr/share/metainfo). Validate with:
       appstreamcli validate app.audionaut.Audionaut.metainfo.xml
     Flathub additionally lints via flatpak-builder-lint. -->
<component type="desktop-application">
  <id>app.audionaut.Audionaut</id>

  <name>Audionaut</name>
  <summary>Edit and record multitrack audio</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="app.audionaut">
    <name>Klaus Voltmer</name>
  </developer>

  <description>
    <p>
      Audionaut is a free, open-source desktop application for effortless
      audio editing and recording. Whether you are working on music, podcasts,
      or multitrack recordings, it gives you precise cutting, per-track
      playlists, flexible multi-channel support, and clean exports — without
      the weight and complexity of a full DAW.
    </p>
    <ul>
      <li>Multitrack, multichannel, region-based and non-destructive editing</li>
      <li>Clip gain, bendable fades and crossfades, clip speed with pitch-preserving time-stretch</li>
      <li>Audio analysis and Auto Edit: segment boundaries, onsets and beat tracking, with automatic musically aligned cuts</li>
      <li>Stem separation into drums, bass, other and vocals — running locally, nothing is uploaded</li>
      <li>Recording with takes, loop playback, snap to grid, tempo sync via Ableton Link</li>
      <li>Export to WAV, FLAC, Ogg Vorbis and MP3</li>
      <li>Undo for everything, including recording takes and agent edits</li>
      <li>AI agents such as Claude can edit sessions over MCP</li>
    </ul>
    <p>
      Stem separation downloads the Demucs model weights (about 80 MB) on
      first use; all processing then happens on your machine.
    </p>
  </description>

  <launchable type="desktop-id">app.audionaut.Audionaut.desktop</launchable>

  <provides>
    <binary>audionaut</binary>
    <mediatype>application/x-audium-project</mediatype>
  </provides>

  <url type="homepage">https://audionaut.app/</url>
