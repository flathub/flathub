<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>school.easybeat.App</id>
  <name>EasyBeat.School</name>
  <summary>Tabs player, metronome, tuner and lesson notes</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <developer id="school.easybeat">
    <name>EasyBeat.School</name>
  </developer>
  <url type="homepage">https://easybeat.school</url>
  <url type="vcs-browser">https://github.com/Nefessom/EasyBeat.School_Releases</url>
  <description>
    <p>EasyBeat.School is a practice app for music students: open Guitar Pro tabs and scores, play them along, and keep your lesson materials in one place.</p>
    <ul>
      <li>Tabs Player for Guitar Pro (.gp, .gp3–.gp5, .gpx), MusicXML and Capella files: notation and tablature, track switching, mixer, loops and tempo control</li>
      <li>Metronome with time signature, subdivisions and several click sounds</li>
      <li>Tuner for guitar and other string instruments, and a drum tuner by overall pitch or by lug</li>
      <li>Notes: lesson folders with PDF books and audio playbacks, with optional Google Drive sync</li>
      <li>Music theory lessons</li>
    </ul>
  </description>
  <launchable type="desktop-id">school.easybeat.App.desktop</launchable>
