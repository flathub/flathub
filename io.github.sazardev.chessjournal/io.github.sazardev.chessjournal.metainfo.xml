<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.sazardev.chessjournal</id>

  <name>Chess Journal</name>
  <summary>Your gamebook for chess</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>Chess Journal is your gamebook to record, analyze and review your chess games.
    Play and analyze games with Stockfish, solve tactics puzzles, explore opening theory,
    and keep a searchable library of your games.</p>

    <p>Features:</p>
    <ul>
      <li>Play chess with Stockfish engine analysis</li>
      <li>Solve tactics puzzles with difficulty progression</li>
      <li>Browse opening theory with ECO-coded database</li>
      <li>Full game report with accuracy, ACPL and blunder detection</li>
      <li>Board editor for setting up positions</li>
      <li>Searchable game library with smart filters</li>
      <li>Import games from Chess.com</li>
      <li>Export games as PGN</li>
      <li>Dark mode and customizable theme colors</li>
    </ul>
  </description>

