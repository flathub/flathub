[Desktop Entry]
Type=Application
Name=aria.fm
Comment=Native Spotify desktop client
Exec=aria
Icon=fm.aria.Client
Categories=AudioVideo;Audio;Player;
Keywords=Spotify;Music;Player;Streaming;
Terminal=false
# Without this, the running window does not match this desktop entry and shells
# show a generic icon plus a duplicate taskbar entry instead of pinning to the
# launcher. The value is "aria-fm" with a HYPHEN — not the "aria.fm" product
# name — measured from the running app via
# `xprop -id <win> WM_CLASS` under XWayland, which reports
# WM_CLASS(STRING) = "aria-fm", "aria-fm".
StartupWMClass=aria-fm
