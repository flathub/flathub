{
    "app-id": "com.github.ridikhost.orkaplayerlinux",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "orka-player-linux",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--share=network",
        "--filesystem=host",
        "--socket=pulseaudio"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "modules": [
        {
            "name": "orka-player-linux",
            "buildsystem": "simple",
            "build-options": {
                "allow-internet": true
            },
            "build-commands": [
                "cargo build --release",
                "install -Dm755 target/release/orka-player-linux /app/bin/orka-player-linux",
                "install -Dm644 com.github.ridikhost.orkaplayerlinux.desktop /app/share/applications/com.github.ridikhost.orkaplayerlinux.desktop",
                "install -Dm644 com.github.ridikhost.orkaplayerlinux.appdata.xml /app/share/metainfo/com.github.ridikhost.orkaplayerlinux.appdata.xml",
                "install -Dm644 com.github.ridikhost.orkaplayerlinux.png /app/share/icons/hicolor/128x128/apps/com.github.ridikhost.orkaplayerlinux.png"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/ridikhost/orka-player-linux.git",
                    "tag": "v2.3.0"
                }
            ]
        }
    ]
}
