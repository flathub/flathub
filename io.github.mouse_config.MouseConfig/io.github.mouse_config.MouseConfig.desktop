#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Mouse Config
GenericName=Gaming Mouse Configuration
Comment=Configure gaming mice on Linux — DPI, RGB, polling rate, macros
Exec=mouse-config
Icon=io.github.mouse_config.MouseConfig
Terminal=false
Categories=Utility;HardwareSettings;
Keywords=mouse;gaming;DPI;RGB;configuration;
