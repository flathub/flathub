<!--
  AppStream MetaInfo — required by Flathub's own build/review bot
  (flatpak-builder-lint); there was no file here at all before this one,
  which would have failed CI on a real submission. <project_license> uses
  LicenseRef-proprietary (SPDX's catch-all for "no SPDX license, closed
  source"), matching the same convention packaging/aur/PKGBUILD already
  uses for this app (LicenseRef-Proprietary) — ServiTacto is closed-source/
  all-rights-reserved, confirmed via clients/desktop/packaging/chocolatey/
  servitacto.nuspec's own comment on why licenseUrl is omitted there too.

  Screenshots are hosted at github.com/servitacto/flathub-assets (a small
  public repo created for this, since nothing here has write access to the
  dist account's own public releases bucket — see the manifest's own
  comment on the PublicReleasesBucket's scoped IAM policy). URLs below are
  pinned to a specific commit (cbfdcbc2af4e61920a550f957da86858f1f10a09),
  not the mutable `main` branch, so they can never silently change under
  Flathub once reviewed. Same four images already used for the Apple App
  Store Connect macOS submission (macos-screenshots/*.png) — same app,
  same screens.
-->
<component type="desktop-application">
  <id>com.servitacto.portal</id>
  <name>ServiTacto</name>
  <summary>Field service management for HVAC, plumbing, and electrical companies</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <developer id="com.servitacto">
    <name>ServiTacto</name>
  </developer>
  <url type="homepage">https://servitacto.com</url>
  <url type="help">https://docs.servitacto.com</url>
  <url type="vcs-browser">https://github.com/servitacto</url>
  <launchable type="desktop-id">com.servitacto.portal.desktop</launchable>
  <description>
    <p>
      ServiTacto is field service management software for service businesses —
      HVAC, plumbing, electrical, and other trades that dispatch technicians to
      job sites. This is the desktop client, a thin wrapper around the hosted
      ServiTacto web app.
    </p>
    <p>With the ServiTacto desktop app, your office team can:</p>
    <ul>
      <li>Create and manage service orders</li>
      <li>Track technician time clock entries with GPS verification</li>
      <li>Track inventory and parts used on each job</li>
      <li>Generate and send invoices to customers</li>
      <li>View schedules and job details across your whole team</li>
    </ul>
    <p>
      An active ServiTacto account is required to use this app — it is a
      client for an existing account's subscription, not a standalone tool.
    </p>
  </description>
