<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata for the Hoard Flatpak. Values below are pulled from
  crates/hoard-desktop/tauri.conf.json (shortDescription, longDescription,
  homepage, category) and Cargo.toml (license) rather than invented — keep
  the two in sync when either changes.

  No <screenshots> block: Flathub requires one for submission review, but a
  local flatpak-builder build doesn't. Add real, hosted screenshot URLs here
  before submitting.
-->
<component type="desktop-application">
  <id>services.hoard.saves</id>
  <launchable type="desktop-id">services.hoard.saves.desktop</launchable>
  <name>Hoard</name>
  <summary>Self-hosted cloud sync for game saves</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>

  <developer id="dev.hoard">
    <name>Hoard</name>
  </developer>

  <url type="homepage">https://github.com/rleeon/hoard</url>
  <url type="bugtracker">https://github.com/rleeon/hoard/issues</url>

  <description>
    <p>
      Hoard syncs your game saves to your own server. Auto-detect games,
      auto-backup when you stop playing, restore previous versions any time.
    </p>
  </description>

  <categories>
    <category>Utility</category>
  </categories>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <content_rating type="oars-1.1" />

  <!--
    The published counter, which is the one in CHANGELOG.md and on the release
    tags — not the workspace version in Cargo.toml, which is a different number
    for a different purpose. Add the new one here when you tag.
  -->
  <releases>
    <release version="1.1.5" date="2026-08-24" />
  </releases>

  <!--
    No <screenshots> yet, and they can't be filled in from what we already
    host: the shots on hoard.services are in Spanish and carry an account name
    and real home paths, which is fine on our own site and wrong on a store
    page in front of everyone. Flathub needs at least one, in English, hosted
    somewhere stable, as PNG or JPEG — the pipeline that builds the thumbnails
    is not guaranteed to read WebP. A local flatpak-builder build doesn't care,
    so this only blocks submission.
  -->
</component>
