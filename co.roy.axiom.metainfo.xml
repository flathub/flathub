<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>co.roy.axiom</id>

  <name>Axiom</name>
  <summary>A precision calculator with persistent history</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="com.chanunkha">
    <name>Roy Chanunkha</name>
  </developer>

  <description>
    <p>
      Axiom is a precision desktop calculator that keeps every result you compute,
      so you never have to retype an expression you already evaluated. Tap any
      history entry to recall it; search, filter, or annotate entries with notes.
    </p>
    <p>Four modes share one window:</p>
    <ul>
      <li>Basic — everyday arithmetic with full BODMAS precedence.</li>
      <li>Scientific — trig, logs, powers, factorials, with toggleable degrees and radians.</li>
      <li>Programmer — integer math with bitwise operators across decimal, hex, octal and binary.</li>
      <li>Conversion — length, mass, temperature, area, volume, speed, time, and data, with live two-way conversion.</li>
    </ul>
    <p>
      Light and dark themes. Keyboard-friendly. History stays on your machine — no
      cloud, no telemetry, no accounts.
    </p>
  </description>

  <launchable type="desktop-id">co.roy.axiom.desktop</launchable>

  <url type="homepage">https://github.com/Skipper-116/axiom</url>
  <url type="bugtracker">https://github.com/Skipper-116/axiom/issues</url>
  <url type="vcs-browser">https://github.com/Skipper-116/axiom</url>
  <url type="contact">https://chanunkha.com</url>
  <!--
    AppStream has no dedicated <url type="privacy"> tag. The privacy
    policy is surfaced in three places: PRIVACY.md at the repo root,
    a "Privacy" link in the in-app About tab, and the description's
    "no cloud, no telemetry, no accounts" line above.
  -->

