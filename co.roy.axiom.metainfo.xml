  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.0.0" date="2026-05-07">
      <description>
        <p>First public release.</p>
        <ul>
          <li>Four calculator modes: Basic, Scientific, Programmer, Conversion.</li>
          <li>Persistent history with search, mode filters, recall, and notes.</li>
          <li>Light and dark themes with system-follow option.</li>
          <li>First-run welcome and an interactive tour.</li>
        </ul>
      </description>
