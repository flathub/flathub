<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.lupyd.client</id>
  <name>Lupyd</name>
  <summary>Lupyd Desktop Client</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer_name>Lupyd Foundation</developer_name>
  <description>
    <p>
      Lupyd is a modern, privacy-first desktop application offering end-to-end encrypted messaging,
      voice and video channels, community groups, and seamless cross-platform communication.
    </p>
    <p>Features include:</p>
    <ul>
      <li>End-to-End Encrypted 1-on-1 and group chats</li>
      <li>High-definition voice and video calls</li>
      <li>Custom workspaces and channels</li>
      <li>Hardware-accelerated modern interface</li>
    </ul>
  </description>
  <url type="homepage">https://lupyd.com</url>
  <url type="bugtracker">https://github.com/lupyd/lupyd/issues</url>
  <url type="help">https://docs.lupyd.com</url>
  <launchable type="desktop-id">com.lupyd.client.desktop</launchable>
  <provides>
    <binary>com.lupyd.client</binary>
  </provides>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.0.43" date="2026-08-30">
      <description>
        <p>Release 0.0.43 with enhanced group synchronization, open-source licenses page, and performance improvements.</p>
      </description>
    </release>
  </releases>
</component>
