        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/drawcoders/dns-resolver/1.0.3-stable/caps/cap-theme-purple.png</image>
            <caption>Purple color theme</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/drawcoders/dns-resolver/1.0.3-stable/caps/dns-servers.png</image>
            <caption>DNS server management</caption>
        </screenshot>
    </screenshots>
</component>