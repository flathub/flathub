<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>com.drawcoders.DnsResolver</id>
    <name>DNS Resolver</name>
    <summary>DNS lookup and analysis tool</summary>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>LicenseRef-proprietary=https://github.com/drawcoders/dns-resolver/blob/1.0.3-stable/LICENSE</project_license>

    <developer id="com.drawcoders">
        <name>Drawcoders</name>
    </developer>

    <description>
        <p>
            DNS Resolver is a graphical application for querying
            and analyzing DNS records.
        </p>
        <ul>
            <li>Custom DNS servers</li>
            <li>UDP, TCP and DNS over HTTPS</li>
            <li>Network interface selection</li>
            <li>Multiple DNS record types</li>
            <li>Export results in JSON and Markdown</li>
        </ul>
    </description>

    <launchable type="desktop-id">com.drawcoders.DnsResolver.desktop</launchable>

    <url type="homepage">https://github.com/drawcoders/dns-resolver</url>
    <url type="bugtracker">https://github.com/drawcoders/dns-resolver/issues</url>

    <provides>
        <binary>dns_resolver</binary>
    </provides>

    <content_rating type="oars-1.1"/>

    <releases>
        <release version="1.0.3-stable" date="2026-11-26"/>
        <release version="1.0.1-stable" date="2026-11-26"/>
    </releases>

    <screenshots>
        <screenshot type="default">
