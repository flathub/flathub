<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>com.nagarenegishi.jobtracker</id>
    <launchable type="desktop-id">com.nagarenegishi.jobtracker.desktop</launchable>
    <name>Job Application Tracker</name>
    <developer id="com.nagarenegishi">
        <name>Nagare Negishi</name>
    </developer>
    <content_rating type="oars-1.1" />

    <summary>Track job applications locally, with no account or cloud sync</summary>
    <metadata_license>MIT</metadata_license>
    <project_license>LicenseRef-proprietary=https://github.com/NagareNegishi/job-tracker-desktop-releases/blob/main/LICENSE.md</project_license>
    <url type="homepage">https://github.com/NagareNegishi/job-tracker-desktop-releases</url>

    <supports>
        <control>pointing</control>
        <control>keyboard</control>
    </supports>

    <description>
        <p>
            A local-only desktop app for tracking job applications: statuses, contacts,
            documents, and an optional AI-assisted job listing parser and application
            analysis. All data stays on this device — no account, no hosted backend.
        </p>
    </description>

    <screenshots>
        <screenshot type="default">
            <image>https://raw.githubusercontent.com/NagareNegishi/job-tracker-desktop-releases/62079f4/screenshots/table.png</image>
            <caption>Table view of tracked job applications</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/NagareNegishi/job-tracker-desktop-releases/62079f4/screenshots/kanban.png</image>
            <caption>Kanban board view of applications by status</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/NagareNegishi/job-tracker-desktop-releases/62079f4/screenshots/analysis.png</image>
            <caption>AI-assisted analysis of a job listing against your profile</caption>
        </screenshot>
    </screenshots>

    <releases>
        <release version="0.1.0" date="2026-08-19" />
    </releases>

    <update_contact>negishinaga@gmail.com</update_contact>
</component>
