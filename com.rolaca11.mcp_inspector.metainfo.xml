<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.rolaca11.mcp_inspector</id>

  <name>MCP Inspector</name>
  <summary>A user-experience focused Model Context Protocol client</summary>

  <developer id="com.rolaca11">
    <name>rolaca11</name>
  </developer>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <url type="homepage">https://github.com/rolaca11/mcp-inspector</url>
  <url type="bugtracker">https://github.com/rolaca11/mcp-inspector/issues</url>
  <url type="vcs-browser">https://github.com/rolaca11/mcp-inspector</url>

  <description>
    <p>
      MCP Inspector is a desktop application for interacting with Model Context Protocol (MCP) servers.
      It provides a clean, intuitive interface for connecting to MCP servers, browsing their capabilities,
      and testing tools, resources, and prompts.
    </p>
    <p>Features:</p>
    <ul>
      <li>Connect to MCP servers via stdio or SSE transports</li>
      <li>Browse and test server tools, resources, and prompts</li>
      <li>View server capabilities and protocol details</li>
      <li>Token usage tracking with tiktoken</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.rolaca11.mcp_inspector.desktop</launchable>

  <branding>
    <color type="primary" scheme_preference="light">#ffffff</color>
    <color type="primary" scheme_preference="dark">#262e36</color>
  </branding>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.0.7" date="2026-05-23">
      <description>
        <p>Initial Flathub release.</p>
      </description>
    </release>
  </releases>

  <screenshots>
    <screenshot type="default">
      <caption>MCP Inspector main interface</caption>
      <image>https://raw.githubusercontent.com/rolaca11/mcp-inspector/main/packages/web/public/favicon.svg</image>
    </screenshot>
  </screenshots>

  <categories>
    <category>Development</category>
  </categories>

  <keywords>
    <keyword>MCP</keyword>
    <keyword>Model Context Protocol</keyword>
    <keyword>AI</keyword>
    <keyword>LLM</keyword>
    <keyword>developer tools</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
</component>
