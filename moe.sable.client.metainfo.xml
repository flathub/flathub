<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>moe.sable.client</id>

  <name>Sable</name>
  <summary>Chat over the Matrix network</summary>

  <developer id="moe.sable">
    <name>Sable Maintainers</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>

  <url type="homepage">https://sable.moe</url>
  <url type="bugtracker">https://github.com/SableClient/Sable/issues</url>
  <url type="vcs-browser">https://github.com/SableClient/Sable</url>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
  </content_rating>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <description>
    <p>
      Sable is a Matrix client for desktop, with end-to-end encrypted
      messaging, spaces, threads, and voice and video calls.
    </p>
    <p>Features:</p>
    <ul>
      <li>End-to-end encryption with cross-signing and key backup</li>
      <li>Spaces, threads, and replies</li>
      <li>Voice and video calls</li>
      <li>Custom themes</li>
    </ul>
  </description>

  <launchable type="desktop-id">moe.sable.client.desktop</launchable>

    <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/SableClient/Sable/dev/docs/screenshots/timeline.png</image>
      <caption>A room timeline</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.21.0" date="2026-08-17">
      <url type="details">https://github.com/SableClient/Sable/releases/tag/v1.21.0</url>
    </release>
  </releases>
</component>
