<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>com.tibia.client</id>
    <url>https://www.tibia.com</url>

    <name>Tibia</name>
    <summary>Tibia MMRPG client (Unofficial flatpak)</summary>

    <description>
        <p>
            Tibia is a free multiplayer online role-playing game (MMORPG) that launched in 1997.
            Create your character and explore a vast, exciting world. Gain experience and treasures
            through combat, quests and other adventures. Interact with other players and engage in
            PvP combat, cooperation, and intense battles.
        </p>
        <p>
            <i>This community-provided package is not verified by, affiliated with, or supported by CipSoft GmbH.</i>
        </p>
    </description>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>LicenseRef-proprietary AND Apache-2.0 AND LicenseRef-Qt</project_license>

    <url type="homepage">https://www.tibia.com/</url>
    <url type="bugtracker">https://www.tibia.com/support/</url>

    <screenshots>
        <screenshot type="default">
            <image>https://www.tibia.com/images/tibia-gameplay.png</image>
            <caption>Explore the world of Tibia</caption>
        </screenshot>
    </screenshots>

    <content_rating type="oars-1.1">
        <content_attribute id="violence-fantasy">moderate</content_attribute>
        <content_attribute id="social-chat">intense</content_attribute>
    </content_rating>

    <releases>
        <release version="15.33" date="2026-10-05">
            <description>
                <p>Latest Tibia client</p>
            </description>
        </release>
    </releases>

    <provides>
        <binary>tibia-wrapper</binary>
    </provides>
</component>
