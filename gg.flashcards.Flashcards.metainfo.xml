<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>gg.flashcards.Flashcards</id>
  <name>Flashcards.gg</name>
  <summary>AI flashcards from a topic, a PDF or a photo</summary>
  <developer id="gg.flashcards">
    <name>Flashcards.gg</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <description>
    <p>Make flashcards from a topic, a PDF or a photo, then study them with spaced repetition. Works offline.</p>
    <p>Type a topic and the app writes the cards for you. You can also upload a PDF, Word, PowerPoint or a photo of your notes. Or just type the cards yourself.</p>
    <p>Study modes: Learn (spaced repetition), Test (type the answer or pick from choices), Browse, Random. Cards can be read aloud. Daily goal.</p>
    <p>Import and export Anki (.apkg), CSV, TSV, TXT, JSON. Share sets with a link. Browse a library of sets from other users.</p>
    <p>Everything is stored locally. Sign in with Google to sync across devices. 28 languages. No ads.</p>
  </description>
  <launchable type="desktop-id">gg.flashcards.Flashcards.desktop</launchable>
  <url type="homepage">https://flashcards.gg</url>
  <url type="contact">https://flashcards.gg/policy.html#contact</url>
  <url type="bugtracker">https://github.com/flashcards-gg/linux/issues</url>
  <url type="vcs-browser">https://github.com/flashcards-gg/linux</url>
