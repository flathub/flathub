<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ahmedrapi79123_cyber.PLY-MUSIC-PLAYER</id>

  <name>PLY</name>
  <summary>Simple and lightweight music player</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer_name>Ahmed</developer_name>

  <description>
    <p>
      PLY is a modern, lightweight music player for Linux. It features a beautiful
      graphical interface built with Tkinter and a rich terminal interface for
      power users.
    </p>
    <p>Features include:</p>
    <ul>
      <li>GStreamer-powered audio engine supporting MP3, WAV, OGG, and more</li>
      <li>Beautiful dark and light themes with album artwork display</li>
      <li>MPRIS2 integration for desktop media controls</li>
      <li>Background playback with system tray controls</li>
      <li>M3U/M3U8 playlist import and export</li>
      <li>Persistent settings and play history</li>
      <li>Rich terminal TUI with full playback control</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.ahmedrapi79123_cyber.PLY-MUSIC-PLAYER.desktop</launchable>

  <provides>
    <binary>ply</binary>
  </provides>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
    <category>Music</category>
  </categories>

  <keywords>
    <keyword>music</keyword>
    <keyword>audio</keyword>
    <keyword>player</keyword>
    <keyword>mp3</keyword>
    <keyword>ogg</keyword>
  </keywords>

  <url type="homepage">https://github.com/ahmedrapi79123-cyber/PLY-MUSIC-PLAYER</url>
  <url type="bugtracker">https://github.com/ahmedrapi79123-cyber/PLY-MUSIC-PLAYER/issues</url>


