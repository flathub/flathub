<component type="desktop-application">
    <id>app.paperjungle.paperjungle</id>
    <name>Paperjungle</name>
    <summary>With paperjungle, you manage your documents stress-free for free</summary>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>LicenseRef-proprietary</project_license>
    <description>
        <p>Say goodbye to paper chaos!</p>
        <p>Manage your documents easily with Paperjungle.</p>
        <p>This app is your personal document manager, helping you to effortlessly digitize, organize, and securely store all your important papers in one place.</p>
        <p>Start now for free and bring order to your documents!</p>
        <ul>
            <li>Smart Document Management: Keep your originals</li>
            <li>Organize your documents: Bring order to them with tags and categories</li>
            <li>Smart full-text search: Find everything easily</li>
            <li>Physical and digital archiving: Find the original paper document if you need it</li>
        </ul>
    </description>
    <launchable type="desktop-id">app.paperjungle.paperjungle.desktop</launchable>
    <content_rating type="oars-1.1">
        <content_attribute id="social-info">intense</content_attribute>
    </content_rating>
    <releases>
        <release version="1.6.5" date="2026-10-10" />
    </releases>
    <categories>
        <category>Office</category>
    </categories>
    <branding>
        <color type="primary" scheme_preference="light">#FF264325</color>
        <color type="primary" scheme_preference="dark">#FF264325</color>
    </branding>
    <url type="homepage">https://paperjungle.app</url>
    <supports>
        <control>keyboard</control>
        <control>pointing</control>
        <control>touch</control>
    </supports>
    <requires>
        <display_length compare="ge">360</display_length>
    </requires>
    <developer id="app.paperjungle">
        <name>HappySquare</name>
    </developer>
    <screenshots>
        <screenshot type="default">
            <image>https://gitlab.com/paperjungle/build/-/raw/78841463ea0d4e21319d7ed275b3b0773694b803/screenshots/overview.png?inline=false</image>
            <caption>Paperjungle document overview</caption>
        </screenshot>
    </screenshots>
</component>
