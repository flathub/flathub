diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 8f4cc35cf8..afcf1f8b98 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -1,8 +1,19 @@
 import com.github.gradle.node.npm.task.NpmTask
+import io.github.jwharm.flatpakgradlegenerator.FlatpakGradleGeneratorTask
 import org.apache.tools.ant.taskdefs.condition.Os
 
 plugins {
     alias(libs.plugins.node)
+    alias(libs.plugins.flatpakGradleGenerator)
+}
+
+repositories {
+    // for Flatpak offline no-network-access build
+    maven {
+        url = uri(rootDir.resolve("./offline-repository"))
+    }
+
+    mavenCentral()
 }
 
 dependencies {
@@ -10,9 +21,9 @@
 }
 
 node {
-    version.set("24.14.1")
-    npmVersion.set("11.12.0")
-    download.set(true)
+    version.set("24.15.0")
+    download.set(false)
+
 }
 
 // Hide tasks which aren't used (from node gradle plugin)
@@ -25,7 +36,7 @@
 tasks.register<NpmTask>("installDependencies") {
     group = "build"
     description = "Install npm dependencies"
-    args.set(listOf("install"))
+    args.set(listOf("install", "--cache", "/run/build/chunker/flatpak-node/npm-cache", "--offline", "true"))
 }
 
 tasks.register<NpmTask>("build") {
@@ -69,4 +80,9 @@
     // Ensure dependencies are installed and we have a chunker build
     val cliBuild = project(":cli").tasks.named("build");
     dependsOn("installDependencies", cliBuild)
+}
+
+tasks.named<FlatpakGradleGeneratorTask>("flatpakGradleGenerator") {
+    outputFile = rootProject.layout.buildDirectory.file("flatpak/app-dependencies-sources.json")
+    downloadDirectory = "./offline-repository"
 }
\ No newline at end of file
