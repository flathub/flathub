+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Copyright 2026 Adam Honse, OpenRGB Team -->
+<component type="addon">
+  <id>org.openrgb.OpenRGB.Plugin.VisualMap</id>
+  <extends>org.openrgb.OpenRGB</extends>
+  <metadata_license>CC0-1.0</metadata_license>
+  <project_license>GPL-2.0-or-later</project_license>
+  <developer id="org.openrgb">
+    <name>Adam Honse, OpenRGB Team</name>
+  </developer>
+
+  <name>OpenRGB Visual Map Plugin</name>
+  <icon type="stock">openrgb-visual-map-plugin</icon>
+
+  <content_rating type="oars-1.0" />
+
+  <summary>Visual Map plugin for OpenRGB to combine multiple devices into a virtual grid</summary>
+
+  <description>
+    <p>
+      The OpenRGB Visual Map plugin is an addon for OpenRGB that allos you to
+      create customized layouts for your devices.  Create a single large matrix
+      zone and arrange your physical devices' LEDs in that customizable grid.  Creates
+      a single virtual device that you can use in other OpenRGB plugins or external
+      applications.
+    </p><p>
+      Features
+    </p>
+    <ul>
+      <li>Arrange one or more devices into a single matrix</li>
+      <li>Span custom effects across your entire setup</li>
+      <li>Save and load as many layouts as you want</li>
+    </ul>
+  </description>
+
+  <releases>
+    <release version="1.0rc2" date="2025-09-14"></release>
+    <release version="0.9" date="2023-07-11"></release>
+    <release version="0.8" date="2022-12-03"></release>
+  </releases>
+
+  <screenshots>
+    <screenshot type="default">
+      <image>https://gitlab.com/OpenRGBDevelopers/OpenRGBVisualMapPlugin/-/raw/master/Documentation/Images/Screenshot_DRAM_Matrix.png</image>
+      <caption>OpenRGB Visual Map Plugin - DRAM Matrix</caption>
+    </screenshot>
+  </screenshots>
+
+  <keywords>
+    <keyword>rgb</keyword>
+    <keyword>lighting</keyword>
+    <keyword>plugin</keyword>
+  </keywords>
+
+  <url type="bugtracker">https://gitlab.com/OpenRGBDevelopers/OpenRGBVisualMapPlugin/-/issues</url>
+  <url type="donation">https://gitlab.com/CalcProgrammer1/OpenRGB/-/blob/master/README.md#support-openrgb</url>
