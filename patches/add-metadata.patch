+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Copyright 2026 Adam Honse, OpenRGB Team -->
+<component type="addon">
+  <id>org.openrgb.OpenRGB.Plugin.Effects</id>
+  <extends>org.openrgb.OpenRGB</extends>
+  <metadata_license>CC0-1.0</metadata_license>
+  <project_license>GPL-2.0-or-later</project_license>
+  <developer id="org.openrgb">
+    <name>Adam Honse, OpenRGB Team</name>
+  </developer>
+
+  <name>OpenRGB Effects Plugin</name>
+  <icon type="stock">openrgb-effects-plugin</icon>
+
+  <content_rating type="oars-1.0" />
+
+  <summary>Effects plugin for OpenRGB that provides lighting effects synced across all devices</summary>
+
+  <description>
+    <p>
+      The OpenRGB Effects Plugin is an addon for OpenRGB that provides a wide
+      variety of lighting effects that can be synchronized across all of your
+      RGB devices at once.  Ambient, audio-reactive, and visualizer effects are
+      built in, along with many classic animation-based effects that can be
+      applied to individual devices and zones.
+    </p><p>
+      Features
+    </p>
+    <ul>
+      <li>Synchronize effects across multiple devices and zones</li>
+      <li>Audio-reactive effects driven by system audio</li>
+      <li>Ambient effects that mirror the colors on your screen</li>
+      <li>Built-in shader, gradient, and custom color effects</li>
+      <li>Animated effects such as rainbow, marquee, comet, and more</li>
+    </ul>
+  </description>
+
+  <releases>
+    <release version="1.0rc2" date="2025-09-14"></release>
+    <release version="0.9" date="2023-07-11"></release>
+    <release version="0.8" date="2022-12-03"></release>
+  </releases>
+
+  <screenshots>
+    <screenshot type="default">
+      <image>https://gitlab.com/OpenRGBDevelopers/OpenRGBEffectsPlugin/-/raw/master/Documentation/Images/Screenshot_AudioVisualizer.png</image>
+      <caption>OpenRGB Effects Plugin - Audio Visualizer</caption>
+    </screenshot>
+    <screenshot type="default">
+      <image>https://gitlab.com/OpenRGBDevelopers/OpenRGBEffectsPlugin/-/raw/master/Documentation/Images/Screenshot_Shaders.png</image>
+      <caption>OpenRGB Effects Plugin - Audio Visualizer</caption>
+    </screenshot>
+  </screenshots>
+
+  <keywords>
+    <keyword>rgb</keyword>
+    <keyword>effects</keyword>
+    <keyword>lighting</keyword>
+    <keyword>plugin</keyword>
+    <keyword>animation</keyword>
+  </keywords>
+
