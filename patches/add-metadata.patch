+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Copyright 2026 Adam Honse, OpenRGB Team -->
+<component type="addon">
+  <id>org.openrgb.OpenRGB.Plugin.E131Receiver</id>
+  <extends>org.openrgb.OpenRGB</extends>
+  <metadata_license>CC0-1.0</metadata_license>
+  <project_license>GPL-2.0-or-later</project_license>
+  <developer id="org.openrgb">
+    <name>Adam Honse, OpenRGB Team</name>
+  </developer>
+
+  <name>OpenRGB E1.31 Receiver Plugin</name>
+  <icon type="stock">openrgb-e131-receiver-plugin</icon>
+
+  <content_rating type="oars-1.0" />
+
+  <summary>E1.31 Receiver plugin for OpenRGB that allows industry standard lighting control software to control OpenRGB devices</summary>
+
+  <description>
+    <p>
+      The OpenRGB E1.31 Receiver Plugin is an addon for OpenRGB that allows mapping
+      OpenRGB devices to E1.31 universes.  E1.31 is an industry-standard protocol for
+      lighting control over IP networks and is supported by a wide variety of hardware
+      and software.  This plugin allows third party software such as QLC+, Vixen Lights,
+      xLights, and others to control your OpenRGB devices.
+    </p><p>
+      Features
+    </p>
+    <ul>
+      <li>Control OpenRGB devices from external E1.31 software</li>
+      <li>Integrate OpenRGB into custom sequenced light shows</li>
+      <li>Tested with QLC+, Vixen Lights, and xLights</li>
+    </ul>
+  </description>
+
+  <releases>
+    <release version="1.0rc2" date="2025-09-14"></release>
+    <release version="0.9" date="2023-07-11"></release>
+    <release version="0.8" date="2022-12-03"></release>
+  </releases>
+
+  <screenshots>
+    <screenshot type="default">
+      <image>https://gitlab.com/OpenRGBDevelopers/OpenRGBE131ReceiverPlugin/-/raw/master/Documentation/Images/Screenshot_Vixen3.png</image>
+      <caption>OpenRGB E1.31 Receiver Plugin - Receiving from Vixen 3</caption>
+    </screenshot>
+  </screenshots>
+
+  <keywords>
+    <keyword>rgb</keyword>
+    <keyword>lighting</keyword>
+    <keyword>plugin</keyword>
+    <keyword>e1.31</keyword>
+  </keywords>
+
