diff --git a/MODULE.bazel b/MODULE.bazel
index c1f0eeb..a6b80e9 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -31,10 +31,40 @@ bazel_dep(name = "toolchains_llvm", version = "1.5.0")
 
 llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
 llvm.toolchain(llvm_version = "19.1.0")
+
+# byteink: link Linux x86_64 binaries against Chromium's Debian bullseye sysroot rather than the build
+# host's glibc. Its glibc stubs stop at GLIBC_2.26, like Google's own JVM binaries.
+llvm.sysroot(
+    name = "llvm_toolchain",
+    label = "@org_chromium_sysroot_linux_x64//:sysroot",
+    targets = ["linux-x86_64"],
+)
 use_repo(llvm, "llvm_toolchain")
 
 register_toolchains("@llvm_toolchain//:all")
 
+http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
+
+# From Chromium's build/linux/sysroot_scripts/sysroots.json ("bullseye_amd64").
+http_archive(
+    name = "org_chromium_sysroot_linux_x64",
+    build_file_content = """
+# Headers and libraries only: the rest (package metadata, systemd units, one of whose names is not
+# a valid Bazel label) is of no use to the compiler or linker.
+filegroup(
+    name = "sysroot",
+    srcs = glob(
+        ["lib/**", "lib64/**", "usr/include/**", "usr/lib/**"],
+        exclude = ["lib/systemd/**", "usr/lib/systemd/**"],
+    ),
+    visibility = ["//visibility:public"],
+)
+""",
+    sha256 = "52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d",
+    type = "tar.xz",
+    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/52d61d4446ffebfaa3dda2cd02da4ab4876ff237853f46d273e7f9b666652e1d"],
+)
+
 # Configure the Android NDK toolchain for NDK builds. Don't register that here so it's not required
 # for builds that don't need it. Those configs can register those in --extra_toolchains.
 bazel_dep(name = "rules_android_ndk", version = "0.1.3")
