diff --git a/MODULE.bazel b/MODULE.bazel
index c1f0eeb..f52b334 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -129,3 +129,16 @@ bazel_dep(
 # See: https://g-issues.skia.org/issues/367315534
 bazel_dep(name = "rules_license", version = "1.0.0")
 bazel_dep(name = "libpng", version = "1.6.47")
+
+# byteink: Windows x86_64 builds cross-compile from Linux with zig's clang (LLVM 19, like the
+# toolchain above) and MinGW-w64, linking libc++ statically. They pass
+# --platforms=@zig_sdk//platform:windows_amd64 --extra_toolchains=@zig_sdk//toolchain:windows_amd64;
+# nothing registers the toolchain here, so Linux builds never see it.
+bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")
+
+zig_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
+use_repo(zig_toolchains, "zig_sdk")
+
+# zlib (for protobuf's gzip streams) passes MSVC flags to any Windows compiler before 1.3.1.bcr.8,
+# which keeps them to MSVC. Same zlib source; for Linux builds only the build file changes.
+bazel_dep(name = "zlib", version = "1.3.1.bcr.8")
diff --git a/ink/jni/BUILD.bazel b/ink/jni/BUILD.bazel
index cffc453..8c744f4 100644
--- a/ink/jni/BUILD.bazel
+++ b/ink/jni/BUILD.bazel
@@ -35,6 +35,9 @@ cc_binary(
         ): [
             "-Wl,-exported_symbols_list,$(location :exported_symbols.txt)",
         ],
+        # byteink: PE has no version scripts. JNIEXPORT marks exactly the JNI functions dllexport,
+        # and a DLL with explicit exports exports nothing else.
+        "@platforms//os:windows": [],
         "//conditions:default": [
             # Use a linker script to limit exported symbols to JNI functions.
             "-Wl,--version-script=$(location :jni.lds)",
