diff --git a/ink/geometry/internal/android_math.h b/ink/geometry/internal/android_math.h
new file mode 100644
index 0000000..46e6799
--- /dev/null
+++ b/ink/geometry/internal/android_math.h
@@ -0,0 +1,196 @@
+#ifndef INK_GEOMETRY_INTERNAL_ANDROID_MATH_H_
+#define INK_GEOMETRY_INTERNAL_ANDROID_MATH_H_
+// Adapted from Android Bionic android-15.0.0_r1, commit
+// 361ba86734fb2821a6adcfdf775db8abd04e0de0,
+// libm/upstream-freebsd/lib/msun/src/{s_atanf,e_atan2f}.c.
+// Keep the original arithmetic: tiny rounding differences can change topology at U-turns.
+// Adaptations: namespaced symbols, bit_cast instead of private word macros, float NaN addition.
+#include <bit>
+#include <cmath>
+#include <cstdint>
+namespace ink::geometry_internal {
+/* s_atanf.c -- float version of s_atan.c.
+ * Conversion to float by Ian Lance Taylor, Cygnus Support, ian@cygnus.com.
+ */
+
+/*
+ * ====================================================
+ * Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
+ *
+ * Developed at SunPro, a Sun Microsystems, Inc. business.
+ * Permission to use, copy, modify, and distribute this
+ * software is freely granted, provided that this notice
+ * is preserved.
+ * ====================================================
+ */
+
+
+static const float atanhi[] = {
+  4.6364760399e-01, /* atan(0.5)hi 0x3eed6338 */
+  7.8539812565e-01, /* atan(1.0)hi 0x3f490fda */
+  9.8279368877e-01, /* atan(1.5)hi 0x3f7b985e */
+  1.5707962513e+00, /* atan(inf)hi 0x3fc90fda */
+};
+
+static const float atanlo[] = {
+  5.0121582440e-09, /* atan(0.5)lo 0x31ac3769 */
+  3.7748947079e-08, /* atan(1.0)lo 0x33222168 */
+  3.4473217170e-08, /* atan(1.5)lo 0x33140fb4 */
+  7.5497894159e-08, /* atan(inf)lo 0x33a22168 */
+};
+
+static const float aT[] = {
+  3.3333328366e-01,
+ -1.9999158382e-01,
+  1.4253635705e-01,
+ -1.0648017377e-01,
+  6.1687607318e-02,
+};
+
+static const float
+one   = 1.0,
+huge   = 1.0e30;
+
+__attribute__((visibility("hidden"))) inline float
+AndroidAtan(float x)
+{
+#pragma clang fp contract(off)
+	float w,s1,s2,z;
+	int32_t ix,hx,id;
+
+	hx = std::bit_cast<int32_t>(x);
+	ix = hx&0x7fffffff;
+	if(ix>=0x4c800000) {	/* if |x| >= 2**26 */
+	    if(ix>0x7f800000)
+		return x+x;		/* NaN */
+	    if(hx>0) return  atanhi[3]+*(volatile float *)&atanlo[3];
+	    else     return -atanhi[3]-*(volatile float *)&atanlo[3];
+	} if (ix < 0x3ee00000) {	/* |x| < 0.4375 */
+	    if (ix < 0x39800000) {	/* |x| < 2**-12 */
+		if(huge+x>one) return x;	/* raise inexact */
+	    }
+	    id = -1;
+	} else {
+	x = fabsf(x);
+	if (ix < 0x3f980000) {		/* |x| < 1.1875 */
+	    if (ix < 0x3f300000) {	/* 7/16 <=|x|<11/16 */
+		id = 0; x = ((float)2.0*x-one)/((float)2.0+x);
+	    } else {			/* 11/16<=|x|< 19/16 */
+		id = 1; x  = (x-one)/(x+one);
+	    }
+	} else {
+	    if (ix < 0x401c0000) {	/* |x| < 2.4375 */
+		id = 2; x  = (x-(float)1.5)/(one+(float)1.5*x);
+	    } else {			/* 2.4375 <= |x| < 2**26 */
+		id = 3; x  = -(float)1.0/x;
+	    }
+	}}
+    /* end of argument reduction */
+	z = x*x;
+	w = z*z;
+    /* break sum from i=0 to 10 aT[i]z**(i+1) into odd and even poly */
+	s1 = z*(aT[0]+w*(aT[2]+w*aT[4]));
+	s2 = w*(aT[1]+w*aT[3]);
+	if (id<0) return x - x*(s1+s2);
+	else {
+	    z = atanhi[id] - ((x*(s1+s2) - atanlo[id]) - x);
+	    return (hx<0)? -z:z;
+	}
+}
+
+/* e_atan2f.c -- float version of e_atan2.c.
+ * Conversion to float by Ian Lance Taylor, Cygnus Support, ian@cygnus.com.
+ */
+
+/*
+ * ====================================================
+ * Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
+ *
+ * Developed at SunPro, a Sun Microsystems, Inc. business.
+ * Permission to use, copy, modify, and distribute this
+ * software is freely granted, provided that this notice
+ * is preserved.
+ * ====================================================
+ */
+
+
+static volatile float
+tiny  = 1.0e-30;
+static const float
+zero  = 0.0,
+pi_o_4  = 7.8539818525e-01, /* 0x3f490fdb */
+pi_o_2  = 1.5707963705e+00, /* 0x3fc90fdb */
+pi      = 3.1415927410e+00; /* 0x40490fdb */
+static volatile float
+pi_lo   = -8.7422776573e-08; /* 0xb3bbbd2e */
+
+__attribute__((visibility("hidden"))) inline float
+AndroidAtan2(float y, float x)
+{
+#pragma clang fp contract(off)
+	float z;
+	int32_t k,m,hx,hy,ix,iy;
+
+	hx = std::bit_cast<int32_t>(x);
+	ix = hx&0x7fffffff;
+	hy = std::bit_cast<int32_t>(y);
+	iy = hy&0x7fffffff;
+	if((ix>0x7f800000)||
+	   (iy>0x7f800000))	/* x or y is NaN */
+	    return x + y;
+	if(hx==0x3f800000) return AndroidAtan(y);   /* x=1.0 */
+	m = ((hy>>31)&1)|((hx>>30)&2);	/* 2*sign(x)+sign(y) */
+
+    /* when y = 0 */
+	if(iy==0) {
+	    switch(m) {
+		case 0:
+		case 1: return y; 	/* atan(+-0,+anything)=+-0 */
+		case 2: return  pi+tiny;/* atan(+0,-anything) = pi */
+		case 3: return -pi-tiny;/* atan(-0,-anything) =-pi */
+	    }
+	}
+    /* when x = 0 */
+	if(ix==0) return (hy<0)?  -pi_o_2-tiny: pi_o_2+tiny;
+
+    /* when x is INF */
+	if(ix==0x7f800000) {
+	    if(iy==0x7f800000) {
+		switch(m) {
+		    case 0: return  pi_o_4+tiny;/* atan(+INF,+INF) */
+		    case 1: return -pi_o_4-tiny;/* atan(-INF,+INF) */
+		    case 2: return  (float)3.0*pi_o_4+tiny;/*atan(+INF,-INF)*/
+		    case 3: return (float)-3.0*pi_o_4-tiny;/*atan(-INF,-INF)*/
+		}
+	    } else {
+		switch(m) {
+		    case 0: return  zero  ;	/* atan(+...,+INF) */
+		    case 1: return -zero  ;	/* atan(-...,+INF) */
+		    case 2: return  pi+tiny  ;	/* atan(+...,-INF) */
+		    case 3: return -pi-tiny  ;	/* atan(-...,-INF) */
+		}
+	    }
+	}
+    /* when y is INF */
+	if(iy==0x7f800000) return (hy<0)? -pi_o_2-tiny: pi_o_2+tiny;
+
+    /* compute y/x */
+	k = (iy-ix)>>23;
+	if(k > 26) {			/* |y/x| >  2**26 */
+	    z=pi_o_2+(float)0.5*pi_lo;
+	    m&=1;
+	}
+	else if(k<-26&&hx<0) z=0.0; 	/* 0 > |y|/x > -2**-26 */
+	else z=AndroidAtan(fabsf(y/x));	/* safe to do y/x */
+	switch (m) {
+	    case 0: return       z  ;	/* atan(+,+) */
+	    case 1: return      -z  ;	/* atan(-,+) */
+	    case 2: return  pi-(z-pi_lo);/* atan(+,-) */
+	    default: /* case 3 */
+		return  (z-pi_lo)-pi;/* atan(-,-) */
+	}
+}
+
+}
+
+#endif
diff --git a/ink/geometry/internal/android_math_test.cc b/ink/geometry/internal/android_math_test.cc
new file mode 100644
index 0000000..ba4ba92
--- /dev/null
+++ b/ink/geometry/internal/android_math_test.cc
@@ -0,0 +1,30 @@
+// Android reference values from NDK 28.2; no personal notebook data.
+#include "ink/geometry/internal/android_math.h"
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include "gtest/gtest.h"
+namespace ink::geometry_internal {
+TEST(AndroidMathTest, AngleBitsMatchAndroid) {
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(0.1f, 0.3f)), 0x3ea4bc7cu);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(0.3f, 0.7f)), 0x3ecf4dfbu);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(-0.3f, 0.7f)), 0xbecf4dfbu);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(0.3f, -0.7f)), 0x402f261bu);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(-0.3f, -0.7f)), 0xc02f261bu);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(1.0f, 3.0f)), 0x3ea4bc7du);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(3.0f, 1.0f)), 0x3f9fe0bbu);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(1e-30f, -1e+30f)), 0x40490fdbu);
+}
+TEST(AndroidMathTest, SignedZerosAndExceptionalInputs) {
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(0.0f, 0.0f)), 0u);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(-0.0f, 0.0f)), 0x80000000u);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(0.0f, -0.0f)), 0x40490fdbu);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(-0.0f, -0.0f)), 0xc0490fdbu);
+  const float inf = std::numeric_limits<float>::infinity();
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(inf, inf)), 0x3f490fdbu);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(inf, -inf)), 0x4016cbe4u);
+  EXPECT_EQ(std::bit_cast<uint32_t>(AndroidAtan2(-inf, -inf)), 0xc016cbe4u);
+  EXPECT_TRUE(std::isnan(AndroidAtan2(inf, std::numeric_limits<float>::quiet_NaN())));
+}
+}
