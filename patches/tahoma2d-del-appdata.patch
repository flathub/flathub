 2 files changed, 1 insertion(+), 22 deletions(-)
 delete mode 100644 toonz/sources/xdg-data/org.tahoma2d.Tahoma2D.appdata.xml

diff --git a/toonz/sources/xdg-data/CMakeLists.txt b/toonz/sources/xdg-data/CMakeLists.txt
