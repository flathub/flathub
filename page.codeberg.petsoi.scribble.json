{
    "id": "page.codeberg.petsoi.scribble",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "scribble",
    "finish-args": [
        "--socket=fallback-x11",
        "--env=GSK_RENDERER=gl",
        "--socket=wayland",
        "--device=dri",
        "--share=ipc",
        "--filesystem=~/Scribble Documents:create",
        "--filesystem=xdg-pictures"
    ],
    "modules": [
        {
            "name": "scribble",
            "buildsystem": "meson",
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-stable/bin"
            },
            "sources": [
                {
                    "type": "archive",
                    "url": "https://codeberg.org/petsoi/scribble/archive/v1.10.2.tar.gz",
                    "sha256": "2c78c4e2cf4b4131039a80c2481aabcc98d2382c1c0760cf1611d01028460afd"
                },
                "cargo-sources.json",
                {
                    "type": "shell",
                    "commands": [
                        "mkdir -p .cargo",
                        "cp cargo/config.toml .cargo/config.toml"
                    ]
                }
            ]
        }
    ]
}
