{
  "name": "onnxruntime",
  "buildsystem": "cmake-ninja",
  "subdir": "cmake",
  "builddir": true,
  "config-opts": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DCMAKE_INSTALL_LIBDIR=lib",
    "-DCMAKE_CXX_STANDARD=20",
    "-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
    "--compile-no-warning-as-error",
    "-DCMAKE_PROJECT_TOP_LEVEL_INCLUDES=/run/build/onnxruntime/flatpak-onnx-offline.cmake",
    "-DFETCHCONTENT_BASE_DIR=/run/build/onnxruntime/flatpak-deps",
    "-DFETCHCONTENT_TRY_FIND_PACKAGE_MODE=NEVER",
    "-DFETCHCONTENT_UPDATES_DISCONNECTED=ON",
    "-DBUILD_SHARED_LIBS=OFF",
    "-DBUILD_TESTING=OFF",
    "-Dprotobuf_LOCAL_DEPENDENCIES_ONLY=ON",
    "-Dprotobuf_BUILD_SHARED_LIBS=OFF",
    "-Donnxruntime_BUILD_SHARED_LIB=ON",
    "-Donnxruntime_BUILD_UNIT_TESTS=OFF",
    "-Donnxruntime_BUILD_BENCHMARKS=OFF",
    "-Donnxruntime_BUILD_FOR_NATIVE_MACHINE=OFF",
    "-Donnxruntime_ENABLE_PYTHON=OFF",
    "-Donnxruntime_ENABLE_TRAINING=OFF",
    "-Donnxruntime_ENABLE_TRAINING_APIS=OFF",
    "-Donnxruntime_ENABLE_TRAINING_OPS=OFF",
    "-Donnxruntime_ENABLE_DLPACK=OFF",
    "-Donnxruntime_USE_CUDA=OFF",
    "-Donnxruntime_USE_TENSORRT=OFF",
    "-Donnxruntime_USE_MIGRAPHX=OFF",
    "-Donnxruntime_USE_XNNPACK=OFF",
    "-Donnxruntime_USE_KLEIDIAI=OFF",
    "-Donnxruntime_USE_QMX_KLEIDIAI_COEXIST=OFF",
    "-Donnxruntime_USE_WEBGPU=OFF",
    "-Donnxruntime_USE_EXTENSIONS=OFF",
    "-Donnxruntime_USE_TELEMETRY=OFF"
  ],
  "post-install": [
    "python3 /run/build/onnxruntime/generate-onnx-sources.py --install-licenses /run/build/onnxruntime /app/share/licenses/io.github.Duecki1.CalibRaw/onnxruntime",
    "strip --strip-unneeded /app/lib/libonnxruntime.so.1.30.0 /app/lib/libonnxruntime_providers_shared.so",
    "test -L /app/lib/libonnxruntime.so && test -f /app/lib/libonnxruntime.so.1.30.0"
  ],
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "*.a"
  ],
  "sources": [
    "onnxruntime-sources.json",
    {
      "type": "file",
      "url": "https://www.boost.org/LICENSE_1_0.txt",
      "sha256": "c9bff75738922193e67fa726fa225535870d2aa1059f91452c411736284ad566",
      "dest": "flatpak-source-archives",
      "dest-filename": "mp11-LICENSE_1_0.txt"
    },
    {
      "type": "file",
      "path": "generate-onnx-sources.py"
    },
    {
      "type": "inline",
      "dest-filename": "flatpak-onnx-offline.cmake",
      "contents": "execute_process(\n  COMMAND python3 \"${CMAKE_CURRENT_LIST_DIR}/generate-onnx-sources.py\"\n          --configure \"${CMAKE_CURRENT_LIST_DIR}\"\n  COMMAND_ERROR_IS_FATAL ANY\n)\n"
    }
  ]
}
