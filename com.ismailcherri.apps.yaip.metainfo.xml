<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata: shown by Flathub, GNOME Software and KDE Discover (the store on the Steam Deck's desktop mode). -->
<component type="desktop-application">
  <id>com.ismailcherri.apps.yaip</id>
  <name>YAIP</name>
  <summary>Watch live TV, movies and series from your Xtream provider</summary>
  <developer id="com.ismailcherri">
    <name>Ismail Cherri</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://yaip.duckdns.org/terms</project_license>
  <description>
    <p>
      YAIP is a player for Xtream Codes playlists. It provides no channels or content: you sign in with an account
      from a service you already subscribe to.
    </p>
    <ul>
      <li>Profiles with illustrated avatars, and playlists shared by every profile</li>
      <li>Live TV with an inline programme guide (XMLTV), movies and series with episodes and seasons</li>
      <li>Favorites, watch history and resume, synced across your devices with end-to-end encrypted playlist logins</li>
      <li>A player for HLS, MPEG-TS, MP4, MKV and AVI, with audio and subtitle tracks, aspect and speed settings</li>
      <li>Downloads for watching without a connection, one title at a time so the provider sees one connection</li>
      <li>Keyboard and gamepad navigation for the couch and the Steam Deck</li>
    </ul>
  </description>
