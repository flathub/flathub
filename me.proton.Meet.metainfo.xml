<component type="desktop-application">
  <id>me.proton.Meet</id>

  <name>Proton Meet</name>
  <summary>End-to-end encrypted video meetings</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <developer id="me.proton">
    <name>Proton AG</name>
  </developer>

  <description>
    <p>
      Proton Meet is a privacy-first video conferencing application that wraps the
      Proton Meet web service (meet.proton.me) in a native desktop window. All video
      calls are end-to-end encrypted, so only the participants can see or hear what is
      shared in the meeting.
    </p>
    <p>
      NOTE: This is a community-maintained Flatpak packaging of Proton Meet. It is not
      officially provided or supported by Proton AG. For official support, please visit
      proton.me/support.
    </p>
    <ul>
      <li>End-to-end encrypted video calls and meetings</li>
      <li>Screen sharing</li>
      <li
            >Open meeting links directly from the browser via the proton-meet:// protocol handler</li>
      <li
            >Picture-in-Picture (PiP) window to keep calls visible while working</li>
    </ul>
  </description>

  <launchable type="desktop-id">me.proton.Meet.desktop</launchable>

  <url type="homepage">https://proton.me/meet</url>
  <url type="vcs-browser">https://github.com/ProtonMail/WebClients</url>
  <url type="contact">https://proton.me/support</url>
  <url type="help">https://proton.me/support</url>

  <screenshots>
    <screenshot type="default">
      <!-- TODO: Replace with a real full-resolution in-app desktop screenshot.
           Flathub prefers actual screenshots of the running Linux application
           (at least 624x351 px, 16:9 aspect ratio) rather than marketing images.
           Take a screenshot with the app running (flatpak run me.proton.Meet),
           host it at a stable URL (e.g. on GitHub or a CDN), then update this entry. -->
      <image>https://proton.me/images/og/meet.jpg</image>
      <caption>Proton Meet video conferencing</caption>
    </screenshot>
  </screenshots>

  <branding>
    <!-- Proton brand purple -->
    <color type="primary" scheme_preference="light">#6d4aff</color>
    <color type="primary" scheme_preference="dark">#8a6ef5</color>
  </branding>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">mild</content_attribute>
    <!-- social-audio moderate: voice/video calls between users -->
    <content_attribute id="social-audio">moderate</content_attribute>
  </content_rating>

  <releases>
    <release version="0.4.16.0" date="2026-05-08">
      <description>
        <p>Initial Flatpak release of Proton Meet, wrapping upstream tag proton-meet@0.4.16.0.</p>
      </description>
    </release>
  </releases>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
</component>
