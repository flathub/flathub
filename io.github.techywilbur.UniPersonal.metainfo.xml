<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.techywilbur.UniPersonal</id>

  <name>Uni Personal</name>
  <summary>All-in-one desktop workspace</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <developer id="io.github.techywilbur">
    <name>William Lindqvist</name>
  </developer>

  <description>
    <p>
      Uni Personal gathers the tools of an everyday desktop into a single
      application, so that notes, files, calendar and the rest live in one
      window instead of a dozen.
    </p>
    <p>Included:</p>
    <ul>
      <li>AI chat with multi-turn history, image upload and screen capture</li>
      <li>Notes with markdown, tags and images</li>
      <li>Spreadsheets and a drawing canvas</li>
      <li>File browser and installed-application launcher</li>
      <li>Calendar and to-do list</li>
      <li>Terminal with a real PTY</li>
      <li>Clipboard history for the current day</li>
      <li>Embedded web browser</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.techywilbur.UniPersonal.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>The launcher, with every feature on one dial</caption>
      <image>https://raw.githubusercontent.com/techywilbur/UniPersonal/main/screenshots/launcher.png</image>
    </screenshot>
    <screenshot>
      <caption>The AI chat, with saved conversations in the sidebar</caption>
      <image>https://raw.githubusercontent.com/techywilbur/UniPersonal/main/screenshots/ai-chat.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/techywilbur/UniPersonal</url>
  <url type="bugtracker">https://github.com/techywilbur/UniPersonal/issues</url>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

  <branding>
    <color type="primary" scheme_preference="light">#c9a227</color>
    <color type="primary" scheme_preference="dark">#7a5c00</color>
  </branding>

  <releases>
    <release version="1.0.40" date="2026-08-03">
      <description>
        <p>First Flatpak release.</p>
      </description>
    </release>
  </releases>
</component>
