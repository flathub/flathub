<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.kurrent.navigator</id>

  <name>Kurrent Navigator</name>
  <summary>Desktop client for KurrentDB</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://assets.navigator.kurrent.io/LICENSE.txt</project_license>

  <developer id="io.kurrent">
    <name>Kurrent, Inc.</name>
  </developer>

  <description>
    <p>
      The desktop user interface for KurrentDB, the event-native database.
      Connect to self-hosted or Kurrent Cloud clusters and explore, operate,
      and monitor them from a single application.
    </p>
    <p>Navigator lets you:</p>
    <ul>
      <li>Monitor cluster health, nodes, and replication at a glance</li>
      <li>Browse streams and inspect event records and their payloads</li>
      <li>Query event data with SQL</li>
      <li>Create and manage projections, persistent subscriptions, and connectors</li>
      <li>Connect to and switch between multiple clusters</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.kurrent.navigator.desktop</launchable>

  <categories>
    <category>Development</category>
    <category>Database</category>
  </categories>

  <keywords>
    <keyword>KurrentDB</keyword>
    <keyword>EventStoreDB</keyword>
    <keyword>event sourcing</keyword>
    <keyword>event store</keyword>
    <keyword>database</keyword>
    <keyword>streams</keyword>
  </keywords>

