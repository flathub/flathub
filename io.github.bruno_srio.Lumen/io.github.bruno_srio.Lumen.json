{
    "id": "io.github.bruno_srio.Lumen",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "lumen",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/lumen/cargo",
            "CARGO_NET_OFFLINE": "true"
        }
    },
    "modules": [
        {
            "name": "lumen",
            "buildsystem": "meson",
            "config-opts": [
                "-Dprofile=default"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/bruno-srio/lumen/archive/refs/tags/v0.2.0.tar.gz",
                    "sha256": "4c857ab8da8e282d2132955bc57789aec5097a60b107b5f3218ed0ba178b72eb",
                    "strip-components": 1
                },
                "cargo-sources.json"
            ]
        }
    ]
}
