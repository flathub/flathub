<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ai.loomfy.Loomfy</id>
  <name>Loomfy</name>
  <summary>Transcribe meetings on your own machine</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <developer id="ai.loomfy">
    <name>Loomfy</name>
  </developer>

  <description>
    <p>
      Loomfy records and transcribes meetings locally, using your GPU. Audio never
      has to leave the machine: transcription, speaker separation and search all
      run on device.
    </p>
    <p>Features:</p>
    <ul>
      <li>Real-time transcription with speaker diarization</li>
      <li>GPU-accelerated on-device processing (Vulkan)</li>
      <li>Captures both your microphone and system audio</li>
      <li>AI summaries, action items and decisions</li>
      <li>Keyword alerts while a meeting is running</li>
      <li>Export to PDF and Markdown</li>
    </ul>
    <p>
      A free account is not required to record and transcribe locally. Cloud
      features such as AI summaries and document generation need an account and
      a paid plan.
    </p>
  </description>

  <launchable type="desktop-id">ai.loomfy.Loomfy.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <image>https://loomfy.ai/screenshots/transcript-en.webp</image>
      <caption>Live transcript with speakers separated</caption>
    </screenshot>
    <screenshot>
      <image>https://loomfy.ai/screenshots/summary-en.webp</image>
      <caption>Summary with decisions and action items</caption>
    </screenshot>
    <screenshot>
      <image>https://loomfy.ai/screenshots/ai-en.webp</image>
      <caption>Ask questions about a recorded meeting</caption>
    </screenshot>
    <screenshot>
      <image>https://loomfy.ai/screenshots/context-en.webp</image>
      <caption>Context surfaced while the meeting runs</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://loomfy.ai</url>
  <url type="contact">https://loomfy.ai/en/contact/</url>

