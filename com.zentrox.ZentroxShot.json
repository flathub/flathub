{
    "app-id": "com.zentrox.ZentroxShot",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.6",
    "sdk": "org.kde.Sdk",
    "command": "zentrox-shot",
    "rename-icon": "zentrox-shot",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--socket=session-bus",
        "--talk-name=org.gnome.Shell.Screenshot",
        "--talk-name=org.freedesktop.portal.Desktop",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.portal.Notifications",
        "--filesystem=xdg-pictures/Screenshots:create",
        "--filesystem=host"
    ],
    "modules": [
        {
            "name": "zbar",
            "config-opts": [
                "--disable-video",
                "--without-python",
                "--without-gtk",
                "--without-qt"
            ],
            "cleanup": [
                "/bin",
                "/include",
                "/lib/pkgconfig",
                "*.la"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/mchehab/zbar.git",
                    "tag": "0.23.93"
                }
            ]
        },
        {
            "name": "leptonica",
            "cleanup": [
                "/bin",
                "/include",
                "/lib/pkgconfig",
                "*.la"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/DanBloomberg/leptonica.git",
                    "tag": "1.87.0"
                }
            ]
        },
        {
            "name": "tesseract",
            "cleanup": [
                "/bin",
                "/include",
                "/lib/pkgconfig",
                "*.la"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/tesseract-ocr/tesseract.git",
                    "tag": "5.5.2"
                }
            ]
        },
        {
            "name": "zentrox-shot",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "dir",
                    "path": "../../"
                }
            ]
        }
    ]
}
