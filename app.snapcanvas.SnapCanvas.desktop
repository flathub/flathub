[Desktop Entry]
Name=SnapCanvas
GenericName=Screenshot & Annotation Tool
Comment=Publication-ready screenshots with privacy, OCR, and smart redaction
Exec=snapcanvas %U
Icon=app.snapcanvas.SnapCanvas
Type=Application
StartupNotify=true
Categories=Graphics;2DGraphics;
MimeType=image/png;image/jpeg;image/webp;
StartupWMClass=SnapCanvas
Keywords=screenshot;capture;annotate;snip;ocr;redact;privacy;
