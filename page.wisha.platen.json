{
    "app-id": "page.wisha.platen",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
    "command": "platen",
    "finish-args" : [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--share=network",
        "--filesystem=~/.cache/platen-paste-files/:create",
        "--filesystem=~/.local/share/onlyoffice/desktopeditors/recover/",
        "--filesystem=~/.var/app/org.onlyoffice.desktopeditors/data/onlyoffice/desktopeditors/recover/"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "env": {
        		"CARGO_NET_OFFLINE": true
        }
    },
    "modules": [
        {
            "name": "platen",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://tangled.org/wisha.page/platen",
                    "tag": "v0.0.1-release-1"
                },
                "cargo-sources.json",
                {
                		"type": "shell",
                		"commands": ["mkdir -p .cargo", "cp -vf cargo/config .cargo/config.toml"]
                	}
            ]
        }
    ]
}
