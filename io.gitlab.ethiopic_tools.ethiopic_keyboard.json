{
    "app-id": "io.gitlab.ethiopic_tools.ethiopic_keyboard",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "22.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "sandbox_main.sh",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "modules": [
        {
            "name": "python3-wxpython",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app wxPython"
            ]
        },
        {
            "name": "ethiopic-keyboard",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/bin",
                "mkdir -p /app/share/ethiopic-keyboard",
                "cp -r assets core gui locales main.py sandbox_main.py /app/share/ethiopic-keyboard/",
                "echo '#!/bin/sh' > /app/bin/sandbox_main.sh",
                "echo 'cd /app/share/ethiopic-keyboard && python3 sandbox_main.py' >> /app/bin/sandbox_main.sh",
                "chmod +x /app/bin/sandbox_main.sh",
                "mkdir -p /app/share/applications",
                "cp assets/ethiopic-keyboard.desktop /app/share/applications/io.gitlab.ethiopic_tools.ethiopic_keyboard.desktop",
                "mkdir -p /app/share/icons/hicolor/512x512/apps",
                "cp assets/icon.png /app/share/icons/hicolor/512x512/apps/io.gitlab.ethiopic_tools.ethiopic_keyboard.png",
                "mkdir -p /app/share/metainfo",
                "cp assets/ethiopic-keyboard.metainfo.xml /app/share/metainfo/io.gitlab.ethiopic_tools.ethiopic_keyboard.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.com/ethiopic-tools/ethiopic-keyboard.git",
                    "tag": "1.0.5"
                }
            ]
        }
    ]
}
