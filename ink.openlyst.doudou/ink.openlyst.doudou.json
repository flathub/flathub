{
    "app-id": "ink.openlyst.doudou",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "doudou",
    "separate-locales": false,
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--filesystem=xdg-music:ro",
        "--filesystem=xdg-download",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.mpris.MediaPlayer2.Player",
        "--own-name=org.mpris.MediaPlayer2.com.mycompany.myapp.audio",
        "--own-name=org.mpris.MediaPlayer2.com.mycompany.myapp.audio.*",
        "--env=LD_LIBRARY_PATH=/app/lib"
    ],
    "modules": [
        "../shared-modules/libappindicator/libappindicator-gtk3-12.10.json",
        "mpv.json",
        {
            "name": "doudou",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "dir",
                    "path": "bundle"
                },
                {
                    "type": "file",
                    "path": "flatpak/ink.openlyst.doudou.svg"
                },
                {
                    "type": "file",
                    "path": "flatpak/ink.openlyst.doudou.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "flatpak/ink.openlyst.doudou.desktop"
                }
            ],
            "build-commands": [
                "mkdir -p /app/doudou",
                "cp -r * /app/doudou",
                "chmod +x /app/doudou/doudou",
                "mkdir -p /app/doudou/lib",
                "ln -s /app/lib/libappindicator3.so /app/doudou/lib/libayatana-appindicator3.so.1",
                "ln -s /app/lib/libindicator3.so /app/doudou/lib/libayatana-indicator3.so.7",
                "ln -s /app/lib/libindicator3.so /app/doudou/lib/libayatana-ido3-0.4.so.0",
                "ln -s /app/lib/libmpv.so /app/lib/libmpv.so.1",
                "mkdir -p /app/bin",
                "echo '#!/bin/sh' > /app/bin/doudou",
                "echo 'cd /app/doudou' >> /app/bin/doudou",
                "echo 'export LD_LIBRARY_PATH=/app/doudou/lib:/app/lib:$LD_LIBRARY_PATH' >> /app/bin/doudou",
                "echo 'exec /app/doudou/doudou \"$@\"' >> /app/bin/doudou",
                "chmod +x /app/bin/doudou",
                "install -Dm644 ink.openlyst.doudou.svg -t /app/share/icons/hicolor/scalable/apps",
                "install -Dm644 ink.openlyst.doudou.metainfo.xml -t /app/share/metainfo",
                "install -Dm644 ink.openlyst.doudou.desktop -t /app/share/applications"
            ]
        }
    ]
}
