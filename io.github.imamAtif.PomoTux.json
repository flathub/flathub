{
	"app-id": "io.github.imamAtif.PomoTux",
	"runtime": "org.kde.Platform",
	"runtime-version": "6.9",
	"sdk": "org.kde.Sdk",
	"command": "pomotux",
	"base": "io.qt.PySide.BaseApp",
	"base-version": "6.9",
	"finish-args": [
		"--share=ipc",
		"--socket=fallback-x11",
		"--device=dri",
		"--talk-name=org.kde.StatusNotifierWatcher",
		"--talk-name=org.freedesktop.Notifications",
		"--persist=.config/pomotux",
		"--persist=.local/share/pomotux"
	],
	"cleanup-commands": [
		"/app/cleanup-BaseApp.sh"
	],
	"modules": [
		{
			"name": "pomotux",
			"buildsystem": "simple",
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/imamAtif/PomoTux.git",
					"tag": "v0.3.0"
				}
			],
			"build-commands": [
				"mkdir -p /app/share/pomotux /app/bin /app/share/applications /app/share/metainfo",
				"cp main.py /app/share/pomotux/",
				"cp -r pomotux /app/share/pomotux/",
				"install -Dm755 packaging/flatpak/pomotux-wrapper.sh /app/bin/pomotux",
				"sed s/^Icon=.*/Icon=io.github.imamAtif.PomoTux/ packaging/io.github.pomotux.desktop > /app/share/applications/io.github.imamAtif.PomoTux.desktop",
				"install -Dm644 packaging/icons/io.github.pomotux.svg /app/share/icons/hicolor/scalable/apps/io.github.imamAtif.PomoTux.svg",
				"install -Dm644 packaging/icons/hicolor/256x256/apps/io.github.pomotux.png /app/share/icons/hicolor/256x256/apps/io.github.imamAtif.PomoTux.png",
				"install -Dm644 packaging/flatpak/io.github.imamAtif.PomoTux.metainfo.xml /app/share/metainfo/io.github.imamAtif.PomoTux.metainfo.xml",
				"install -Dm644 LICENSE /app/share/licenses/io.github.imamAtif.PomoTux/pomotux"
			]
		}
	]
}
