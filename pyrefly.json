{
    "name": "pyrefly",
    "buildsystem": "simple",
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/pyrefly/cargo"
        }
    },
    "build-commands": [
        "cargo build --offline --release -p pyrefly",
        "install -Dm755 target/release/pyrefly -t ${FLATPAK_DEST}/bin/"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/facebook/pyrefly",
            "tag": "1.4.1",
            "commit": "b726cd5f45eec1443e0f224dedd1dd45dcfb1a5d",
            "x-checker-data": {
                "type": "git",
                "tag-pattern": "^([\\d.]+)$"
            }
        },
        "pyrefly-cargo-sources.json"
    ]
}
