{
    "app-id": "com.openamity.OpenAmity",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.node24"
    ],
    "base": "io.qt.PySide.BaseApp",
    "base-version": "6.11",
    "command": "run_OpenAmity.sh",
    "build-options": {
        "append-path": "/usr/lib/sdk/node24/bin"
    },
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=dri",
        "--filesystem=home"
    ],
    "modules": [
        {
            "name": "portaudio",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/PortAudio/portaudio.git",
                    "tag": "v19.7.0",
                    "commit": "147dd722548358763a8b649b3e4b41dfffbcfbb6"
                }
            ]
        },
        "python3-requirements.json",
        {
            "name": "nodejs",
            "buildsystem": "simple",
            "build-commands": [
                "/usr/lib/sdk/node24/install.sh",
                "ln -sf /app/node/bin/node /app/bin/node"
            ]
        },
        {
            "name": "open_amity",
            "buildsystem": "simple",
            "build-commands": [
                "install -D -m 644 LICENSE /app/share/licenses/com.openamity.OpenAmity/LICENSE",
                "install -D -m 644 LICENSE /app/LICENSE",
                "install -D -m 644 compile/com.openamity.OpenAmity.desktop /app/share/applications/com.openamity.OpenAmity.desktop",
                "install -D -m 644 compile/com.openamity.OpenAmity.metainfo.xml /app/share/metainfo/com.openamity.OpenAmity.metainfo.xml",
                "install -D -m 644 src/assets/com.openamity.OpenAmity.png /app/share/icons/hicolor/512x512/apps/com.openamity.OpenAmity.png",
                "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true PUPPETEER_SKIP_DOWNLOAD=true npm --prefix src/tools/whatsapp_node --cache flatpak-node/npm-cache --prefer-offline --no-audit --no-fund ci",
                "cp -r src /app/src",
                "cp run_OpenAmity.sh /app/bin/run_OpenAmity.sh",
                "chmod +x /app/bin/run_OpenAmity.sh"
            ],
            "post-install": [
                "BASEAPP_REMOVE_WEBENGINE=1 /app/cleanup-BaseApp.sh || true",
                "rm -rf /app/lib/python3.*/site-packages/OpenGL*",
                "rm -rf /app/lib/python3.*/site-packages/PySide6/QtQuick* /app/lib/python3.*/site-packages/PySide6/QtQml* /app/lib/python3.*/site-packages/PySide6/Qt3D* /app/lib/python3.*/site-packages/PySide6/QtPdf* /app/lib/python3.*/site-packages/PySide6/QtSensors* /app/lib/python3.*/site-packages/PySide6/QtPositioning*",
                "rm -rf /app/lib/python3.*/site-packages/kubernetes* /app/lib/python3.*/site-packages/google_antigravity*",
                "rm -rf /app/lib/python3.*/site-packages/av* /app/lib/python3.*/site-packages/av.libs",
                "rm -rf /app/lib/python3.*/site-packages/piper/train /app/lib/python3.*/site-packages/piper/hebrew/*.onnx /app/lib/python3.*/site-packages/piper/tashkeel/*.onnx",
                "ln -sf /app/bin/node /app/lib/python3.*/site-packages/playwright/driver/node 2>/dev/null || true",
                "rm -rf /app/src/assets/screenshots /app/src/assets/fonts/Inter-*.ttf",
                "find /app/src/tools/whatsapp_node/node_modules -type f \\( -name \"*.d.ts\" -o -name \"*.map\" \\) -delete"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/OpenTangent/OpenAmity.git",
                    "tag": "v0.3.7",
                    "commit": "300a8ad4ea812a8b3d20e5ef561411d0952117ff"
                },
                "node-sources.json"
            ]
        }
    ]
}
