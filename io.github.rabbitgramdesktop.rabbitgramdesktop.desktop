[Desktop Entry]
Name=rabbitGram
Comment=rabbitGram Desktop Messaging Client
TryExec=rabbitGram
Exec=rabbitGram -- %U
Icon=io.github.rabbitgramdesktop.rabbitgramdesktop
Terminal=false
StartupWMClass=rabbitGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;x-scheme-handler/ton;
Keywords=tg;chat;im;messaging;messenger;sms;tdesktop;rabbitgram;rabbitGram;
Actions=quit;
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=rabbitGram -quit
Name=Quit rabbitGram
Icon=application-exit
