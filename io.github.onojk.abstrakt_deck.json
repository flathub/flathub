{
    "id": "io.github.onojk.abstrakt_deck",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "abstrakt-deck",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=xdg-videos:create"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/abstrakt-deck/cargo"
        }
    },
    "modules": [
        {
            "name": "x264",
            "buildsystem": "simple",
            "build-commands": [
                "./configure --prefix=/app --enable-shared --enable-pic --disable-cli",
                "make -j$(nproc)",
                "make install"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://code.videolan.org/videolan/x264/-/archive/b35605ace3ddf7c1a5d67a2eb553f034aef41d55/x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55.tar.bz2",
                    "sha256": "6eeb82934e69fd51e043bd8c5b0d152839638d1ce7aa4eea65a3fedcf83ff224"
                }
            ]
        },
        {
            "name": "ffmpeg",
            "buildsystem": "simple",
            "build-commands": [
                "./configure --prefix=/app --enable-gpl --enable-libx264 --extra-cflags=-I/app/include --extra-ldflags=-L/app/lib --disable-doc --disable-ffplay --disable-network --disable-debug",
                "make -j$(nproc)",
                "make install"
            ],
            "cleanup": [
                "/share/ffmpeg/examples"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ffmpeg.org/releases/ffmpeg-7.1.5.tar.xz",
                    "sha256": "de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f"
                }
            ]
        },
        {
            "name": "abstrakt-deck",
            "buildsystem": "simple",
            "build-commands": [
                "rm -f .cargo/config.toml .cargo/config",
                "cargo --offline build --release --verbose",
                "install -Dm755 target/release/abstrakt-deck /app/bin/abstrakt-deck",
                "install -Dm644 io.github.onojk.abstrakt_deck.desktop /app/share/applications/io.github.onojk.abstrakt_deck.desktop",
                "install -Dm644 io.github.onojk.abstrakt_deck.metainfo.xml /app/share/metainfo/io.github.onojk.abstrakt_deck.metainfo.xml",
                "install -Dm644 io.github.onojk.abstrakt_deck.png /app/share/icons/hicolor/512x512/apps/io.github.onojk.abstrakt_deck.png"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/onojk/abstrakt_deck.git",
                    "tag": "v0.1.8",
                    "commit": "7800bcaa603fda3f3544ad5ab97f2de4e79af68a"
                },
                "cargo-sources.json",
                {
                    "type": "file",
                    "path": "io.github.onojk.abstrakt_deck.desktop"
                },
                {
                    "type": "file",
                    "path": "io.github.onojk.abstrakt_deck.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "io.github.onojk.abstrakt_deck.png"
                }
            ]
        }
    ]
}
