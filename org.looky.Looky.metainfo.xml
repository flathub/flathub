<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.looky.Looky</id>

  <name>Looky</name>
  <summary>Quick file previewer for Linux</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Looky is a fast file previewer for Linux, inspired by Quick Look on macOS.
      Select a file in your file manager, run Looky, and get an instant preview
      in a clean floating window — no need to open a full application.
    </p>
    <p>Supported file types:</p>
    <ul>
      <li>Images: JPG, PNG, GIF, WebP, SVG, BMP</li>
      <li>Text and code: TXT, Markdown, JSON, YAML, TOML, XML, HTML, CSS, JS, Python, Rust, Shell</li>
      <li>Documents: PDF (with page navigation)</li>
      <li>Video: MP4, MKV, WebM, AVI</li>
      <li>Audio: MP3, WAV, OGG, FLAC</li>
    </ul>
  </description>

  <categories>
    <category>Utility</category>
    <category>FileTools</category>
  </categories>

  <keywords>
    <keyword>preview</keyword>
    <keyword>quick look</keyword>
    <keyword>file viewer</keyword>
    <keyword>image</keyword>
    <keyword>pdf</keyword>
    <keyword>video</keyword>
  </keywords>

  <url type="homepage">https://github.com/jaro17/looky</url>
  <url type="bugtracker">https://github.com/jaro17/looky/issues</url>

  <launchable type="desktop-id">org.looky.Looky.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>Audio preview with playback controls</caption>
      <image>https://raw.githubusercontent.com/jaro17/looky/main/assets/screenshots/Screenshot_1.png</image>
    </screenshot>
    <screenshot>
      <caption>Video preview with native playback</caption>
      <image>https://raw.githubusercontent.com/jaro17/looky/main/assets/screenshots/Screenshot_2.png</image>
    </screenshot>
    <screenshot>
      <caption>PDF preview with page navigation</caption>
      <image>https://raw.githubusercontent.com/jaro17/looky/main/assets/screenshots/Screenshot_3.png</image>
    </screenshot>
    <screenshot>
      <caption>Nautilus integration — right-click context menu</caption>
      <image>https://raw.githubusercontent.com/jaro17/looky/main/assets/screenshots/Screenshot_4.jpg</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1">
    <!-- File viewer with no network access, no user content generation -->
    <content_attribute id="social-info">none</content_attribute>
  </content_rating>

  <releases>
    <release version="0.1.0" date="2026-05-26">
      <description>
        <p>Initial release. Supports image, text, PDF, video, and audio previews.</p>
      </description>
    </release>
  </releases>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
</component>
