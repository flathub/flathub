{
    "id" : "io.github.mhdev_89.WebArchive",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "webarchive",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=home/ZIMs"],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"],
    "modules" : [
        "python3-libzim.json",
        {
            "name" : "webarchive",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {"type" : "git","url" : "https://github.com/mhdev-89/WebArchive.git","tag" : "v1.1.0"}]}]}
