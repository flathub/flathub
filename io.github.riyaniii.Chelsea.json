{
    "id": "io.github.riyaniii.Chelsea",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "chelsea",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--talk-name=org.freedesktop.ScreenSaver",
        "--filesystem=xdg-download/Chelsea:create",
        "--env=LC_NUMERIC=C"
    ],
    "add-extensions": {
        "org.freedesktop.Platform.codecs-extra": {
            "directory": "lib/codecs-extra",
            "version": "25.08-extra",
            "add-ld-path": "lib",
            "no-autodownload": false,
            "autodelete": false
        }
    },
    "cleanup-commands": [
        "mkdir -p /app/lib/codecs-extra"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        "python3-diskcache.json",
        "python3-chelsea-deps.json",
        {
            "name": "nuvio-engine",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 lib/libnuvio_engine.so.0.1.6 ${FLATPAK_DEST}/lib/libnuvio_engine.so.0.1.6",
                "ln -sf libnuvio_engine.so.0.1.6 ${FLATPAK_DEST}/lib/libnuvio_engine.so.0",
                "install -Dm644 -t ${FLATPAK_DEST}/share/licenses/nuvio-engine licenses/*"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/NuvioMedia/nuvio-engine/releases/download/v0.1.6/nuvio-engine-linux-x86_64-0.1.6.tar.gz",
                    "sha256": "d5c9a4a94f676403da3422ea80a3faceeb57c99c14f98155a7b702416874a1dd",
                    "only-arches": [
                        "x86_64"
                    ]
                }
            ]
        },
        {
            "name": "libass",
            "buildsystem": "meson",
            "config-opts": [
                "-Ddefault_library=shared"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/libass/libass.git",
                    "tag": "0.17.5",
                    "commit": "4a05d8127f525943ebf45fdc6497c9e665947f0d"
                }
            ]
        },
        {
            "name": "libplacebo",
            "buildsystem": "meson",
            "config-opts": [
                "-Dvulkan=enabled",
                "-Dshaderc=enabled",
                "-Dglslang=disabled",
                "-Dd3d11=disabled",
                "-Ddemos=false",
                "-Dtests=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://code.videolan.org/videolan/libplacebo.git",
                    "tag": "v7.387.0",
                    "commit": "275f7dea27924cdd34ab2e6c20e448b6bc4fab65"
                }
            ]
        },
        {
            "name": "mpv",
            "buildsystem": "meson",
            "config-opts": [
                "-Dlibmpv=true",
                "-Dcplayer=false",
                "-Dlua=disabled",
                "-Djavascript=disabled",
                "-Dmanpage-build=disabled",
                "-Dhtml-build=disabled",
                "-Dpdf-build=disabled",
                "-Dtests=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/mpv-player/mpv.git",
                    "tag": "v0.42.0",
                    "commit": "b0841e8c4d156b8403dc1876c4cbd9011eb583f3"
                }
            ]
        },
        {
            "name": "chelsea",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/riyaniii/Chelsea.git",
                    "tag": "0.1.1"
                }
            ],
            "builddir": true
        }
    ]
}
