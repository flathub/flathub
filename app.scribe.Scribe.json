{
    "app-id": "app.scribe.Scribe",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "scribe",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "build-options": {
        "build-args": [
            "--share=network"
        ],
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/scribe/cargo",
            "CARGO_REGISTRIES_CRATES_IO_PROTOCOL": "sparse",
            "CARGO_TARGET_DIR": "target"
        }
    },
    "modules": [
        {
            "name": "scribe",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release --locked",
                "install -Dm755 target/release/scribe /app/bin/scribe",
                "install -Dm644 data/app.scribe.Scribe.desktop /app/share/applications/app.scribe.Scribe.desktop",
                "install -Dm644 data/app.scribe.Scribe.metainfo.xml /app/share/metainfo/app.scribe.Scribe.metainfo.xml",
                "install -Dm644 data/app.scribe.Scribe.gschema.xml /app/share/glib-2.0/schemas/app.scribe.Scribe.gschema.xml",
                "glib-compile-schemas /app/share/glib-2.0/schemas",
                "install -Dm644 data/icons/hicolor/scalable/apps/app.scribe.Scribe.svg /app/share/icons/hicolor/scalable/apps/app.scribe.Scribe.svg",
                "install -Dm644 data/icons/hicolor/scalable/actions/scribe-preview-on-symbolic.svg /app/share/icons/hicolor/scalable/actions/scribe-preview-on-symbolic.svg",
                "install -Dm644 data/icons/hicolor/scalable/actions/scribe-preview-off-symbolic.svg /app/share/icons/hicolor/scalable/actions/scribe-preview-off-symbolic.svg"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/gnacho/scribe",
                    "commit": "6a5762da45ec32c72e255b94a8e4289ca3641ae4"
                }
            ]
        }
    ]
}