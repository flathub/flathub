name: libelectron
buildsystem: simple
build-options:
  append-path: /usr/lib/sdk/node22/bin
  env:
    XDG_CACHE_HOME: /run/build/libelectron/flatpak-node/cache
    npm_config_cache: /run/build/libelectron/flatpak-node/npm-cache
    npm_config_nodedir: /usr/lib/sdk/node22
build-commands:
  - install -dm755 /app/opt/libelectron
  - cp -a libelectron/. /app/opt/libelectron/
  - install -Dm644 package-lock.json /app/opt/libelectron/package-lock.json
  - npm install --legacy-peer-deps --omit=dev --offline --prefix /app/opt/libelectron
  - printf '@LIBELECTRON_VERSION@\n' > /app/opt/libelectron/version.txt
  - install -dm755 /app/opt/libelectron/libsplash
  - cp -a libsplash/. /app/opt/libelectron/libsplash/
  - install -dm755 /app/opt/libelectron/libadblock
  - cp -a libadblock/. /app/opt/libelectron/libadblock/
  - install -dm755 /app/opt/libelectron/libuseragent
  - cp -a libuseragent/. /app/opt/libelectron/libuseragent/
  - ln -sf /app/bin/libelectronmeta /app/opt/libelectron/electron
  - sh -c 'install -Dm644 LICENSE "/app/share/licenses/${FLATPAK_ID}/libelectron/LICENSE"'
sources:
  - ../generated-sources.json
  - type: file
    path: ../package-lock.json
  - type: file
    path: ../LICENSE
  - type: archive
    url: https://gitlab.com/linuxbombay/libelectron/libelectron/-/archive/@LIBELECTRON_VERSION@/libelectron-@LIBELECTRON_VERSION@.tar.bz2
    sha256: @LIBELECTRON_SHA256@
    dest: libelectron
    strip-components: 1
  - type: archive
    url: https://gitlab.com/linuxbombay/libelectron/libsplash/-/archive/@LIBSPLASH_VERSION@/libsplash-@LIBSPLASH_VERSION@.tar.bz2
    sha256: @LIBSPLASH_SHA256@
    dest: libsplash
    strip-components: 1
  - type: archive
    url: https://gitlab.com/linuxbombay/libelectron/libadblock/libadblock/-/archive/@LIBADBLOCK_VERSION@/libadblock-@LIBADBLOCK_VERSION@.tar.bz2
    sha256: @LIBADBLOCK_SHA256@
    dest: libadblock
    strip-components: 1
  - type: archive
    url: https://gitlab.com/linuxbombay/libelectron/libuseragent/-/archive/@LIBUSERAGENT_VERSION@/libuseragent-@LIBUSERAGENT_VERSION@.tar.bz2
    sha256: @LIBUSERAGENT_SHA256@
    dest: libuseragent
    strip-components: 1
