#!/usr/bin/env bash

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
versions_file="${repo_dir}/versions/libelectron.env"
template_file="${repo_dir}/modules/libelectron.yml.in"
output_file="${repo_dir}/modules/libelectron.yml"

source "${versions_file}"

required_vars=(
    LIBELECTRON_VERSION LIBELECTRON_SHA256
    LIBSPLASH_VERSION LIBSPLASH_SHA256
    LIBADBLOCK_VERSION LIBADBLOCK_SHA256
    LIBUSERAGENT_VERSION LIBUSERAGENT_SHA256
)

for var in "${required_vars[@]}"; do
    if [[ -z "${!var:-}" ]]; then
        printf 'Missing required variable: %s\n' "${var}" >&2
        exit 1
    fi
done

content="$(< "${template_file}")"
for var in "${required_vars[@]}"; do
    content="${content//@${var}@/${!var}}"
done

printf '%s\n' "${content}" > "${output_file}"
