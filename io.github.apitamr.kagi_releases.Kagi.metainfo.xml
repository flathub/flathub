<?xml version="1.0" encoding="UTF-8"?>
<!-- Kagi's store listing (Flathub, GNOME Software, Discover).
     scripts/linux/flatpak.sh fills in the release's version and date. -->
<component type="desktop-application">
  <id>io.github.apitamr.kagi_releases.Kagi</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <name>Kagi</name>
  <summary>A compact database client</summary>
  <developer id="io.github.apitamr">
    <name>apitamr</name>
  </developer>
  <description>
    <p>
      Kagi is a fast, compact client for your databases: PostgreSQL, MySQL and
      MariaDB, SQLite, DuckDB, SQL Server, ClickHouse, MongoDB and Redis in one
      window.
    </p>
    <ul>
      <li>Browse tables page by page, filter and sort on the server, and edit rows, applied in one transaction</li>
      <li>Write queries with autocomplete, run them, explain them and keep their history</li>
      <li>See a table's structure, follow foreign keys and draw the schema as a diagram</li>
      <li>Compare two schemas or two tables' rows and copy the SQL that syncs them</li>
      <li>Import and export CSV and JSON, dump and restore databases</li>
      <li>Connect through SSH tunnels and TLS, with passwords kept in the system keyring</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.apitamr.kagi_releases.Kagi.desktop</launchable>
  <provides>
    <binary>kagi</binary>
  </provides>
  <url type="homepage">https://github.com/apitamr/kagi-releases</url>
  <url type="bugtracker">https://github.com/apitamr/kagi-releases/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>Browsing a table</caption>
      <image>https://raw.githubusercontent.com/apitamr/kagi-releases/main/screenshots/table.png</image>
    </screenshot>
    <screenshot>
      <caption>Running a query, in the dark theme</caption>
      <image>https://raw.githubusercontent.com/apitamr/kagi-releases/main/screenshots/query.png</image>
    </screenshot>
    <screenshot>
      <caption>A schema's diagram</caption>
      <image>https://raw.githubusercontent.com/apitamr/kagi-releases/main/screenshots/diagram.png</image>
    </screenshot>
    <screenshot>
      <caption>Saved connections</caption>
      <image>https://raw.githubusercontent.com/apitamr/kagi-releases/main/screenshots/connections.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#fcd9a8</color>
    <color type="primary" scheme_preference="dark">#7a3b12</color>
  </branding>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <releases>
