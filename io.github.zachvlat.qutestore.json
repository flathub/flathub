{
  "app-id": "io.github.zachvlat.qutestore",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "command": "qutestore",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=/var/lib/flatpak",
    "--filesystem=xdg-data/flatpak",
    "--filesystem=/var/tmp",
    "--filesystem=~/.var/app",
    "--talk-name=org.freedesktop.Flatpak",
    "--system-talk-name=org.freedesktop.Flatpak.SystemHelper"
  ],
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/bash-completion",
    "/share/applications/mimeinfo.cache",
    "/share/gettext",
    "/share/icons/hicolor/icon-theme.cache",
    "/share/man",
    "/share/pkgconfig",
    "/share/zsh",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "bubblewrap",
      "buildsystem": "meson",
      "config-opts": [
        "-Dman=disabled",
        "-Dselinux=disabled",
        "-Dtests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/containers/bubblewrap/releases/download/v0.12.0/bubblewrap-0.12.0.tar.xz",
          "sha256": "9760d007363e3abba7c747489910f9f82d9fca53ba3bd3282e396fa3c97a3314"
        }
      ]
    },
    {
      "name": "flatpak",
      "buildsystem": "meson",
      "config-opts": [
        "-Dgtkdoc=disabled",
        "-Ddocbook_docs=disabled",
        "-Dgir=disabled",
        "-Dtests=false",
        "-Dman=disabled",
        "-Ddconf=disabled",
        "-Dmalcontent=disabled",
        "-Dseccomp=disabled",
        "-Dselinux_module=disabled",
        "-Dsandboxed_triggers=false",
        "-Dsystem_helper=enabled",
        "-Dsystemd=disabled",
        "-Dsystem_install_dir=/var/lib/flatpak",
        "-Dsystem_bubblewrap=bwrap",
        "-Dsystem_dbus_proxy=xdg-dbus-proxy",
        "--sysconfdir=/var/run/host/etc"
      ],
      "cleanup": [
        "/bin/flatpak-bisect",
        "/bin/flatpak-coredumpctl",
        "/etc/profile.d",
        "/lib/systemd",
        "/lib/sysusers.d",
        "/lib/tmpfiles.d",
        "/share/dbus-1/interfaces/org.freedesktop.*",
        "/share/dbus-1/services/org.freedesktop.*",
        "/share/flatpak/triggers",
        "/share/gdm",
        "/share/zsh",
        "/share/fish"
      ],
      "post-install": [
        "install -Dpm0755 -t /app/bin /usr/bin/update-mime-database /usr/bin/update-desktop-database"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/flatpak/flatpak/releases/download/1.18.2/flatpak-1.18.2.tar.xz",
          "sha256": "800ff8cb14c369a3c19984932ae2cbea1b0d38363daa57cfb8ef04b8d7f08e10"
        },
        {
          "type": "patch",
          "path": "build-aux/flatpak/revokefs-propagate-fuse-main-failure.patch"
        }
      ],
      "modules": [
        {
          "name": "python3-pyparsing",
          "buildsystem": "simple",
          "cleanup": [
            "*"
          ],
          "build-commands": [
            "pip3 install --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} pyparsing"
          ],
          "sources": [
            {
              "type": "file",
              "url": "https://files.pythonhosted.org/packages/e4/11/b213bebff182584360cb8d17c72c1677fec5c5c228de439e63bcf8ab1c8f/pyparsing-3.3.3.tar.gz",
              "sha256": "928ae7e20211f3b6f3915a72f06a0cfd29ab9d24279dd6346b6b1a7146397d36"
            },
            {
              "type": "file",
              "url": "https://files.pythonhosted.org/packages/69/59/b6fc2188dfc7ea4f936cd12b49d707f66a1cb7a1d2c16172963534db741b/flit_core-3.12.0.tar.gz",
              "sha256": "18f63100d6f94385c6ed57a72073443e1a71a4acb4339491615d0f16d6ff01b2"
            }
          ]
        },
        {
          "name": "python3-babel",
          "buildsystem": "simple",
          "cleanup": [
            "*"
          ],
          "build-commands": [
            "pip3 install --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} --no-build-isolation babel"
          ],
          "sources": [
            {
              "type": "file",
              "url": "https://files.pythonhosted.org/packages/7d/b2/51899539b6ceeeb420d40ed3cd4b7a40519404f9baf3d4ac99dc413a834b/babel-2.18.0.tar.gz",
              "sha256": "b80b99a14bd085fcacfa15c9165f651fbb3406e66cc603abf11c5750937c992d"
            }
          ]
        },
        {
          "name": "polkit",
          "buildsystem": "meson",
          "config-opts": [
            "-Dlibs-only=true",
            "-Dintrospection=false",
            "-Dauthfw=shadow"
          ],
          "rm-configure": true,
          "build-options": {
            "env": {
              "CFLAGS": "-Wno-implicit-function-declaration"
            }
          },
          "cleanup": [
            "/bin/*",
            "/etc/dbus-1",
            "/etc/pam.d",
            "/include",
            "/lib/pkgconfig",
            "/lib/polkit-1",
            "/share/dbus-1/system-services/*",
            "/share/polkit-1"
          ],
          "sources": [
            {
              "type": "archive",
              "url": "https://github.com/polkit-org/polkit/archive/refs/tags/127.tar.gz",
              "sha256": "9b7bc16f086479dcc626c575976568ba4a85d34297a750d8ab3d2e57f6d8b988"
            }
          ],
          "modules": [
            {
              "name": "ostree",
              "buildsystem": "autotools",
              "config-opts": [
                "--disable-man",
                "--with-curl",
                "--without-libsystemd"
              ],
              "build-options": {
                "env": {
                  "BASH_COMPLETIONSDIR": "/app/share/bash-completion/completions"
                }
              },
              "cleanup": [
                "/bin",
                "/etc/grub.d",
                "/etc/ostree",
                "/share/ostree",
                "/libexec"
              ],
              "sources": [
                {
                  "type": "archive",
                  "url": "https://github.com/ostreedev/ostree/releases/download/v2026.4/libostree-2026.4.tar.xz",
                  "sha256": "b26c9016eb03bb4ee52cc00c642d56e00fc79ae7faac6bf4aa317d7451339ef7"
                }
              ],
              "modules": [
                {
                  "name": "libfuse",
                  "buildsystem": "autotools",
                  "config-opts": [
                    "UDEV_RULES_PATH=/app/etc/udev/rules.d",
                    "INIT_D_PATH=/app/etc/init.d"
                  ],
                  "build-options": {
                    "env": {
                      "MOUNT_FUSE_PATH": "../tmp/"
                    }
                  },
                  "cleanup": [
                    "/bin/ulockmgr_server",
                    "/etc"
                  ],
                  "post-install": [
                    "install -Dpm0755 ./fusermount-wrapper.sh /app/bin/fusermount"
                  ],
                  "sources": [
                    {
                      "type": "archive",
                      "url": "https://github.com/libfuse/libfuse/releases/download/fuse-2.9.9/fuse-2.9.9.tar.gz",
                      "sha256": "d0e69d5d608cc22ff4843791ad097f554dd32540ddc9bed7638cc6fea7c1b4b5"
                    },
                    {
                      "type": "patch",
                      "path": "build-aux/flatpak/fuse-2.9.2-namespace-conflict-fix.patch"
                    },
                    {
                      "type": "patch",
                      "path": "build-aux/flatpak/fuse-disable-sys-mount-under-flatpak.patch"
                    },
                    {
                      "type": "patch",
                      "path": "build-aux/flatpak/fuse-2.9.2-closefrom.patch"
                    },
                    {
                      "type": "file",
                      "path": "build-aux/flatpak/fusermount-wrapper.sh"
                    }
                  ]
                }
              ]
            },
            {
              "name": "xdg-dbus-proxy",
              "buildsystem": "meson",
              "config-opts": [
                "-Dman=disabled",
                "-Dtests=false"
              ],
              "sources": [
                {
                  "type": "archive",
                  "url": "https://github.com/flatpak/xdg-dbus-proxy/releases/download/0.1.8/xdg-dbus-proxy-0.1.8.tar.xz",
                  "sha256": "b6630bd24f8161b0e2546d2acbb014a3b3249f5c0d75f2a863ade898b9034d3d"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "qutestore",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_PREFIX_PATH=/app"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/zachvlat/qutestore.git",
          "tag": "1.0.1",
          "commit": "0e830b71cc08030e068e7d95edf265c9e788e229"
        }
      ]
    }
  ]
}
