{
  "app-id": "io.github.toazd.selah",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "selah",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=ipc",
    "--share=network",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-config/selah:create",
    "--socket=system-bus",
    "--talk-name=org.freedesktop.NetworkManager"
  ],
  "modules": [
    {
      "name": "selah-bundle",
      "buildsystem": "simple",
      "cleanup": [
        "/${FLATPAK_ID}.png",
        "/${FLATPAK_ID}.svg",
        "/${FLATPAK_ID}.desktop",
        "/${FLATPAK_ID}.metainfo.xml",
        "/LICENSE"
      ],
      "build-commands": [
        "install -d ${FLATPAK_DEST}/bin",
        "install -Dm0755 selah ${FLATPAK_DEST}/bin/selah",
        "cp -r lib ${FLATPAK_DEST}/bin/",
        "cp -r data ${FLATPAK_DEST}/bin/",
        "install -Dm0644 ${FLATPAK_ID}.desktop ${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop",
        "install -Dm0644 ${FLATPAK_ID}.metainfo.xml ${FLATPAK_DEST}/share/metainfo/${FLATPAK_ID}.metainfo.xml",
        "install -Dm0644 ${FLATPAK_ID}.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/${FLATPAK_ID}.svg",
        "install -Dm0644 ${FLATPAK_ID}.svg ${FLATPAK_DEST}/share/icons/hicolor/symbolic/apps/${FLATPAK_ID}.svg",
        "install -Dm0644 ${FLATPAK_ID}.png ${FLATPAK_DEST}/share/icons/hicolor/512x512/apps/${FLATPAK_ID}.png",
        "for size in 16 24 32 48 64 128 256; do mkdir -p ${FLATPAK_DEST}/share/icons/hicolor/${size}x${size}/apps/ && ln -s ${FLATPAK_DEST}/share/icons/hicolor/512x512/apps/${FLATPAK_ID}.png ${FLATPAK_DEST}/share/icons/hicolor/${size}x${size}/apps/${FLATPAK_ID}.png; done"
      ],
      "sources": [
        {
          "type": "archive",
          "only-arches": "[ \"x86_64\" ]",
          "url": "https://github.com/toazd/selah/releases/download/v0.7.5-build.85/Selah-0.7.5.tar.gz",
          "sha256": "675f2092f6a9b18cefde844e20dc13a1ed3164781076588e5820e3b478ed4ecb"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/toazd/selah/refs/heads/main/flathub/io.github.toazd.selah/io.github.toazd.selah.desktop",
          "sha256":"366b18e39f5fcada8a06a9c3d9c5a1e0ca4393c45028de224594086a9af626f5",
          "dest-filename": "io.github.toazd.selah.desktop"
        },
        {
          "type": "file",
          "url":"https://github.com/toazd/selah/blob/ae68649c2aae3a1d197bf486e1d909e0ca4e5a95/flathub/io.github.toazd.selah/io.github.toazd.selah.png?raw=true",
          "sha256":"366b18e39f5fcada8a06a9c3d9c5a1e0ca4393c45028de224594086a9af626f5",
          "dest-filename": "io.github.toazd.selah.png"
        },
        {
          "type": "file",
          "url":"https://raw.githubusercontent.com/toazd/selah/refs/heads/main/flathub/io.github.toazd.selah/io.github.toazd.selah.metainfo.xml",
          "sha256":"7a61ffb7bc91611bf755eef72b3c881d6db4114f289b91341c031077835e4b91",
          "dest-filename": "io.github.toazd.selah.metainfo.xml"
        },
        {
          "type": "file",
          "url":"https://raw.githubusercontent.com/toazd/selah/b5e271fcd9ca8c72bdc136c74196cf7dd8c88fa2/flathub/io.github.toazd.selah/io.github.toazd.selah.svg",
          "sha256":"4b1a0124e941897e08d67adbdf517c9a4a5c041f0516fcef47d4a12065994b89",
          "dest-filename": "io.github.toazd.selah.svg"
        },
        {
          "type":"file",
          "url": "https://raw.githubusercontent.com/toazd/selah/refs/heads/main/LICENSE",
          "sha256": "6b0382b16279f26ff69014300541967a356a666eb0b91b422f6862f6b7dad17e",
          "dest-filename": "LICENSE"
        }
      ]
    }
  ]
}
