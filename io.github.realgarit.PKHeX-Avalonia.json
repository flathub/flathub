{
    "app-id": "io.github.realgarit.PKHeX-Avalonia",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.dotnet10"
    ],
    "command": "PKHeX.Avalonia",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--device=dri",
        "--share=network",
        "--env=DOTNET_ROOT=/app/lib/dotnet"
    ],
    "build-options": {
        "prepend-path": "/usr/lib/sdk/dotnet10/bin",
        "append-ld-library-path": "/usr/lib/sdk/dotnet10/lib",
        "env": {
            "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
            "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "true",
            "NUGET_PACKAGES": "/run/build/pkhex-avalonia/nuget-cache"
        }
    },
    "modules": [
        {
            "name": "dotnet",
            "buildsystem": "simple",
            "build-commands": [
                "/usr/lib/sdk/dotnet10/bin/install.sh",
                "install -Dm644 /usr/lib/sdk/dotnet10/share/licenses/org.freedesktop.Sdk.Extension.dotnet10/dotnet-sdk/LICENSE.txt /app/share/licenses/dotnet/LICENSE.txt"
            ]
        },
        {
            "name": "pkhex-avalonia",
            "buildsystem": "simple",
            "build-commands": [
                "dotnet publish PKHeX.Avalonia/PKHeX.Avalonia.csproj -c Release -r linux-x64 --no-self-contained -p:PublishSingleFile=false -p:NuGetAudit=false --source ./nuget-sources --source /usr/lib/sdk/dotnet10/nuget/packages -o /app/lib/pkhex-avalonia",
                "sed -i '/^appstreamcli validate --no-net /d' packaging/flatpak/install-assets.sh",
                "bash packaging/flatpak/install-assets.sh 1.88.0 4337f06881614b409c70429903013de8bf375cfc 2026-10-05",
                "python3 -c 'import pathlib,struct; d=pathlib.Path('\"'\"'PKHeX.Avalonia/Assets/Icons/icon.icns'\"'\"').read_bytes(); p=8\nwhile p<len(d):\n t=d[p:p+4]; n=struct.unpack('\"'\"'>I'\"'\"',d[p+4:p+8])[0]\n if t==b'\"'\"'ic08'\"'\"':\n  out=pathlib.Path('\"'\"'/app/share/icons/hicolor/256x256/apps/io.github.realgarit.PKHeX-Avalonia.png'\"'\"'); out.parent.mkdir(parents=True,exist_ok=True); out.write_bytes(d[p+8:p+n]); break\n p+=n\nelse: raise RuntimeError('\"'\"'Missing original 256px icon'\"'\"')'"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/realgarit/PKHeX-Avalonia/archive/refs/tags/v1.88.0.tar.gz",
                    "sha256": "613571d37c4ebefb6892afe993c14ad7b981bc7d52c35b7f8f6125d14c62a2d6",
                    "strip-components": 1
                },
                "nuget-sources.json"
            ]
        }
    ]
}
