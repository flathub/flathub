  <description>
    <p>
      IronSync is folder synchronization for Linux from Ironwood Apps. Analyze
      before you synchronize, then back up, mirror, move, or two-way merge
      between local paths and network mounts (SMB/CIFS).
    </p>
    <p>
      Profiles stay under your home directory. No account is required for core sync.
    </p>
  </description>
  <launchable type="desktop-id">com.ironwoodapps.IronSync.desktop</launchable>
  <provides>
    <binary>IronSync</binary>
  </provides>
