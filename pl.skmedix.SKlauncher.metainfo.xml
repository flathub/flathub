<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>pl.skmedix.SKlauncher</id>
  <name>SKlauncher</name>
  <summary>Secure and modern Minecraft Launcher</summary>
  <description>
    <p>SKlauncher is a secure and modern Minecraft launcher with a clean, elegant interface. It offers seamless integration of Fabric, Forge, NeoForge and Quilt modloaders, built-in Modrinth/CurseForge modpack support, and a lightweight Delta Updates system.</p>
    <p>Features:</p>
    <ul>
      <li>Built-in modloaders (Fabric, Forge, NeoForge, Quilt)</li>
      <li>Modpack installation via Modrinth and CurseForge</li>
      <li>Lightweight and fast Delta Updates</li>
      <li>Easy skin and cape management</li>
      <li>Multi-language support</li>
      <li>Cross-platform (Windows, Linux, macOS)</li>
    </ul>
  </description>
  <launchable type="desktop-id">pl.skmedix.SKlauncher.desktop</launchable>
