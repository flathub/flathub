{
    "app-id" : "io.github.marcopcabrera.HiFiDvdMaker",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "46",
    "sdk" : "org.gnome.Sdk",
    "command" : "hifidvdmaker",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/bin/freetype-config",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "libdvdread",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://code.videolan.org/videolan/libdvdread/-/archive/7.1.1/libdvdread-7.1.1.tar.bz2",
                    "sha256" : "6dec544f502d7af70c5a8f8f19a49ffe2daca60dbd8fc0b4ffe3597fa791c24c"
                }
            ]
        },
        {
            "name": "freetype-config-wrapper",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/bin",
                "echo '#!/bin/sh' > /app/bin/freetype-config",
                "echo 'exec pkg-config freetype2 \"$@\"' >> /app/bin/freetype-config",
                "chmod +x /app/bin/freetype-config"
            ]
        },
        {
            "name" : "dvdauthor",
            "buildsystem" : "autotools",
            "make-args" : [
                "SUBDIRS=src"
            ],
            "make-install-args" : [
                "SUBDIRS=src"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://downloads.sourceforge.net/dvdauthor/dvdauthor-0.7.2.tar.gz",
                    "sha256" : "3020a92de9f78eb36f48b6f22d5a001c47107826634a785a62dfcd080f612eb7"
                }
            ]
        },
        {
            "name" : "cdrkit",
            "buildsystem" : "cmake",
            "config-opts" : [
                "-DCMAKE_INSTALL_PREFIX=/app",
                "-DCMAKE_C_FLAGS=-fcommon"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://deb.debian.org/debian/pool/main/c/cdrkit/cdrkit_1.1.11.orig.tar.gz",
                    "sha256" : "d1c030756ecc182defee9fe885638c1785d35a2c2a297b4604c0e0dcc78e47da"
                }
            ]
        },
        {
            "name" : "hifidvdmaker",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/marcopcabrera/HiFiDvdMaker.git",
                    "branch" : "main",
                    "commit" : "34df6d1713ec3badd782ab692739545965b17832"
                }
            ]
        }
    ]
}