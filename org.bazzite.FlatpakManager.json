{
    "app-id": "org.bazzite.FlatpakManager",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.8",
    "sdk": "org.kde.Sdk",
    "command": "flatpak-manager-start",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--filesystem=host",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "modules": [
        {
            "name": "pyqt6",
            "buildsystem": "simple",
            "build-options": {
                "build-args": [
                    "--share=network"
                ]
            },
            "build-commands": [
                "pip3 install --prefix=/app PyQt6"
            ]
        },
        {
            "name": "flatpak-manager",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 flatpak_safe_manager.py /app/bin/flatpak_safe_manager.py",
                "chmod +x /app/bin/flatpak_safe_manager.py",
                "install -Dm644 org.bazzite.FlatpakManager.desktop /app/share/applications/org.bazzite.FlatpakManager.desktop",
                "install -Dm644 org.bazzite.FlatpakManager.metainfo.xml /app/share/metainfo/org.bazzite.FlatpakManager.metainfo.xml",
                "install -Dm644 'uninstall icon.png' /app/share/icons/hicolor/256x256/apps/org.bazzite.FlatpakManager.png",
                "echo '#!/bin/sh' > /app/bin/flatpak-manager-start",
                "echo 'python3 /app/bin/flatpak_safe_manager.py \"$@\"' >> /app/bin/flatpak-manager-start",
                "chmod +x /app/bin/flatpak-manager-start"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/LionheartTim/Flatpak-Uninstaller.git",
                    "branch": "main"
                }
            ]
        }
    ]
}
