<!-- Flathub metainfo for org.ankitov.AnkiTov.
     Canonical copy lives in the AnkiTov repo (packaging/flatpak/flathub/) and is
     mirrored into the flathub/flathub submission folder. Bump <releases> on every
     Flathub release. The direct-download bundle uses packaging/flatpak/
     org.ankitov.AnkiTov.appdata.xml (with @VERSION@/@DATE@ placeholders) instead. -->
<component type="desktop-application">
  <id>org.ankitov.AnkiTov</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <name>AnkiTov</name>
  <summary>Self-hosted spaced repetition for classrooms and self-study</summary>
  <developer_name>AnkiTov Project</developer_name>
  <description>
    <p>
      AnkiTov is a spaced-repetition server that runs on your own machine:
      a teacher dashboard, a browser reviewer for students, and an
      Anki-compatible FSRS scheduler over a single SQLite file. No analytics,
      no third-party services, no accounts on someone else's infrastructure.
    </p>
    <p>
      Start it, open http://localhost:5150, claim the teacher account on first
      run, and import the bundled CC0 deck packs. In classroom mode students on
      the same network join from any browser — no installs, no student accounts
      required.
    </p>
    <p>
      AnkiTov reads and writes Anki deck packages (.apkg), schedules reviews
      with the open FSRS algorithm, and ships 28 CC0 seed decks across 13
      languages.
    </p>
  </description>
