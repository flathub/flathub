{
    "app-id": "io.github.gerardoarias.gnote-calendar",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "gnote-calendar",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-documents",
        "--talk-name=org.freedesktop.Notifications"
    ],
    "modules": [
        {
            "name": "gnote-calendar",
            "buildsystem": "simple",
            "build-commands": [
                "make -j$(nproc)",
                "install -Dm755 build/gnote-calendar /app/bin/gnote-calendar",
                "install -Dm755 gui_qt.py /app/share/gnote-calendar/gui_qt.py",
                "install -Dm755 gui.py /app/share/gnote-calendar/gui.py",
                "install -Dm755 legacy/gui_gtk4.py /app/share/gnote-calendar/gui_gtk4.py || true",
                "install -Dm644 data/schema.sql /app/share/gnote-calendar/data/schema.sql",
                "install -Dm644 packaging/gnote-calendar.desktop /app/share/applications/io.github.gerardoarias.gnote-calendar.desktop",
                "install -Dm644 packaging/gnote-calendar.svg /app/share/icons/hicolor/scalable/apps/io.github.gerardoarias.gnote-calendar.svg",
                "install -Dm644 flatpak/io.github.gerardoarias.gnote-calendar.metainfo.xml /app/share/metainfo/io.github.gerardoarias.gnote-calendar.metainfo.xml",
                "install -Dm644 requirements.txt /app/share/gnote-calendar/requirements.txt",
                "pip3 install --prefix=/app --no-build-isolation PySide6==6.7.3 Markdown || true"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/gerardoarias/gnote-calendar",
                    "tag": "v2.0.0",
                    "commit": "a812c42dfa28977931f6f1768f0e9bda4f511acc"
                }
            ]
        }
    ]
}
