<component type="desktop-application">
  <id>com.brave.Origin</id>
  <launchable type="desktop-id">com.brave.Origin.desktop</launchable>
  <name>Brave Origin</name>
  <developer id="com.brave">
    <name>Brave Software</name>
  </developer>
  <summary>Minimalist Brave without the extras</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <url type="homepage">https://brave.com/origin/</url>
  <url type="bugtracker">https://github.com/brave/brave-browser/issues</url>
  <url type="contribute">https://github.com/brave/brave-browser/blob/master/CONTRIBUTING.md</url>
  <url type="help">https://support.brave.com/hc/en-us/articles/38561489788173-What-is-Brave-Origin</url>
  <url type="vcs-browser">https://github.com/brave/brave-browser</url>
  <description>
    <p>Brave Origin is a stripped-down edition of the Brave browser. It keeps Brave's core privacy
      protections, including Shields for blocking ads and trackers, and removes the optional extras
      such as Rewards, Wallet, VPN and the Leo AI assistant.</p>
    <p>Brave Origin keeps its own profile, separate from a regular Brave installation, so both can
      be installed side by side.</p>
  </description>
