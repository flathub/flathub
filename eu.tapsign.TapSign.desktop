[Desktop Entry]
Type=Application
Name=TapSign
Comment=Sign a PDF with your own certificate
Comment[ro]=Semnează un PDF cu certificatul tău
Exec=tapsign %F
Icon=eu.tapsign.TapSign
Terminal=false
Categories=Office;Utility;
MimeType=application/pdf;x-scheme-handler/tapsign;
StartupWMClass=eu.tapsign.TapSign
Keywords=sign;PDF;PAdES;certificate;token;
Actions=sign;

[Desktop Action sign]
Name=Sign with TapSign
Name[ro]=Semnează cu TapSign
Exec=tapsign %F
