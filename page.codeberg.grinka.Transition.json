{
    "id" : "page.codeberg.grinka.Transition",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "transition",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-music",
        "--filesystem=xdg-videos",
        "--filesystem=xdg-download"
    ],
    "modules" : [
        {
            "name" : "Transition",
            "buildsystem" : "simple",
            "build-options" : {
                "append-path" : "/usr/lib/sdk/rust-stable/bin",
                "env" : {
                    "CARGO_HOME": "/run/build/Transition/cargo",
                    "CARGO_NET_OFFLINE": "true",
                    "RUST_BACKTRACE" : "1",
                    "RUST_LOG" : "transition=debug"
                }
            },
            "build-commands": [
                "install -Dm0644 cargo/config .cargo/config.toml",
                "cargo --offline fetch --manifest-path Cargo.toml --verbose",
                "cargo build --offline --release --all-features",
                "install -Dm0755 target/release/transition ${FLATPAK_DEST}/bin/transition",
                "install -Dm0644 data/icons/${FLATPAK_ID}.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/${FLATPAK_ID}.svg",
                "install -Dm0644 data/icons/page.codeberg.grinka.Transition-symbolic.svg ${FLATPAK_DEST}/share/icons/hicolor/symbolic/apps/${FLATPAK_ID}-symbolic.svg",
                "install -Dm0644 data/page.codeberg.grinka.Transition.desktop ${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop",
                "install -Dm0644 data/page.codeberg.grinka.Transition.service ${FLATPAK_DEST}/share/dbus-1/services/${FLATPAK_ID}.service",
                "install -Dm0644 data/page.codeberg.grinka.Transition.metainfo.xml ${FLATPAK_DEST}/share/metainfo/${FLATPAK_ID}.metainfo.xml"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://codeberg.org/grinka/transition.git",
                    "tag": "v2.0",
                    "commit": "c37f2f67127671c3a71f6e2d56ff552480665262"
                },
                "cargo-sources.json"
            ]
        }
    ]
}
