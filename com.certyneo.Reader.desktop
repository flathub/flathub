[Desktop Entry]
Type=Application
Name=Certyneo Reader
GenericName=PDF Reader
Comment=PDF reader and word processor
Exec=certyneo-reader %U
Icon=com.certyneo.Reader
Terminal=false
Categories=Office;Viewer;WordProcessor;
Keywords=pdf;viewer;reader;annotate;redact;form;docx;word;
MimeType=application/pdf;application/vnd.certyneo.writer+json;application/vnd.openxmlformats-officedocument.wordprocessingml.document;
StartupWMClass=Certyneo Reader
X-Flatpak-RenamedFrom=certyneo-reader-desktop.desktop;
