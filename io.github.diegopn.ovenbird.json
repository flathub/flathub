{
    "app-id": "io.github.diegopn.ovenbird",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "separate-locales": false,
    "command": "ovenbird",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "modules": [
        {
            "name": "libpanel",
            "buildsystem": "meson",
            "config-opts": [
                "-Ddocs=disabled",
                "-Dinstall-examples=false",
                "-Dintrospection=disabled",
                "-Dvapi=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libpanel/1.10/libpanel-1.10.4.tar.xz",
                    "sha256": "593888a7691f0af8aaa6e193c9e14afa86a810c0c2f27515c6d813f18733b1cd"
                }
            ]
        },
        {
            "name": "tectonic",
            "buildsystem": "simple",
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/tectonic/cargo"
                }
            },
            "build-commands": [
                "cargo build --offline --locked --release --features external-harfbuzz --bin tectonic",
                "install -Dm755 target/release/tectonic /app/bin/tectonic"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/tectonic-typesetting/tectonic.git",
                    "tag": "tectonic@0.17.0",
                    "commit": "8c0126a9653239a2e6e0a5274af9b8510f643030"
                },
                "tectonic-cargo-sources.json"
            ]
        },
        {
            "name": "poppler",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_CPP_TESTS=OFF",
                "-DBUILD_GTK_TESTS=OFF",
                "-DBUILD_MANUAL_TESTS=OFF",
                "-DENABLE_BOOST=OFF",
                "-DENABLE_CPP=OFF",
                "-DENABLE_GLIB=ON",
                "-DENABLE_GOBJECT_INTROSPECTION=OFF",
                "-DENABLE_GTK_DOC=OFF",
                "-DENABLE_QT5=OFF",
                "-DENABLE_QT6=OFF",
                "-DENABLE_UTILS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://poppler.freedesktop.org/poppler-26.10.0.tar.xz",
                    "sha256": "6792cb7c69205007ad87d2e936cecc5b3a31fac29ab54ffc3175fdb6b2a6ce35"
                }
            ]
        },
        {
            "name": "ovenbird",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/diegopn/ovenbird.git",
                    "tag": "v0.2.0",
                    "commit": "5e74a58c56a2d6d316488b80253e9a90b4bb1257"
                },
                {
                    "type": "patch",
                    "path": "metainfo-screenshots.patch"
                }
            ],
            "config-opts": [
                "-Dbuildtype=release"
            ]
        }
    ]
}
