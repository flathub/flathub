{
  "app-id": "io.github.NeooMir.Pole",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "pole",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/pole/cargo"
    }
  },
  "modules": [
    {
      "name": "pole",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/NeooMir/Pole",
          "tag": "v1.3.0",
          "commit": "d610fa1e454731ecc67146823e739b42ca3b9c26"
        },
        {
          "type": "git",
          "url": "https://github.com/NeooMir/PyPole",
          "tag": "v1.0.1",
          "commit": "d8221a06707bd74c7411fbb864c66b4c1ee3f6b1",
          "dest": "python"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
