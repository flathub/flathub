#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Open Couch
Name[pt_BR]=Open Couch
Comment=Switch the display layout between desktop and TV/couch mode, and control Steam Big Picture
Comment[pt_BR]=Alterna o layout de telas entre desktop e TV/sala, e controla o modo Big Picture da Steam
Icon=io.github.gustavobelo.opencouch
Exec=opencouch
Terminal=false
Categories=Game;Utility;
Keywords=steam;bigpicture;couch;tv;monitor;display;kscreen;
StartupNotify=true
X-Flatpak=io.github.gustavobelo.opencouch
