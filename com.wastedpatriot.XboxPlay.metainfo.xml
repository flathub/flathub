  <name>XboxPlay</name>
  <summary>Xbox remote play and xCloud on Linux</summary>
  <developer id="com.wastedpatriot">
    <name>WastedPatriot</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>Play your Xbox and Xbox Cloud Gaming in a window, with a controller or the keyboard and mouse.</p>
    <p>Not affiliated with Microsoft. You need your own Xbox account.</p>
  </description>
  <launchable type="desktop-id">com.wastedpatriot.XboxPlay.desktop</launchable>
