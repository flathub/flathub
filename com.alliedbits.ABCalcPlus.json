{
  "app-id": "com.alliedbits.ABCalcPlus",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "abcalc",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "abcalc",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/abcalc",
        "install -m 755 abcalc /app/lib/abcalc/abcalc",
        "find . -maxdepth 1 -name '*.dll' -exec install -m 644 {} /app/lib/abcalc/ \\;",
        "find . -maxdepth 1 -name '*.so' -exec install -m 755 {} /app/lib/abcalc/ \\;",
        "install -Dm755 abcalc-launcher /app/bin/abcalc",
        "install -Dm644 com.alliedbits.ABCalcPlus.desktop /app/share/applications/com.alliedbits.ABCalcPlus.desktop",
        "install -Dm644 abcalc.png /app/share/icons/hicolor/256x256/apps/com.alliedbits.ABCalcPlus.png",
        "install -Dm644 com.alliedbits.ABCalcPlus.metainfo.xml /app/share/metainfo/com.alliedbits.ABCalcPlus.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/com.alliedbits.ABCalcPlus/LICENSE"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://alliedbits.com/downloads/abcalc-1.5.2-linux-x86_64.tar.gz",
          "sha256": "6bf11bb2143990b31d434985a05bc3e46c631b38cb7d3a8edc906aa4984f14b2",
          "strip-components": 1,
          "only-arches": [
            "x86_64"
          ]
        },
        {
          "type": "script",
          "dest-filename": "abcalc-launcher",
          "commands": [
            "#!/bin/sh",
            "exec /app/lib/abcalc/abcalc \"$@\""
          ]
        },
        {
          "type": "file",
          "path": "com.alliedbits.ABCalcPlus.desktop"
        },
        {
          "type": "file",
          "path": "com.alliedbits.ABCalcPlus.metainfo.xml"
        }
      ]
    }
  ]
}
