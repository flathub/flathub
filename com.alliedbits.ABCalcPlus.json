{
  "app-id": "com.alliedbits.ABCalcPlus",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "abcalc",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "abcalc",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 abcalc /app/lib/abcalc",
        "install -Dm755 abcalc-launcher /app/bin/abcalc",
        "install -Dm755 *.so /app/lib/",
        "install -Dm644 com.alliedbits.ABCalcPlus.desktop /app/share/applications/com.alliedbits.ABCalcPlus.desktop",
        "install -Dm644 abcalc.png /app/share/icons/hicolor/256x256/apps/com.alliedbits.ABCalcPlus.png",
        "install -Dm644 com.alliedbits.ABCalcPlus.metainfo.xml /app/share/metainfo/com.alliedbits.ABCalcPlus.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/com.alliedbits.ABCalcPlus/LICENSE"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://alliedbits.com/files/abcalc-1.5.5-linux-x86_64.tar.gz",
          "sha256": "e2ea480f8f1f11a5901fcb0741fb19b005b16ab7dd72b6510f6112afe244304c",
          "strip-components": 1,
          "only-arches": [
            "x86_64"
          ]
        },
        {
          "type": "archive",
          "url": "https://alliedbits.com/files/abcalc-1.5.5-linux-aarch64.tar.gz",
          "sha256": "ab5b2df0fed3ada660228d50a6b0a0b006320d3f4d98c6684f0aa01fc69fdd0a",
          "strip-components": 1,
          "only-arches": [
            "aarch64"
          ]
        },
        {
          "type": "script",
          "dest-filename": "abcalc-launcher",
          "commands": [
            "exec /app/lib/abcalc \"$@\""
          ]
        }
      ]
    }
  ]
}
