{
  "app-id": "com.alliedbits.ABCalcPlus",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "abcalc",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "abcalc",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 abcalc /app/lib/abcalc/abcalc",
        "install -Dm755 abcalc-launcher /app/bin/abcalc",
        "install -Dm755 *.so /app/lib/abcalc/",
        "install -Dm644 com.alliedbits.ABCalcPlus.desktop /app/share/applications/com.alliedbits.ABCalcPlus.desktop",
        "install -Dm644 abcalc.png /app/share/icons/hicolor/256x256/apps/com.alliedbits.ABCalcPlus.png",
        "install -Dm644 com.alliedbits.ABCalcPlus.metainfo.xml /app/share/metainfo/com.alliedbits.ABCalcPlus.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/com.alliedbits.ABCalcPlus/LICENSE"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://alliedbits.com/files/abcalc-1.5.5-linux-x86_64.tar.gz",
          "sha256": "495b6b7ef1e29f3f33dcc1499fe1c2eaba297e040102fb35eeceb9503a2f1f12",
          "strip-components": 1,
          "only-arches": [
            "x86_64"
          ]
        },
        {
          "type": "archive",
          "url": "https://alliedbits.com/files/abcalc-1.5.5-linux-aarch64.tar.gz",
          "sha256": "34f50ecaad458d9e9d8bdd9c11e6ecdeb85b656e3f82779b564f4f68200e6dd1",
          "strip-components": 1,
          "only-arches": [
            "aarch64"
          ]
        },
        {
          "type": "script",
          "dest-filename": "abcalc-launcher",
          "commands": [
            "export LD_LIBRARY_PATH=/app/lib/abcalc:$LD_LIBRARY_PATH",
            "cd /app/lib/abcalc",
            "exec ./abcalc \"$@\""
          ]
        },
        {
          "type": "file",
          "path": "com.alliedbits.ABCalcPlus.metainfo.xml"
        },
        {
          "type": "file",
          "path": "com.alliedbits.ABCalcPlus.desktop"
        }
      ]
    }
  ]
}
