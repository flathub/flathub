{
  "app-id": "com.alliedbits.ABCalcPlus",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "abcalc",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "abcalc",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 apply_extra /app/bin/apply_extra",
        "install -Dm755 abcalc-launcher /app/bin/abcalc",
        "install -Dm644 com.alliedbits.ABCalcPlus.desktop /app/share/applications/com.alliedbits.ABCalcPlus.desktop",
        "install -Dm644 abcalc.png /app/share/icons/hicolor/256x256/apps/com.alliedbits.ABCalcPlus.png",
        "install -Dm644 com.alliedbits.ABCalcPlus.metainfo.xml /app/share/metainfo/com.alliedbits.ABCalcPlus.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/com.alliedbits.ABCalcPlus/LICENSE"
      ],
      "sources": [
        {
          "type": "extra-data",
          "filename": "abcalc.tar.gz",
          "url": "https://alliedbits.com/files/abcalc-1.5.3-linux-x86_64.tar.gz",
          "sha256": "9f6bf79159b583793a0991be654a27e2979c4c44e379d887877647ce0a72a281",
          "size": 61800172,
          "only-arches": [
            "x86_64"
          ]
        },
        {
          "type": "extra-data",
          "filename": "abcalc.tar.gz",
          "url": "https://alliedbits.com/files/abcalc-1.5.3-linux-aarch64.tar.gz",
          "sha256": "f8085319e515fb527bb7ffc217d41f24f855b5f11657248fb014da20f8acd61a",
          "size": 59417678,
          "only-arches": [
            "aarch64"
          ]
        },
        {
          "type": "script",
          "dest-filename": "apply_extra",
          "commands": [
            "tar xzf abcalc.tar.gz --strip-components=1",
            "rm abcalc.tar.gz"
          ]
        },
        {
          "type": "script",
          "dest-filename": "abcalc-launcher",
          "commands": [
            "export LD_LIBRARY_PATH=/app/extra:$LD_LIBRARY_PATH",
            "exec /app/extra/abcalc \"$@\""
          ]
        },
        {
          "type": "file",
          "path": "com.alliedbits.ABCalcPlus.desktop"
        },
        {
          "type": "file",
          "path": "com.alliedbits.ABCalcPlus.metainfo.xml"
        },
        {
          "type": "file",
          "path": "abcalc.png"
        },
        {
          "type": "file",
          "path": "LICENSE"
        }
      ]
    }
  ]
}
