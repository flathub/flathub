{
    "id" : "top.akizip.akizip",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "akizip",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        "formats/7-zip.yml"
        ,
        {
            "name" : "akizip",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "tag": "0.1.0",
                    "commit":"96ddb50714d4e4caadb4e39f84c7359cdf136c35",
                    "url" : "https://github.com/akizip/akizip"
                }
            ]
        }
    ]
}
