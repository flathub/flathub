{
    "id" : "top.akizip.akizip",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "akizip",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name": "7-zip",
            "buildsystem": "simple",
            "build-commands": [
                "for bundle in Alone2 SFXCon; do\npushd CPP/7zip/Bundles/${bundle}\nmake -j ${FLATPAK_BUILDER_N_JOBS} -f ../../cmpl_gcc.mak\npopd\ndone",
                "install -Dm755 CPP/7zip/Bundles/Alone2/b/g/7zz   /app/bin/7zz"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/ip7z/7zip.git",
                    "tag": "26.01",
                    "commit": "8c63d71ff886bda90c86db28466287f977374237",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ]
        },
        {
            "name" : "akizip",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "tag": "0.1.0",
                    "commit":"96ddb50714d4e4caadb4e39f84c7359cdf136c35",
                    "url" : "https://github.com/akizip/akizip"
                }
            ]
        }
    ]
}
