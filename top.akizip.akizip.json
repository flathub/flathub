{
    "id" : "top.akizip.akizip",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "akizip",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "7zip",
            "buildsystem" : "simple",
            "build-commands" : [
                "tar -xf 7z2601-linux-x64.tar.xz",
                "install -Dm755 7zz /app/bin/7zz",
                "install -Dm755 7zzs /app/bin/7zzs"
            ],
            "sources" : [
                {
                    "type" : "file",
                    "url" : "https://github.com/ip7z/7zip/releases/download/26.01/7z2601-linux-x64.tar.xz",
                    "sha256" : "8ea0fc8a135e7b848e80a4116fe22dff56c8c4518dde1f43cce67f4e340b437a"
                }
            ]
        },
        {
            "name" : "akizip",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "tag": "0.1.0",
                    "commit":"96ddb50714d4e4caadb4e39f84c7359cdf136c35",
                    "url" : "https://github.com/akizip/akizip"
                }
            ]
        }
    ]
}
