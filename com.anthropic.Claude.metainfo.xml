<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.anthropic.Claude</id>
  <name>Claude</name>
  <summary>Chat and code with Anthropic's AI</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <developer id="com.anthropic">
    <name>Anthropic</name>
  </developer>
  <description>
    <p>
      Desktop app for Claude, Anthropic's AI assistant. Chat, Cowork and
      Claude Code in one window: parallel sessions, visual diff review, an
      integrated terminal and editor, and live app preview.
    </p>
    <p>
      A claude.ai account is required. Sign-in tokens are stored in the
      system keyring, so a Secret Service provider such as GNOME Keyring or
      KWallet must be available.
    </p>
    <p>
      NOTE: This package is not verified by, affiliated with, or supported
      by Anthropic, PBC. It installs the official Linux build, downloaded
      from Anthropic's repository at install time.
    </p>
  </description>
  <launchable type="desktop-id">com.anthropic.Claude.desktop</launchable>
  <url type="homepage">https://claude.ai</url>
  <url type="help">https://support.claude.com</url>
  <url type="vcs-browser">https://github.com/jforman96/claude-desktop-flatpak</url>
  <url type="bugtracker">https://github.com/jforman96/claude-desktop-flatpak/issues</url>
  <content_rating type="oars-1.1"/>
  <branding>
    <color type="primary" scheme_preference="light">#e8c4b0</color>
    <color type="primary" scheme_preference="dark">#8a4a2f</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/jforman96/claude-desktop-flatpak/main/screenshots/main.png</image>
      <caption>Chat with Claude</caption>
    </screenshot>
  </screenshots>
  <keywords>
    <keyword>AI</keyword>
    <keyword>assistant</keyword>
    <keyword>chat</keyword>
    <keyword>Claude Code</keyword>
    <keyword>LLM</keyword>
  </keywords>
  <releases>
    <release version="1.18286.2" date="2026-07-07"/>
  </releases>
</component>
