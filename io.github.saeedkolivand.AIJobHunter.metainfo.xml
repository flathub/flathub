<!--
  AppStream metadata for the Flathub listing. Flathub's appstreamcli
  validation REQUIRES a non-empty <releases> element (there is no
  generate-from-git-tags support) — the entry below is a placeholder kept in
  sync with the resolved release tag by release.yml's `update-flathub` job
  (same sed step that pins the manifest's `tag:`), not hand-edited per release.
-->
<component type="desktop-application">
  <id>io.github.saeedkolivand.AIJobHunter</id>
  <name>AI Job Hunter</name>
  <summary>AI-powered job search and application assistant</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <developer id="io.github.saeedkolivand">
    <name>Saeed Kolivand</name>
  </developer>
  <url type="homepage">https://aijobhunter.app</url>
  <url type="vcs-browser">https://github.com/saeedkolivand/ai-job-hunter-app</url>
  <url type="bugtracker">https://github.com/saeedkolivand/ai-job-hunter-app/issues</url>
  <description>
    <p>
      AI Job Hunter finds, scores, and helps you apply to jobs — résumé tailoring,
      cover letters, application tracking, and job-board scraping, running locally
      with your choice of AI provider, including fully offline via Ollama.
    </p>
    <p>Features:</p>
    <ul>
      <li>Job-board scraping and matching across major ATS platforms</li>
      <li>AI-tailored résumé and cover-letter generation, multiple templates</li>
      <li>Application tracking with a saved → applied → offer pipeline</li>
      <li>A companion browser extension for one-click job import</li>
      <li>Local-first: your résumé and application data never leave the device
        except to the AI provider or job board you configure</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.saeedkolivand.AIJobHunter.desktop</launchable>
  <screenshots>
