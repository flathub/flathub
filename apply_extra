#!/bin/sh
# Runs at flatpak INSTALL time from /app/bin/apply_extra, with the working
# directory set to /app/extra (where flatpak downloaded the payload tarball).
#
# The payload is a plain .tar.gz (not the AppImage): flatpak runs this script
# in a minimal sandbox with /proc disabled, and the AppImage runtime needs
# /proc/self/exe to self-extract — GNU tar does not, so it works here.
#
# Extracts usr/bin/justice plus usr/lib/justice/bundled-mods/justice/.
set -e

tar -xzf justice.tar.gz
rm -f justice.tar.gz
