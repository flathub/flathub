#!/bin/bash
# Runs on first install when the manifest uses type: extra-data for the Linux dist tarball.
set -euo pipefail
install -d "${FLATPAK_DEST}/opt/sibir"
tar --zstd -xf "${FLATPAK_DEST}/extra/sibir-linux-amd64.tar.zst" -C "${FLATPAK_DEST}/opt/sibir"
chmod +x "${FLATPAK_DEST}/opt/sibir/Sibir.x86_64" || true
