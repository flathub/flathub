#!/bin/sh
# Runs once at install time, in the sandbox. Unpacks the downloaded AppImage (Qt is inside it) next to the app.
# The AppImage's own extractor does not work here (it needs /proc/self/exe), so the squashfs part is unpacked
# with unsquashfs. It starts right after the ELF header tables of the small runtime in front of it.
set -e
offset=$(python3 -c "
import struct
h = open('shoebill.AppImage', 'rb').read(64)
shoff, = struct.unpack_from('<Q', h, 0x28)
entsize, num = struct.unpack_from('<HH', h, 0x3A)
print(shoff + entsize * num)")
/app/bin/unsquashfs -no-progress -d shoebill -o "$offset" shoebill.AppImage > /dev/null
rm -f shoebill.AppImage
