#!/bin/sh
# Flatpak runs this in /app/extra after downloading the proprietary app archive.
# The metadata is installed during the build; only the app is extracted here.
set -eu
archive=netmode.tar.gz
test -f "$archive"
tar -xzf "$archive" --no-same-owner
test -x NetMode/bin/NetMode
test -r NetMode/lib/app/NetMode.cfg
test -f NetMode/lib/runtime/lib/server/libjvm.so
rm -- "$archive"
