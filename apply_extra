#!/bin/sh
# Körs EN gång vid installation, i en sandlåda utan nätverk, med den hämtade
# filen i arbetskatalogen (som blir /app/extra i den installerade appen).
set -e

tar -xf unipersonal.tar.gz
rm -f unipersonal.tar.gz

# Körbara bitar tappar sina rättigheter om arkivet packas om på vägen.
chmod +x UniPersonal.Desktop unipersonal-clipboard
chmod +x CefGlueBrowserProcess/Xilium.CefGlue.BrowserProcess
