{
    "app-id": "com.cyberkoalastudios.calls",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "base": "org.electronjs.Electron2.BaseApp",
    "base-version": "20.08",
    "command": "ccalls",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--share=network",
        "--filesystem=home:rw",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=com.canonical.AppMenu.Registrar",
        "--device=dri",
        "--socket=pulseaudio"
    ],
    "modules": [
        {
            "name": "ccalls",
            "buildsystem": "simple",
            "build-commands": [
                "npm install --production",
                "cp -r * /app/"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/CyberKoalaStudios/calls-releases.git",
                    "tag": "2.7.4",
                    "commit": "26f63ce1d6e056b8abe44ed15bb4d38ea754793b"
                }
            ]
        }
    ]
}
