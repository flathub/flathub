{
    "app-id": "org.ankitov.AnkiTov",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "ankitov-launch",
    "finish-args": [
        "--share=network"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "append-ld-library-path": "/usr/lib/sdk/rust-stable/lib",
        "env": {
            "CARGO_HOME": "/run/build/ankitov/cargo"
        }
    },
    "modules": [
        {
            "name": "ankitov",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release --offline --locked",
                "install -Dm755 target/release/backend /app/bin/backend",
                "install -Dm755 packaging/launch/ankitov-launch.sh /app/bin/ankitov-launch",
                "install -Dm644 backend/config/production.yaml /app/bin/config/production.yaml",
                "mkdir -p /app/bin/content/seed",
                "cp -R content/seed/packages /app/bin/content/seed/",
                "install -Dm644 packaging/flatpak/org.ankitov.AnkiTov.desktop /app/share/applications/org.ankitov.AnkiTov.desktop",
                "install -Dm644 org.ankitov.AnkiTov.metainfo.xml /app/share/metainfo/org.ankitov.AnkiTov.metainfo.xml",
                "install -Dm644 icons/org.ankitov.AnkiTov-64.png /app/share/icons/hicolor/64x64/apps/org.ankitov.AnkiTov.png",
                "install -Dm644 icons/org.ankitov.AnkiTov-128.png /app/share/icons/hicolor/128x128/apps/org.ankitov.AnkiTov.png",
                "install -Dm644 icons/org.ankitov.AnkiTov-256.png /app/share/icons/hicolor/256x256/apps/org.ankitov.AnkiTov.png"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/yitzhakbg/AnkiTov.git",
                    "tag": "v0.6.0",
                    "commit": "f62147e883467b3768841021cdb73725296e71f0",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v0\\.[0-9.]+$"
                    }
                },
                "cargo-sources.json",
                {
                    "type": "file",
                    "path": "org.ankitov.AnkiTov.metainfo.xml"
                },
                {
                    "type": "dir",
                    "path": "icons",
                    "dest": "icons"
                }
            ]
        }
    ]
}
