<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <metadata_license>MIT</metadata_license>
    <id>io.github.bacmanni.jellytune</id>
    <name>JellyTune</name>
    <summary>Gnome audio client for Jellyfin</summary>
    <url type="homepage">https://github.com/bacmanni/jellytune</url>
    <project_license>GPL-3.0-or-later</project_license>
    <content_rating type="oars-1.1" />

    <developer id="io.github.bacmanni">
        <name>Joni Bäckström</name>
    </developer>

    <launchable type="desktop-id">io.github.bacmanni.jellytune.desktop</launchable>

    <description>
        <p>My idea is to have native Gnome app for Jellyfin that is also fully supported for mobile devices. Nothing more, nothing less. So simple audio player. That means no massive edit functionality and no video playback. Main focus is on audio. My wish is to use this on my mobile Linux device at some point.</p>
    </description>

    <!-- Freedesktop Categories -->
    <categories>
        <category>AudioVideo</category>
    </categories>

    <keywords>
        <keyword translate="no">Jellyfin</keyword>
        <keyword translate="no">Gnome</keyword>
        <keyword>audioplayer</keyword>
        <keyword>audio</keyword>
        <keyword>music</keyword>
    </keywords>

