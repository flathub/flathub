<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.cbsalgo.CBSChat</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>CBSChat</name>
  <summary>Chat, voice and video for teams and communities</summary>
  <summary xml:lang="tr">Ekipler ve topluluklar için sohbet, sesli ve görüntülü görüşme</summary>
  <developer id="com.cbsalgo">
    <name>CBSAlgo Inc.</name>
  </developer>
  <description>
    <p>CBSChat is a messaging app for teams and communities, running on our own servers at cbschat.com.</p>
    <ul>
      <li>Servers with text and voice channels</li>
      <li>Direct messages and group chats</li>
      <li>Voice and video calls with screen sharing</li>
      <li>Sign in with your e-mail and a one-time code</li>
      <li>No ads and no tracking</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.cbsalgo.CBSChat.desktop</launchable>
  <url type="homepage">https://cbschat.com</url>
  <url type="help">https://cbschat.com/indir</url>
  <branding>
    <color type="primary" scheme_preference="light">#c7d2fe</color>
    <color type="primary" scheme_preference="dark">#312e81</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <caption>Text channels in a community server</caption>
      <image>https://cbschat.com/flatpak/screenshots/cbschat-chat-1.png</image>
    </screenshot>
    <screenshot>
      <caption>Sign in with your e-mail</caption>
      <image>https://cbschat.com/flatpak/screenshots/cbschat-login-1.png</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
    <category>Chat</category>
  </categories>
  <keywords>
    <keyword>chat</keyword>
    <keyword>messaging</keyword>
    <keyword>voice</keyword>
    <keyword>video</keyword>
  </keywords>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>
