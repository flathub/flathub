<component type="desktop-application">
  <id>com.prelora.desktop</id>
  <name>Prelora</name>
  <summary>GTD tasks and live timers</summary>
  <developer id="com.prelora">
    <name>TGC Network LLC</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://prelora.app/terms/</project_license>
  <url type="homepage">https://prelora.app/</url>
  <url type="help">https://prelora.app/</url>
  <url type="bugtracker">mailto:privacy@prelora.app</url>
  <description>
    <p>
      Prelora helps you capture, clarify, and finish work on your own machine.
      It combines a GTD-style task hub with live countdown timers in one calm
      desktop app — local-first, with encrypted data at rest.
    </p>
    <p>Tasks</p>
    <ul>
      <li>Inbox, Next, Scheduled, Someday, and Focus lists</li>
      <li>Search across lists, recurring tasks, and Trash with restore</li>
    </ul>
    <p>Timers &amp; reminders</p>
    <ul>
      <li>Multiple live countdown timers (pause, extend, relaunch, dismiss)</li>
      <li>Month-grid reminders with repeating schedules and an upcoming list</li>
    </ul>
    <p>Local-first</p>
    <ul>
      <li>Your data stays on the device by default</li>
      <li>Export, backup, and delete controls in Settings → Data</li>
      <li>Linux packages: AppImage, .deb, and Flatpak</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.prelora.desktop.desktop</launchable>
  <provides>
    <binary>prelora-desktop</binary>
  </provides>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>
  <categories>
    <category>Office</category>
    <category>Utility</category>
    <category>ProjectManagement</category>
  </categories>
  <content_rating type="oars-1.1" />
