{
  "id": "io.github.almightynan.Spool",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "spool",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=cups"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/spool/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "cleanup": ["/share/doc"],
  "modules": [
    {
      "name": "spool",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked --offline -p spool",
        "install -Dm755 target/release/spool /app/bin/spool",
        "install -Dm644 data/io.github.almightynan.Spool.desktop /app/share/applications/io.github.almightynan.Spool.desktop",
        "install -Dm644 data/io.github.almightynan.Spool.metainfo.xml /app/share/metainfo/io.github.almightynan.Spool.metainfo.xml",
        "install -Dm644 data/icons/hicolor/scalable/apps/io.github.almightynan.Spool.svg /app/share/icons/hicolor/scalable/apps/io.github.almightynan.Spool.svg",
        "install -Dm644 data/icons/hicolor/symbolic/apps/io.github.almightynan.Spool-symbolic.svg /app/share/icons/hicolor/symbolic/apps/io.github.almightynan.Spool-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/almightynan/spool.git",
          "path": "v0.1.0",
          "commit": "8b51526fd508638ec8e0cb5bc191106daa5d786a"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
