{
    "app-id": "com.blynq.app",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "Blynq",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--device=all",
        "--filesystem=home",
        "--talk-name=org.freedesktop.Notifications",
        "--share=network"
    ],
    "modules": [
        {
            "name": "blynq",
            "buildsystem": "simple",
            "build-commands": [
                "arx x extra-data.tar.gz || tar -xzf extra-data.tar.gz",
                "install -D Blynq /app/bin/Blynq",
                "install -D com.blynq.app.desktop /app/share/applications/com.blynq.app.desktop",
                "install -D com.blynq.app-128.png /app/share/icons/hicolor/128x128/apps/com.blynq.app.png",
                "install -D com.blynq.app-512.png /app/share/icons/hicolor/512x512/apps/com.blynq.app.png",
                "install -D com.blynq.app.metainfo.xml /app/share/metainfo/com.blynq.app.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "extra-data",
                    "filename": "extra-data.tar.gz",
                    "url": "https://github.com/Krzysiek-Mistrz/Blynq-releases/releases/download/v1.0.0/Blynq-linux-x64.tar.gz",
                    "sha256": "85467a7882b765cbf4727ed99f14d363793074620d266846091631915123ccfb",
                    "size": 42428748
                }
            ]
        }
    ]
}
