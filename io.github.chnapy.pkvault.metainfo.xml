<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>io.github.chnapy.pkvault</id>

  <!-- old ID used locally before flathub publish -->
  <replaces>
    <id>org.chnapy.pkvault</id>
  </replaces>
  <provides>
    <id>org.chnapy.pkvault</id>
  </provides>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <launchable type="desktop-id">io.github.chnapy.pkvault.desktop</launchable>

  <name>PKVault</name>
  <name xml:lang="fr">PKVault</name>
  <name xml:lang="de">PKVault</name>
  <name xml:lang="pt_BR">PKVault</name>

  <summary>Pokemon storage and save manipulation tool based on PKHeX</summary>
  <summary xml:lang="fr">Outil de stockage et de manipulation de sauvegardes Pokémon basé sur PKHeX</summary>
  <summary xml:lang="de">Pokémon-Aufbewahrungs- und Speicherbearbeitungswerkzeug basierend auf PKHeX</summary>
  <summary xml:lang="pt_BR">Ferramenta de armazenamento e manipulação de saves de Pokémon baseada em PKHeX</summary>

  <description>
    <p>
      PKVault is a Pokemon storage and save manipulation tool based on PKHeX.
      Edit your save files, manage your collection, transfer Pokémon between games and more.
    </p>
    <p xml:lang="fr">
      PKVault est un outil de stockage et de manipulation de sauvegardes Pokémon basé sur PKHeX.
      Modifiez vos fichiers de sauvegarde, gérez votre collection, transférez des Pokémon entre les jeux, etc.
    </p>
    <p xml:lang="de">
      PKVault ist ein Pokémon-Aufbewahrungs- und Speicherbearbeitungswerkzeug basierend auf PKHeX.
      Bearbeiten Sie Ihre Speicherdateien, verwalten Sie Ihre Sammlung, übertragen Sie Pokémon zwischen Spielen und mehr.
    </p>
    <p xml:lang="pt_BR">
      PKVault é uma ferramenta de armazenamento e manipulação de saves de Pokémon baseada em PKHeX.
      Edite seus arquivos de save, gerencie sua coleção, transfira Pokémon entre jogos e muito mais.
    </p>
  </description>

  <categories>
    <category>Utility</category>
    <category>Game</category>
  </categories>

  <keywords>
    <keyword>pokemon</keyword>
    <keyword>pkhex</keyword>
    <keyword>save</keyword>
    <keyword>storage</keyword>
    <keyword>editor</keyword>
    <keyword>collection</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>gamepad</control>
