{
  "app-id": "fr.dwightstudio.TypeForMe",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "type-for-me",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "type-for-me",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/type-for-me/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm 755 target/release/type-for-me -t /app/bin/",
        "install -Dm 644 rsc/fr.dwightstudio.TypeForMe.svg /app/share/icons/hicolor/scalable/apps/fr.dwightstudio.TypeForMe.svg",
        "install -Dm 644 rsc/fr.dwightstudio.TypeForMe-symbolic.svg /app/share/icons/hicolor/symbolic/apps/fr.dwightstudio.TypeForMe-symbolic.svg",
        "msgfmt --xml --template rsc/fr.dwightstudio.TypeForMe.metainfo.xml -d po -o fr.dwightstudio.TypeForMe.metainfo.xml",
        "install -Dm 644 fr.dwightstudio.TypeForMe.metainfo.xml /app/share/metainfo/fr.dwightstudio.TypeForMe.metainfo.xml",
        "msgfmt --desktop --template rsc/fr.dwightstudio.TypeForMe.desktop -d po -o fr.dwightstudio.TypeForMe.desktop",
        "desktop-file-install --dir=/app/share/applications fr.dwightstudio.TypeForMe.desktop"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Dwight-Studio/type-for-me.git",
          "tag": "v1.0.0",
          "commit": "035af340336fb74178446bff2ebc8ef5ea65bc18"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
