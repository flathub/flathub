{
    "app-id": "io.github.adrianandin0.PaintNotNet",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.7",
    "sdk": "org.kde.Sdk",
    "base": "com.riverbankcomputing.PyQt.BaseApp",
    "base-version": "6.7",
    "command": "paintnotnet",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home"
    ],
    "modules": [
        "python3-requirements.json",
        {
            "name": "paintnotnet",
            "buildsystem": "simple",
            "build-commands": [
                "install -d /app/bin",
                "install -d /app/share/PaintNotNet",
                "cp -r * /app/share/PaintNotNet/",
                "echo '#!/bin/sh' > /app/bin/paintnotnet",
                "echo 'exec python3 /app/share/PaintNotNet/main.py \"$@\"' >> /app/bin/paintnotnet",
                "chmod +x /app/bin/paintnotnet",
                "install -D -m 644 io.github.adrianandin0.PaintNotNet.desktop /app/share/applications/io.github.adrianandin0.PaintNotNet.desktop",
                "install -D -m 644 io.github.adrianandin0.PaintNotNet.metainfo.xml /app/share/metainfo/io.github.adrianandin0.PaintNotNet.metainfo.xml",
                "install -D -m 644 gui/icono.png /app/share/icons/hicolor/128x128/apps/io.github.adrianandin0.PaintNotNet.png"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/adrianandin0/PaintNotNet.git",
                    "branch": "main"
                },
                {
                    "type": "file",
                    "path": "io.github.adrianandin0.PaintNotNet.desktop"
                },
                {
                    "type": "file",
                    "path": "io.github.adrianandin0.PaintNotNet.metainfo.xml"
                }
            ]
        }
    ]
}
