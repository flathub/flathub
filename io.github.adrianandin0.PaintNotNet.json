{
    "app-id": "io.github.adrianandin0.PaintNotNet",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "base": "com.riverbankcomputing.PyQt.BaseApp",
    "base-version": "6.11",
    "command": "paintnotnet",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=network"
    ],
    "modules": [
        {
            "name": "python3-numpy",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"numpy>=1.24.0\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/15/72/2cebe04758e1123f625ed3221cb3c48602175ad619dd9b47de69689b4656/numpy-2.1.0-cp313-cp313-manylinux_2_17_x86_64.manylinux2014_x86_64.whl",
                    "sha256": "0ab32eb9170bf8ffcbb14f11613f4a0b108d3ffee0832457c5d4808233ba8977"
                }
            ]
        },
        {
            "name": "python3-opencv-python-headless",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"opencv-python-headless>=4.8.0\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/15/72/2cebe04758e1123f625ed3221cb3c48602175ad619dd9b47de69689b4656/numpy-2.1.0-cp313-cp313-manylinux_2_17_x86_64.manylinux2014_x86_64.whl",
                    "sha256": "0ab32eb9170bf8ffcbb14f11613f4a0b108d3ffee0832457c5d4808233ba8977"
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/2b/97/8170e9819764c47e436c130d3ff6cfb73b58f923eae9d3a03d8982b04aec/opencv_python_headless-5.0.0.93-cp37-abi3-manylinux2014_x86_64.manylinux_2_17_x86_64.whl",
                    "sha256": "09a872a157c1376ab922a69bbf22f9a95bcc7b658a9d8b436a60212b02b2eeb4"
                }
            ]
        },
        {
            "name": "paintnotnet",
            "buildsystem": "simple",
            "build-commands": [
                "install -d /app/bin",
                "install -d /app/share/PaintNotNet",
                "cp -r * /app/share/PaintNotNet/",
                "echo '#!/bin/sh' > /app/bin/paintnotnet",
                "echo 'cd /app/share/PaintNotNet' >> /app/bin/paintnotnet",
                "echo 'exec python3 main.py \"$@\"' >> /app/bin/paintnotnet",
                "chmod +x /app/bin/paintnotnet",
                "install -D -m 644 flatpak/io.github.adrianandin0.PaintNotNet.desktop /app/share/applications/io.github.adrianandin0.PaintNotNet.desktop",
                "install -D -m 644 flatpak/io.github.adrianandin0.PaintNotNet.metainfo.xml /app/share/metainfo/io.github.adrianandin0.PaintNotNet.metainfo.xml",
                "install -D -m 644 gui/icono.png /app/share/icons/hicolor/512x512/apps/io.github.adrianandin0.PaintNotNet.png"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/adrianandin0/PaintNotNet.git",
                    "commit": "aeacafe98b87c457c51b5d49c9a9f73391d3b125"
                }
            ]
        }
    ]
}
