<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.lighttable.LightTable</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>LightTable</name>
  <summary>Edit photographs and simulate photographic film</summary>
  <developer id="app.lighttable">
    <name>Nicholas Reville</name>
  </developer>
  <description>
    <p>LightTable is a digital darkroom for RAW photographs, with non-destructive editing and film simulation.</p>
    <p>Organize photographs, adjust light and color, apply local masks, compare edits, and export finished images. Film controls model film stocks, development, photographic paper, and scanning.</p>
  </description>
  <launchable type="desktop-id">app.lighttable.LightTable.desktop</launchable>
  <url type="homepage">https://lighttable.app/</url>
  <url type="bugtracker">https://github.com/reville/lighttable-digital-darkroom/issues</url>
  <url type="help">https://lighttable.app/features.html</url>
  <url type="vcs-browser">https://github.com/reville/lighttable-digital-darkroom</url>
