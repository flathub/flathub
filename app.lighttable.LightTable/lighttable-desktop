#!/bin/sh
set -eu
# Flatpak supplies private XDG data/config/cache directories. XDG_STATE_HOME
# is not supplied by all supported Flatpak versions, so anchor it explicitly.
: "${XDG_DATA_HOME:?Flatpak XDG_DATA_HOME is required}"
: "${XDG_RUNTIME_DIR:?Flatpak XDG_RUNTIME_DIR is required}"
export XDG_STATE_HOME="$XDG_DATA_HOME/state"
export LIGHTTABLE_INSTANCE_DIR="$XDG_RUNTIME_DIR/app/app.lighttable.LightTable/instances"
export GTK_USE_PORTAL=1
export PYTHONNOUSERSITE=1
exec /app/LightTable/bin/lighttable-desktop "$@"
