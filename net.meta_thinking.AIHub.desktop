[Desktop Entry]
Type=Application
Name=AI Hub
GenericName=AI Gateway
Comment=Run an OpenAI-compatible API gateway over your own AI subscriptions
# The wrapper from the manifest, which restores XDG_CONFIG_HOME before execing
# the Tauri binary (/app/bin/AIHub in the self-built bundle, /app/extra/bin/AIHub
# under Flathub). Launching the binary directly would skip that and silently
# break the Connections feature. flatpak rewrites this line to a `flatpak run`
# invocation when it exports the file. Shared by both manifests.
Exec=ai-hub
# Renamed from Tauri's own icon at install time: flatpak only exports icons
# named for the app id.
Icon=net.meta_thinking.AIHub
Terminal=false
Categories=Development;Network;
Keywords=AI;LLM;OpenAI;Gateway;Proxy;API;Gemini;Claude;Codex;
# GTK takes WM_CLASS from the program name, and the program the window actually
# belongs to is the execed binary — AIHub — not the `ai-hub` wrapper. Get
# this wrong and the shell treats the window as an unknown app: no icon in the
# dock, and the tray item does not associate with it.
StartupWMClass=AIHub
StartupNotify=true
X-GNOME-UsesNotifications=false
