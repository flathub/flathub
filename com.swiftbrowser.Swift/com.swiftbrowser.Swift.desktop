[Desktop Entry]
Name=Swift
GenericName=Web Browser
Exec=swift-browser %U
TryExec=swift-browser
Terminal=false
Type=Application
Icon=com.swiftbrowser.Swift
StartupWMClass=Swift
Comment=The browser that moves at your speed.
Categories=Network;WebBrowser;
Keywords=web;browser;privacy;fast;tracker;blocker;
MimeType=text/html;text/plain;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
