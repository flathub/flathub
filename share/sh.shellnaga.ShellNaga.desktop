[Desktop Entry]
Type=Application
Version=1.5
Name=Shell'Naga
Name[es]=Shell'Naga
Name[pt_BR]=Shell'Naga
GenericName=Terminal and SSH client
GenericName[es]=Terminal y cliente SSH
GenericName[pt_BR]=Terminal e cliente SSH
Comment=Fast terminal and SSH client with tabs, split panes, SFTP and serial
Comment[es]=Terminal y cliente SSH rápido con pestañas, paneles divididos, SFTP y serie
Comment[pt_BR]=Terminal e cliente SSH rápido com abas, painéis divididos, SFTP e serial
Keywords=terminal;console;shell;ssh;sftp;serial;telnet;mosh;tmux;
Keywords[es]=terminal;consola;shell;ssh;sftp;serie;telnet;mosh;tmux;
Keywords[pt_BR]=terminal;console;shell;ssh;sftp;serial;telnet;mosh;tmux;
Exec=shellnaga
Icon=sh.shellnaga.ShellNaga
Terminal=false
StartupNotify=true
StartupWMClass=sh.shellnaga.ShellNaga
Categories=System;TerminalEmulator;
Actions=NewWindow;QuickConnect;

[Desktop Action NewWindow]
Name=New Window
Name[es]=Nueva ventana
Name[pt_BR]=Nova janela
Exec=shellnaga --new-window

[Desktop Action QuickConnect]
Name=Connect…
Name[es]=Conectar…
Name[pt_BR]=Conectar…
Exec=shellnaga --quick-connect
