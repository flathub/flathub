<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>group.vir.delam</id>
  <metadata_license>MIT</metadata_license>
  <project_license>proprietary</project_license>

  <name>Delam To</name>
  <summary>Collaborative task tracker for teams</summary>

  <description>
    <p>
      Delam To is a cross-platform task manager designed for small teams and
      individuals. Create projects, assign tasks, track progress with priorities
      and due dates, attach photos and geo-locations, communicate via comments —
      all synced in real time across devices.
    </p>
    <p>Key features:</p>
    <ul>
      <li>Projects with member invites and role management</li>
      <li>Tasks with priorities, due dates and geo-location pins</li>
      <li>Real-time comments with photo/video/audio attachments</li>
      <li>Push notifications for task updates and mentions</li>
      <li>Offline-first with automatic sync</li>
      <li>Available in Ukrainian, English, Russian and Czech</li>
    </ul>
  </description>

  <launchable type="desktop-id">group.vir.delam.desktop</launchable>

  <url type="homepage">https://delam.vir.group</url>
  <url type="bugtracker">https://delam.vir.group</url>
  <url type="help">https://delam.vir.group</url>

  <developer id="group.vir">
    <name>Vir Group</name>
  </developer>

  <provides>
    <binary>delam</binary>
  </provides>

  <releases>
    <release version="0.1.0" date="2026-08-10">
      <description>
        <p>Initial public release.</p>
        <ul>
          <li>Projects, tasks, comments and media attachments</li>
          <li>Mastodon OAuth authentication</li>
          <li>Real-time notifications</li>
          <li>Geo-location task pins with OpenStreetMap</li>
          <li>Invite members via shareable links</li>
        </ul>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">moderate</content_attribute>
    <content_attribute id="social-info">moderate</content_attribute>
  </content_rating>

  <screenshots>
    <screenshot type="default">
      <caption>Dashboard with project list</caption>
    </screenshot>
  </screenshots>

  <keywords>
    <keyword>task</keyword>
    <keyword>project</keyword>
    <keyword>tracker</keyword>
    <keyword>team</keyword>
    <keyword>todo</keyword>
    <keyword>collaboration</keyword>
  </keywords>
</component>
