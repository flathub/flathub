{
  "id": "io.github.Lib_LOCALE.Calculatrice",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "calculatrice",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--env=WEBKIT_DISABLE_DMABUF_RENDERER=1"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/calculatrice/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "modules": [
    {
      "name": "calculatrice",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --release --manifest-path src-tauri/Cargo.toml",
        "install -Dm0755 src-tauri/target/release/calculatrice /app/bin/calculatrice",
        "install -Dm0644 flatpak/io.github.Lib_LOCALE.Calculatrice.desktop /app/share/applications/io.github.Lib_LOCALE.Calculatrice.desktop",
        "install -Dm0644 flatpak/io.github.Lib_LOCALE.Calculatrice.metainfo.xml /app/share/metainfo/io.github.Lib_LOCALE.Calculatrice.metainfo.xml",
        "install -Dm0644 src-tauri/icons/icon.svg /app/share/icons/hicolor/scalable/apps/io.github.Lib_LOCALE.Calculatrice.svg",
        "install -Dm0644 src-tauri/icons/32x32.png /app/share/icons/hicolor/32x32/apps/io.github.Lib_LOCALE.Calculatrice.png",
        "install -Dm0644 src-tauri/icons/64x64.png /app/share/icons/hicolor/64x64/apps/io.github.Lib_LOCALE.Calculatrice.png",
        "install -Dm0644 src-tauri/icons/128x128.png /app/share/icons/hicolor/128x128/apps/io.github.Lib_LOCALE.Calculatrice.png",
        "install -Dm0644 src-tauri/icons/128x128@2x.png /app/share/icons/hicolor/256x256/apps/io.github.Lib_LOCALE.Calculatrice.png",
        "install -Dm0644 src-tauri/icons/icon.png /app/share/icons/hicolor/512x512/apps/io.github.Lib_LOCALE.Calculatrice.png"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Lib-LOCALE/calculatrice.git",
          "commit": "bc9c4eb0bb6dbd20f236f7131a344a256aaf3e4c"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
