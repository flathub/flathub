<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.kaiterm.KaiTerm</id>

  <name>KaiTerm</name>

  <summary>Terminal manager for SSH, MOSH, SFTP, FTP, and local shells</summary>

  <developer id="dev.kaiterm">
    <name>KaiTerm Developers</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://kaiterm.dev</project_license>

  <description>
    <p>
      KaiTerm is a desktop connection manager for SSH-heavy workflows. It combines an xterm.js terminal workspace with a searchable connection tree, reusable secrets, scripted actions, local backup/restore tools, and optional KaiTerm Pro features for clusters, startup automation, advanced connection workflows, and encrypted sync.
    </p>
  </description>

  <launchable type="desktop-id">
    dev.kaiterm.KaiTerm.desktop
  </launchable>

  <releases>
    <release version="1.0.1" date="2026-07-14"/>
    <release version="1.0.0" date="2026-07-13"/>
  </releases>

