#!/bin/sh
# com.kitkarl.VideoSquisher launcher — same recipe as the AppImage AppRun:
# prefer X11/xcb (the most compatible path on XWayland and ordinary
# desktops; the user can still override with QT_QPA_PLATFORM), and put the
# bundled xcb/ffmpeg libraries first on the loader path.
HERE=/app/VideoSquisher
export LD_LIBRARY_PATH="$HERE/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ -n "$DISPLAY" ] && [ -z "$QT_QPA_PLATFORM" ]; then
  export QT_QPA_PLATFORM=xcb
fi
exec "$HERE/VideoSquisher" "$@"
