#!/bin/sh
# HenshinLogos Flatpak launcher (Flathub / extra-data build)
set -e

VERSION="5.1"
USER_APP="$HOME/.local/share/henshinlogos"
SOURCE="/app/extra/HenshinLogos"

# Seed / update the writable per-user copy on first run or version change.
if [ ! -d "$USER_APP" ] || [ ! -f "$USER_APP/.henshinlogos-version" ] || [ "$(cat "$USER_APP/.henshinlogos-version" 2>/dev/null)" != "$VERSION" ]; then
    mkdir -p "$USER_APP"
    cp -a "$SOURCE"/. "$USER_APP"/
    printf '%s' "$VERSION" > "$USER_APP/.henshinlogos-version"
fi

cd "$USER_APP"
exec "$USER_APP/HenshinLogos" "$@"
