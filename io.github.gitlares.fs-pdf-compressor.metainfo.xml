<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gitlares.fs-pdf-compressor</id>
  <name>FS PDF Compressor</name>
  <summary>Compress PDF files locally, without uploading them</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <developer id="io.github.gitlares">
    <name>Daniel Lares</name>
  </developer>
  <description>
    <p>FS PDF Compressor is a desktop utility that reduces PDF file sizes entirely on your own machine. No document is uploaded: compression runs locally with Ghostscript.</p>
    <ul>
      <li>Compress one PDF, several PDFs, or a folder</li>
      <li>Choose Balanced, Preserve, or Maximum compression</li>
      <li>Optionally keep the original files</li>
      <li>Works without an account, advertising, or telemetry</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.gitlares.fs-pdf-compressor.desktop</launchable>
  <categories>
    <category>Utility</category>
    <category>Office</category>
  </categories>
  <url type="homepage">https://gitlares.github.io/fs-pdf-compressor/</url>
