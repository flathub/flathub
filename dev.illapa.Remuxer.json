{
    "id": "dev.illapa.Remuxer",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "remuxer",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        "ffmpeg.yaml",
        "python3-requirements.json",
        {
            "name": "remuxer",
            "builddir": true,
            "buildsystem": "meson",
            "config-opts": [],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/bymoxb/remuxer.git",
                    "tag": "v1.0.0",
                    "commit": "8fcbe66ccb56d136907a1f9c75065c1ed04c9a68",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([0-9]+\\.[0-9]+\\.[0-9]+)$"
                    }
                }
            ]
        }
    ],
    "build-options": {
        "env": {}
    }
}