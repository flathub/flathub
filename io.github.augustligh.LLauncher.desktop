[Desktop Entry]
Name=LLauncher
Comment=Unofficial Arknights: Endfield launcher for Linux
Comment[ru]=Неофициальный лаунчер Arknights: Endfield для Linux
Exec=llauncher
Icon=io.github.augustligh.LLauncher
Terminal=false
Type=Application
Categories=Game;
Keywords=endfield;arknights;launcher;proton;wine;
StartupWMClass=llauncher
Actions=play;

[Desktop Action play]
Name=Launch Arknights: Endfield
Name[ru]=Запустить Arknights: Endfield
Exec=llauncher --play
Icon=io.github.augustligh.LLauncher
