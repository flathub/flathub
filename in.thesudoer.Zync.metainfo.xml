<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>in.thesudoer.Zync</id>
  <launchable type="desktop-id">in.thesudoer.Zync.desktop</launchable>
  <name>Zync</name>
  <developer id="in.thesudoer">
    <name>Zync</name>
  </developer>
  <summary>Native SSH workspace for terminals, files, vault, and tunnels</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <url type="homepage">https://zync.thesudoer.in</url>
  <url type="bugtracker">https://github.com/zync-sh/zync/issues</url>
  <url type="vcs-browser">https://github.com/zync-sh/zync</url>
  <content_rating type="oars-1.1" />
  <categories>
    <category>Network</category>
    <category>RemoteAccess</category>
    <category>TerminalEmulator</category>
  </categories>
  <keywords>
    <keyword>SSH</keyword>
    <keyword>terminal</keyword>
    <keyword>SFTP</keyword>
    <keyword>remote</keyword>
    <keyword>devops</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#4F46E5</color>
    <color type="primary" scheme_preference="dark">#6366F1</color>
  </branding>
  <recommends>
    <display_length compare="ge">360</display_length>
  </recommends>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <description>
    <p>
      Zync is a fast, native SSH workspace: manage hosts, keep terminals alive,
      browse remote files, forward ports, and store credentials in a local vault.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://zync.thesudoer.in/og.png</image>
      <caption>Zync SSH workspace overview</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="2.22.5" date="2026-08-10">
      <description>
        <p>Latest GitHub release packaged as Flatpak from the official .deb.</p>
      </description>
    </release>
  </releases>
  <update_contact>hello@thesudoer.in</update_contact>
</component>
