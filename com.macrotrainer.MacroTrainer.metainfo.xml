<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.macrotrainer.MacroTrainer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <name>Macro Trainer</name>
  <summary>Privacy-first macro tracking</summary>
  <developer id="com.macrotrainer">
    <name>Nick Hirras</name>
  </developer>

  <description>
    <p>
      Macro Trainer is a privacy-first macro tracking application. Track your
      daily nutrition and calories locally on your device — no subscriptions,
      no cloud syncing, no ads. The Linux build is free.
    </p>
    <p>Features:</p>
    <ul>
      <li>Log meals against a large built-in food database, entirely offline</li>
      <li>Daily macro and calorie dashboard</li>
      <li>AI coaching that adjusts your plan as you go</li>
      <li>Intermittent fasting timer</li>
      <li>Body weight and progress tracking charts</li>
      <li>Your data stays on your device</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.macrotrainer.MacroTrainer.desktop</launchable>
  <content_rating type="oars-1.1" />

  <url type="homepage">https://macrotrainer.com</url>
  <url type="contact">https://macrotrainer.com</url>

  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </recommends>

  <screenshots>
    <screenshot type="default">
      <image>https://macrotrainer.com/screenshots/linux/01-today-dashboard.png</image>
      <caption>Today view: daily macros, coach suggestions, and activity at a glance</caption>
    </screenshot>
    <screenshot>
      <image>https://macrotrainer.com/screenshots/linux/02-meal-logging.png</image>
      <caption>Log meals with detailed macros from the built-in food database</caption>
    </screenshot>
    <screenshot>
      <image>https://macrotrainer.com/screenshots/linux/03-workout-logging.png</image>
      <caption>Guided workout logging with sets, reps, and weights</caption>
    </screenshot>
    <screenshot>
      <image>https://macrotrainer.com/screenshots/linux/04-progress-charts.png</image>
      <caption>Weight, lean mass, and body fat trends across your program</caption>
    </screenshot>
    <screenshot>
      <image>https://macrotrainer.com/screenshots/linux/05-coaching-hub.png</image>
      <caption>Coaching Hub with suggested plan adjustments</caption>
    </screenshot>
    <screenshot>
      <image>https://macrotrainer.com/screenshots/linux/06-coach-chat.png</image>
      <caption>Chat with your AI coach, running entirely on your device</caption>
    </screenshot>
  </screenshots>

  <releases>
