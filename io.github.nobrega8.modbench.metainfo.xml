<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata of the Flatpak (the Flathub page). Flathub's bot adds a
     <release> for each new release. -->
<component type="desktop-application">
  <id>io.github.nobrega8.modbench</id>
  <name>Modbench</name>
  <summary>Test Modbus devices over TCP, RTU and ASCII</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.nobrega8">
    <name>Afonso Nóbrega</name>
  </developer>
  <launchable type="desktop-id">io.github.nobrega8.modbench.desktop</launchable>
  <provides>
    <binary>modbench</binary>
    <binary>modbench-cli</binary>
    <mediatype>text/x-mbmap</mediatype>
    <mediatype>application/x-mbsim</mediatype>
  </provides>

  <description>
    <p>
      Modbench is a lightweight Modbus client. Test any address by hand, or
      open a device map and read every register by name, already scaled, with
      units and labels.
    </p>
    <ul>
      <li>Manual requests with any function code, over serial RTU or ASCII, Modbus TCP or UDP, or RTU over TCP or UDP</li>
      <li>Device maps: registers by name with types, byte and word order, scaling, units, bit fields and state labels, and over 400 shared maps to download</li>
      <li>A map builder to write a map from a device's manual, with checks on each register while you type</li>
      <li>Checks a device against its map and reports it as a printable page</li>
      <li>Safe writes: typed controls, limits from the map and a read-only mode</li>
      <li>Charts, raw frames, logs and CSV recordings</li>
      <li>Finds unit IDs, serial settings and the registers that answer</li>
      <li>A simulator of several Modbus devices, with values that change on their own</li>
      <li>A command line tool, modbench-cli, and an MCP server for AI assistants</li>
    </ul>
    <p>
      To use serial adapters, the user may need to be in the dialout group.
    </p>
  </description>

