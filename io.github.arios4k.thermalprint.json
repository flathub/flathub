{
  "app-id": "io.github.arios4k.thermalprint",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "thermalprint",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=cups"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "/share/doc",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "cups-client",
      "buildsystem": "simple",
      "build-commands": [
        "./configure --prefix=/app --libdir=/app/lib --with-components=libcups --with-tls=gnutls --with-dnssd=avahi --disable-dbus --disable-pam --disable-gssapi --disable-libusb --disable-static --with-domainsocket=/run/cups/cups.sock",
        "make -C cups libs -j${FLATPAK_BUILDER_N_JOBS}",
        "make -C cups install-libs",
        "make -C systemv lp lpstat lpoptions -j${FLATPAK_BUILDER_N_JOBS}",
        "install -Dm755 systemv/lp systemv/lpstat systemv/lpoptions -t /app/bin",
        "install -Dm644 LICENSE -t /app/share/licenses/io.github.arios4k.thermalprint/cups"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/OpenPrinting/cups/releases/download/v2.4.20/cups-2.4.20-source.tar.gz",
          "sha256": "ab4d9cd7f3e58060091d2b24972223d6401675f11c49b65abf4f6ef31dea22ff"
        }
      ]
    },
    {
      "name": "poppler-data",
      "buildsystem": "simple",
      "build-commands": [
        "make install prefix=/app",
        "install -Dm644 COPYING COPYING.adobe COPYING.gpl2 -t /app/share/licenses/io.github.arios4k.thermalprint/poppler-data"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://poppler.freedesktop.org/poppler-data-0.4.12.tar.gz",
          "sha256": "c835b640a40ce357e1b83666aabd95edffa24ddddd49b8daff63adb851cdab74"
        }
      ]
    },
    {
      "name": "poppler",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DENABLE_UTILS=ON",
        "-DENABLE_CPP=OFF",
        "-DENABLE_GLIB=OFF",
        "-DENABLE_QT5=OFF",
        "-DENABLE_QT6=OFF",
        "-DENABLE_GOBJECT_INTROSPECTION=OFF",
        "-DENABLE_NSS3=OFF",
        "-DENABLE_GPGME=OFF",
        "-DENABLE_LIBCURL=OFF",
        "-DENABLE_BOOST=OFF",
        "-DBUILD_MANUAL_TESTS=OFF"
      ],
      "post-install": [
        "install -Dm644 COPYING COPYING3 -t /app/share/licenses/io.github.arios4k.thermalprint/poppler"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://poppler.freedesktop.org/poppler-26.10.0.tar.xz",
          "sha256": "6792cb7c69205007ad87d2e936cecc5b3a31fac29ab54ffc3175fdb6b2a6ce35"
        }
      ]
    },
    {
      "name": "thermalprint",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/thermalprint/cargo"
        }
      },
      "build-commands": [
        "cargo --offline build --release --locked",
        "install -Dm755 target/release/thermalprint /app/bin/thermalprint",
        "install -Dm644 data/io.github.arios4k.thermalprint.desktop -t /app/share/applications",
        "install -Dm644 data/io.github.arios4k.thermalprint.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 data/org.thermalprint.ThermalPrint.svg /app/share/icons/hicolor/scalable/apps/io.github.arios4k.thermalprint.svg",
        "install -Dm644 data/org.thermalprint.ThermalPrint.png /app/share/icons/hicolor/256x256/apps/io.github.arios4k.thermalprint.png",
        "install -Dm644 LICENSE -t /app/share/licenses/io.github.arios4k.thermalprint/thermalprint"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/arios4k/thermalprint/archive/b328576e17dd09490f3c42c1fabf29a719bb073f.tar.gz",
          "sha256": "dd0a4af9fa785e17029171e72e3c54d3c37880268e022f0de3a4f7547ec6351f"
        },
        "cargo-sources.json"
      ]
    }
  ],
  "x-packaging-provenance": "AI-assisted packaging; Cargo sources generated with flatpak-builder-tools."
}
