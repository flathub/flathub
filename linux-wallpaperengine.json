{
  "name": "linux-wallpaperengine",
  "modules": [
    {
      "name": "glew",
      "no-autogen": true,
      "make-args": [
        "SYSTEM=linux-egl",
        "GLEW_PREFIX=/app",
        "GLEW_DEST=/app",
        "LIBDIR=/app/lib",
        "BINDIR=/app/bin",
        "INCDIR=/app/include/GL"
      ],
      "make-install-args": [
        "SYSTEM=linux-egl",
        "GLEW_PREFIX=/app",
        "GLEW_DEST=/app",
        "LIBDIR=/app/lib",
        "BINDIR=/app/bin",
        "INCDIR=/app/include/GL"
      ],
      "cleanup": [
        "/bin",
        "/include",
        "/lib/pkgconfig",
        "/lib/*.a"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/nigels-com/glew/releases/download/glew-2.3.1/glew-2.3.1.tgz",
          "sha256": "b64790f94b926acd7e8f84c5d6000a86cb43967bd1e688b03089079799c9e889"
        },
        {
          "type": "shell",
          "commands": [
            "sed -i 's|lib64|lib|g' config/Makefile.linux config/Makefile.linux-egl"
          ]
        }
      ]
    },
    {
      "name": "glu",
      "buildsystem": "meson",
      "config-opts": [
        "-Dgl_provider=glvnd"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://archive.mesa3d.org/glu/glu-9.0.3.tar.xz",
          "sha256": "bd43fe12f374b1192eb15fe20e45ff456b9bc26ab57f0eee919f96ca0f8a330f"
        }
      ]
    },
    {
      "name": "freeglut",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DFREEGLUT_BUILD_DEMOS=OFF",
        "-DFREEGLUT_BUILD_STATIC_LIBS=OFF",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/freeglut/freeglut/releases/download/v3.6.0/freeglut-3.6.0.tar.gz",
          "sha256": "9c3d4d6516fbfa0280edc93c77698fb7303e443c1aaaf37d269e3288a6c3ea52"
        }
      ],
      "build-options": {
        "cflags": "-std=gnu17"
      }
    },
    {
      "name": "libass",
      "config-opts": [
        "--disable-static"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/*.la"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/libass/libass/releases/download/0.17.3/libass-0.17.3.tar.xz",
          "sha256": "eae425da50f0015c21f7b3a9c7262a910f0218af469e22e2931462fed3c50959"
        }
      ]
    },
    {
      "name": "libplacebo",
      "buildsystem": "meson",
      "config-opts": [
        "-Ddemos=false",
        "-Dvulkan=disabled",
        "-Dtests=false"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://code.videolan.org/videolan/libplacebo.git",
          "tag": "v7.349.0",
          "commit": "1fd3c7bde7b943fe8985c893310b5269a09b46c5"
        }
      ]
    },
    {
      "name": "mpv",
      "buildsystem": "meson",
      "config-opts": [
        "-Dlibmpv=true",
        "-Dcplayer=false",
        "-Dlua=disabled",
        "-Djavascript=disabled",
        "-Dmanpage-build=disabled",
        "-Dhtml-build=disabled",
        "-Dpdf-build=disabled"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/mpv-player/mpv.git",
          "tag": "v0.40.0",
          "commit": "e48ac7ce08462f5e33af6ef9deeac6fa87eef01e"
        }
      ]
    },
    {
      "name": "glfw",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=ON",
        "-DGLFW_BUILD_EXAMPLES=OFF",
        "-DGLFW_BUILD_TESTS=OFF",
        "-DGLFW_BUILD_DOCS=OFF"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/glfw/glfw/releases/download/3.4/glfw-3.4.zip",
          "sha256": "b5ec004b2712fd08e8861dc271428f048775200a2df719ccf575143ba749a3e9"
        }
      ]
    },
    {
      "name": "glm",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/include && cp -r glm /app/include/",
        "find /app/include/glm -name '*.txt' -delete"
      ],
      "cleanup": [
        "/include/glm"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/g-truc/glm/archive/refs/tags/1.0.1.tar.gz",
          "sha256": "9f3174561fd26904b23f0db5e560971cbf9b3cbda0b280f04d5c379d03bf234c"
        }
      ]
    },
    {
      "name": "engine",
      "buildsystem": "simple",
      "build-options": {
        "no-debuginfo": true,
        "strip": true
      },
      "build-commands": [
        "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=/app -DBUILD_TESTING=OFF -DENABLE_GLSLANG_BINARIES=OFF -DSPIRV_CROSS_CLI=OFF -DSPIRV_CROSS_ENABLE_TESTS=OFF",
        "cmake --build build --target linux-wallpaperengine",
        "install -d /app/lib/linux-wallpaperengine /app/bin",
        "cd build/output && cp -a linux-wallpaperengine liblinux-wallpaperengine-lib.so libcef.so libEGL.so libGLESv2.so libvk_swiftshader.so vk_swiftshader_icd.json icudtl.dat v8_context_snapshot.bin *.pak locales /app/lib/linux-wallpaperengine/",
        "install -Dm644 build/cef/cef_binary_135.0.17+gcbc1c5b+chromium-135.0.7049.52_linux64_minimal/LICENSE.txt /app/share/licenses/io.github.diode701.NyaaPaper/cef/LICENSE.txt",
        "install -Dm644 build/cef/cef_binary_135.0.17+gcbc1c5b+chromium-135.0.7049.52_linux64_minimal/CREDITS.html /app/share/licenses/io.github.diode701.NyaaPaper/cef/CREDITS.html",
        "ln -s ../lib/linux-wallpaperengine/linux-wallpaperengine /app/bin/linux-wallpaperengine"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/diode701/nyaa-wallpaperengine.git",
          "commit": "5956411e0aebf0009f176b2b9638e6ca1de4d72d"
        },
        {
          "type": "archive",
          "url": "https://cef-builds.spotifycdn.com/cef_binary_135.0.17%2Bgcbc1c5b%2Bchromium-135.0.7049.52_linux64_minimal.tar.bz2",
          "sha256": "24ac1980e62be7b1aea2c337d6bd4bc770dccd8b37e47c6db94b397f13ec4dc6",
          "dest": "build/cef/cef_binary_135.0.17+gcbc1c5b+chromium-135.0.7049.52_linux64_minimal"
        }
      ]
    }
  ]
}
