{
  "app-id": "io.github.mhosseinab.clipdeck",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "clipdeck-launcher",
  "finish-args": [
    "--socket=x11",
    "--share=ipc",
    "--socket=pulseaudio",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--env=CLIPDECK_FORCE_X11=1"
  ],
  "modules": [
    {
      "name": "clipdeck",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/clipdeck/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo build --frozen --release --manifest-path=apps/linux/Cargo.toml --package clipdeck-app",
        "install -Dm755 apps/linux/target/release/clipdeck /app/bin/clipdeck",
        "install -Dm755 clipdeck-launcher /app/bin/clipdeck-launcher",
        "install -Dm644 apps/linux/crates/app/assets/io.github.mhosseinab.clipdeck.desktop /app/share/applications/io.github.mhosseinab.clipdeck.desktop",
        "desktop-file-edit --set-key=Exec --set-value=clipdeck-launcher /app/share/applications/io.github.mhosseinab.clipdeck.desktop",
        "install -Dm644 apps/linux/crates/app/assets/icon.png /app/share/icons/hicolor/256x256/apps/io.github.mhosseinab.clipdeck.png",
        "install -Dm644 apps/linux/crates/app/assets/io.github.mhosseinab.clipdeck.metainfo.xml /app/share/metainfo/io.github.mhosseinab.clipdeck.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/clipdeck/LICENSE",
        "install -Dm644 apps/linux/crates/app/assets/fonts/OFL.txt /app/share/licenses/clipdeck/OFL-Roboto.txt"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/mhosseinab/clipdeck.git",
          "commit": "e80e346fec85e1cbcb6b34b94a32341e5786536b"
        },
        "cargo-sources.json",
        {
          "type": "file",
          "path": "clipdeck-launcher"
        }
      ]
    }
  ]
}
