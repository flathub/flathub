  <id>io.github.Zerocool66612.macaque-dock</id>

  <name>Macaque Dock</name>
  <summary>A macOS-inspired dock for KDE Plasma 6 and Wayland</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="io.github.zerocool66612">
    <name>Drew Owen</name>
