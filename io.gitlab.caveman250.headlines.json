{
	"app-id": "io.gitlab.caveman250.headlines",
	"runtime": "org.gnome.Platform",
	"runtime-version": "51",
	"sdk": "org.gnome.Sdk",
	"command": "headlines",
	"finish-args": [
		"--share=network",
		"--share=ipc",
		"--socket=wayland",
		"--socket=fallback-x11",
		"--socket=pulseaudio",
		"--device=dri",
		"--env=GST_PLUGIN_FEATURE_RANK=v4l2h264dec:NONE"
	],
	"cleanup": [
		"/include",
		"/lib/*/include",
		"/lib/pkgconfig",
		"/share/pkgconfig",
		"/share/aclocal",
		"/man",
		"/share/man",
		"/share/info",
		"/share/gtk-doc",
		"*.la",
		"*.a"
	],
	"modules": [
		{
			"name": "jsoncpp",
			"buildsystem": "meson",
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/open-source-parsers/jsoncpp.git",
					"tag": "1.9.6",
					"commit": "89e2973c754a9c02a49974d839779b151e95afd6"
				}
			]
		},
		{
			"name": "headlines",
			"buildsystem": "cmake-ninja",
			"config-opts": [
				"-DFLATPAK_BUILD=ON",
				"-DDIST_BUILD=ON",
				"-DCMAKE_BUILD_TYPE=RelWithDebInfo"
			],
			"sources": [
				{
					"type": "git",
					"url": "https://gitlab.com/caveman250/headlines",
					"tag": "0.8.0",
					"commit": "de139879772a666ee4d80397da8cc1da0c8d302e"
				}
			]
		}
	]
}
