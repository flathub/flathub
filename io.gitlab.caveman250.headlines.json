{
  "app-id": "io.gitlab.caveman250.headlines",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "headlines",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets"
  ],
  "cleanup": [
    "/include",
    "/lib/*/include",
    "/lib/pkgconfig",
    "/share/pkgconfig",
    "/share/aclocal",
    "/man",
    "/share/man",
    "/share/info",
    "/share/gtk-doc",
    "*.la",
    "*.a"
  ],
  "add-extensions": {
    "org.freedesktop.Platform.ffmpeg-full": {
      "directory": "lib/ffmpeg",
      "version": "24.08",
      "add-ld-path": "."
    }
  },
  "cleanup-commands": [
    "mkdir -p ${FLATPAK_DEST}/lib/ffmpeg"
  ],
  "modules": [
    {
      "name": "jsoncpp",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/open-source-parsers/jsoncpp.git",
          "tag": "1.9.6"
        }
      ]
    },
    {
      "name": "headlines",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DFLATPAK_BUILD=ON",
        "-DDIST_BUILD=ON",
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.com/caveman250/headlines",
          "tag": "0.8.0"
        }
      ]
    }
  ]
}