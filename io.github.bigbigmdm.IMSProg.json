{
    "app-id": "io.github.bigbigmdm.IMSProg",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.9",
    "sdk": "org.kde.Sdk",
    "command": "IMSProg",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=all",
        "--filesystem=host",
        "--share=network"
    ],
    "modules": [
        {
            "name": "libusb",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-static"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libusb/libusb/releases/download/v1.0.30/libusb-1.0.30.tar.bz2",
                    "sha256": "fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf"
                }
            ]
        },
        {
            "name": "libftdi",
            "buildsystem": "cmake",
            "config-opts": [
                "-DLIBFTDI_STATIC_LIBS=OFF",
                "-DFTDI_EEPROM=OFF",
                "-DLIB_SUFFIX="
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.intra2net.com/en/developer/libftdi/download/libftdi1-1.5.tar.bz2",
                    "sha256": "7c7091e9c86196148bd41177b4590dccb1510bfe6cea5bf7407ff194482eb049"
                }
            ]
        },
    {
            "name": "imsprog",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/lib/udev/rules.d",
                "cmake -S IMSProg_programmer -B IMSProg_programmer/build -DCMAKE_INSTALL_PREFIX=/app",
                "cmake --build IMSProg_programmer/build --parallel $(nproc)",
                "sed -i 's|/usr/lib/udev/rules.d|/app/lib/udev/rules.d|g' IMSProg_programmer/build/cmake_install.cmake",
                "cmake --install IMSProg_programmer/build",
                "cmake -S IMSProg_editor -B IMSProg_editor/build -DCMAKE_INSTALL_PREFIX=/app",
                "cmake --build IMSProg_editor/build --parallel $(nproc)",
                "cmake --install IMSProg_editor/build",
                "cmake -S IMSProg_database_update -B IMSProg_database_update/build -DCMAKE_INSTALL_PREFIX=/app",
                "cmake --build IMSProg_database_update/build --parallel $(nproc)",
                "cmake --install IMSProg_database_update/build",
                "mkdir -p /app/share/icons/hicolor/64x64/apps",
                "mv /app/share/pixmaps/IMSProg64.png /app/share/icons/hicolor/64x64/apps/io.github.bigbigmdm.IMSProg.png",
                "mv /app/share/pixmaps/chipEdit64.png /app/share/icons/hicolor/64x64/apps/io.github.bigbigmdm.IMSProg.editor.png",
                "mv /app/share/pixmaps/IMSProg_database_update.png /app/share/icons/hicolor/64x64/apps/io.github.bigbigmdm.IMSProg.database_update.png",
                "mv /app/share/applications/IMSProg.desktop /app/share/applications/io.github.bigbigmdm.IMSProg.desktop",
                "mv /app/share/applications/IMSProg_editor.desktop /app/share/applications/io.github.bigbigmdm.IMSProg.editor.desktop",
                "mv /app/share/applications/IMSProg_database_update.desktop /app/share/applications/io.github.bigbigmdm.IMSProg.database_update.desktop",
                "sed -i 's|Exec=/usr/bin/IMSProg|Exec=IMSProg|g' /app/share/applications/io.github.bigbigmdm.IMSProg.desktop",
                "sed -i 's|Icon=/usr/share/pixmaps/IMSProg64.png|Icon=io.github.bigbigmdm.IMSProg|g' /app/share/applications/io.github.bigbigmdm.IMSProg.desktop",
                "sed -i 's|Exec=/usr/bin/IMSProg_editor|Exec=IMSProg_editor|g' /app/share/applications/io.github.bigbigmdm.IMSProg.editor.desktop",
                "sed -i 's|Icon=/usr/share/pixmaps/chipEdit64.png|Icon=io.github.bigbigmdm.IMSProg.editor|g' /app/share/applications/io.github.bigbigmdm.IMSProg.editor.desktop",
                "sed -i 's|Exec=/usr/bin/IMSProg_database_update|Exec=IMSProg_database_update|g' /app/share/applications/io.github.bigbigmdm.IMSProg.database_update.desktop",
                "sed -i 's|Icon=/usr/share/pixmaps/IMSProg_database_update.png|Icon=io.github.bigbigmdm.IMSProg.database_update|g' /app/share/applications/io.github.bigbigmdm.IMSProg.database_update.desktop"
            ],
                        "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/bigbigmdm/IMSProg/archive/refs/tags/v1.9.1.tar.gz",
                    "sha256": "8be3cc8775929944ddd3c4dc0b3111c3269dc894cc086c151ff2117e0450c984"
                }
            ]
        }
    ]
}

