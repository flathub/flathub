{
    "app-id": "io.github.bigbigmdm.IMSProg",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "IMSProg",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=all",
        "--filesystem=host",
        "--share=network"
    ],
    "modules": [
        {
            "name": "libftdi",
            "buildsystem": "cmake",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_INSTALL_PREFIX=/app",
                "-DLIBFTDI_STATIC_LIBS=OFF",
                "-DFTDI_EEPROM=OFF",
                "-DLIB_SUFFIX="
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.intra2net.com/en/developer/libftdi/download/libftdi1-1.5.tar.bz2",
                    "sha256": "7c7091e9c86196148bd41177b4590dccb1510bfe6cea5bf7407ff194482eb049"
                }
            ]
        },
        {
            "name": "imsprog-programmer",
            "buildsystem": "cmake",
            "subdir": "IMSProg_programmer",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_INSTALL_PREFIX=/app"
            ],
            "post-install": [
                "mkdir -p /app/share/icons/hicolor/64x64/apps",
                "mv /app/share/pixmaps/IMSProg64.png /app/share/icons/hicolor/64x64/apps/io.github.bigbigmdm.IMSProg.png",
                "mv /app/share/applications/IMSProg.desktop /app/share/applications/io.github.bigbigmdm.IMSProg.desktop",
                "mv /app/share/metainfo/io.github.bigbigmdm.imsprog.metainfo.xml /app/share/metainfo/io.github.bigbigmdm.IMSProg.metainfo.xml",
                "sed -i 's|<id>.*</id>|<id>io.github.bigbigmdm.IMSProg</id>|' /app/share/metainfo/io.github.bigbigmdm.IMSProg.metainfo.xml",
                "desktop-file-edit --set-key=Icon --set-value=io.github.bigbigmdm.IMSProg /app/share/applications/io.github.bigbigmdm.IMSProg.desktop",
                "desktop-file-edit --set-key=Exec --set-value=IMSProg /app/share/applications/io.github.bigbigmdm.IMSProg.desktop",
                "desktop-file-edit --remove-key=Comment /app/share/applications/io.github.bigbigmdm.IMSProg.desktop"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/bigbigmdm/IMSProg/archive/refs/tags/v1.9.1.tar.gz",
                    "sha256": "8be3cc8775929944ddd3c4dc0b3111c3269dc894cc086c151ff2117e0450c984"
                },
                {
                    "type": "patch",
                    "path": "udevdir.patch"
                }
            ]
        },
        {
            "name": "imsprog-editor",
            "buildsystem": "cmake",
            "subdir": "IMSProg_editor",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_INSTALL_PREFIX=/app"
            ],
            "post-install": [
                "mkdir -p /app/share/icons/hicolor/64x64/apps",
                "mv /app/share/pixmaps/chipEdit64.png /app/share/icons/hicolor/64x64/apps/io.github.bigbigmdm.IMSProg.editor.png",
                "mv /app/share/applications/IMSProg_editor.desktop /app/share/applications/io.github.bigbigmdm.IMSProg.editor.desktop",
                "mv /app/share/metainfo/io.github.bigbigmdm.imsprog_editor.metainfo.xml /app/share/metainfo/io.github.bigbigmdm.IMSProg.editor.metainfo.xml",
                "sed -i 's|<id>.*</id>|<id>io.github.bigbigmdm.IMSProg.editor</id>|' /app/share/metainfo/io.github.bigbigmdm.IMSProg.editor.metainfo.xml",
                "desktop-file-edit --set-key=Icon --set-value=io.github.bigbigmdm.IMSProg.editor /app/share/applications/io.github.bigbigmdm.IMSProg.editor.desktop",
                "desktop-file-edit --set-key=Exec --set-value=IMSProg_editor /app/share/applications/io.github.bigbigmdm.IMSProg.editor.desktop",
                "desktop-file-edit --remove-key=Comment /app/share/applications/io.github.bigbigmdm.IMSProg.editor.desktop"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/bigbigmdm/IMSProg/archive/refs/tags/v1.9.1.tar.gz",
                    "sha256": "8be3cc8775929944ddd3c4dc0b3111c3269dc894cc086c151ff2117e0450c984"
                }
            ]
        },
        {
            "name": "imsprog-database-update",
            "buildsystem": "cmake",
            "subdir": "IMSProg_database_update",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_INSTALL_PREFIX=/app"
            ],
            "post-install": [
                "mkdir -p /app/share/icons/hicolor/64x64/apps",
                "mv /app/share/pixmaps/IMSProg_database_update.png /app/share/icons/hicolor/64x64/apps/io.github.bigbigmdm.IMSProg.database_update.png",
                "mv /app/share/applications/IMSProg_database_update.desktop /app/share/applications/io.github.bigbigmdm.IMSProg.database_update.desktop",
                "mv /app/share/metainfo/io.github.bigbigmdm.imsprog_database_update.metainfo.xml /app/share/metainfo/io.github.bigbigmdm.IMSProg.database_update.metainfo.xml",
                "sed -i 's|<id>.*</id>|<id>io.github.bigbigmdm.IMSProg.database_update</id>|' /app/share/metainfo/io.github.bigbigmdm.IMSProg.database_update.metainfo.xml",
                "desktop-file-edit --set-key=Icon --set-value=io.github.bigbigmdm.IMSProg.database_update /app/share/applications/io.github.bigbigmdm.IMSProg.database_update.desktop",
                "desktop-file-edit --set-key=Exec --set-value=IMSProg_database_update /app/share/applications/io.github.bigbigmdm.IMSProg.database_update.desktop",
                "desktop-file-edit --remove-key=Comment /app/share/applications/io.github.bigbigmdm.IMSProg.database_update.desktop"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/bigbigmdm/IMSProg/archive/refs/tags/v1.9.1.tar.gz",
                    "sha256": "8be3cc8775929944ddd3c4dc0b3111c3269dc894cc086c151ff2117e0450c984"
                }
            ]
        }
    ]
}

