    </screenshots>

    <requires>
        <control>keyboard</control>
        <control>pointing</control>
        <display_length compare="ge">768</display_length>
    </requires>

    <releases>
        <release version="0.5.9" date="2026-11-17">
            <url type="details">https://github.com/ProtonLumo/lumo-desktop/blob/master/changelog.md#059</url>
            <description>
                <p>Security</p>
                <ul>
                    <li>Security improvements to tool approvals, connectors, credential handling, links and permissions.</li>
                </ul>
                <p>Added</p>
                <ul>
                    <li>Connectors: Added an "Always allow" option for tools in settings, which runs the tool without asking even after reading untrusted content and in scheduled tasks.</li>
                </ul>
                <p>Fixed</p>
                <ul>
                    <li>macOS: The tray icon now adapts to a dark menu bar.</li>
                    <li>macOS: Iframes can navigate again.</li>
                    <li>Linux: Dialog messages containing % are shown correctly.</li>
                </ul>
            </description>
        </release>
    </releases>

</component>
