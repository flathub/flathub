<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>me.proton.Lumo</id>

    <name>Lumo</name>
    <summary>Confidential AI chat assistant</summary>

    <developer id="me.proton">
        <name>Proton AG</name>
    </developer>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-only</project_license>

    <description>
        <p>
            # AI should empower you, not exploit you for your data
        </p>
        <p>
            Millions rely on popular AI chat tools to simplify their lives — often unaware that every message, idea, and piece of sensitive information can be harvested, stored, and sold. Lumo gives you the power of AI with one key difference: All conversations with Lumo are stored with zero-access encryption, so no one (not even Proton) can access them.
        </p>
        <p>
            Lumo is created by the scientists behind Proton Mail, Proton VPN, and the nonprofit Proton Foundation.
        </p>
    </description>

    <branding>
        <color type="primary" scheme_preference="light">#c061cb</color>
        <color type="primary" scheme_preference="dark">#1c71d8</color>
    </branding>

    <content_rating type="oars-1.1" />

    <url type="bugtracker">https://github.com/flathub/me.proton.Lumo/issues</url>
    <url type="homepage">https://proton.me/lumo</url>
    <url type="vcs-browser">https://github.com/ProtonLumo/lumo-desktop</url>
    <url type="help">https://proton.me/support/lumo</url>

    <launchable type="desktop-id">me.proton.Lumo.desktop</launchable>
    <screenshots>
        <screenshot type="default">
            <image>https://forgejo.maledict.me/Maledict/lumo-flatpak/raw/commit/92ef556f2d647c737ccc7e7f473186ed47381f7f/screenshots/1.png</image>
            <caption>Main</caption>
        </screenshot>
        <screenshot>
            <image>https://forgejo.maledict.me/Maledict/lumo-flatpak/raw/commit/92ef556f2d647c737ccc7e7f473186ed47381f7f/screenshots/2.png</image>
            <caption>Library</caption>
        </screenshot>
        <screenshot>
            <image>https://forgejo.maledict.me/Maledict/lumo-flatpak/raw/commit/92ef556f2d647c737ccc7e7f473186ed47381f7f/screenshots/3.png</image>
            <caption>Customize</caption>
        </screenshot>
        <screenshot>
            <image>https://forgejo.maledict.me/Maledict/lumo-flatpak/raw/commit/92ef556f2d647c737ccc7e7f473186ed47381f7f/screenshots/4.png</image>
