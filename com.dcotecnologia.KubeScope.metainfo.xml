<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.dcotecnologia.KubeScope</id>
  <name>KubeScope</name>
  <summary>Desktop viewer for Kubernetes and Amazon EKS workloads</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="com.dcotecnologia">
    <name>DCO Tecnologia</name>
  </developer>
  <description>
    <p>
      KubeScope is a read-only desktop console for Kubernetes and Amazon EKS:
      cluster overview, Pods and Deployments with CPU, memory and restarts,
      resource details and live logs.
    </p>
  </description>
  <launchable type="desktop-id">com.dcotecnologia.KubeScope.desktop</launchable>
  <url type="homepage">https://github.com/dcotecnologia/kubescope</url>
  <url type="bugtracker">https://github.com/dcotecnologia/kubescope/issues</url>
