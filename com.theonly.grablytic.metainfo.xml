  <name>Grablytic</name>
  <summary>Privacy-first high-performance media downloader</summary>
  <description>
    <p>
      Grablytic is a modern, privacy-respecting media extractor powered by an embedded
      yt-dlp engine. It allows users to download video and audio streams in full fidelity
      from over 1,000 supported platforms with zero advertising SDKs and zero telemetry.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Up to 4K/8K 60fps video downloads and Opus/AAC high-bitrate extraction</li>
      <li>Hardware-optimized local processing with embedded runtimes</li>
      <li>Playlist batch downloads with selective ordering and shuffling</li>
      <li>Sleek, fluid dark-mode user interface</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.theonly.grablytic.desktop</launchable>
  <url type="homepage">https://github.com/OnlyXianzo/Grablytic</url>
