<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream 元数据。默认语言为英文、中文以 xml:lang="zh-CN" 提供翻译，
  这是 Flathub 的通行做法：校验器按英文规则检查首字母大写，
  而界面语言仍会按用户 locale 自动选择。
-->
<component type="desktop-application">
  <id>icu.talklink.KonglingMail</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Kongling Mail</name>
  <name xml:lang="zh-CN">空灵邮箱</name>

  <summary>Local desktop email client</summary>
  <summary xml:lang="zh-CN">本地桌面邮箱管理客户端</summary>

  <!--
    注意：<description> 本身不能带 xml:lang（校验器会报
    metainfo-localized-description-tag）。本地化标记要加在内部的 <p> / <li> 上，
    客户端会按用户 locale 只显示匹配的段落。
  -->
  <description>
    <p>
      Kongling Mail is a local desktop email client for Linux. Message bodies and
      attachments are cached in a local SQLite database, so browsing and full-text
      search keep working offline, and account credentials are stored in the system
      keyring.
    </p>
    <p xml:lang="zh-CN">
      空灵邮箱是一款面向 Linux 桌面的本地邮件客户端。邮件正文与附件全部缓存于本机
      SQLite 数据库，支持离线浏览与全文检索；账户凭据交由系统密钥环加密保存。
    </p>
    <p>Features:</p>
    <ul>
      <li>Multiple accounts, each with its own colour and signature</li>
      <li xml:lang="zh-CN">多账户管理：可同时添加任意数量的邮箱，支持启用/停用与颜色标识</li>
      <li>Unified inbox that aggregates the inboxes of every account</li>
      <li xml:lang="zh-CN">全部收件箱：把所有账户的收件箱聚合到同一个列表查看</li>
      <li>IMAP + SMTP, POP3, Exchange / Office 365 (EWS) and OAuth2 sign-in</li>
      <li xml:lang="zh-CN">协议支持：IMAP + SMTP、POP3、Exchange / Office365（EWS）、OAuth2 授权登录</li>
      <li>Automatic account setup through provider presets, Mozilla autoconfig, DNS SRV and port probing</li>
      <li xml:lang="zh-CN">自动配置发现：内置常见服务商预设，未命中时尝试 autoconfig、DNS SRV 与端口探测</li>
      <li>Offline full-text search across accounts and folders (SQLite FTS5)</li>
      <li xml:lang="zh-CN">本地全文搜索：SQLite FTS5，中文按字切分，可跨账户跨文件夹检索</li>
      <li>Labels, filter rules, conversation view, templates, snooze and undo send</li>
      <li xml:lang="zh-CN">标签、规则过滤、会话视图、模板、稍后提醒与撤销发送</li>
      <li>Attachment manager with in-app preview for images and PDFs</li>
      <li xml:lang="zh-CN">附件管理器，图片与 PDF 可在应用内直接预览</li>
      <li>Drafts synced to the server, .eml export, backup and restore</li>
      <li xml:lang="zh-CN">草稿同步到服务器、邮件导出为 .eml、备份与恢复</li>
      <li>App lock: require a password before the window is shown</li>
      <li xml:lang="zh-CN">应用锁：设置密码后每次打开都需先解锁</li>
      <li>Simplified Chinese and English interface, light and dark themes</li>
      <li xml:lang="zh-CN">界面支持简体中文与英文，可切换浅色 / 深色主题</li>
    </ul>
  </description>

