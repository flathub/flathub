<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>xyz.mipha.ineedmore</id>
  <name>I Need More</name>
  <summary>5 arcade minigames with a story mode</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>I Need More is a collection of 5 arcade minigames with simple one-touch controls.</p>
    <ul>
      <li>FlapSpace: Navigate through obstacles in this fast-paced flapper</li>
      <li>SpaceRun: Run as far as you can while dodging everything in your path</li>
      <li>Snake: The classic game. Eat, grow, don't bite yourself</li>
      <li>SkyRise: Jump your way to the top and don't fall</li>
      <li>FinalBattle: You're surrounded. Shoot everything that moves</li>
    </ul>
    <p>Unlock all minigames in Story Mode, then play them endlessly in Free Mode and chase your high scores.</p>
  </description>
  <releases>
    <release version="1.0.0" date="2026-05-31"/>
  </releases>
  <url type="homepage">https://javiermoralesdev.itch.io/i-need-more</url>
