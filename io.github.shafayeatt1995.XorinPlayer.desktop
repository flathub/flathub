[Desktop Entry]
Name=Xorin Player
GenericName=Audio & Cinema Video Player
Comment=High-Fidelity Audio and Cinema Video Player powered by Rust
Exec=xorin-player %U
Icon=io.github.shafayeatt1995.XorinPlayer
Terminal=false
Type=Application
Categories=AudioVideo;Player;Audio;Video;
Keywords=music;audio;sound;player;equalizer;video;movie;media;
MimeType=audio/mpeg;audio/mp3;audio/x-wav;audio/wav;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/aac;audio/mp4;audio/x-m4a;video/mp4;video/x-matroska;video/x-msvideo;video/quicktime;video/webm;video/x-flv;video/x-ms-wmv;video/mpeg;video/ogg;
StartupNotify=true
StartupWMClass=xorin-player
