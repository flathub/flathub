[Desktop Entry]
Name=PatchCraft Launcher
GenericName=Unofficial RuneScape Launcher
Comment=Unofficial native Linux launcher for RuneScape 3, Old School RuneScape, and Dragonwilds (Jagex Accounts)
Exec=patchcraft-launcher %U
Icon=dev.patchcraft.Launcher
Terminal=false
Type=Application
Categories=Game;RolePlaying;
MimeType=x-scheme-handler/jagex;x-scheme-handler/jagex-launcher;x-scheme-handler/runescape;x-scheme-handler/rs-launch;
StartupWMClass=patchcraft-launcher
PrefersNonDefaultGPU=true
Keywords=runescape;runescape3;rs3;osrs;jagex;runelite;hdos;dragonwilds;patchcraft;steamdeck;steamos;electron;game;
