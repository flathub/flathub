<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>in.melodius.Melodius</id>
  <name>Melodius</name>
  <summary>Stream music, run Jam sessions and see your listening stats</summary>
  <developer id="in.melodius">
    <name>Melodius</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=</project_license>
  <description>
    <p>Melodius is a music streaming app. Search millions of songs, build playlists and keep your library in step across the web, Android and your computer.</p>
    <ul>
      <li>Play songs, albums and playlists with crossfade, lyrics and a queue you can rearrange</li>
      <li>Listen together in Jam sessions</li>
      <li>See your listening stats: top songs, artists and streaks</li>
      <li>Keep songs on your computer to play without a connection</li>
      <li>Control playback from your desktop's media keys and player controls</li>
    </ul>
    <p>A Melodius account is required.</p>
  </description>
  <launchable type="desktop-id">in.melodius.Melodius.desktop</launchable>
  <url type="homepage">https://www.melodius.in</url>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Music</category>
  </categories>
  <branding>
    <color type="primary" scheme_preference="light">#b8f5c8</color>
    <color type="primary" scheme_preference="dark">#0f3d1f</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <caption>Home and your library</caption>
      <image>https://www.melodius.in/flathub/home.png</image>
    </screenshot>
    <screenshot>
      <caption>Themes, accent colours and backgrounds</caption>
      <image>https://www.melodius.in/flathub/themes.png</image>
    </screenshot>
    <screenshot>
      <caption>A 10-band equalizer</caption>
      <image>https://www.melodius.in/flathub/equalizer.png</image>
    </screenshot>
    <screenshot>
      <caption>Listening stats and Sound Capsule</caption>
      <image>https://www.melodius.in/flathub/stats.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">940</display_length>
  </requires>
  <releases>
    <release version="1.14.5" date="2026-11-02">
      <description>
        <p>Starts faster and plays from a smaller set of media components.</p>
      </description>
    </release>
  </releases>
</component>
