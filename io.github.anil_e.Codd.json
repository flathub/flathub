{
  "id": "io.github.anil_e.Codd",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "codd",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "codd",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/anil-e/codd.git",
          "tag": "v0.1.0",
          "commit": "e7577c422ba187d5905e90f486523436bc9ecb53"
        },
        "cargo-sources.json"
      ],
      "config-opts": ["-Dcargo-home=/run/build/codd/cargo"]
    }
  ]
}
