<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.optiscaler_client.Optiscaler_Client</id>
  <name>Optiscaler Client</name>
  <summary>A modern manager for OptiScaler</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.optiscaler_client">
    <name>Optiscaler Client contributors</name>
  </developer>
  <description>
    <p>
      Optiscaler Client detects the games installed on your system and installs, updates and
      configures OptiScaler and related upscaling and frame generation components for them.
    </p>
    <ul>
      <li>Automatic scanning of Steam and Heroic libraries, plus custom folders and manual games</li>
      <li>Install, update and remove OptiScaler, FSR, XeSS and DLSS components per game</li>
      <li>Profiles and an editor for OptiScaler.ini settings</li>
      <li>Bulk install across your whole library</li>
      <li>Frame Generation and Multi Frame Generation setup</li>
    </ul>
    <p>
      Optiscaler Client is an unofficial frontend. The components it downloads are third-party
      software under their own licenses.
    </p>
  </description>
  <launchable type="desktop-id">io.github.optiscaler_client.Optiscaler_Client.desktop</launchable>
  <url type="homepage">https://github.com/Optiscaler-Client/Optiscaler-Client</url>
