{
  "id": "io.github.kai_j_g.CosmicHardwareMonitor",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "cosmic-ext-hardware-monitor",
  "finish-args": [
    "--socket=wayland",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=com.system76.CosmicSettingsDaemon.*",
    "--filesystem=/sys/class/hwmon:ro",
    "--filesystem=/sys/class/drm:ro",
    "--filesystem=/sys/devices:ro",
    "--device=all"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-ext-hardware-monitor/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-ext-hardware-monitor",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 ./target/release/cosmic-ext-hardware-monitor /app/bin/cosmic-ext-hardware-monitor",
        "install -Dm0644 ./data/io.github.kai_j_g.CosmicHardwareMonitor.desktop /app/share/applications/io.github.kai_j_g.CosmicHardwareMonitor.desktop",
        "install -Dm0644 ./data/io.github.kai_j_g.CosmicHardwareMonitor.metainfo.xml /app/share/metainfo/io.github.kai_j_g.CosmicHardwareMonitor.metainfo.xml",
        "install -Dm0644 ./data/icons/io.github.kai_j_g.CosmicHardwareMonitor.svg /app/share/icons/hicolor/scalable/apps/io.github.kai_j_g.CosmicHardwareMonitor.svg",
        "install -Dm0644 ./data/icons/io.github.kai_j_g.CosmicHardwareMonitor-symbolic.svg /app/share/icons/hicolor/scalable/apps/io.github.kai_j_g.CosmicHardwareMonitor-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Kai-J-G/CosmicHardwareMonitor.git",
          "tag": "v1.0.0",
          "commit": "777252c0887136ccccccd7799cd5c54e24e01ef9"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
