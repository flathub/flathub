{
  "$schema": "https://raw.githubusercontent.com/flatpak/flatpak-builder/main/data/flatpak-manifest.schema.json",
  "app-id": "io.github.hmidani_abdelilah.Media_Downloader",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "media-downloader",
  "separate-locales": false,
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.freedesktop.Notifications",
    "--env=MEDIA_DOWNLOADER_DISABLE_YTDLP_AUTO_UPDATE=1"
  ],
  "build-options": {
    "env": {
      "PIP_DISABLE_PIP_VERSION_CHECK": "1",
      "PYTHONDONTWRITEBYTECODE": "1"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/doc",
    "/share/man",
    "/bin/tclsh*",
    "/bin/wish*",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "python3-tkinter",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --no-build-isolation --no-deps --prefix=${FLATPAK_DEST} ."
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/iwalton3/tkinter-standalone.git",
          "commit": "8e78e38ef0cceb44a3a0062e1c314a4ff3f981db"
        }
      ],
      "modules": [
        {
          "name": "tcl",
          "buildsystem": "autotools",
          "subdir": "unix",
          "config-opts": [
            "--enable-threads",
            "--enable-shared",
            "--disable-zipfs"
          ],
          "post-install": [
            "chmod 755 /app/lib/libtcl*.so"
          ],
          "sources": [
            {
              "type": "archive",
              "url": "https://prdownloads.sourceforge.net/tcl/tcl9.0.0-src.tar.gz",
              "sha256": "3bfda6dbaee8e9b1eeacc1511b4e18a07a91dff82d9954cdb9c729d8bca4bbb7"
            }
          ],
          "license-files": [
            "license.terms"
          ]
        },
        {
          "name": "tk",
          "buildsystem": "autotools",
          "subdir": "unix",
          "config-opts": [
            "--disable-zipfs"
          ],
          "post-install": [
            "chmod +w /app/lib/libtcl9tk*.so",
            "ln -sf /app/bin/wish9.0 /app/bin/wish"
          ],
          "sources": [
            {
              "type": "archive",
              "url": "https://prdownloads.sourceforge.net/tcl/tk9.0.0-src.tar.gz",
              "sha256": "f166e3c20773c82243f753cef4b091d05267cb7f87da64be88cb2ca5a2ba027e"
            }
          ],
          "license-files": [
            "license.terms"
          ]
        }
      ],
      "license-files": [
        "LICENSE"
      ]
    },
    {
      "name": "quickjs",
      "buildsystem": "simple",
      "build-commands": [
        "make -j${FLATPAK_BUILDER_N_JOBS} qjs",
        "install -Dm755 qjs /app/bin/qjs"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://bellard.org/quickjs/quickjs-2026-06-04.tar.xz",
          "sha256": "b376e839b322978313d929fd20663b11ba58b75df5a46c126dd19ea2fa70ad2a"
        }
      ],
      "license-files": [
        "LICENSE"
      ]
    },
    {
      "name": "aria2",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-libaria2",
        "--disable-websocket",
        "--disable-nls",
        "--disable-ftp",
        "--without-appletls",
        "--without-cppunit",
        "--without-gnutls",
        "--without-libcares",
        "--without-libcunit",
        "--without-libgcrypt",
        "--without-libgmp",
        "--without-libssh2",
        "--without-libxml2",
        "--without-sqlite3",
        "--with-openssl"
      ],
      "cleanup": [
        "/share/doc",
        "/share/man"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/aria2/aria2/releases/download/release-1.37.0/aria2-1.37.0.tar.xz",
          "sha256": "60a420ad7085eb616cb6e2bdf0a7206d68ff3d37fb5a956dc44242eb2f79b66b"
        }
      ],
      "license-files": [
        "COPYING",
        "LICENSE.OpenSSL"
      ]
    },
    "python3-dependencies.json",
    {
      "name": "media-downloader",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/share/media-downloader /app/share/applications /app/share/icons/hicolor/512x512/apps /app/share/metainfo /app/share/licenses/${FLATPAK_ID}",
        "install -m644 app.py aria2_check.py convert.py downloader.py ffmpeg_check.py gui.py notification.py path_ffmpeg.py utils.py ytdlp_manager.py /app/share/media-downloader/",
        "cp -a languages asset /app/share/media-downloader/",
        "install -Dm755 flatpak/io.github.hmidani_abdelilah.Media_Downloader.sh /app/bin/media-downloader",
        "install -Dm644 flatpak/io.github.hmidani_abdelilah.Media_Downloader.desktop /app/share/applications/${FLATPAK_ID}.desktop",
        "install -Dm644 flatpak/io.github.hmidani_abdelilah.Media_Downloader.appdata.xml /app/share/metainfo/${FLATPAK_ID}.metainfo.xml",
        "install -Dm644 icon.png /app/share/icons/hicolor/512x512/apps/${FLATPAK_ID}.png",
        "install -Dm644 LICENSE /app/share/licenses/${FLATPAK_ID}/LICENSE"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/hmidani-abdelilah/Media_Downloader.git",
          "commit": "123c950fad2a73a948d5967cfff9544b3af13ad4"
        }
      ],
      "license-files": [
        "LICENSE"
      ],
      "post-install": [
        "mkdir -p /app/share/licenses/${FLATPAK_ID}/python",
        "for info in /app/lib/python*/site-packages/*.dist-info; do name=$(basename \"$info\"); for license in \"$info\"/licenses \"$info\"/LICENSE* \"$info\"/COPYING* \"$info\"/NOTICE*; do if test -e \"$license\"; then mkdir -p \"/app/share/licenses/${FLATPAK_ID}/python/$name\"; cp -a \"$license\" \"/app/share/licenses/${FLATPAK_ID}/python/$name/\"; fi; done; done"
      ]
    }
  ]
}
