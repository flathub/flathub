{
  "app-id": "io.github.pebois.gnome-ai-chat",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.node24"
  ],
  "command": "io.github.pebois.gnome-ai-chat",
  "finish-args": [
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=home:ro",
    "--filesystem=xdg-documents:ro",
    "--filesystem=xdg-download:ro",
    "--filesystem=xdg-desktop:ro",
    "--filesystem=xdg-pictures:ro"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/node24/bin",
    "env": {
      "NPM_CONFIG_OFFLINE": "true",
      "NPM_CONFIG_CACHE": "/run/build/gnome-ai-chat/flatpak-node/npm-cache"
    }
  },
  "modules": [
    {
      "name": "gnome-ai-chat",
      "buildsystem": "simple",
      "build-commands": [
        "npm ci --offline --ignore-scripts",
        "npm run build",
        "glib-compile-resources resources.gresource.xml",
        "install -Dm644 resources.gresource ${FLATPAK_DEST}/share/io.github.pebois.gnome-ai-chat/resources.gresource",
        "install -Dm755 bin/io.github.pebois.gnome-ai-chat ${FLATPAK_DEST}/bin/io.github.pebois.gnome-ai-chat",
        "install -d ${FLATPAK_DEST}/share/io.github.pebois.gnome-ai-chat",
        "cp -r dist ${FLATPAK_DEST}/share/io.github.pebois.gnome-ai-chat/",
        "install -Dm644 io.github.pebois.gnome-ai-chat.desktop ${FLATPAK_DEST}/share/applications/io.github.pebois.gnome-ai-chat.desktop",
        "install -Dm644 io.github.pebois.gnome-ai-chat.metainfo.xml ${FLATPAK_DEST}/share/metainfo/io.github.pebois.gnome-ai-chat.metainfo.xml",
        "install -Dm644 icons/scalable/apps/io.github.pebois.gnome-ai-chat.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/io.github.pebois.gnome-ai-chat.svg",
        "install -Dm644 icons/hicolor/256x256/apps/io.github.pebois.gnome-ai-chat.png ${FLATPAK_DEST}/share/icons/hicolor/256x256/apps/io.github.pebois.gnome-ai-chat.png",
        "install -Dm644 icons/hicolor/128x128/apps/io.github.pebois.gnome-ai-chat.png ${FLATPAK_DEST}/share/icons/hicolor/128x128/apps/io.github.pebois.gnome-ai-chat.png",
        "install -Dm644 icons/hicolor/48x48/apps/io.github.pebois.gnome-ai-chat.png ${FLATPAK_DEST}/share/icons/hicolor/48x48/apps/io.github.pebois.gnome-ai-chat.png",
        "gtk-update-icon-cache -qtf ${FLATPAK_DEST}/share/icons/hicolor"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/pebois/gnome-ai-chat.git",
          "tag": "v1.9.1",
          "commit": "10c0a614f6507b6d4c1b8d1b96fd2a6a71671358"
        },
        "generated-sources.json"
      ]
    }
  ]
}
