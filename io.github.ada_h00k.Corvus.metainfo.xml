      <caption>Corvus with a light theme</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/ada-h00k/Corvus/84d1651c44d3f5f96513d967411eb21c1bb9a64a/docs/screenshots/Corvus_BreezeDark.png</image>
      <caption>Corvus with a dark theme</caption>
