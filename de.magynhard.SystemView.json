{
  "app-id": "de.magynhard.SystemView",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "system-view",
  "separate-locales": false,
  "appstream-compose": false,
  "finish-args": [
    "--require-version=1.17.0",
    "--socket=wayland",
    "--socket=x11",
    "--socket=pulseaudio",
    "--socket=cups",
    "--share=ipc",
    "--device=dri",
    "--filesystem=host-root:ro",
    "--filesystem=/run/udev:ro",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.gnome.Shell",
    "--talk-name=org.gnome.Mutter.DisplayConfig",
    "--talk-name=org.gnome.Settings",
    "--system-talk-name=org.freedesktop.NetworkManager",
    "--system-talk-name=org.bluez",
    "--system-talk-name=org.freedesktop.UDisks2"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/*.la",
    "/share/man",
    "/share/doc"
  ],
  "modules": [
    {
      "name": "bdw-gc",
      "buildsystem": "autotools",
      "config-opts": ["--disable-static"],
      "post-install": ["install -Dm644 README.QUICK /app/share/licenses/de.magynhard.SystemView/bdw-gc/README.QUICK"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/bdwgc/bdwgc/releases/download/v8.2.12/gc-8.2.12.tar.gz",
          "sha256": "42e5194ad06ab6ffb806c83eb99c03462b495d979cda782f3c72c08af833cd4e"
        }
      ]
    },
    {
      "name": "glxinfo",
      "buildsystem": "simple",
      "build-commands": [
        "cc -D_GNU_SOURCE -O2 -I src/glad/include -I src/util src/xdemos/glxinfo.c src/util/glinfo_common.c src/glad/src/glad.c -o glxinfo $(pkg-config --cflags --libs gl x11) -lm -ldl",
        "install -Dm755 glxinfo /app/bin/glxinfo",
        "install -Dm644 src/xdemos/glxinfo.c /app/share/licenses/de.magynhard.SystemView/mesa-demos/glxinfo.c",
        "install -Dm644 src/util/glinfo_common.c /app/share/licenses/de.magynhard.SystemView/mesa-demos/glinfo_common.c",
        "install -Dm644 src/glad/src/glad.c /app/share/licenses/de.magynhard.SystemView/mesa-demos/glad.c"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://archive.mesa3d.org/demos/mesa-demos-9.0.0.tar.xz",
          "sha256": "3046a3d26a7b051af7ebdd257a5f23bfeb160cad6ed952329cdff1e9f1ed496b"
        }
      ]
    },
    {
      "name": "vulkaninfo",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DBUILD_CUBE=OFF", "-DBUILD_ICD=OFF", "-DBUILD_TESTS=OFF"],
      "post-install": ["install -Dm644 LICENSE.txt /app/share/licenses/de.magynhard.SystemView/vulkan-tools/LICENSE.txt"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/KhronosGroup/Vulkan-Tools/archive/refs/tags/vulkan-sdk-1.4.321.0.tar.gz",
          "sha256": "f897f76b1fae6b85b567ee86d7bc1ba6f5b1a13d3bfa5fe0f07fdb81609f7b75"
        }
      ]
    },
    {
      "name": "system-view",
      "buildsystem": "simple",
      "build-options": {"prepend-path": "/run/build/system-view/crystal/bin"},
      "build-commands": ["bash scripts/offline-build.sh /app"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/magynhard/system-view.cr.git",
          "tag": "0.4.0",
          "commit": "bfa5386ac74b80f8d877cbb93622c082a0cc9558"
        },
        {
          "type": "archive",
          "url": "https://github.com/crystal-lang/crystal/releases/download/1.21.0/crystal-1.21.0-1-linux-x86_64-bundled.tar.gz",
          "sha256": "cc407bd071915cc7b5d9348281e669a911d20a1f4b9fac52a62088660eb22208",
          "dest": "crystal",
          "strip-components": 2,
          "only-arches": ["x86_64"]
        },
        {
          "type": "archive",
          "url": "https://github.com/crystal-lang/crystal/releases/download/1.21.0/crystal-1.21.0-1-linux-aarch64-bundled.tar.gz",
          "sha256": "87e042842baad7a03014dba819fe74bd81ba221d2a84200984433bcfb691d133",
          "dest": "crystal",
          "strip-components": 2,
          "only-arches": ["aarch64"]
        },
        {"type": "git", "url": "https://codeberg.org/geopjr/gettext.cr.git", "commit": "9374e7f42622bc917c42d5ff40488ae86ef99068", "dest": "lib/gettext"},
        {"type": "git", "url": "https://github.com/hugopl/gi-crystal.git", "commit": "fcded7a9e80d42425d004764fdc79892c86d7dc0", "dest": "lib/gi-crystal"},
        {"type": "git", "url": "https://github.com/hugopl/gtk4.cr.git", "commit": "b0be1f829b0ac3080fe607bde11ae37338736675", "dest": "lib/gtk4"},
        {"type": "git", "url": "https://github.com/hugopl/harfbuzz.cr.git", "commit": "8f070deee7840c7dabeaf228513ac9d93807cdd2", "dest": "lib/harfbuzz"},
        {"type": "git", "url": "https://github.com/hugopl/libadwaita.cr.git", "commit": "32d7c7de0d0a2bd9f4c0a03011f5cebf2868c859", "dest": "lib/libadwaita"},
        {"type": "git", "url": "https://github.com/hugopl/pango.cr.git", "commit": "378511bc8c5a8278025a30e1330f948dc1c99e7c", "dest": "lib/pango"}
      ]
    }
  ]
}
