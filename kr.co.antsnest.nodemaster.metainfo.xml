<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream 메타데이터. AppImage 와 Flathub 가 모두 이 파일을 읽는다.
  스냅 스토어는 snapcraft.yaml 의 summary/description 을 쓰므로 여기와 중복된다.
  둘을 고칠 때 문구를 함께 맞춘다.
-->
<component type="desktop-application">
  <id>kr.co.antsnest.nodemaster</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <name>NodeMaster Linux Preview</name>
  <name xml:lang="ko">노드마스터 리눅스 미리보기</name>
  <summary>Offline knowledge tree editor</summary>
  <summary xml:lang="ko">내 컴퓨터에 저장하는 지식 트리 편집기</summary>
  <description>
    <p>
      NodeMaster is a native, offline knowledge tree editor. Organize files, tabs,
      nodes and custom attributes without a server account. Documents stay local.
      This Linux development preview does not yet include all Windows features.
    </p>
    <p xml:lang="ko">
      노드마스터는 서버 계정 없이 동작하는 지식 트리 편집기다. 파일·탭·노드·커스텀 속성을
      내 컴퓨터에만 저장한다. 이 리눅스판은 개발 미리보기이며 Windows 판의 모든 기능을
      아직 담고 있지 않다.
    </p>
  </description>
  <launchable type="desktop-id">kr.co.antsnest.nodemaster.desktop</launchable>
  <developer id="kr.co.antsnest">
    <name>AntsNest</name>
  </developer>
  <url type="homepage">https://antsnest.co.kr</url>
  <categories>
    <category>Office</category>
    <category>Utility</category>
  </categories>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1" />
  <!--
    Flathub 심사가 요구하는 화면 그림. 리눅스판을 Xvfb 1600x1000 에서 실제로 띄워
    창 전체를 갈무리한 것이다. 주소는 deb 를 올린 것과 같은 공개 파일 서버다.
    판을 올려 화면이 달라지면 새로 갈무리해 올리고 이 주소를 바꾼다.
  -->
  <screenshots>
    <screenshot type="default">
      <image>https://file.skynet.re.kr/biz_antsnest/f20261029_364j4t.png</image>
      <caption>Knowledge tree with file list, node tree and node editor</caption>
      <caption xml:lang="ko">파일 목록·노드 트리·노드 편집기가 함께 있는 기본 화면</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.1.0-alpha.2" date="2026-10-28">
      <description>
        <p>Linux development preview.</p>
      </description>
    </release>
  </releases>
</component>
