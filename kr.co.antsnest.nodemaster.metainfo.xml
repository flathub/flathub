<!--
  AppStream 메타데이터. AppImage 와 Flathub 가 모두 이 파일을 읽는다.
  스냅 스토어는 snapcraft.yaml 의 summary/description 을 쓰므로 여기와 중복된다.
  둘을 고칠 때 문구를 함께 맞춘다.
-->
<component type="desktop-application">
  <id>kr.co.antsnest.nodemaster</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <name>NodeMaster Desktop for Linux</name>
  <name xml:lang="ko">노드마스터 데스크톱 리눅스</name>
  <summary>Offline knowledge tree editor</summary>
  <summary xml:lang="ko">내 컴퓨터에 저장하는 지식 트리 편집기</summary>
  <description>
    <p>
      NodeMaster is a native, offline knowledge tree editor. Organize files, tabs,
      nodes, custom attributes, 3D nebula graphs, and AI agent MCP workflows locally.
    </p>
    <p xml:lang="ko">
      노드마스터는 내 컴퓨터에 저장하는 지식 트리 편집기다. 파일·탭·노드·커스텀 속성·3D 성운 그래프와
      AI 에이전트 MCP 실행 흐름을 한곳에서 다룬다.
    </p>
  </description>
  <launchable type="desktop-id">kr.co.antsnest.nodemaster.desktop</launchable>
  <developer id="kr.co.antsnest">
    <name>AntsNest</name>
  </developer>
  <url type="homepage">https://antsnest.co.kr</url>
  <categories>
    <category>Office</category>
    <category>Utility</category>
  </categories>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1" />
  <!--
    Flathub 심사가 요구하는 화면 그림. 리눅스판을 Xvfb 1600x1000 에서 실제로 띄워
    창 전체를 갈무리한 것이다. 주소는 deb 를 올린 것과 같은 공개 파일 서버다.
    판을 올려 화면이 달라지면 새로 갈무리해 올리고 이 주소를 바꾼다.
  -->
