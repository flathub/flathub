<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.noderelay.UplinkIRC</id>
  <name>Uplink</name>
  <summary>Fast, secure IRC client with full IRCv3 support</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      Uplink is a fast, secure IRC client built with Qt6 and C++17. It supports 37 IRCv3
      capabilities and focuses on correctness, security, and a clean native interface.
    </p>
    <ul>
      <li>37 IRCv3 capabilities including echo-message, message-tags, and chathistory</li>
      <li>SASL PLAIN and EXTERNAL (certificate) authentication</li>
      <li>TLS with certificate pinning — no silent trust of unknown certs</li>
      <li>DCC file send and receive</li>
      <li>Link previews with SSRF protection</li>
      <li>Message reactions</li>
      <li>Customizable themes</li>
      <li>System tray support</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.noderelay.UplinkIRC.desktop</launchable>

  <url type="homepage">https://uplinkirc.chat</url>
  <url type="bugtracker">https://github.com/noderelay/UplinkIRC/issues</url>
  <url type="vcs-browser">https://github.com/noderelay/UplinkIRC</url>

  <developer id="io.github.noderelay">
    <name>NodeRelay</name>
  </developer>

  <categories>
    <category>Network</category>
    <category>IRCClient</category>
  </categories>

  <keywords>
    <keyword>IRC</keyword>
    <keyword>chat</keyword>
    <keyword>IRCv3</keyword>
    <keyword>instant messaging</keyword>
  </keywords>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">moderate</content_attribute>
  </content_rating>

  <releases>
    <release version="0.25.54" date="2026-06-26">
      <description>
        <p>macOS codesign fix; themes moved to Resources for codesign compatibility.</p>
      </description>
    </release>
  </releases>
</component>
