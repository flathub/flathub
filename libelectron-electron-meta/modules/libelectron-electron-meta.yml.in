name: libelectron-electron-meta
buildsystem: simple
build-commands:
  - install -dm755 /app/opt/libelectron-electron-meta/node_modules/electron/dist
  - cp -a electron-dist/. /app/opt/libelectron-electron-meta/node_modules/electron/dist/
  - printf '@ELECTRON_VERSION@\n' > /app/opt/libelectron-electron-meta/version.txt
  - install -Dm755 libelectronmeta /app/bin/libelectronmeta
  - sh -c 'install -Dm644 LICENSE "/app/share/licenses/${FLATPAK_ID}/libelectron-electron-meta/LICENSE"'
sources:
  - type: archive
    url: https://github.com/electron/electron/releases/download/v@ELECTRON_VERSION@/electron-v@ELECTRON_VERSION@-linux-x64.zip
    sha256: @ELECTRON_X64_SHA256@
    dest: electron-dist
    only-arches:
      - x86_64
  - type: archive
    url: https://github.com/electron/electron/releases/download/v@ELECTRON_VERSION@/electron-v@ELECTRON_VERSION@-linux-arm64.zip
    sha256: @ELECTRON_ARM64_SHA256@
    dest: electron-dist
    only-arches:
      - aarch64
  - type: file
    path: ../LICENSE
  - type: file
    path: ../scripts/libelectronmeta
