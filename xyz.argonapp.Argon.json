{
  "app-id": "xyz.argonapp.Argon",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "Argon",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--env=GTK_USE_PORTAL=1"
  ],
  "modules": [
    {
      "name": "argon",
      "buildsystem": "simple",
      "build-commands": [
        "ar x argon.deb",
        "tar -xf data.tar.*",
        "install -Dm755 usr/bin/Argon /app/bin/Argon",
        "install -Dm644 xyz.argonapp.Argon.desktop /app/share/applications/xyz.argonapp.Argon.desktop",
        "install -Dm644 xyz.argonapp.Argon.metainfo.xml /app/share/metainfo/xyz.argonapp.Argon.metainfo.xml",
        "install -Dm644 xyz.argonapp.Argon.png /app/share/icons/hicolor/256x256/apps/xyz.argonapp.Argon.png",
        "install -Dm644 TERMS.html /app/share/licenses/xyz.argonapp.Argon/argon/TERMS.html",
        "install -Dm644 usr/share/argon/flathub-channel.json /app/share/xyz.argonapp.Argon/channel.json"
      ],
      "sources": [
        {
