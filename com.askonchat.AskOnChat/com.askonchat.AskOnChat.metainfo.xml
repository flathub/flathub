<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.askonchat.AskOnChat</id>

  <name>AskOnChat</name>
  <summary>Unified inbox, team chat, and AI assistant for customer conversations</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://askonchat.com/terms</project_license>

  <developer id="com.askonchat">
    <name>AskOnChat</name>
  </developer>

  <description>
    <p>
      AskOnChat brings your customer conversations from WhatsApp, Instagram,
      Messenger, Telegram, and email into a single inbox, alongside team chat,
      contacts, bookings, tasks, calls, broadcasts, and an AI assistant.
    </p>
    <p>Features:</p>
    <ul>
      <li>One shared inbox across WhatsApp, Instagram, Messenger, Telegram, and email</li>
      <li>Internal team chat alongside customer threads</li>
      <li>Contacts, bookings, tasks, and call history in one place</li>
      <li>Broadcasts and reporting</li>
      <li>An AI assistant that drafts and answers from your conversation history</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.askonchat.AskOnChat.desktop</launchable>

  <url type="homepage">https://askonchat.com</url>

  <!-- Screenshots are fetched by Flathub over HTTPS; they are NOT bundled. Each URL
       below must resolve before submission. Upload the PNGs to Spaces first, e.g.:
         flatpak/tools/upload-screenshots.sh path/to/screenshots/
       (see flatpak/README.md > "Screenshots"). Rules: window <= 1000x700 (2000x1400
       HiDPI), keep the window decoration (title bar + shadows), PNG, caption one
       sentence with no trailing period. Add or remove <screenshot> entries to match
       the PNGs you actually upload; the first (type="default") is the hero image. -->
  <screenshots>
    <screenshot type="default">
      <image>https://askonchat-desktop.nyc3.cdn.digitaloceanspaces.com/desktop/screenshots/inbox.png</image>
      <caption>A shared inbox where the AI handles customer conversations</caption>
    </screenshot>
    <screenshot>
      <image>https://askonchat-desktop.nyc3.cdn.digitaloceanspaces.com/desktop/screenshots/assistant.png</image>
      <caption>Configure the AI front desk that answers for your business</caption>
    </screenshot>
    <screenshot>
      <image>https://askonchat-desktop.nyc3.cdn.digitaloceanspaces.com/desktop/screenshots/contacts.png</image>
      <caption>Contact intelligence across every channel</caption>
    </screenshot>
    <screenshot>
      <image>https://askonchat-desktop.nyc3.cdn.digitaloceanspaces.com/desktop/screenshots/bookings.png</image>
      <caption>Bookings synced with your calendar</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">moderate</content_attribute>
  </content_rating>

  <releases>
    <release version="1.0.25" date="2026-07-17">
      <description>
        <p>Initial Flatpak packaging of the AskOnChat desktop app.</p>
      </description>
    </release>
  </releases>
</component>
