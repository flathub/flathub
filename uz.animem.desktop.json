{
  "app-id": "uz.animem.desktop",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "animem-uz-wrapper",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--socket=session-bus",
    "--share=network",
    "--device=all"
  ],
  "modules": [
    {
      "name": "animem-uz",
      "buildsystem": "simple",
      "build-commands": [
        "chmod +x animem-uz-appimage",
        "./animem-uz-appimage --appimage-extract",
        "mkdir -p /app/bin",
        "cp -r squashfs-root/* /app/bin/",
        "chmod +x /app/bin/animem-uz",
        "echo '#!/bin/sh' > /app/bin/animem-uz-wrapper",
        "echo 'exec /app/bin/animem-uz --no-sandbox --disable-dev-shm-usage --disable-gpu-sandbox \"$@\"' >> /app/bin/animem-uz-wrapper",
        "chmod +x /app/bin/animem-uz-wrapper"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://github.com/mosinjonovjasurbek00-glitch/Animem-Uz/releases/download/1.0.0/Animem.Uz-1.0.0.AppImage",
          "sha256": "69afe14161232fc5e0ef1a9d8cd90a05c3d7bc3124f62a935c32da5b91b79773",
          "dest-filename": "animem-uz-appimage"
        }
      ]
    }
  ]
}
