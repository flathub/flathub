[Desktop Entry]
Version=1.0
Name=PPPlayer
Comment=Discover, stream, and play music and videos
Exec=ppplayer %U
Icon=com.ppplayer.PPPlayer
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Video;Player;
MimeType=audio/mpeg;audio/x-wav;audio/ogg;audio/flac;video/mp4;video/x-matroska;video/webm;x-scheme-handler/ppplayer;
Keywords=music;video;player;streaming;audio;media;
StartupWMClass=ppplayer
