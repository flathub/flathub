<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.FireFoxx150.NovaCommander</id>
  <name>Nova Commander</name>
  <summary>Dual-pane dark file manager</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.firefoxx150">
    <name>FireFoxx150</name>
  </developer>
  <description>
    <p>Nova Commander is a dual-pane file manager with columns, list and thumbnail views, tabs, a preview panel, undo and colour-coded file ages.</p>
    <p>Drag and drop moves files by default. Hold Ctrl while dragging to copy.</p>
    <ul>
      <li>Two panes, each with its own tabs</li>
      <li>Columns, list and thumbnail views, with video frame thumbnails</li>
      <li>Drag to select, Properties dialog, and file operations with pause and cancel</li>
      <li>Undo for moves, copies and renames</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.github.FireFoxx150.NovaCommander.desktop</launchable>
