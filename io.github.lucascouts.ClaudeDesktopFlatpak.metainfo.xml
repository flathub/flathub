<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.lucascouts.ClaudeDesktopFlatpak</id>

  <name>Claude Desktop</name>
  <summary>Chat with Claude from your desktop</summary>
  <developer id="io.github.lucascouts">
    <name>lucascouts</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://www.anthropic.com/legal/consumer-terms</project_license>

  <description>
    <p>
      Claude Desktop brings Anthropic's AI assistant to your desktop: chat with
      Claude, attach files and screenshots, use voice dictation, start Claude
      Code sessions on your projects and connect MCP servers for tool use.
    </p>
    <p>
      This is an unofficial package. It downloads the official Claude Desktop
      binary from Anthropic's release server at install time and is not
      affiliated with or endorsed by Anthropic. Requires a Claude.ai account.
    </p>
    <p>
      Note: local MCP servers must be launched on the host, e.g. with
      "flatpak-spawn --host npx ...". The virtual-machine code-execution
      sandbox feature is unavailable inside Flatpak.
    </p>
  </description>

  <launchable type="desktop-id">io.github.lucascouts.ClaudeDesktopFlatpak.desktop</launchable>

  <url type="homepage">https://claude.ai</url>
  <url type="help">https://code.claude.com/docs/en/desktop-linux</url>
  <url type="vcs-browser">https://github.com/lucascouts/ClaudeDesktopFlatpak</url>
  <url type="bugtracker">https://github.com/lucascouts/ClaudeDesktopFlatpak/issues</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/lucascouts/ClaudeDesktopFlatpak/main/screenshots/main.png</image>
      <caption>Claude Desktop main window</caption>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#da7756</color>
    <color type="primary" scheme_preference="dark">#2b2a27</color>
  </branding>

  <content_rating type="oars-1.1"/>

  <categories>
    <category>Utility</category>
    <category>Development</category>
  </categories>

  <keywords>
    <keyword>AI</keyword>
    <keyword>Chat</keyword>
    <keyword>Assistant</keyword>
    <keyword>Claude</keyword>
    <keyword>LLM</keyword>
  </keywords>

  <releases>
    <release version="1.20186.0" date="2026-07-08"/>
  </releases>
</component>
