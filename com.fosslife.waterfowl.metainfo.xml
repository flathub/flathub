      <image>https://raw.githubusercontent.com/fosslife/waterfowl/master/.github/screenshots/data-table.png</image>
      <caption>Browsing PostgreSQL table data with type-aware columns</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/fosslife/waterfowl/master/.github/screenshots/schema-overview.png</image>
      <caption>Schema overview — tables, views, functions and sequences</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/fosslife/waterfowl/master/.github/screenshots/welcome.png</image>
      <caption>Recent connections on the welcome screen</caption>
    </screenshot>
  </screenshots>

