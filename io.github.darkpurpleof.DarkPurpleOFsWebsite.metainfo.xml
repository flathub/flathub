<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.darkpurpleof.DarkPurpleOFsWebsite</id>
  <name>DarkPurpleOF's Website</name>
  <summary>DarkPurpleOF's Website for desktop</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
     <developer id="io.github.darkpurpleof">
     <name>DarkPurpleOF</name>
   </developer>
  <url type="homepage">https://darkpurpleof.github.io</url>
  <url type="bugtracker">https://darkpurpleof.github.io/support/help</url>
  <description>
    <p>DarkPurpleOF's Website, now right on your desktop. Stay connected with the community and keep everything one click away from your taskbar, with a faster, more comfortable experience than a browser tab.</p>
    <p>Highlights:</p>
    <ul>
      <li>Desktop notifications, so you know when something happens even while the app is in the background</li>
      <li>Plugins to extend and personalize the app, installed with a double-click on a plugin file</li>
      <li>Sticker packs you can import and use anywhere in the app</li>
      <li>Optional system tray and start-on-login support, where your desktop allows it</li>
      <li>Remembers your window size and position between sessions</li>
      <li>Safe mode when something isn't working as expected (This disables plugins!!)</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.darkpurpleof.DarkPurpleOFsWebsite.desktop</launchable>
  <provides>
    <id>io.github.darkpurpleof.DarkPurpleOFsWebsite.desktop</id>
  </provides>
  <content_rating type="oars-1.1">
    <content_attribute id="language-profanity">mild</content_attribute>
    <content_attribute id="language-humor">mild</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <screenshots>
    <screenshot type="default">
      <image type="source">https://darkpurpleof.github.io/assets/screenshots/1.png</image>
    </screenshot>
    <screenshot>
      <image type="source">https://darkpurpleof.github.io/assets/screenshots/2.png</image>
    </screenshot>
    <screenshot>
      <image type="source">https://darkpurpleof.github.io/assets/screenshots/3.png</image>
    </screenshot>
    <screenshot>
      <image type="source">https://darkpurpleof.github.io/assets/screenshots/4.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="1.0.0" date="2026-10-11">
      <description>
        <p>First release of DarkPurpleOF's Website for desktop.</p>
        <p>Some features may behave differently from the mobile version, be limited, not work yet, or be missing entirely. They will be added back over the following weeks.</p>
      </description>
    </release>
  </releases>
</component>
