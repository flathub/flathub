[Desktop Entry]
Type=Application
Name=PDFchemy Tools
GenericName=PDF Utility
Comment=Local-First Emergency Document Utility Built For The People
Exec=pdfchemy %U
Icon=io.github.kiss2oblivion.PDFchemy
Terminal=false
Categories=Office;Utility;Publishing;
MimeType=application/pdf;application/epub+zip;text/plain;
StartupNotify=true
StartupWMClass=com.pdfchemy.desktop.MainKt
Keywords=pdf;compress;merge;split;reader;reflow;privacy;offline;tools;
