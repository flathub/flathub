[Desktop Entry]
Name=Tocaê Reprodutor
Name[pt_BR]=Tocaê Reprodutor
Comment=Minimalist video player
Comment[pt_BR]=Reprodutor de vídeo minimalista
# Executa o binário através do zypak, que integra o sandbox do Chromium ao
# sandbox do Flatpak. É o mesmo wrapper apontado por `command:` no manifest.
Exec=run.sh %U
Icon=io.github.joaomjbraga.tocae-reprodutor
Terminal=false
Type=Application
Categories=AudioVideo;Player;
Keywords=video;player;playlist;media;vídeo;reprodutor;
StartupNotify=true
StartupWMClass=io.github.joaomjbraga.tocae-reprodutor
