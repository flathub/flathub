<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.livemcq.livemcq</id>

  <name>LiveMCQ</name>
  <summary>Practice MCQs and prepare for job exams</summary>

  <developer id="com.livemcq">
    <name>CrackTech Ltd</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <description>
    <p>
      LiveMCQ is an online exam preparation app. Take live and archived model
      tests, practise topic by topic, and study with videos, PDFs and audio, all
      in one place.
    </p>
    <p>Features:</p>
    <ul>
      <li>Model tests and exam preparation for BCS, bank, bar council, teacher, nurse and other job exams</li>
      <li>Archive of past questions with results, merit list and answer review</li>
      <li>Compass: see your progress and get practice suggestions for weak topics</li>
      <li>Study section with video, PDF and audio material, plus a study group</li>
      <li>Smart search and topic-wise practice</li>
    </ul>
    <p>An internet connection and a LiveMCQ account are required.</p>
  </description>

  <launchable type="desktop-id">com.livemcq.livemcq.desktop</launchable>

  <url type="homepage">https://web.livemcq.com</url>
  <url type="help">https://www.facebook.com/livemcq/</url>
  <url type="contact">mailto:contact@livemcq.com</url>

  <screenshots>
    <screenshot type="default">
      <image>https://assets.livemcq.com/apks/linux-distributions/screenshots/screenshot1.png</image>
      <caption>Home: exam, study and premium sections</caption>
    </screenshot>
    <screenshot>
      <image>https://assets.livemcq.com/apks/linux-distributions/screenshots/screenshot2.png</image>
      <caption>Weekly model test with routine, result and archive</caption>
    </screenshot>
    <screenshot>
      <image>https://assets.livemcq.com/apks/linux-distributions/screenshots/screenshot3.png</image>
      <caption>Compass: your progress and practice suggestions</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <keywords>
    <keyword>MCQ</keyword>
    <keyword>exam</keyword>
    <keyword>BCS</keyword>
    <keyword>study</keyword>
    <keyword>quiz</keyword>
  </keywords>

  <branding>
    <color type="primary" scheme_preference="light">#2736ab</color>
    <color type="primary" scheme_preference="dark">#7d8bf0</color>
  </branding>

  <requires>
    <internet>always</internet>
  </requires>
  <recommends>
    <display_length compare="ge">360</display_length>
  </recommends>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <releases>
    <release version="6.4.13" date="2026-11-09">
      <description>
        <p>First release on Flathub.</p>
      </description>
    </release>
  </releases>

  <update_contact>contact@livemcq.com</update_contact>
</component>
