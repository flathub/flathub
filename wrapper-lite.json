{
  "name": "wrapper-lite",
  "modules": [
    {
      "name": "wrapper-lite-entry",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm0755 start-wrapper-lite.sh /app/bin/start-wrapper-lite.sh"
      ],
      "sources": [
        {
          "type": "file",
          "path": "start-wrapper-lite.sh"
        }
      ]
    },
    {
      "name": "dtc",
      "buildsystem": "simple",
      "build-commands": [
        "meson setup build -Dprefix=/app -Dlibdir=lib -Dwerror=false -Dtools=false -Dpython=disabled -Dtests=false -Dyaml=disabled",
        "ninja -C build",
        "ninja -C build install"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/dgibson/dtc/archive/refs/tags/v1.8.1.tar.gz",
          "sha256": "74b50bb19134f6562490afea53e59953dd6c4afb17e5ccb60be32221262d3390",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 16911,
            "stable-only": true,
            "url-template": "https://github.com/dgibson/dtc/archive/refs/tags/v$version.tar.gz"
          }
        }
      ]
    },
    {
      "name": "libslirp",
      "buildsystem": "simple",
      "build-commands": [
        "meson setup build -Dprefix=/app -Dlibdir=lib -Ddefault_library=shared",
        "ninja -C build",
        "ninja -C build install"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.com/qemu-project/libslirp.git",
          "tag": "v4.9.5",
          "commit": "390848f47391f412451b2d259d8527fabb51e5e3",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^v(\\d+(?:\\.\\d+)*)$"
          }
        }
      ]
    },
    {
      "name": "qemu",
      "buildsystem": "simple",
      "build-commands": [
        "python3 -m zipfile -e /run/build/qemu/distlib-*.whl pydeps",
        "PKG_CONFIG_PATH=/app/lib/pkgconfig PYTHONPATH=$PWD/pydeps ./configure --prefix=/app --target-list=x86_64-softmmu --disable-docs --enable-fdt=system --enable-slirp --disable-gtk --extra-cflags=-I/app/include --extra-ldflags=-L/app/lib --disable-gcrypt --disable-nettle --disable-curses --disable-vnc --disable-sdl --disable-numa --disable-capstone --disable-vde --disable-vhost-net --disable-vhost-crypto --disable-vhost-kernel --disable-vhost-user --disable-vhost-user-blk-server --disable-vhost-vdpa --disable-fuse --disable-fuse-lseek --disable-libnfs --disable-tools --disable-werror",
        "make -j$(nproc)",
        "make install",
        "mkdir -p /app/bin/qemu/bin",
        "cp /app/bin/qemu-system-x86_64 /app/bin/qemu/bin/qemu-system-x86_64"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.qemu.org/qemu-8.2.10.tar.xz",
          "sha256": "37b4a643da8ed6015eef35f5d7f06e7259d9c95359965a0a98e9667c621ab2bb",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 13607,
            "stable-only": true,
            "versions": {
              "<": "8.3"
            },
            "url-template": "https://download.qemu.org/qemu-$version.tar.xz"
          }
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/c1/2b/238f02a4927fa2e27aa995371d240a468b52e42eae44a678434aff736b38/distlib-0.4.4-py2.py3-none-any.whl",
          "sha256": "cf09d55b1e85a89576b036aeb71550bfd68320f3f21761ca329eadadad918638",
          "x-checker-data": {
            "type": "pypi",
            "name": "distlib",
            "packagetype": "bdist_wheel"
          }
        }
      ]
    },
    {
      "name": "wrapper-lite-qemu",
      "buildsystem": "simple",
      "build-commands": [
        "g++ -std=c++11 -O2 -Wall -o wrapper-lite-qemu wrapper-lite-qemu.cpp",
        "install -Dm0755 wrapper-lite-qemu /app/bin/wrapper-lite-qemu"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/jannuary/wrapper.git",
          "commit": "884384935368137233ba1129ceb53bd34bbc81fc"
        }
      ]
    },
    {
      "name": "e2fsprogs",
      "buildsystem": "autotools",
      "config-opts": [
        "--prefix=/app",
        "--sbindir=/app/bin",
        "--disable-libblkid",
        "--disable-libuuid",
        "--disable-uuidd",
        "--disable-nls",
        "--disable-rpath"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v1.47.4/e2fsprogs-1.47.4.tar.xz",
          "sha256": "fd5bf388cbdbe006a3d3b318d983b2948382440acc85a87f1e7d108653e8db0b",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 646,
            "stable-only": true,
            "url-template": "https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v$version/e2fsprogs-$version.tar.xz"
          }
        }
      ]
    },
    {
      "name": "wrapper-lite-assets",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm0644 qemu/vmlinuz-lite-qemu /app/bin/qemu/vmlinuz-lite-qemu",
        "install -Dm0644 qemu/lite-initramfs.cpio.gz /app/bin/qemu/lite-initramfs.cpio.gz",
        "truncate -s 64M /app/bin/qemu/data.img",
        "/app/bin/mke2fs -q -t ext4 -F /app/bin/qemu/data.img"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/jannuary/wrapper.git",
          "commit": "884384935368137233ba1129ceb53bd34bbc81fc"
        }
      ]
    }
  ]
}
