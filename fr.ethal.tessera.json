{
  "app-id": "fr.ethal.tessera",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "tessera-gtk",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/tessera/cargo"
    }
  },
  "modules": [
    {
      "name": "tessera",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release -p tessera-gtk --offline",
        "install -Dm755 target/release/tessera-gtk -t /app/bin/",
        "install -Dm644 data/fr.ethal.tessera.desktop -t /app/share/applications/",
        "install -Dm644 data/fr.ethal.tessera.metainfo.xml -t /app/share/metainfo/",
        "install -Dm644 data/icons/hicolor/scalable/apps/fr.ethal.tessera.svg -t /app/share/icons/hicolor/scalable/apps/"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://codeberg.org/ethal/tessera.git",
          "tag": "v0.1.0",
          "commit": "79147b7f077dd2e7c4e99c01fc0f6a435dc9d324"
        },
        "cargo-sources.json"
      ]
    }
  ]
}