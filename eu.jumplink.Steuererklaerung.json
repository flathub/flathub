{
  "id": "eu.jumplink.Steuererklaerung",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.node24",
    "org.freedesktop.Sdk.Extension.typescript"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/node24/bin:/usr/lib/sdk/typescript/bin:/app/bin"
  },
  "command": "steuererklaerung",
  "finish-args": [
    "--device=dri",
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--talk-name=org.freedesktop.secrets",
    "--env=GJSIFY_LOCALE_DIR=/app/share/locale"
  ],
  "modules": [
    {
      "name": "intltool",
      "cleanup": [
        "*"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://launchpad.net/intltool/trunk/0.51.0/+download/intltool-0.51.0.tar.gz",
          "sha256": "67c74d94196b153b774ab9f89b2fa6c6ba79352407037c8c14d5aeb334e959cd"
        }
      ]
    },
    {
      "name": "libgda",
      "buildsystem": "meson",
      "config-opts": [
        "-Dui=false",
        "-Dhelp=false",
        "-Djson=true",
        "-Dsqlcipher=false",
        "-Dlibsoup=false",
        "-Dlibsecret=false",
        "-Dexamples=false",
        "-Dtools=false",
        "-Ddoc=false",
        "-Dldap=false",
        "-Dweb=false"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/gtk-doc",
        "/bin"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libgda/6.0/libgda-6.0.0.tar.xz",
          "sha256": "995f4b420e666da5c8bac9faf55e7aedbe3789c525d634720a53be3ccf27a670"
        }
      ]
    },
    {
      "name": "steuererklaerung",
      "buildsystem": "simple",
      "build-commands": [
        "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs install --immutable",
        "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs workspace steuererklaerung-cli i18n:compile",
        "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs workspace steuererklaerung-cli build:app:flathub",
        "install -d /app/bin",
        "printf '#!/usr/bin/gjs -m\\n' > /app/bin/steuererklaerung",
        "cat app/dist/app/steuer-app.gjs.mjs >> /app/bin/steuererklaerung",
        "chmod 0755 /app/bin/steuererklaerung",
        "install -d /app/lib/girepository-1.0",
        "install -m644 node_modules/@gjsify/http-soup-bridge-linux-x64/prebuilds/linux-x64/GjsifyHttpSoupBridge-1.0.typelib /app/lib/girepository-1.0/",
        "install -m755 node_modules/@gjsify/http-soup-bridge-linux-x64/prebuilds/linux-x64/libgjsifyhttpsoupbridge.so /app/lib/",
        "install -d /app/demo",
        "cp -r app/demo/. /app/demo/",
        "install -d /app/share/locale",
        "cp -r app/dist/locale/. /app/share/locale/",
        "install -Dm644 app/data/eu.jumplink.Steuererklaerung.desktop /app/share/applications/eu.jumplink.Steuererklaerung.desktop",
        "install -Dm644 app/data/eu.jumplink.Steuererklaerung.metainfo.xml /app/share/metainfo/eu.jumplink.Steuererklaerung.metainfo.xml",
        "install -Dm644 app/data/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg /app/share/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg",
        "install -Dm644 app/data/icons/hicolor/symbolic/apps/eu.jumplink.Steuererklaerung-symbolic.svg /app/share/icons/hicolor/symbolic/apps/eu.jumplink.Steuererklaerung-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/JumpLink/steuererklaerung.git",
          "tag": "v0.1.4",
          "commit": "7a674f1b0f7ae542d351462d87830edde3a0426c",
          "disable-submodules": true,
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^v(\\d+\\.\\d+\\.\\d+)$",
            "version-scheme": "semantic"
          }
        }
      ]
    }
  ]
}
