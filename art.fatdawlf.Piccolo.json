{
    "id": "art.fatdawlf.Piccolo",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "piccolo",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "modules": [
        {
            "name": "piccolo",
            "builddir": true,
            "buildsystem": "meson",
            "config-opts": [
                "-Dprofile=release",
                "-Dapp_id_suffix="
            ],
            "build-options": {
                "env": [
                    "CARGO_NET_OFFLINE=true"
                ]
            },
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/Azakidev/Piccolo",
                    "tag": "0.1.0-flathub",
                    "commit": "1f3e77cdcf206a16a5ea9078f858bc700385f182"
                },
                "cargo-sources-piccolo.json",
                {
                    "type": "shell",
                    "commands": [
                        "mkdir .cargo",
                        "cp cargo/config .cargo"
                    ]
                }
            ]
        }
    ]
}
