  <name>MeshApp</name>
  <summary>Meshtastic desktop client</summary>
  <developer id="app.privatepractice">
    <name>Konstantin A. Smirnov</name>
  </developer>
  <launchable type="desktop-id">app.privatepractice.meshapp.desktop</launchable>
  <description>
    <p>MeshApp is a desktop client for Meshtastic devices and mesh networks.</p>
    <p>It supports TCP, serial or USB and Bluetooth Low Energy connections, chat, node monitoring, telemetry charts, packet debugging and device configuration.</p>
  </description>
