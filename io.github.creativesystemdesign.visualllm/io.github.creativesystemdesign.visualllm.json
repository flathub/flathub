{
  "app-id": "io.github.creativesystemdesign.visualllm",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "visualllm",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=network",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "visualllm",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 visualllm /app/bin/visualllm",
        "install -Dm644 io.github.creativesystemdesign.visualllm.desktop /app/share/applications/io.github.creativesystemdesign.visualllm.desktop",
        "install -Dm644 icon.png /app/share/icons/hicolor/512x512/apps/io.github.creativesystemdesign.visualllm.png",
        "install -Dm644 io.github.creativesystemdesign.visualllm.metainfo.xml /app/share/metainfo/io.github.creativesystemdesign.visualllm.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/io.github.creativesystemdesign.visualllm/LICENSE"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/CreativeSystemDesign/visualllm/releases/download/v0.1.0/visualllm-v0.1.0.tar.gz",
          "sha256": "REPLACE_WITH_ACTUAL_SHA256_ON_RELEASE"
        }
      ]
    }
  ]
}