<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.lumtub.lumtub</id>
  <name>Lumtub</name>
  <summary>Watch YouTube your way</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.lumtub">
    <name>Lumtub</name>
  </developer>
  <description>
    <p>
      A YouTube client with mpv playback, on-device recommendations you can understand and control,
      bilingual subtitles and live chat as danmaku on the video. Watch without signing in; connect
      your account only when you want to interact.
    </p>
    <ul>
      <li>Smooth playback with mpv and hardware decoding, up to 8K</li>
      <li>A home feed worked out on your computer, with the reason for every video</li>
      <li>Two subtitle lines at once, for learning a language</li>
      <li>Live chat flying over the video</li>
      <li>SponsorBlock, DeArrow and Return YouTube Dislike</li>
      <li>Downloads, picture-in-picture and casting to Chromecast and DLNA TVs</li>
      <li>Dozens of skins and more than 70 interface languages</li>
    </ul>
    <p>Lumtub is not affiliated with YouTube or Google.</p>
  </description>
