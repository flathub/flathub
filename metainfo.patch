-    install (FILES ${PROJECT_NAME}.appdata.xml DESTINATION ${SHARE_DIR}/metainfo)
+    install (FILES ${PROJECT_NAME}.metainfo.xml DESTINATION ${SHARE_DIR}/metainfo)
