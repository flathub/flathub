diff --git a/flatpak/io.github.zerospades.ZeroSpades.metainfo.xml b/flatpak/io.github.zerospades.ZeroSpades.metainfo.xml
new file mode 100644
index 0000000..d16d055
--- /dev/null
+++ b/flatpak/io.github.zerospades.ZeroSpades.metainfo.xml
@@ -0,0 +1,86 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<component type="desktop-application">
+  <id>io.github.zerospades.ZeroSpades</id>
+  <metadata_license>CC0-1.0</metadata_license>
+  <project_license>GPL-3.0+ and LicenseRef-Proprietary=https://github.com/yvt/openspades-paks/blob/master/Nonfree/LICENSE.md
+  </project_license>
+  <developer id="io.github.zerospades">
+    <name>ZeroSpades</name>
+  </developer>
+  <name>ZeroSpades</name>
+
+  <summary>Open Source voxel shooter</summary>
+
+  <description>
+    <p> ZeroSpades is a fork of OpenSpades, a clone of Ace of Spades 0.75, which is a free online
+    first-person shooter created by Ben Aksoy, featuring fully destructible
+    terrain and plenty of game modes (including the well-known Capture the
+    Flag) created by the community.</p>
+    <ul>
+      <li>Can connect to a vanilla/pyspades/pysnip server</li>
+      <li>Uses OpenGL/AL for better experience</li>
+      <li>Open source, and cross platform</li>
+    </ul>
+  </description>
+
+  <categories>
+    <category>Game</category>
+    <category>Shooter</category>
+  ​</categories>
+
+  <content_rating type="oars-1.1">
+    <content_attribute id="violence-cartoon">intense</content_attribute>
+    <content_attribute id="violence-bloodshed">mild</content_attribute>
+    <content_attribute id="social-chat">intense</content_attribute>
+  </content_rating>
+
+  <launchable type="desktop-id">io.github.zerospades.ZeroSpades.desktop</launchable>
+
+  <url type="homepage">https://github.com/zerospades/zerospades/</url>
+  <url type="bugtracker">https://github.com/zerospades/zerospades/issues</url>
+  
+  <screenshots>
+    <screenshot type="default">
+      <image>https://openspades.yvt.jp/media/images/ss4.jpg</image>
+    </screenshot>
+    <screenshot>
+      <image>https://openspades.yvt.jp/media/images/ss5.jpg</image>
+    </screenshot>
+    <screenshot>
+      <image>https://openspades.yvt.jp/media/images/ss6.jpg</image>
+    </screenshot>
+    <screenshot>
+      <image>https://openspades.yvt.jp/media/images/ss1.jpg</image>
+    </screenshot>
+    <screenshot>
+      <image>https://openspades.yvt.jp/media/images/ss2.jpg</image>
+    </screenshot>
+    <screenshot>
+      <image>https://openspades.yvt.jp/media/images/ss3.jpg</image>
+    </screenshot>
+  </screenshots>
+
+  <releases>
+    <release version="0.0.8" date="2025-12-25" url="https://github.com/zerospades/zerospades/releases/tag/v0.0.8">
+      <description>
+        <p>Highlights:</p>
+        <ul>
+          <li>Configurable keybindings for quick volume control (<code>cg_keyVolumeUp</code>,
+            <code>cg_keyVolumeDown</code>).
+          </li>
+          <li>Toggle spectator mode at any time for admins (<code>cg_keyStaffSpectating</code>).
+          </li>
+          <li>Added weapon charms/keychains (<code>cg_weaponCharms</code>).
+          </li>
+          <li>Added cartoon-style outlines in OpenGL mode (<code>r_outlines</code>).
+          </li>
+          <li>Option to display the names of dead players (<code>cg_playerNamesDead</code>).
+          </li>
+          <li>Added an option to switch between classic recoil and the v0.1.3 recoil model
+            (<code>cg_classicWeaponRecoil</code>).
+          </li>
+        </ul>
+      </description>
+    </release>
+  </releases>
+</component>
