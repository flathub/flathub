#!/bin/sh
# Launcher for SolidWave Radio inside the Flatpak sandbox.
HERE="/app"
export LD_LIBRARY_PATH="${HERE}/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

FONT_DIR="${HERE}/share/solidwave_radio/fonts"
if [ ! -e "${HERE}/bin/fonts" ] && [ -d "${FONT_DIR}" ]; then
  ln -sfn "${FONT_DIR}" "${HERE}/bin/fonts" 2>/dev/null || true
fi

PRESET_DIR="${HERE}/share/solidwave_radio/presets"
if [ ! -e "${HERE}/bin/presets" ] && [ -d "${PRESET_DIR}" ]; then
  ln -sfn "${PRESET_DIR}" "${HERE}/bin/presets" 2>/dev/null || true
fi

cd "${HERE}/bin" || exit 1
exec "${HERE}/bin/solidwave_radio" "$@"
