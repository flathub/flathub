<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Moresyl.MetaClean</id>
  <name>MetaClean</name>
  <summary>Remove file metadata offline</summary>
  <developer id="io.github.moresyl">
    <name>Moresyl</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      MetaClean removes potentially sensitive metadata from images, PDFs,
      Office documents, and text files without uploading them to a server.
    </p>
    <p>
      Select one or more files, review the planned output, and create cleaned
      copies locally. Originals are preserved, and processing remains offline.
    </p>
  </description>
  <launchable type="desktop-id">io.github.Moresyl.MetaClean.desktop</launchable>
  <provides>
    <binary>metaclean</binary>
  </provides>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Moresyl/metaclean/f60becff65126a38072bb187f1a5fb1937d4cb7c/assets/metaclean-screenshot.png</image>
      <caption>MetaClean file selection and cleaning interface</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/Moresyl/metaclean</url>
  <url type="bugtracker">https://github.com/Moresyl/metaclean/issues</url>
  <url type="vcs-browser">https://github.com/Moresyl/metaclean</url>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.1.0" date="2026-08-15">
      <description>
        <p>Initial public release with cross-platform offline metadata cleaning.</p>
      </description>
    </release>
  </releases>
</component>
