{
  "app-id": "io.github.creativesystemdesign.visualllm",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "visualllm",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=network",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "visualllm",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 visualllm /app/bin/visualllm",
        "install -Dm644 io.github.creativesystemdesign.visualllm.desktop /app/share/applications/io.github.creativesystemdesign.visualllm.desktop",
        "install -Dm644 icons/io.github.creativesystemdesign.visualllm.png /app/share/icons/hicolor/512x512/apps/io.github.creativesystemdesign.visualllm.png",
        "install -Dm644 io.github.creativesystemdesign.visualllm.metainfo.xml /app/share/metainfo/io.github.creativesystemdesign.visualllm.metainfo.xml",
        "install -Dm644 LICENSE /app/share/licenses/io.github.creativesystemdesign.visualllm/LICENSE"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/CreativeSystemDesign/visualllm/releases/download/v0.5.0/visualllm-v0.5.0.tar.gz",
          "sha256": "17454f298ad6e7220cfd3f09b4d90eb94806b0f9ae35cbf4e63be5f73e021a03"
        },
        {
          "type": "file",
          "path": "io.github.creativesystemdesign.visualllm.desktop"
        },
        {
          "type": "file",
          "path": "io.github.creativesystemdesign.visualllm.metainfo.xml"
        },
        {
          "type": "file",
          "path": "icons/io.github.creativesystemdesign.visualllm.png"
        },
        {
          "type": "file",
          "path": "LICENSE"
        }
      ]
    }
  ]
}
