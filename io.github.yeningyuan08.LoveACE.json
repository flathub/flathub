{
  "app-id": "io.github.yeningyuan08.LoveACE",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "loveace",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-download"
  ],
  "build-options": {
    "append-path": "/app/opt/flutter/bin",
    "env": {
      "FLUTTER_SUPPRESS_ANALYTICS": "true",
      "PKG_CONFIG_PATH": "/app/lib/pkgconfig:/app/lib/x86_64-linux-gnu/pkgconfig:/app/share/pkgconfig:/usr/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig"
    }
  },
  "modules": [
    {
      "name": "libsecret",
      "buildsystem": "meson",
      "config-opts": [
        "-Dintrospection=false",
        "-Dvapi=false",
        "-Dmanpage=false",
        "-Dgtk_doc=false",
        "-Dcrypto=libgcrypt"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libsecret/0.21/libsecret-0.21.7.tar.xz",
          "sha256": "6b452e4750590a2b5617adc40026f28d2f4903de15f1250e1d1c40bfd68ed55e"
        }
      ]
    },
    {
      "name": "flutter-sdk",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/opt",
        "cp -r flutter /app/opt/flutter"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.44.2-stable.tar.xz",
          "sha256": "b0de1d19754688ec6769c9a067db3b0594479d3d767f971bfecfc132904c8d5e",
          "strip-components": 1,
          "dest": "flutter"
        }
      ]
    },
    {
      "name": "loveace",
      "buildsystem": "simple",
      "build-commands": [
        "flutter config --no-analytics",
        "flutter pub get",
        "flutter build linux --release",
        "mkdir -p /app/bin /app/loveace",
        "cp -r build/linux/x64/release/bundle/* /app/loveace/",
        "ln -s /app/loveace/loveace /app/bin/loveace",
        "install -Dm644 assets/images/logo.png /app/share/icons/hicolor/512x512/apps/io.github.yeningyuan08.LoveACE.png",
        "install -Dm644 io.github.yeningyuan08.LoveACE.desktop /app/share/applications/io.github.yeningyuan08.LoveACE.desktop",
        "install -Dm644 io.github.yeningyuan08.LoveACE.metainfo.xml /app/share/metainfo/io.github.yeningyuan08.LoveACE.metainfo.xml"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/yeningyuan08/LoveACE.git",
          "branch": "flathub",
          "path": "desktop"
        }
      ]
    }
  ]
}
