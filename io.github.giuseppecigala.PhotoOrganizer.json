{
    "id": "io.github.giuseppecigala.PhotoOrganizer",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "base": "io.qt.PySide.BaseApp",
    "base-version": "6.10",
    "command": "photo-organizer",
    "build-options": {
        "env": {
            "BASEAPP_REMOVE_WEBENGINE": "1",
            "BASEAPP_DISABLE_NUMPY": "1"
        }
    },
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-pictures",
        "--filesystem=xdg-documents",
        "--filesystem=xdg-download"
    ],
    "cleanup-commands": [
        "/app/cleanup-BaseApp.sh"
    ],
    "modules": [
        "python3-pillow.json",
        {
            "name": "photo-organizer",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 main.py /app/bin/photo-organizer",
                "install -d /app/bin/resources",
                "cp app_icon.png folder.png organize.png license.txt /app/bin/resources/",
                "install -d /app/share/applications",
                "install -Dm644 io.github.giuseppecigala.PhotoOrganizer.desktop /app/share/applications/io.github.giuseppecigala.PhotoOrganizer.desktop",
                "install -d /app/share/metainfo",
                "install -Dm644 io.github.giuseppecigala.PhotoOrganizer.metainfo.xml /app/share/metainfo/io.github.giuseppecigala.PhotoOrganizer.metainfo.xml",
                "install -d /app/share/icons/hicolor/128x128/apps",
                "install -Dm644 io.github.giuseppecigala.PhotoOrganizer.png /app/share/icons/hicolor/128x128/apps/io.github.giuseppecigala.PhotoOrganizer.png"
            ],
            "sources": [
                { "type": "file", "path": "main.py" },
                { "type": "file", "path": "resources/app_icon.png" },
                { "type": "file", "path": "resources/folder.png" },
                { "type": "file", "path": "resources/organize.png" },
                { "type": "file", "path": "resources/license.txt" },
                { "type": "file", "path": "io.github.giuseppecigala.PhotoOrganizer.desktop" },
                { "type": "file", "path": "io.github.giuseppecigala.PhotoOrganizer.metainfo.xml" },
                { "type": "file", "path": "io.github.giuseppecigala.PhotoOrganizer.png" }
            ]
        }
    ]
}