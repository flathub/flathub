{
  "id": "com.rolaca11.mcp_inspector",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "24.08",
  "command": "mcp-inspector",
  "finish-args": [
    "--socket=wayland",
    "--socket=x11",
    "--share=ipc",
    "--device=dri",
    "--socket=pulseaudio",
    "--filesystem=home",
    "--share=network",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "mcp-inspector",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 mcp-inspector.sh /app/bin/mcp-inspector",
        "cp -r linux-unpacked /app/lib/mcp-inspector",
        "install -Dm644 com.rolaca11.mcp_inspector.desktop /app/share/applications/com.rolaca11.mcp_inspector.desktop",
        "install -Dm644 com.rolaca11.mcp_inspector.svg /app/share/icons/hicolor/scalable/apps/com.rolaca11.mcp_inspector.svg",
        "install -Dm644 com.rolaca11.mcp_inspector.metainfo.xml /app/share/metainfo/com.rolaca11.mcp_inspector.metainfo.xml"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/rolaca11/mcp-inspector/releases/download/v1.0.7/mcp-inspector-linux-x86_64.tar.gz",
          "sha256": "TODO_UPDATE_WITH_SHA256_FROM_RELEASE",
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/rolaca11/mcp-inspector/releases/latest",
            "version-query": ".tag_name | sub(\"^v\"; \"\")",
            "url-query": ".assets[] | select(.name == \"mcp-inspector-linux-x86_64.tar.gz\") | .browser_download_url"
          }
        },
        {
          "type": "file",
          "path": "mcp-inspector.sh"
        },
        {
          "type": "file",
          "path": "com.rolaca11.mcp_inspector.desktop"
        },
        {
          "type": "file",
          "path": "com.rolaca11.mcp_inspector.svg"
        },
        {
          "type": "file",
          "path": "com.rolaca11.mcp_inspector.metainfo.xml"
        }
      ]
    }
  ]
}
