<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.shafayeatt1995.XorinPlayer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Xorin Player</name>
  <summary>High-Fidelity Audio and Cinema Video Player powered by Rust</summary>
  <description>
    <p>
      Xorin Player is an ultra-fast, lightweight desktop media player engineered with Rust,
      eframe/egui, Symphonia, and VLC hardware acceleration.
    </p>
    <p>Features:</p>
    <ul>
      <li>Minimal memory footprint (~18MB RAM)</li>
      <li>Hardware-accelerated cinema video playback</li>
      <li>10-band interactive visual equalizer</li>
      <li>Rich playlist management and drag-and-drop support</li>
      <li>Native file association and Open-With capabilities</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.shafayeatt1995.XorinPlayer.desktop</launchable>
  <url type="homepage">https://github.com/shafayeatt1995/music_player</url>
  <url type="bugtracker">https://github.com/shafayeatt1995/music_player/issues</url>
  <developer_name>Shafayeat Al-Anik</developer_name>
  <provides>
    <binary>xorin-player</binary>
    <mediatype>audio/mpeg</mediatype>
    <mediatype>audio/mp3</mediatype>
    <mediatype>audio/x-wav</mediatype>
    <mediatype>audio/wav</mediatype>
    <mediatype>audio/flac</mediatype>
    <mediatype>audio/x-flac</mediatype>
    <mediatype>audio/ogg</mediatype>
    <mediatype>audio/aac</mediatype>
    <mediatype>audio/mp4</mediatype>
    <mediatype>audio/x-m4a</mediatype>
    <mediatype>video/mp4</mediatype>
    <mediatype>video/x-matroska</mediatype>
    <mediatype>video/x-msvideo</mediatype>
    <mediatype>video/quicktime</mediatype>
    <mediatype>video/webm</mediatype>
  </provides>
  <releases>
    <release version="1.0.0" date="2026-10-20">
      <description>
        <p>Initial stable release with full cross-platform audio and video support.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
