{
    "app-id": "io.github.eduszesz.Evangelion",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "evangelion-run",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri"
    ],
    "build-options": {
        "cflags": "-I/app/include -I/app/include/SDL2",
        "cxxflags": "-I/app/include -I/app/include/SDL2",
        "env": {
            "LOCALBASE": "/app",
            "C_INCLUDE_PATH": "/app/include:/app/include/SDL2",
            "LIBRARY_PATH": "/app/lib"
        }
    },
    "modules": [
        "shared-modules/SDL2/SDL2_image.json",
        "shared-modules/SDL2/SDL2_ttf.json",
        "shared-modules/SDL2/SDL2_mixer.json",
        "python3-pygame.json",
        {
            "name": "evangelion",
            "buildsystem": "simple",
            "build-commands": [
                "install -d /app/share/evangelion",
                "install -m 644 evangelion.py /app/share/evangelion/",
                "install -m 644 tema_*.mp3 /app/share/evangelion/",
                "install -m 644 icon-at.png /app/share/evangelion/",
                "install -m 644 dejavu-sans-mono.bold.ttf /app/share/evangelion/",
                "install -Dm 755 evangelion-run /app/bin/evangelion-run",
                "install -Dm 644 io.github.eduszesz.Evangelion.desktop /app/share/applications/io.github.eduszesz.Evangelion.desktop",
                "install -Dm 644 icon-at.png /app/share/icons/hicolor/256x256/apps/io.github.eduszesz.Evangelion.png",
                "install -Dm 644 io.github.eduszesz.Evangelion.metainfo.xml /app/share/metainfo/io.github.eduszesz.Evangelion.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/eduszesz/evangelion.git",
                    "tag": "v1.0.3",
                    "commit": "e582678c01c89c13fd762e014f2a73fd4e3ad3b1"
                }
            ]
        }
    ]
}
