<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.victumapp.pos</id>
  <name>VictumPOS</name>
  <summary>Desktop point-of-sale terminal</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://pos.victumapp.com/pos</project_license>
  <developer id="com.victumapp">
    <name>Victum</name>
  </developer>
  <url type="homepage">https://pos.victumapp.com/pos</url>
  <description>
    <p>VictumPOS is a desktop point-of-sale terminal for businesses that use the Victum platform.</p>
    <p>The application integrates the web POS with local desktop capabilities required at the register, including ESC/POS printing, notifications, audio feedback, location access, and local bridge communication.</p>
  </description>
  <launchable type="desktop-id">com.victumapp.pos.desktop</launchable>
  <keywords>
    <keyword>POS</keyword>
    <keyword>Point of Sale</keyword>
    <keyword>Retail</keyword>
    <keyword>Printing</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#1F6FEB</color>
    <color type="primary" scheme_preference="dark">#0F3D70</color>
  </branding>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <image>https://github.com/ANDERSON-OSORIO/VictumPOS-Linux-Releases/releases/download/v1.0.3/victumpos-screenshot-1.png</image>
      <caption>VictumPOS desktop terminal</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/ANDERSON-OSORIO/VictumPOS-Linux-Releases/releases/download/v1.0.3/victumpos-screenshot-2.png</image>
      <caption>Point-of-sale workspace</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/ANDERSON-OSORIO/VictumPOS-Linux-Releases/releases/download/v1.0.3/victumpos-screenshot-3.png</image>
      <caption>VictumPOS configuration and register tools</caption>
    </screenshot>
  </screenshots>
