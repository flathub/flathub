#!/bin/bash
set -e

# Tibia Flatpak wrapper script
# This script ensures proper environment setup for Tibia

export LD_LIBRARY_PATH="/app/share/Tibia/lib:$LD_LIBRARY_PATH"
export QT_QPA_PLATFORM_PLUGIN_PATH="/app/share/Tibia/plugins"
export FONTCONFIG_PATH="/app/etc/fonts"

# Optional: Set working directory to avoid permission issues
cd "$HOME" || cd /tmp

# Launch Tibia
exec /app/share/Tibia/Tibia "$@"

