<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.playtarockonline.PlayTarockOnline</id>
  <name>PlayTarockOnline</name>
  <summary>Play Slovenian tarock online</summary>
  <summary xml:lang="sl">Slovenski tarok na spletu</summary>
  <developer id="com.playtarockonline">
    <name>Play Tarock Online</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <description>
    <p>PlayTarockOnline is the home of Slovenian tarock online. Take a seat, pick a game and play with friends, players from all over Slovenia or computer opponents, any time and without waiting.</p>
    <p>The game follows Slovenian tarock rules: bidding, calling a king, the talon, announcements, contra and automatic scoring.</p>
    <ul>
      <li>Games for 4, 3 or 2 players</li>
      <li>Computer opponents fill empty seats so you can play right away</li>
      <li>Friends, game invitations and table chat</li>
      <li>Tournaments and a rated leaderboard</li>
      <li>Watch other players' games live</li>
      <li>Choice of card styles and table looks</li>
      <li>The same game and account on computer, phone and tablet</li>
    </ul>
    <p xml:lang="sl">PlayTarockOnline je dom slovenskega taroka na spletu. Igraj s prijatelji, z igralci iz vse Slovenije ali z računalniškimi nasprotniki, kadarkoli in brez čakanja.</p>
    <p>The app is the official desktop client of playtarockonline.com; an internet connection and an account are required.</p>
  </description>
  <launchable type="desktop-id">com.playtarockonline.PlayTarockOnline.desktop</launchable>
