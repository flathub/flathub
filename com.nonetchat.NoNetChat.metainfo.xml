<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.nonetchat.NoNetChat</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>NoNetChat</name>
  <summary>Chat with nearby devices over Bluetooth and local networks</summary>
  <summary xml:lang="fr">Communiquez à proximité par Bluetooth et sur le réseau local</summary>
  <developer id="com.nonetchat">
    <name>Pascal Mietlicki</name>
  </developer>
  <description>
    <p>NoNetChat connects nearby devices through Bluetooth Low Energy and
       local networks. Exchange messages, files and voice notes without
       an Internet messaging account.</p>
    <p>Local audio and video features use the bundled WebRTC engine.
       Available connections depend on your hardware and operating system.</p>
    <p xml:lang="fr">NoNetChat relie les appareils à proximité par Bluetooth
       Low Energy et sur les réseaux locaux. Échangez des messages, des
       fichiers et des notes vocales sans compte de messagerie Internet.</p>
    <p xml:lang="fr">Les fonctions audio et vidéo locales utilisent le moteur
       WebRTC inclus. Les connexions disponibles dépendent du matériel et
       du système d'exploitation.</p>
  </description>
  <launchable type="desktop-id">com.nonetchat.NoNetChat.desktop</launchable>
  <provides>
    <binary>nonetchat</binary>
  </provides>
  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
  </categories>
  <url type="homepage">https://nonetchat.com/</url>
  <url type="bugtracker">https://github.com/pmietlicki/nonetchat-linux/issues</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-info">intense</content_attribute>
  </content_rating>
