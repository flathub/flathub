<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.hannes_software.ToneForge</id>
  <name>Tone Forge</name>
  <summary>Offline modular synthesizer and sound-design workbench</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://hannes-software.com/terms/</project_license>

  <developer id="com.hannes_software">
    <name>Hannes Software</name>
  </developer>

  <description>
    <p>
      Tone Forge is a native, offline-first modular synthesizer and sound-design workbench for Linux.
      Connect oscillators, filters, envelopes, LFOs, and modulation paths on a visual patch graph,
      audition patches in real time, and shape your tone through a serial output-effects chain.
    </p>
    <p>
      The permanent free Community Edition runs completely locally with no account, cloud dependency,
      or background telemetry. An optional Pro license unlocks expanded module slots and library workflows.
    </p>
  </description>

  <launchable type="desktop-id">com.hannes_software.ToneForge.desktop</launchable>

  <url type="homepage">https://hannes-software.com/tone-forge/</url>
  <url type="help">https://hannes-software.com/contact/</url>
  <url type="vcs-browser">https://github.com/hannes-wan/tone-forge-official</url>

  <branding>
    <color type="primary" scheme_preference="light">#d96b38</color>
    <color type="primary" scheme_preference="dark">#1e2430</color>
  </branding>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Music</category>
  </categories>

  <keywords>
    <keyword>synthesizer</keyword>
    <keyword>modular</keyword>
    <keyword>sound-design</keyword>
    <keyword>audio</keyword>
    <keyword>music</keyword>
    <keyword>offline</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <content_rating type="oars-1.1" />

  <screenshots>
    <screenshot type="default">
      <caption>Visual modular oscillator and patch graph workspace in Tone Forge</caption>
      <image>https://raw.githubusercontent.com/hannes-wan/tone-forge-official/main/docs/screenshots/oscillator-graph-01.png</image>
    </screenshot>
    <screenshot>
      <caption>Real-time filter audition and modulation controls</caption>
      <image>https://raw.githubusercontent.com/hannes-wan/tone-forge-official/main/docs/screenshots/live-filter-audition-01.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.2" date="2026-11-24">
      <description>
        <p>Improved visual oscillator patch graph editing, live filter audition, and Linux desktop packaging.</p>
      </description>
    </release>
    <release version="0.1.1" date="2026-11-22">
      <description>
        <p>Stability improvements and serial output effects refinement.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-07">
      <description>
        <p>Initial release of Tone Forge for Linux and Windows.</p>
      </description>
    </release>
  </releases>
</component>
