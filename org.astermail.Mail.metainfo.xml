<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.astermail.Mail</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <name>Aster Mail</name>
  <summary>End-to-end encrypted, quantum-safe email</summary>

  <developer id="org.astermail">
    <name>Aster Communications Inc.</name>
  </developer>

  <description>
    <p>
      Aster Mail is private email that's actually easy to use. Your mailbox is end-to-end encrypted, and mail between Aster accounts is quantum-safe, so only you and the people you write to can read it.
    </p>
    <p>Highlights:</p>
    <ul>
      <li>End-to-end encrypted, quantum-safe email</li>
      <li>10 GB of free storage</li>
      <li>5 free aliases to keep your real address private</li>
      <li>Use your own custom domain, free</li>
      <li>PGP support, so you can send encrypted mail to any provider</li>
      <li>Move over in minutes by importing from Gmail, Outlook, Yahoo and more</li>
      <li>Reach Aster over Tor with its own onion service</li>
    </ul>
    <p>
      An Aster account is required. The desktop app is open source under AGPL v3 and built with Tauri.
    </p>
  </description>

  <launchable type="desktop-id">org.astermail.Mail.desktop</launchable>

  <url type="homepage">https://astermail.org</url>
  <url type="bugtracker">https://github.com/Aster-Privacy/Aster-Mail/issues</url>
  <url type="vcs-browser">https://github.com/Aster-Privacy/Aster-Mail</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Aster-Privacy/Aster-Mail/main/flatpak/screenshots/inbox.png</image>
      <caption>Your encrypted inbox</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Aster-Privacy/Aster-Mail/main/flatpak/screenshots/aliases.png</image>
      <caption>Create and manage email aliases</caption>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#a8c4ff</color>
    <color type="primary" scheme_preference="dark">#1f3d8a</color>
  </branding>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">moderate</content_attribute>
    <content_attribute id="money-purchasing">intense</content_attribute>
  </content_rating>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <provides>
    <binary>aster-mail-desktop</binary>
  </provides>

  <releases>
    <release version="1.4.75" date="2026-10-18">
      <url type="details">https://github.com/Aster-Privacy/Aster-Mail/releases/tag/v1.4.75</url>
    </release>
  </releases>
</component>
