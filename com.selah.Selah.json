{
  "app-id": "com.selah.Selah",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "selah",
  "branch": "$VERSION",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=ipc",
    "--share=network",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-config/selah:create",
    "--socket=system-bus",
    "--talk-name=org.freedesktop.NetworkManager"
  ],
  "modules": [
    {
      "name": "selah-bundle",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/bin",
        "install -D -m755 selah /app/bin/selah",
        "cp -r lib /app/bin/",
        "cp -r data /app/bin/",
        "install -Dm0644 com.selah.Selah.desktop /app/share/applications/com.selah.Selah.desktop",
        "install -Dm0644 com.selah.Selah.svg /app/share/icons/hicolor/scalable/apps/com.selah.Selah.svg",
        "install -Dm0644 com.selah.Selah.svg /app/share/icons/hicolor/symbolic/apps/com.selah.Selah.svg",
        "install -Dm0644 com.selah.Selah.png /app/share/icons/hicolor/512x512/apps/com.selah.Selah.png",
        "ln -s /app/share/icons/hicolor/512x512/apps/com.selah.Selah.png /app/share/icons/hicolor/256x256/apps/com.selah.Selah.png",
        "ln -s /app/share/icons/hicolor/512x512/apps/com.selah.Selah.png /app/share/icons/hicolor/128x128/apps/com.selah.Selah.png",
        "ln -s /app/share/icons/hicolor/512x512/apps/com.selah.Selah.png /app/share/icons/hicolor/64x64/apps/com.selah.Selah.png",
        "ln -s /app/share/icons/hicolor/512x512/apps/com.selah.Selah.png /app/share/icons/hicolor/48x48/apps/com.selah.Selah.png",
        "ln -s /app/share/icons/hicolor/512x512/apps/com.selah.Selah.png /app/share/icons/hicolor/32x32/apps/com.selah.Selah.png",
        "ln -s /app/share/icons/hicolor/512x512/apps/com.selah.Selah.png /app/share/icons/hicolor/16x16/apps/com.selah.Selah.png",
        "install -Dm0644 com.selah.Selah.metainfo.xml /app/share/metainfo/com.selah.Selah.metainfo.xml"
      ],
      "sources": [
        {
          "type": "archive",
          "only-arches": "x86_64",
          "url": "https://github.com/toazd/selah/releases/download/v0.7.5-build.85/Selah-0.7.5.tar.gz",
          "sha256": "675f2092f6a9b18cefde844e20dc13a1ed3164781076588e5820e3b478ed4ecb"
        },
