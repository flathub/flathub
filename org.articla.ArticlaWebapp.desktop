[Desktop Entry]
Version=1.0
Type=Application
Name=Articla
Comment=Desktop client for articla.org forum
GenericName=Articla Web Client
Exec=run.sh %U
Icon=org.articla.ArticlaWebapp
Terminal=false
StartupNotify=true
Categories=Network;InstantMessaging;WebBrowser;X-Social;
Keywords=articla;forum;anime;games;social;browser;
StartupWMClass=org.articla.ArticlaWebapp
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=run.sh --new-window