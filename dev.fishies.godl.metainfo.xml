<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
    <id>dev.fishies.godl</id>
    <replaces>io.github.sockeye_d.godl</replaces>

    <name>godl</name>
    <summary>Godot version manager</summary>

    <developer id="dev.fishies">
        <name>sockeye-d (fishnpotatoes, fishy)</name>
    </developer>

    <metadata_license>MIT</metadata_license>
    <project_license>MIT</project_license>

    <description>
        <p>Manage your Godot projects and versions in one place.</p>
    </description>

    <provides>
        <binary>godl</binary>
    </provides>

    <categories>
        <category>Utility</category>
    </categories>

    <keywords>
        <keyword>godot</keyword>
        <keyword>utilities</keyword>
    </keywords>

    <branding>
        <color type="primary" scheme_preference="light">#478cbf</color>
        <color type="primary" scheme_preference="dark">#233440</color>
    </branding>

    <launchable type="desktop-id">dev.fishies.godl.desktop</launchable>
    <screenshots>
        <screenshot type="default">
            <image>https://codeberg.org/fishn/godl/raw/master/assets/overview.png</image>
        </screenshot>
        <screenshot>
            <image>https://codeberg.org/fishn/godl/raw/master/assets/local-versions.png</image>
        </screenshot>
        <screenshot>
            <image>https://codeberg.org/fishn/godl/raw/master/assets/remote-versions.png</image>
        </screenshot>
    </screenshots>

    <releases>
        <release version="1.4.0" date="2026-08-16">
            <url type="details">https://codeberg.org/fishn/godl/releases/v1.4.0</url>
            <description>
                <p>Major release 1.4.0 brings a major UI overhaul and performance improvements.</p>
            </description>
        </release>
        <release version="1.3.1" date="2025-08-19">
            <url type="details">https://codeberg.org/fishn/godl/releases/v1.3.1</url>
            <description>
                <p>Maintenance release v1.3.1 brings some bugfixes, most notably that the long pause on startup has been fixed.</p>
            </description>
        </release>
        <release version="1.3" date="2025-08-19">
            <url type="details">https://codeberg.org/fishn/godl/releases/v1.3</url>
            <description>
                <p>Release v1.3 brings some new features and bugfixes!</p>
            </description>
        </release>
        <release version="1.2.2" date="2025-08-19">
            <url type="details">https://codeberg.org/fishn/godl/releases/v1.2.2</url>
            <description>
                <p>Bugfix update</p>
            </description>
        </release>
        <release version="1.2.1" date="2025-08-09">
            <url type="details">https://codeberg.org/fishn/godl/releases/v1.2.1</url>
            <description>
                <p>Flatpak release</p>
            </description>
        </release>
    </releases>

    <content_rating type="oars-1.1" />

    <url type="bugtracker">https://codeberg.org/fishn/godl/issues</url>
    <url type="homepage">https://codeberg.org/fishn/godl/</url>
    <url type="vcs-browser">https://codeberg.org/fishn/godl/</url>
</component>
