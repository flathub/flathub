{
    "id": "co.dumitres.Vocalis",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm20"
    ],
    "command": "vocalis",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--filesystem=xdg-run/pipewire-0",
        "--talk-name=org.kde.StatusNotifierWatcher"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm20/bin",
        "env": {
            "CARGO_HOME": "/run/build/vocalis/cargo",
            "CARGO_NET_OFFLINE": "true",
            "LIBCLANG_PATH": "/usr/lib/sdk/llvm20/lib"
        },
        "prepend-ld-library-path": "/usr/lib/sdk/llvm20/lib"
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "vocalis",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline build --release",
                "install -Dm755 target/release/vocalis /app/bin/vocalis",
                "install -Dm644 data/co.dumitres.Vocalis.desktop /app/share/applications/co.dumitres.Vocalis.desktop",
                "install -Dm644 data/co.dumitres.Vocalis.metainfo.xml /app/share/metainfo/co.dumitres.Vocalis.metainfo.xml",
                "install -Dm644 data/icons/hicolor/scalable/apps/co.dumitres.Vocalis.svg /app/share/icons/hicolor/scalable/apps/co.dumitres.Vocalis.svg",
                "install -Dm644 data/icons/hicolor/symbolic/apps/co.dumitres.Vocalis-symbolic.svg /app/share/icons/hicolor/symbolic/apps/co.dumitres.Vocalis-symbolic.svg"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/geodro/vocalis.git",
                    "tag": "v0.1.1",
                    "commit": "6275cd073b620ff856c9e26b435a166b486de2c6"
                },
                "build-aux/cargo-sources.json"
            ]
        }
    ]
}
