<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>io.github.relativemodder.fivetris</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Fivetris</name>
  <summary
    >Tetris training tool for exploring board states and strategies</summary>

  <developer id="io.github.relativemodder">
    <name>relativemodder</name>
  </developer>

  <description>
    <p>
      Fivetris is a Rust rewrite of four-tris, an open source training tool for
      block-stacking games. It allows you to quickly explore different board
      situations, test stacking options, and train freely in a Tetris-like
      environment.
    </p>
    <ul>
      <li>Draw pieces freely on the board to (re)construct any scenario</li>
      <li>Test different strategies and other things</li>
      <li>Screenshot other Tetris-like games and analyze their board states</li>
    </ul>
  </description>

  <launchable
        type="desktop-id"
    >io.github.relativemodder.fivetris.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <image
            >https://raw.githubusercontent.com/relativemodder/fivetris/refs/heads/main/assets/docs/1.png</image>
      <caption>Draw pieces on the board and test different strategies</caption>
    </screenshot>
    <screenshot>
      <image
            >https://raw.githubusercontent.com/relativemodder/fivetris/refs/heads/main/assets/docs/2.png</image>
      <caption>Analyze boards from other Tetris-like games</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/relativemodder/fivetris</url>
  <url type="bugtracker">https://github.com/relativemodder/fivetris/issues</url>
  <url type="vcs-browser">https://github.com/relativemodder/fivetris</url>

  <branding>
    <color type="primary" scheme_preference="light">#4a90d9</color>
    <color type="primary" scheme_preference="dark">#1e3a5f</color>
  </branding>

  <content_rating type="oars-1.1" />

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <releases>
    <release version="0.1.5" date="2026-06-28">
      <description>
        <p>Latest release of Fivetris.</p>
      </description>
    </release>
  </releases>
</component>
