{
  "app-id": "io.github.hernantz.timezones",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "timezones",
  "modules": [
    {
      "name": "gweather-locations",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/gweather-locations/2026/gweather-locations-2026.2.tar.xz",
          "sha256": "e7570a3661e0a752a06387b2032585cf588fc56770b1f9f39f1a55d17b2835fe"
        }
      ],
      "cleanup": [
        "/share/gweather-locations",
        "/share/pkgconfig"
      ]
    },
    {
      "name": "geocode-glib",
      "buildsystem": "meson",
      "config-opts": [
        "-Denable-installed-tests=false",
        "-Denable-introspection=true",
        "-Denable-gtk-doc=false",
        "-Dsoup2=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/geocode-glib/3.26/geocode-glib-3.26.4.tar.xz",
          "sha256": "2d9a6826d158470449a173871221596da0f83ebdcff98b90c7049089056a37aa"
        }
      ],
      "cleanup": [
        "/share/icons",
        "/include",
        "/lib/pkgconfig",
        "/share/gir-1.0"
      ]
    },
    {
      "name": "libgweather",
      "buildsystem": "meson",
      "config-opts": [
        "-Dtests=false",
        "-Dgtk_doc=false",
        "-Denable_vala=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libgweather/4.6/libgweather-4.6.0.tar.xz",
          "sha256": "7f5d0e8c9685ef2ff46c2f3a57cae48d7bf3540b2d83921f889ef28e6a876788"
        }
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/gir-1.0"
      ]
    },
    {
      "name": "timezones",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "-Dpython.bytecompile=2"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/hernantz/timezones.git",
          "tag": "v1.0.0",
          "commit": "064c04064e37b2004668aed5df9a34e39c9292a6"
        }
      ]
    }
  ],
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig"
  ]
}
