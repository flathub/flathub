# The Flatpak copy. Same file as simson-desk.desktop except for the
# two lines Flatpak dictates: the icon has to be named for the app id,
# and Exec is the wrapper on /app/bin rather than a distro path.
# The .deb and the snap keep the original, whose names are right there.
[Desktop Entry]
Type=Application
Version=1.5
Name=Simson Desk
GenericName=Email Client
Comment=Email, calendar and tasks for Microsoft 365
# No absolute path: the .deb installs the binary onto PATH, and the AppImage
# runtime resolves this against the bundle root. Hardcoding /opt/... would break
# the AppImage, and hardcoding the AppImage layout would break the .deb.
Exec=simson-desk %U
Icon=com.simsononline.SimsonDesk
Terminal=false
Categories=Office;Email;Calendar;ContactManagement;
# No competitor's name here. The first Microsoft Store submission was
# rejected for exactly one thing — "Outlook" in the search terms — and
# GNOME Software and the Snap Store both index Keywords for search, so
# the same rule applies to the same word. The protocol and service names
# stay: they say what the app talks to, not what it competes with.
Keywords=email;mail;calendar;tasks;contacts;microsoft;365;exchange;imap;smtp;
StartupNotify=true
StartupWMClass=simson-desk
# Registers the app as a handler for mailto: links, so "email this" elsewhere on
# the desktop can open a composer here.
MimeType=x-scheme-handler/mailto;
SingleMainWindow=true
