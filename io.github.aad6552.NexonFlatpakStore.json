{
  "app-id": "io.github.aad6552.NexonFlatpakStore",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "nexon-flatpak-store",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "nexon-flatpak-store",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/bin /app/share/nexon-flatpak-store",
        "cp -r src/nexon_store /app/share/nexon-flatpak-store/",
        "install -Dm755 bin/nexon-flatpak-store /app/bin/nexon-flatpak-store",
        "install -Dm644 data/io.github.aad6552.NexonFlatpakStore.desktop /app/share/applications/io.github.aad6552.NexonFlatpakStore.desktop",
        "install -Dm644 data/io.github.aad6552.NexonFlatpakStore.metainfo.xml /app/share/metainfo/io.github.aad6552.NexonFlatpakStore.metainfo.xml",
        "install -Dm644 data/icons/hicolor/64x64/apps/io.github.aad6552.NexonFlatpakStore.png /app/share/icons/hicolor/64x64/apps/io.github.aad6552.NexonFlatpakStore.png",
        "install -Dm644 data/icons/hicolor/128x128/apps/io.github.aad6552.NexonFlatpakStore.png /app/share/icons/hicolor/128x128/apps/io.github.aad6552.NexonFlatpakStore.png",
        "install -Dm644 data/icons/hicolor/256x256/apps/io.github.aad6552.NexonFlatpakStore.png /app/share/icons/hicolor/256x256/apps/io.github.aad6552.NexonFlatpakStore.png"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Aad6552/NexonFlatpakStore.git",
          "tag": "v1.0.2",
          "commit": "5571d0f463be173d12c06a8b10e606022cb47c38"
        }
      ]
    }
  ]
}
