<component type="desktop-application">
  <id>io.github.smin987.ImageOptimizer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <name>Image Optimizer</name>
  <summary>Optimize images and GIFs</summary>
  <developer id="io.github.smin987">
    <name>smin987</name>
  </developer>
  <description>
    <p>Image Optimizer is a desktop application that drastically compresses images by up to 90% while preserving visual fidelity — speeding up websites and saving storage.</p>
    <ul>
      <li>One-click WebP / JPG / BOTH conversion with quality control</li>
      <li>Animated GIF to Animated WebP conversion — every frame and timing preserved</li>
      <li>sRGB color management powered by LittleCMS, with Display P3 / Adobe RGB gamut mapping</li>
      <li>10 social media presets for YouTube, Instagram, and more</li>
      <li>Alpha channel (transparency) preservation or flatten onto solid white</li>
      <li>Three smart resizing modes: fit max width, scale %, keep original size</li>
      <li>English / 한국어 bilingual interface</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.smin987.ImageOptimizer.desktop</launchable>
