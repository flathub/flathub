<component type="desktop-application">
  <id>com.gtask_for_desktop.GTaskForDesktop</id>
  <name>GTask for Desktop</name>
  <summary>Desktop application for Google Tasks</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://gtask-for-desktop.com/flathub-license.txt</project_license>
  <description>
    <p>GTask for Desktop is a desktop application for Google Tasks - 
       It synchronizes with your Google Tasks account and adds features
       beyond the web version, including full-screen mode, offline access,
       fast full-text search, dark mode, import and export, keyboard
       shortcuts, and more.</p>
  </description>
