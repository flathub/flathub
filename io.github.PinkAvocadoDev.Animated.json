{
    "app-id" : "io.github.PinkAvocadoDev.Animated",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "add-extensions" : {
        "org.freedesktop.Platform.ffmpeg-full" : {
            "directory" : "lib/ffmpeg",
            "version" : "24.08",
            "add-ld-path" : "."
        }
    },
    "command" : "animated",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-videos"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        "python3-build-deps.json",
        "python3-moviepy.json",
        "python3-pyyaml.json",
        {
            "name" : "animated",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/PinkAvocadoDev/Animated.git",
                    "tag" : "1.0.0",
                    "commit" : "9950da52baff7ad9f856c49bc2527306e259c8b614fd7a9170cccdde1d97015e"
                }
            ]
        }
    ]
}