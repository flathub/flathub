<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.queryahub.querya_desktop</id>
  <name>Querya Desktop</name>
  <summary>Multi-database desktop client</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="com.queryahub">
    <name>QueryaHub</name>
  </developer>
  <description>
    <p>Querya Desktop is a desktop client for working with several databases from one window.</p>
    <p>Features:</p>
    <ul>
      <li>PostgreSQL, MySQL, SQLite, MongoDB and Redis connections, with SSH tunnels</li>
      <li>SQL editor with a result grid, staged edits and export</li>
      <li>MongoDB document viewer and aggregation builder, Redis key browser and CLI</li>
      <li>Themes and extensions</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.queryahub.querya_desktop.desktop</launchable>
  <url type="homepage">https://github.com/QueryaHub/Querya-Desktop</url>
  <url type="bugtracker">https://github.com/QueryaHub/Querya-Desktop/issues</url>
