    <category>Development</category>
    <category>Database</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>querya_desktop</binary>
  </provides>
  <releases>
    <release version="0.4.18" date="2026-09-28"/>
  </releases>
</component>
