  <name>Study &amp; Revision: Spaced Repetition</name>
  <summary>Science-backed study planner for long-term memory retention</summary>
  
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  
  <developer id="in.courseways">
    <name>Manoj</name>
  </developer>

  <description>
    <p>
      Study &amp; Revision: Spaced Repetition is a powerful, science-backed study planner designed to help you learn faster and retain information longer.
    </p>
    <p>
      By leveraging the proven spaced repetition learning technique, the application intelligently schedules your review sessions to optimize your memory retention. Instead of cramming, you review material at the precise moment you are about to forget it, ensuring long-term mastery of any subject.
    </p>
    <p>
      Whether you are a student preparing for exams, a professional learning new skills, or a language learner, this app provides the tools you need to stay organized, focused, and successful.
    </p>
  </description>

  <launchable type="desktop-id">in.courseways.StudyAndRevisionPlanner.desktop</launchable>

  <categories>
    <category>Education</category>
  </categories>
  
  <keywords>
