<component type="desktop-application">
  <id>com.yoameet.YoAMeet</id>
  <name>YoA Meet</name>
  <summary>HD video meetings with a built-in production studio</summary>
  <summary xml:lang="fr">Visioconférence HD avec régie studio intégrée</summary>
  <summary xml:lang="de">HD-Videokonferenzen mit integrierter Produktionsregie</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <!-- Ajuster si la licence du code diffère (MIT, proprietary, etc.) -->
  <project_license>LicenseRef-proprietary</project_license>

  <developer id="com.yoameet">
    <name>Yoa Meet</name>
  </developer>

  <url type="homepage">https://yoameet.com</url>
  <url type="bugtracker">https://yoameet.com/support.html</url>
  <url type="help">https://yoameet.com/support.html</url>
  <url type="contact">mailto:support@yoameet.com</url>

  <description>
    <p>
      YoA Meet brings HD video conferencing and a production control room together
      in one desktop app. Use it for team meetings, webinars, community gatherings,
      and live events.
    </p>
    <p>Features include:</p>
    <ul>
      <li>HD video and audio meetings</li>
      <li>Screen sharing and chat</li>
      <li>Participant management (microphone / camera)</li>
      <li>Studio control room: preview, TAKE, and program (PGM)</li>
      <li>Detachable windows for chat, participants, and production</li>
      <li>Join by invite link</li>
    </ul>
    <p xml:lang="fr">
      YoA Meet réunit visioconférence HD et régie de production dans une application
      de bureau. Idéal pour les réunions d’équipe, webinaires, communautés et lives.
    </p>
  </description>

  <launchable type="desktop-id">com.yoameet.YoAMeet.desktop</launchable>
  <provides>
    <binary>yoa</binary>
  </provides>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <categories>
    <category>Network</category>
    <category>AudioVideo</category>
    <category>Office</category>
  </categories>

  <keywords>
    <keyword>video</keyword>
    <keyword>meeting</keyword>
    <keyword>conference</keyword>
    <keyword>webinar</keyword>
  </keywords>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>

  <branding>
    <color type="primary" scheme_preference="light">#2563eb</color>
    <color type="primary" scheme_preference="dark">#1e3a8a</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>YoA Meet home</caption>
      <image>https://github.com/Yonky2022/yoameet-linux-releases/releases/download/v1.0.7.44/linux-home.png</image>
    </screenshot>
    <screenshot>
      <caption>Meeting grid</caption>
      <image>https://github.com/Yonky2022/yoameet-linux-releases/releases/download/v1.0.7.44/linux-meeting.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.0.7" date="2026-09-11">
      <description>
        <p>Linux desktop / Flatpak readiness and meeting join reliability.</p>
        <ul>
          <li>Flatpak: NetworkManager access for LiveKit connectivity checks</li>
          <li>Linux: in-app meeting navigation (no broken detached process)</li>
          <li>Mute / unmute stays in sync with published audio</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
