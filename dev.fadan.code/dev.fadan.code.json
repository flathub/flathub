{
  "app-id": "dev.fadan.code",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "23.08",
  "command": "fadan-code",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--filesystem=home",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "fadan-code",
      "buildsystem": "simple",
      "build-commands": [
        "ar x fadan-code_1.0.0_amd64.deb",
        "tar -xf data.tar.*",
        "cp -r opt/Fadan\\ Code/* /app/",
        "install -Dm755 /app/fadan-code /app/bin/fadan-code",
        "cp /app/libffmpeg.so /app/lib/libffmpeg.so",
        "cp /app/libEGL.so /app/lib/libEGL.so",
        "cp /app/libGLESv2.so /app/lib/libGLESv2.so",
        "install -Dm644 /app/icudtl.dat /app/bin/icudtl.dat",
        "install -Dm644 /app/snapshot_blob.bin /app/bin/snapshot_blob.bin",
        "install -Dm644 /app/v8_context_snapshot.bin /app/bin/v8_context_snapshot.bin",
        "install -Dm644 /app/resources.pak /app/bin/resources.pak",
        "install -Dm644 /app/chrome_100_percent.pak /app/bin/chrome_100_percent.pak",
        "install -Dm644 /app/chrome_200_percent.pak /app/bin/chrome_200_percent.pak",
        "cp -r /app/locales /app/bin/locales",
        "cp -r /app/resources /app/bin/resources",
        "install -Dm644 dev.fadan.code.desktop /app/share/applications/dev.fadan.code.desktop",
        "install -Dm644 dev.fadan.code.png /app/share/icons/hicolor/512x512/apps/dev.fadan.code.png"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://github.com/Fadan3003/Fadan-code/releases/download/v1.0.0/fadan-code_1.0.0_amd64.deb",
          "sha256": "d7a68a247de51b84e19822d3db0ffa47f8a32b6dd17f88e74146c299783c1f31"
        },
        {
          "type": "file",
          "path": "dev.fadan.code.desktop"
        },
        {
          "type": "file",
          "path": "dev.fadan.code.png"
        }
      ]
    }
  ]
}
