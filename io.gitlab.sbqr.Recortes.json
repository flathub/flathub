{
    "id": "io.gitlab.sbqr.Recortes",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "recortes",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--talk-name=org.gnome.Shell"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/recortes/cargo"
        }
    },
    "cleanup": [
        "/lib/pkgconfig",
        "/include",
        "*.a"
    ],
    "modules": [
        {
            "name": "recortes",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline fetch --manifest-path Cargo.toml",
                "cargo --offline build --release --locked",
                "install -Dm755 target/release/recortes /app/bin/recortes",
                "install -Dm644 data/icons/hicolor/scalable/apps/io.gitlab.sbqr.Recortes.svg /app/share/icons/hicolor/scalable/apps/io.gitlab.sbqr.Recortes.svg",
                "install -Dm644 data/icons/hicolor/symbolic/apps/io.gitlab.sbqr.Recortes-symbolic.svg /app/share/icons/hicolor/symbolic/apps/io.gitlab.sbqr.Recortes-symbolic.svg",
                "install -Dm644 data/icons/hicolor/16x16/apps/io.gitlab.sbqr.Recortes-symbolic.svg /app/share/icons/hicolor/16x16/apps/io.gitlab.sbqr.Recortes-symbolic.svg",
                "install -Dm644 data/icons/hicolor/16x16@2/apps/io.gitlab.sbqr.Recortes-symbolic.svg /app/share/icons/hicolor/16x16@2/apps/io.gitlab.sbqr.Recortes-symbolic.svg",
                "install -Dm644 data/icons/hicolor/32x32/apps/io.gitlab.sbqr.Recortes.svg /app/share/icons/hicolor/32x32/apps/io.gitlab.sbqr.Recortes.svg",
                "install -Dm644 data/icons/hicolor/32x32@2/apps/io.gitlab.sbqr.Recortes.svg /app/share/icons/hicolor/32x32@2/apps/io.gitlab.sbqr.Recortes.svg",
                "install -Dm644 data/icons/hicolor/48x48/apps/io.gitlab.sbqr.Recortes.svg /app/share/icons/hicolor/48x48/apps/io.gitlab.sbqr.Recortes.svg",
                "install -Dm644 data/icons/hicolor/48x48@2/apps/io.gitlab.sbqr.Recortes.svg /app/share/icons/hicolor/48x48@2/apps/io.gitlab.sbqr.Recortes.svg",
                "sh build-aux/install-translations.sh /app",
                "desktop-file-validate /app/share/applications/io.gitlab.sbqr.Recortes.desktop"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.com/sbqr/recortes.git",
                    "tag": "1.0.0",
                    "commit": "786aa85f34988169f5e8968eb046f7c6975a9789"
                },
                "cargo-sources.json"
            ]
        }
    ]
}
