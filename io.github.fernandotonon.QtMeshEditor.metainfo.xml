<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata for Flatpak / Flathub.
  App ID must match InstallFlavor::updateCommandHint (Flatpak).
-->
<component type="desktop-application">
  <id>io.github.fernandotonon.QtMeshEditor</id>
  <name>QtMeshEditor</name>
  <summary>Free 3D asset tool for indie game developers</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.fernandotonon">
    <name>Fernando Tonon</name>
  </developer>
  <url type="homepage">https://fernandotonon.github.io/QtMeshEditor</url>
  <url type="bugtracker">https://github.com/fernandotonon/QtMeshEditor/issues</url>
  <url type="vcs-browser">https://github.com/fernandotonon/QtMeshEditor</url>
  <description>
    <p>
      Merge Mixamo animations, convert between 40+ 3D formats, edit materials
      with AI assistance, and inspect skeletons and bone weights. Supports FBX,
      glTF, OBJ, Collada, STL and more. Includes a CLI for batch processing and
      an MCP server for AI agent integration.
    </p>
    <p>
      CLI inside Flatpak:
      <code>flatpak run --command=qtmesh io.github.fernandotonon.QtMeshEditor --help</code>
    </p>
  </description>
  <launchable type="desktop-id">io.github.fernandotonon.QtMeshEditor.desktop</launchable>
  <provides>
    <binary>qtmesheditor</binary>
    <binary>qtmesh</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <recommends>
    <control>touch</control>
  </recommends>
  <categories>
    <category>Graphics</category>
    <category>Viewer</category>
  </categories>
  <keywords>
    <keyword>3D</keyword>
    <keyword>mesh</keyword>
    <keyword>FBX</keyword>
    <keyword>glTF</keyword>
    <keyword>animation</keyword>
  </keywords>
  <content_rating type="oars-1.1"/>
  <releases>
    <!-- CI / pack-flatpak-from-deb.sh rewrites the version + date before build. -->
    <release version="3.62.0" date="2026-11-01"/>
  </releases>
</component>
