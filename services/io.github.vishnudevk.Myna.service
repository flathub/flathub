[Unit]
Description=Myna dictation daemon
Documentation=https://github.com/canonical/myna
# Start after the session bus is available and the user session targets are up.
# Mirrors the snap's daemon-scope:user + WantedBy=default.target approach.
After=dbus.socket
Wants=dbus.socket

[Service]
Type=simple
ExecStart=/usr/bin/flatpak run --command=myna-daemon io.github.vishnudevk.Myna
# Restart on failure (matches snap's default restart-condition).
Restart=on-failure
RestartSec=1s
# Clean exit on session bus death: myna-desktop exits non-zero when its served
# D-Bus connection dies (see myna-snap snapcraft.yaml comment); the unit then
# restarts on the new bus. Matches the snap's documented behaviour.
SuccessExitStatus=0

[Install]
WantedBy=default.target
