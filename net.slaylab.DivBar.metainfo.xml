<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>net.slaylab.DivBar</id>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>MIT</project_license>
	<name>DivBar</name>
	<summary>Visual dividers for your taskbar</summary>
	<developer id="net.slaylab">
		<name>Daniel Slay</name>
	</developer>
	<description>
		<p>Linux taskbars don't give you a way to group pinned apps. DivBar generates a thin divider entry to pin and drag between your app groups.</p>
		<p>Works on KDE Plasma, GNOME, XFCE, Cinnamon, MATE, LXQt, Budgie, Pantheon, Sway, Hyprland, and others. Twenty bundled colors in vertical and horizontal orientations, plus custom images.</p>
	</description>
	<launchable type="desktop-id">net.slaylab.DivBar.desktop</launchable>
	<url type="homepage">https://github.com/Danielslay86/divbar</url>
	<url type="bugtracker">https://github.com/Danielslay86/divbar/issues</url>
	<url type="vcs-browser">https://github.com/Danielslay86/divbar</url>
	<screenshots>
		<screenshot type="default">
			<caption>Divs between app groups on KDE Plasma panel</caption>
			<image>https://raw.githubusercontent.com/Danielslay86/divbar/v1.0.2/screenshots/kde-taskbar-bottom.png</image>
		</screenshot>
		<screenshot>
			<caption>Divs on GNOME with Dash to Panel</caption>
			<image>https://raw.githubusercontent.com/Danielslay86/divbar/v1.0.2/screenshots/gnome-taskbar.png</image>
		</screenshot>
		<screenshot>
			<caption>Style Picker</caption>
			<image>https://raw.githubusercontent.com/Danielslay86/divbar/v1.0.2/screenshots/gnome-styles.png</image>
		</screenshot>
	</screenshots>
	<content_rating type="oars-1.1"/>
	<branding>
