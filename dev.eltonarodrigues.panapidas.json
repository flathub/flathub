{
    "id": "dev.eltonarodrigues.panapidas",
    "runtime": "org.gnome.Sdk",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "panapidas",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--talk-name=org.freedesktop.secrets"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        "dukpy.json",
        {
            "name": "panapidas",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://codeberg.org/eltonarodrigues/Panapidas.git",
                    "tag" : "v1.0.0",
                    "commit": "4a9837b47ea96f377195313d27b5f641a4009416"
                }
            ],
            "config-opts": [
                "--libdir=lib"
            ]
        }
    ],
    "build-options": {
        "env": {}
    }
}
