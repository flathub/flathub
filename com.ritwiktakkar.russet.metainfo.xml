<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.ritwiktakkar.russet</id>
  
  <name>Russet</name>
  <summary>Private, customizable, and powerful on-device AI assistant</summary>
  
  <metadata_license>CC-BY-4.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://rickytakkar.com/russet/LICENSE.txt</project_license>
  
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  
  <description>
    <p>
      Russet runs large language models directly on your computer, so your conversations never leave your machine and work even when you are offline. There are no accounts to create, no subscriptions, and no usage limits.
    </p>
    <p>
      Load any GGUF model from your filesystem or browse a curated catalog of community models. Inference is accelerated by your GPU when available, with fine-grained control over context length, sampling, system prompts, and other generation parameters so you can tune each model to your hardware and workflow.
    </p>
    <p>
      A clean GNOME-native interface makes it easy to chat, switch between models, and manage your library, while power users can dig into the underlying settings whenever they need to.
    </p>
  </description>

  <url type="homepage">https://rickytakkar.com/russet_status_update</url>
  
