{
    "app-id": "com.github.elizeubarbosaabreu.BibliaSacra",
    "runtime": "org.kde.Platform",
    "runtime-version": "5.15-24.08",
    "sdk": "org.kde.Sdk",
    "base": "com.riverbankcomputing.PyQt.BaseApp",
    "base-version": "5.15-24.08",
    "command": "biblia",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--filesystem=home/.local/share/xiphos:create"
    ],
    "modules": [
        {
            "name": "biblia",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 biblia.py /app/bin/biblia",
                "install -Dm644 biblia.png /app/share/icons/hicolor/256x256/apps/com.github.elizeubarbosaabreu.BibliaSacra.png",
                "install -Dm644 com.github.elizeubarbosaabreu.BibliaSacra.desktop /app/share/applications/com.github.elizeubarbosaabreu.BibliaSacra.desktop",
                "install -Dm644 com.github.elizeubarbosaabreu.BibliaSacra.metainfo.xml /app/share/metainfo/com.github.elizeubarbosaabreu.BibliaSacra.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/elizeubarbosaabreu/biblia-leitor/archive/v2.3.tar.gz",
                    "sha256": "d20fb045ee4766d12b52ee09bad18b58456f683e4935b08541c87611e1a56c0b",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/elizeubarbosaabreu/biblia-leitor/releases/latest",
                        "tag-query": ".tag_name",
                        "timestamp-query": ".published_at",
                        "version-query": ".tag_name | ltrimstr(\"v\")"
                    }
                }
            ]
        }
    ]
}
