  <releases>
    <release version="1.0.0" date="2026-05-11">
      <description>
        <h3>Features</h3>
        <ul>
          <li><strong>AI Continuation</strong>
            <ul>
              <li>Ask AI to generate moves from any selected position.</li>
              <li>Easily navigate between the original moves and AI-generated variations.</li>
            </ul>
          </li>
          <li><strong>AI Games</strong>
            <ul>
              <li>Player vs AI</li>
              <li>AI vs AI</li>
              <li>Start from the default position or any custom position</li>
              <li>Let the AI take over from the current position</li>
              <li>Switch sides with the AI during a game</li>
            </ul>
          </li>
          <li><strong>AI Settings Panel</strong> — Adjust search depth, thinking time, and memory usage.</li>
          <li><strong>Support for Two Strong Engines</strong>
            <ul>
                <li><strong>Pikafish</strong> and <strong>Fairy-Stockfish</strong> supported</li>
                <li>Xiangqi Lab does <strong>not</strong> ship with any AI engine — you must download and configure them separately.</li>
            </ul>
          </li>
          <li><strong>Five Languages</strong> — English, Simplified Chinese, Traditional Chinese, Vietnamese, and Malay.</li>
          <li><strong>Two Piece Symbol Sets</strong> — Traditional Kanji and Emoji pieces.</li>
          <li><strong>Two Coordinate Systems</strong> — Chinese coordinates and UCI coordinates.</li>
        </ul>

        <h3>Technical</h3>
        <ul>
          <li>Extremely lightweight — only Python + Tkinter</li>
          <li>Official Windows support (in addition to macOS and Linux)</li>
        </ul>
      </description>
    </release>

    <release version="0.1.0" date="2026-05-01">
      <description>
        <h3>Features</h3>
        <ul>
          <li>List all existing games</li>
          <li>Create a new game</li>
          <li>Open an existing game</li>
          <li>Edit initial board position</li>
          <li>Add or edit moves</li>
          <li>AI-powered best move suggestions (requires Fairy-Stockfish)</li>
        </ul>

        <h3>Technical</h3>
        <ul>
          <li>Built with Python + Tkinter</li>
          <li>Supports macOS and Linux</li>
        </ul>
      </description>
    </release>
  </releases>

