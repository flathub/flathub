<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>io.gitlab.xiangqilab.xiangqilab</id>

  <name>Xiangqi Lab</name>
  <summary>A fully local Xiangqi desktop app with AI-powered analysis</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <description>
    <p>Xiangqi Lab is a fully local and private Xiangqi desktop application with AI-powered analysis.</p>
    <p>It requires no internet, collects no data, and runs locally. Features include player vs AI, AI vs AI, game editor, and support for two Xiangqi engines (Fairy-Stockfish and Pikafish, Xiangqi engines must be installed separately).</p>
    <p>Perfect for study, practice, and experimentation.</p>
  </description>

