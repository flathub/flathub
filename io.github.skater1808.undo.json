{
    "app-id": "io.github.skater1808.undo",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "undo",
    "finish-args": [
        "--filesystem=home"
    ],
    "modules": [
        {
            "name": "undo",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 undo /app/bin/undo",
                "install -Dm644 LICENSE /app/share/licenses/undo/LICENSE",
                "install -Dm644 README.md /app/share/doc/undo/README.md",
                "install -Dm644 flatpak/io.github.skater1808.undo.metainfo.xml /app/share/metainfo/io.github.skater1808.undo.metainfo.xml",
                "install -Dm644 flatpak/io.github.skater1808.undo.desktop /app/share/applications/io.github.skater1808.undo.desktop"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/Skater1808/undo/archive/refs/tags/v0.2.0.tar.gz",
                    "sha256": "08b9916411fd9fec1b0f688abbe0eea63b7e7129e53f7febeaf2fab11339f2d0"
                }
            ]
        }
    ]
}
