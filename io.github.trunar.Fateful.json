        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "fateful",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/trunar/Fateful.git",
                    "tag" : "v0.1.1",
                    "commit" : "a74af881ec7284d27a29af8bc34550ab1b82b3a1"
                }
            ]
        }
    ]
}
