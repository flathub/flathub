{
	"id": "org.freedesktop.Sdk.Extension.c3lang",
	"runtime": "org.freedesktop.Sdk",
	"runtime-version": "25.08",
	"sdk": "org.freedesktop.Sdk",
	"default-branch": "25.08",
	"build-extension": true,
	"appstream-compose": false,
	"modules": [
		{
			"name": "c3c",
			"buildsystem": "simple",
			"build-commands": [ "cp -r * $FLATPAK_DEST" ],
			"sources": [
				{
					"type": "archive",
					"url": "https://github.com/c3lang/c3c/releases/download/v0.8.3/c3-linux-static.tar.gz",
					"sha256": "bc3c276dd6f8ce36584b6f289c872a83c448053ee0a2d23b2ec90d7a32dd423e",
					"x-checker-data": {
						"type": "json",
						"url": "https://api.github.com/repos/c3lang/c3c/releases/latest",
						"version-query": ".tag_name | sub(\"^v\"; \"\")",
						"url-query": ".assets[] | select(.name==\"c3-linux-static.tar.gz\") | .browser_download_url"
					}
				},
				{
					"type": "file",
					"url": "https://github.com/c3lang/c3c/raw/refs/tags/v0.8.3/LICENSE",
					"sha256": "0a1de2181f8b6cc3c02c1281b04785080fd467941fddb2d18505c6b834e09155",
					"x-checker-data": {
						"type": "json",
						"url": "https://api.github.com/repos/c3lang/c3c/releases/latest",
						"version-query": ".tag_name | sub(\"^v\"; \"\")",
						"url-query": "\"https://github.com/c3lang/c3c/raw/refs/tags/v\" + $version + \"/LICENSE\""
					}
				}
			]
		},
		{
			"name": "script",
			"buildsystem": "simple",
			"build-commands": [ "install -t $FLATPAK_DEST enable.sh" ],
			"sources": [
				{
					"type": "script",
					"commands": [ "export PATH=$PATH:/usr/lib/sdk/c3lang" ],
					"dest-filename": "enable.sh"
				}
			]
		},
		{
			"name": "metainfo",
			"buildsystem": "simple",
			"build-commands": [ "install -Dm644 -t $FLATPAK_DEST/share/metainfo $FLATPAK_ID.metainfo.xml" ],
			"sources": [
				{
					"type": "file",
					"path": "org.freedesktop.Sdk.Extension.c3lang.metainfo.xml"
				}
			]
		}
	]
}
