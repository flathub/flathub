<component type="desktop-application">
  <id>io.github.nafeeur.Suketchi</id>
  <name>Suketchi</name>
  <summary>A lightweight PDF reader and editor</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.nafeeur">
    <name>Nafeeur Rahman</name>
  </developer>
  <description>
    <p>
      Suketchi PDF delivers a smooth, native desktop experience for viewing,
      navigating, and editing PDF documents without heavy resource overhead.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Viewing and navigating multi-page PDF documents</li>
      <li>Freehand annotation with a hand-drawn sketch aesthetic</li>
      <li>Adding, merging, extracting, and reordering pages</li>
      <li>Handwritten-style signatures</li>
      <li>Exporting pages to images, text, HTML, Markdown, or DOCX</li>
      <li>Optimizing, reducing, and encrypting PDF files</li>
    </ul>
  </description>
