{
	"id": "de.mintux.DigitizerUtility",
	"runtime": "org.gnome.Platform",
	"runtime-version": "50",
	"sdk": "org.gnome.Sdk",
	"sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
	"command": "digitizer-utility",
	"finish-args": [
		"--share=ipc",
		"--socket=fallback-x11",
		"--socket=wayland",
		"--device=dri",
		"--usb=vnd:0644+dev:8045",
		"--usb=vnd:0644+dev:804e"
	],
	"build-options": {
		"append-path": "/usr/lib/sdk/rust-stable/bin"
	},
	"modules": [
		{
			"name": "digitizer-utility",
			"buildsystem": "meson",
			"sources": [
				{
					"type": "archive",
					"url": "https://codeberg.org/Cameo007/digitizer-utility/releases/download/1.1.0/digitizer-utility-1.1.0.tar.xz",
					"sha256": "f73be7a0a2bb66a1ab225a697d1fdca2d973237d674a33e7b1ef302d02a81a67"
				}
			]
		}
	]
}
