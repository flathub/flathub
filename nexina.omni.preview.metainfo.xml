<component type="desktop-application">
  <id>nexina.omni.preview</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Omni Preview</name>
  <summary>All-in-one file previewer and document viewer</summary>
  <developer id="nexina.omni.preview">
    <name>NEXINA</name>
  </developer>
  <description>
    <p>
      Omni Preview is a fast, versatile desktop application for previewing documents, images, videos, audio, code, and archives all in one place.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Support for PDF, Office documents (DOCX, XLSX, PPTX)</li>
      <li>Image viewer with support for SVG, PNG, JPEG, GIF, WEBP, and BMP</li>
      <li>Audio and video player with native hardware acceleration</li>
      <li>Syntax-highlighted code and markdown reader</li>
      <li>Archive inspector for ZIP files</li>
    </ul>
  </description>
  <launchable type="desktop-id">nexina.omni.preview.desktop</launchable>
  <url type="homepage">https://github.com/nexina/omni-previewer</url>
