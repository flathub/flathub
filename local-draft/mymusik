#!/bin/sh
set -eu
APPDIR=/app/opt/mymusik
export APPDIR
LD_LIBRARY_PATH="$APPDIR/usr/lib"
if [ -d "$APPDIR/usr/bin/python/lib" ]; then
    LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$APPDIR/usr/bin/python/lib"
fi
export LD_LIBRARY_PATH
export XDG_DATA_DIRS="/app/share:$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/share}"
exec "$APPDIR/usr/bin/DesktopApp" "$@"
