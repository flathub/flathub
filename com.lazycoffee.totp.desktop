[Desktop Entry]
Version=1.0
Type=Application
Name=LazyCoffee TOTP
GenericName=TOTP Authenticator & Credential Manager
GenericName[zh_CN]=双因素身份验证与凭据管理器
Comment=Secure, privacy-first 2FA Authenticator and Credential Manager
Comment[zh_CN]=安全、私密的双因素身份验证与身份凭据管理器
Exec=lc_totp_app %u
Icon=com.lazycoffee.totp
Terminal=false
Categories=Utility;Security;
Keywords=totp;authenticator;2fa;otp;token;password;security;credentials;
Keywords[zh_CN]=动态口令;身份验证器;谷歌验证器;双因素认证;密码管家;两步验证;安全凭据;
StartupWMClass=com.lazycoffee.totp
MimeType=x-scheme-handler/otpauth;
