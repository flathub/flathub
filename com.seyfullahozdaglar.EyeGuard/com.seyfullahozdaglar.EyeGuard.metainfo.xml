<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.seyfullahozdaglar.EyeGuard</id>

  <name>Eye Guard</name>

  <summary>
    Minimal eye break reminder
  </summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Eye Guard is a minimalist desktop utility that reminds users
      to rest their eyes using the 20-20-20 rule.
    </p>

    <p>
      Features include fullscreen break overlays, smooth fade animations,
      configurable reminder intervals, and lightweight PyQt6 design.
    </p>
  </description>

  <launchable type="desktop-id">
    com.seyfullahozdaglar.EyeGuard.desktop
  </launchable>

  <screenshots>
    <screenshot type="default">
      <image>
        https://raw.githubusercontent.com/seyfullahozdaglar/eye-guard/main/screenshots/main.png
      </image>
    </screenshot>
  </screenshots>

  <url type="homepage">
    https://github.com/seyfullahozdaglar/eye-guard
  </url>

  <developer_name>
    Seyfullah
  </developer_name>

  <categories>
    <category>Utility</category>
  </categories>
</component>