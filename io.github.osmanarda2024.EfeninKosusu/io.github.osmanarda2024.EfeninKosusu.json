{
    "app-id": "io.github.osmanarda2024.EfeninKosusu",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "efeninkosusu",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=network"
    ],
    "modules": [
        {
            "name": "efeninkosusu",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 main.js /app/bin/efeninkosusu",
                "install -Dm644 index.html /app/share/io.github.osmanarda2024.EfeninKosusu/index.html",
                "install -Dm644 io.github.osmanarda2024.EfeninKosusu.desktop /app/share/applications/io.github.osmanarda2024.EfeninKosusu.desktop",
                "install -Dm644 icon.svg /app/share/icons/hicolor/scalable/apps/io.github.osmanarda2024.EfeninKosusu.svg",
                "install -Dm644 io.github.osmanarda2024.EfeninKosusu.metainfo.xml /app/share/metainfo/io.github.osmanarda2024.EfeninKosusu.metainfo.xml"
            ],
            "sources": [
                { "type": "file", "path": "main.js" },
                { "type": "file", "path": "index.html" },
                { "type": "file", "path": "io.github.osmanarda2024.EfeninKosusu.desktop" },
                { "type": "file", "path": "icon.svg" },
                { "type": "file", "path": "io.github.osmanarda2024.EfeninKosusu.metainfo.xml" }
            ]
        }
    ]
}
