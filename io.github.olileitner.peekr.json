{
  "app-id": "io.github.olileitner.peekr",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "peekr",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--filesystem=xdg-videos"
  ],
  "modules": [
    {
      "name": "peekr",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
      },
      "build-commands": [
        "mkdir -p .cargo",
        "cp flatpak-cargo-config.toml .cargo/config.toml",
        "cargo build --release --offline --frozen",
        "install -Dm755 target/release/peekr /app/bin/peekr",
        "install -Dm644 data/io.github.olileitner.peekr.desktop /app/share/applications/io.github.olileitner.peekr.desktop",
        "install -Dm644 data/icons/hicolor/scalable/apps/io.github.olileitner.peekr.svg /app/share/icons/hicolor/scalable/apps/io.github.olileitner.peekr.svg",
        "install -Dm644 data/io.github.olileitner.peekr.metainfo.xml /app/share/metainfo/io.github.olileitner.peekr.metainfo.xml"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/olileitner/peekr/archive/refs/tags/v0.1.4.tar.gz",
          "sha256": "77331ef65aaaf8dac97b6b4a8427c2ef9ad3eb209a960e7996a2bc992274b55c"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
