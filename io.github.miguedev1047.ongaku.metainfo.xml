<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>io.github.miguedev1047.ongaku</id>
    <launchable type="desktop-id">io.github.miguedev1047.ongaku.desktop</launchable>
    <name>Ongaku</name>
    <developer id="io.github.miguedev1047">
        <name>Miguel Jiménez</name>
    </developer>

    <summary>Lightweight desktop music player and YouTube audio downloader</summary>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>MIT</project_license>
    <url type="homepage">https://github.com/miguedev1047/ongaku</url>
    <url type="bugtracker">https://github.com/miguedev1047/ongaku/issues</url>
    <url type="vcs-browser">https://github.com/miguedev1047/ongaku</url>

    <content_rating type="oars-1.1" />

    <categories>
        <category>AudioVideo</category>
        <category>Audio</category>
        <category>Player</category>
        <category>Music</category>
    </categories>

    <keywords>
        <keyword>music</keyword>
        <keyword>player</keyword>
        <keyword>youtube</keyword>
        <keyword>audio</keyword>
        <keyword>downloader</keyword>
        <keyword>mp3</keyword>
    </keywords>

    <branding>
        <color type="primary" scheme_preference="light">#00ffff</color>
        <color type="primary" scheme_preference="dark">#0c9aff</color>
    </branding>

    <recommends>
        <display_length compare="ge">360</display_length>
        <control>pointing</control>
        <control>keyboard</control>
    </recommends>

    <supports>
        <control>pointing</control>
        <control>keyboard</control>
        <control>touch</control>
    </supports>

    <description>
        <p>
            Ongaku is a clean, minimal, and blazing-fast desktop music player and YouTube audio downloader.
        </p>
        <p>Features:</p>
        <ul>
            <li>Instant YouTube search and background audio streaming.</li>
            <li>Smart download queue with automatic ID3 tagging and embedded high-res cover art.</li>
            <li>Safe batch local audio file importing with protected chunking pipeline.</li>
            <li>Offline library and custom playlist organization.</li>
            <li>Built-in hardware media key support and system integration.</li>
        </ul>
    </description>

    <icon type="remote">https://raw.githubusercontent.com/miguedev1047/ongaku/refs/heads/master/public/ongaku-logo.png</icon>

