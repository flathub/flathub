<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.openfield.Openfield</id>
  <name>Openfield</name>
  <summary>Multi-agent PTY orchestration canvas</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <!-- Closed-source (see LICENSE in the main repo). AppStream/Flathub do
       accept proprietary apps (Spotify, Slack, Discord, Steam are all on
       Flathub) — the correct id for "no open-source license, no SPDX id"
       is the AppStream-reserved `LicenseRef-proprietary`, not a free-text
       string. -->
  <project_license>LicenseRef-proprietary</project_license>
  <description>
    <p>
      Openfield spawns multiple PTY terminals (shells, claude, aider, and
      other agent CLIs) on a canvas and wires them together so agents can
      delegate tasks to each other via a built-in HTTP orchestrator.
    </p>
  </description>
  <launchable type="desktop-id">dev.openfield.Openfield.desktop</launchable>
  <url type="homepage">https://github.com/NatanBack77/openfield-releases</url>
  <content_rating type="oars-1.1" />
  <releases>
    <!-- Bump alongside the extra-data url/sha256/size in the manifest on
         every tag meant to reach Flathub users. -->
    <release version="0.1.11" date="2026-07-09" />
  </releases>
</component>
