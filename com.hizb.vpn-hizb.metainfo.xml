<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.hizb.vpn-hizb</id>

  <name>VPN Hizb</name>
  <summary>Public VPN client for Linux</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <developer id="com.hizb">
    <name>Ajang Supardi</name>
  </developer>

  <description>
    <p>
      VPN Hizb is a free and open-source VPN client that provides secure internet access through a global network of public VPN servers via the VPN Gate API.
    </p>
    <p>Features include:</p>
    <ul>
      <li>VPN Gate integration for public server access</li>
      <li>IP leak detection</li>
      <li>IPv6 management to prevent leaks</li>
      <li>Bilingual support (English and Indonesian)</li>
      <li>One-click connect with a clean, simple UI</li>
    </ul>
    <p>**Requires the VPN Hizb daemon to be installed on your system.** The daemon runs with root privileges and manages the OpenVPN connection. Install it via your package manager or from the GitHub releases page.</p>
  </description>

  <url type="homepage">https://github.com/ajangsupardi/vpn-hizb</url>
  <url type="bugtracker">https://github.com/ajangsupardi/vpn-hizb/issues</url>
  <url type="vcs-browser">https://github.com/ajangsupardi/vpn-hizb</url>

  <launchable type="desktop-id">com.hizb.vpn-hizb.desktop</launchable>

  <screenshots>
