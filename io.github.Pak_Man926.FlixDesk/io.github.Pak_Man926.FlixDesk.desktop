[Desktop Entry]
Name=FlixDesk
GenericName=Netflix Desktop Client
Comment=Unofficial Netflix desktop client for Linux with MPRIS and Widevine DRM
Exec=flixdesk %U
Icon=io.github.Pak_Man926.FlixDesk
Type=Application
StartupNotify=true
StartupWMClass=FlixDesk
Categories=AudioVideo;Video;Player;TV;Network;
Keywords=netflix;stream;video;movie;tv;series;mpris;media;
MimeType=x-scheme-handler/flixdesk;
Actions=PlayPause;NextEpisode;Preferences;

[Desktop Action PlayPause]
Name=Play / Pause
Exec=flixdesk --action=playpause

[Desktop Action NextEpisode]
Name=Next Episode
Exec=flixdesk --action=next

[Desktop Action Preferences]
Name=Preferences
Exec=flixdesk --action=preferences
