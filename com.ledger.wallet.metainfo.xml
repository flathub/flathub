<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.ledger.wallet</id>
  <name>Ledger Wallet</name>
  <summary>Manage your cryptocurrency assets with Ledger Wallet</summary>
  <icon type="stock">com.ledger.wallet.png</icon>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  
  <developer id="com.ledger">
    <name>LedgerHQ</name>
  </developer>
  
  <categories>
    <category>Office</category>
    <category>Finance</category>
  </categories>
  
  <description>
  <p>NOTE: This is the official Ledger Wallet AppImage packaged into a Flatpak by the community. This is NOT affiliated with Ledger.</p>
  <p>Ledger Wallet™ lets you build your portfolio: buy, swap, stake, spend* with the simplicity of exchanges &amp; security of a signer.</p>
  <p>For the Ledger device to be detected over USB you must install the udev rules. See Linux installation instructions at: https://support.ledger.com/article/4404389606417-zd</p>
  </description>
  
  <url type="homepage">https://www.ledger.com/</url>
  <url type="help">https://support.ledger.com/</url>
  <url type="vcs-browser">https://github.com/LedgerHQ/ledger-live</url>
  
  <launchable type="desktop-id">com.ledger.wallet.desktop</launchable>  
  
  <screenshots>
  
