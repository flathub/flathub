{
  "app-id": "de.turtle_coding_gbr.turtlements",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "turtlements-wrapper",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=pulseaudio"
  ],
  "cleanup": [
    "*.a",
    "/include",
    "/lib/pkgconfig",
    "/share/pkgconfig"
  ],
  "modules": [
    {
      "name": "libass",
      "buildsystem": "meson",
      "config-opts": [
        "-Dtest=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/libass/libass/releases/download/0.17.3/libass-0.17.3.tar.xz",
          "sha256": "eae425da50f0015c21f7b3a9c7262a910f0218af469e22e2931462fed3c50959"
        }
      ]
    },
    {
      "name": "libplacebo",
      "buildsystem": "meson",
      "config-opts": [
        "-Dvulkan=disabled",
        "-Dopengl=disabled"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://code.videolan.org/videolan/libplacebo/-/archive/v6.338.2/libplacebo-v6.338.2.tar.gz",
          "sha256": "d029adbe55bba8aed7aed2c48b0b66081dddfb9d42683a709342e33aa666c544"
        }
      ]
    },
    {
      "name": "libmpv",
      "buildsystem": "meson",
      "config-opts": [
        "-Dlibmpv=true",
        "-Dcplayer=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/mpv-player/mpv/archive/refs/tags/v0.38.0.tar.gz",
          "sha256": "86d9ef40b6058732f67b46d0bbda24a074fae860b3eaae05bab3145041303066"
        }
      ]
    },
    {
      "name": "turtlements",
      "buildsystem": "simple",
      "sources": [
        {
          "type": "archive",
          "url": "https://static.turtle-coding-gbr.de/archives/turtlements/1.0.6+44.tar.gz",
          "sha256": "90fa16a90d4ea3a4202eef05750f3a7f6fff84e80abf985a757956c1eddafc29",
          "strip-components": 0,
          "only-arches": [
            "x86_64"
          ]
        }
      ],
      "build-commands": [
        "install -Dm755 data/turtlements-wrapper.sh /app/bin/turtlements-wrapper",
        "install -Dm755 bin/Turtlements /app/execute",
        "mkdir -p /app/bin/turtlements/",
        "ln -s /app/execute /app/bin/turtlements/execute",
        "install -Dm644 data/entry.desktop /app/share/applications/$FLATPAK_ID.desktop",
        "install -Dm644 data/icon.png /app/share/icons/hicolor/256x256/apps/$FLATPAK_ID.png",
        "install -Dm644 data/metainfo.xml /app/share/metainfo/$FLATPAK_ID.metainfo.xml",
        "install -Dm644 data/mime.xml /app/share/mime/packages/$FLATPAK_ID.xml",
        "mkdir -p /app/lib",
        "cp -r bin/lib/* /app/lib/",
        "mkdir -p /app/data",
        "cp -r bin/data/* /app/data/"
      ]
    }
  ]
}
