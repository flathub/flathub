<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Duf1220.PicoCar-Racing</id>

  <name>PicoCar Racing</name>
  <summary>Race with tiny RC cars</summary>
  <summary xml:lang="cs">Závody s malými RC autíčky</summary>

  <developer id="io.github.duf1220">
    <name>UPSIDE DOWN VR</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <description>
    <p>PicoCar Racing is an arcade racing game with tiny remote-controlled cars. Race through 9 tracks and beat your best times.</p>
    <p xml:lang="cs">PicoCar Racing jsou arkádové závody s malými RC autíčky. Projeďte 9 tratí a překonejte své nejlepší časy.</p>
    <p>Controls: pause the game with P.</p>
    <p xml:lang="cs">Ovládání: hru pozastavíte klávesou P.</p>
  </description>

  <launchable type="desktop-id">io.github.Duf1220.PicoCar-Racing.desktop</launchable>

  <url type="homepage">https://github.com/Duf1220/PicoCar-Racing</url>
  <url type="bugtracker">https://github.com/Duf1220/PicoCar-Racing/issues</url>
  <url type="vcs-browser">https://github.com/Duf1220/PicoCar-Racing</url>

  <update_contact>office@upsidedownvr.cz</update_contact>

  <screenshots>
    <!-- Další snímky: screenshots/2.png, 3.png ... PNG 16:9, bez rámu okna -->
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Duf1220/PicoCar-Racing/main/screenshots/1.png</image>
      <caption>Racing on a track</caption>
      <caption xml:lang="cs">Závod na trati</caption>
    </screenshot>
  </screenshots>

  <branding>
    <!-- Barvy pozadí na stránce Flathubu, upravte podle ikony -->
    <color type="primary" scheme_preference="light">#f0d9c8</color>
    <color type="primary" scheme_preference="dark">#3b5566</color>
  </branding>

  <recommends>
    <control>keyboard</control>
    <control>gamepad</control>
  </recommends>
  <supports>
    <control>pointing</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <!-- Vygenerujte na https://hughsie.github.io/oars/generate.html a vložte sem.
       Prázdný tag = žádný citlivý obsah. -->
  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.0.0" date="2026-10-13">
      <description>
        <p>Initial Flathub release.</p>
        <p xml:lang="cs">První vydání na Flathubu.</p>
      </description>
    </release>
  </releases>
</component>
