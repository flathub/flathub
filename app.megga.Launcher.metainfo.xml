<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.megga.Launcher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://megga.app/#/copyright</project_license>

  <name>Megga</name>
  <summary>One account for chat, wallet, storage, mail, TV and games</summary>
  <developer id="app.megga">
    <name>MEGGA</name>
  </developer>

  <description>
    <p>
      MEGGA is a self-hosted super app: chat and calls, a wallet, cloud storage, your own
      @megga.app email, TV+, a marketplace, social, maps and games, all behind one sign-in.
      It runs on MEGGA's own servers, with no big tech in between.
    </p>
    <p>The desktop app adds:</p>
    <ul>
      <li>Every MEGGA app in one window</li>
      <li>Downloading, installing and launching PC games from MEGGA Play</li>
      <li>A tray icon so you stay reachable with the window closed</li>
      <li>Desktop notifications for messages and calls</li>
    </ul>
  </description>

  <launchable type="desktop-id">app.megga.Launcher.desktop</launchable>

  <url type="homepage">https://megga.app</url>
  <url type="help">https://megga.app/#/changelog</url>

  <screenshots>
    <screenshot type="default">
      <image>https://megga.app/icon/launcher/screenshots/home.png</image>
      <caption>All of MEGGA in one window</caption>
    </screenshot>
    <screenshot>
      <image>https://megga.app/icon/launcher/screenshots/changelog.png</image>
      <caption>See what's new in every release</caption>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#c4b5fd</color>
    <color type="primary" scheme_preference="dark">#2e1a6b</color>
  </branding>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
    <content_attribute id="money-purchasing">mild</content_attribute>
  </content_rating>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <internet>always</internet>
  </requires>

  <releases>
    <release version="0.7.6" date="2026-11-11">
      <description>
        <p>Dock and taskbar icon fixes, and launcher reliability improvements.</p>
      </description>
    </release>
  </releases>
</component>
