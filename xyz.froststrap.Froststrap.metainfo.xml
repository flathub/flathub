<component type="desktop-application">
  <id>xyz.froststrap.Froststrap</id>
  <name>Froststrap</name>
  <summary>Launch and customize Roblox</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <developer id="xyz.froststrap">
    <name>Froststrap</name>
