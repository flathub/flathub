<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>com.alliedbits.ABCalcPlus</id>
    <project_license>LicenseRef-proprietary=https://alliedbits.com/abcalc/LicensePlus.html</project_license>
    <name>ABCalc Plus</name>
    <summary>Programmable calculator for complex expressions</summary>
    <metadata_license>CC0-1.0</metadata_license>
    <developer id="com.alliedbits">
        <name>Allied Bits Ltd.</name>
    </developer>
    <description>
        <p>
            ABCalc Plus is a powerful yet user-friendly programmable calculator for complex expressions, offering multi-format results, persistent history, unlimited memory, and much more.
        </p>
        <ul>
            <li>Calculation of complex expressions with full text-editor support</li>
            <li>Presentation of results in various formats concurrently</li>
            <li>History of calculations that persists across sessions</li>
            <li>Unlimited number of memory cells (variables)</li>
            <li>Over 100 built-in functions for statistics, science, programming, and everyday use</li>
            <li>Unit conversion with over 100 units of measurement</li>
            <li>Different UI themes</li>
            <li>Create your own library of functions</li>
            <li>Settings, history, and function library can be synchronized with cloud storage of your choice</li>
        </ul>
    </description>
    <launchable type="desktop-id">com.alliedbits.ABCalcPlus.desktop</launchable>
    <categories>
        <category>Office</category>
        <category>Utility</category>
    </categories>
    <keywords>
        <keyword>programmable</keyword>
        <keyword>calculator</keyword>
    </keywords>    
    <branding>
        <color type="primary" scheme_preference="light">#10adb0</color>
        <color type="primary" scheme_preference="dark">#0e2125</color>
    </branding>    
    <content_rating type="oars-1.1"/>
    <url type="homepage">https://alliedbits.com/abcalc</url>
    <url type="contact">https://alliedbits.com/contacts/</url>
    <screenshots>
        <screenshot type="default">
            <caption>Main calculator window</caption>
            <image>https://alliedbits.com/abcalc/images/linux_main_screen.png</image>
        </screenshot>
        <screenshot>
            <caption>Main calculator window with dark skin</caption>
            <image>https://alliedbits.com/abcalc/images/linux_dark_skin.png</image>
