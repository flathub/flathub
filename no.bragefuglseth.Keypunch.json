{
    "id":"no.bragefuglseth.Keypunch",
    "runtime":"org.gnome.Platform",
    "runtime-version":"50",
    "sdk":"org.gnome.Sdk",
    "sdk-extensions":[
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command":"keypunch",
    "finish-args":[
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-run/app/com.discordapp.Discord:create"
    ],
    "build-options":{
        "append-path":"/usr/lib/sdk/rust-stable/bin"
    },
    "modules":[
        {
            "name":"keypunch",
            "builddir":true,
            "buildsystem":"meson",
            "config-opts":[
                "-Dbuildtype=release",
                "-Dsandboxed=true"
            ],
            "run-tests":true,
            "sources":[
                {
                    "type":"git",
                    "url":"https://github.com/bragefuglseth/keypunch.git",
                    "tag":"v7.0",
                    "commit":"09fc8bc9dbe58da4421b60541fbad2a63e214ea8"
                },
                "cargo-sources.json"
            ]
        }
    ]
}

