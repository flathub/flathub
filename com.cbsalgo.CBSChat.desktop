[Desktop Entry]
Name=CBSChat
GenericName=Instant Messenger
GenericName[tr]=Anlık Mesajlaşma
Comment=Instant messaging and VoIP application
Comment[tr]=Anlık mesajlaşma ve sesli/görüntülü görüşme uygulaması
Exec=cbschat %U
Terminal=false
Type=Application
Icon=com.cbsalgo.CBSChat
StartupWMClass=com.cbsalgo.CBSChat
Keywords=chat;im;messaging;messenger;voip;voice;video;call;sohbet;mesaj;
Categories=Network;InstantMessaging;Chat;
StartupNotify=true
SingleMainWindow=true
MimeType=x-scheme-handler/cbschat;
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Name[tr]=Ayarları Aç
Exec=cbschat --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Name[tr]=Yeni Özel Mesaj
Exec=cbschat --fluxer-task=new-dm %U
