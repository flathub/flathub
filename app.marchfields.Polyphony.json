{
    "id" : "app.marchfields.Polyphony",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "command" : "polyphony",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=xdg-run/discord-ipc-0",
        "--filesystem=xdg-run/app/com.discordapp.Discord:create"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        "wrapper-lite.json",
        "python3-pylast.json",
        "python3-discord-rpc.json",
        "python3-orchestrator.json",
        {
            "name" : "polyphony",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.gnome.org/jannuary/polyphony",
                    "commit" : "66b29e1053797948806d1178bd665ea66c7c7ff3",
                    "tag" : "1",
                    "x-checker-data" : {
                        "type" : "git",
                        "tag-pattern" : "^(\\d+(?:\\.\\d+)*)$"
                    }
                }
            ]
        }
    ]
}
