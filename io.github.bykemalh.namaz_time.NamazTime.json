{
    "id" : "io.github.bykemalh.namaz_time.NamazTime",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "separate-locales" : false,
    "command" : "namaz-time",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--talk-name=org.kde.StatusNotifierWatcher"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "env" : {
            "CARGO_HOME" : "/run/build/namaz-time/cargo",
            "RUST_BACKTRACE" : "1",
            "RUST_LOG" : "namaz_time=info,warn"
        }
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "namaz-time",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "--buildtype=release"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/bykemalh/namaz-time.git",
                    "tag" : "v0.1.0",
                    "commit" : "d3cc548a232c4e78b020ce34ce3a567844540991"
                },
                "cargo-sources.json"
            ]
        }
    ]
}
