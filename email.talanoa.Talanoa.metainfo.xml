<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>email.talanoa.Talanoa</id>
  <name>Talanoa</name>
  <summary>The email client with conversations, todos, calendar and AI, private by design.</summary>
  <developer id="email.talanoa">
    <name>Ekoha</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://talanoa.email/terms</project_license>
  <description>
    <p>
      Talanoa is a desktop email client for people who hate email. Instead of one long list of
      messages, your inbox is organized by sender: you see who is writing to you and what matters,
      not a stream of newsletters and notifications.
    </p>
    <p>
      Your mail stays on your computer. Talanoa stores everything locally, It connects to Gmail, Outlook, Yahoo, iCloud and any
      IMAP account, in one unified inbox.
    </p>
    <ul>
      <li>Inbox grouped by the people and services that write to you</li>
      <li>Unified inbox across every account</li>
      <li>Turn an email into a task on a built-in to-do board</li>
      <li>One click to unsubscribe from a sender, block it and clean up its emails</li>
      <li>Share your free time slots from the composer, with a booking link</li>
      <li>Calendar, contacts and attachments at hand</li>
      <li>No cloud sync and no ads: your emails stay on your computer</li>
    </ul>
  </description>
  <launchable type="desktop-id">email.talanoa.Talanoa.desktop</launchable>
  <url type="homepage">https://talanoa.email</url>
  <url type="help">https://talanoa.email/help</url>
  <url type="faq">https://talanoa.email/help</url>
  <url type="contact">https://talanoa.email/help/contact-support</url>
  <url type="vcs-browser">https://github.com/talanoa-email/desktop-releases</url>
  <branding>
    <color type="primary" scheme_preference="light">#ede9fe</color>
    <color type="primary" scheme_preference="dark">#4c1d95</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image>https://talanoa.email/img/light_mode.png</image>
      <caption>The inbox, organized by sender</caption>
    </screenshot>
    <screenshot>
      <image>https://talanoa.email/img/dark_mode.png</image>
      <caption>The same inbox in dark mode</caption>
    </screenshot>
    <screenshot>
      <image>https://talanoa.email/img/changelog/v1.1.3-3.png</image>
      <caption>A conversation, read like a chat</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="1.2.2" date="2026-11-11">
      <url type="details">https://talanoa.email/changelog/1.2.2</url>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>Network</category>
    <category>Email</category>
  </categories>
  <keywords>
    <keyword>email</keyword>
    <keyword>mail</keyword>
    <keyword>inbox</keyword>
    <keyword>imap</keyword>
    <keyword>gmail</keyword>
    <keyword>outlook</keyword>
  </keywords>
  <provides>
    <binary>talanoa</binary>
    <mediatype>x-scheme-handler/mailto</mediatype>
  </provides>
  <recommends>
    <display_length compare="ge">768</display_length>
    <internet>always</internet>
  </recommends>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
</component>
