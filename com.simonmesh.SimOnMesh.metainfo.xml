<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.simonmesh.SimOnMesh</id>
  <name>SimOnMesh</name>
  <summary>Interactive hex-block mesh generator for OpenFOAM</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <description>
    <p>
      SimOnMesh is a desktop application for visualizing STL geometry and
      generating OpenFOAM blockMeshDict files. It provides an interactive 3D
      viewport to load STL geometry, fit hexahedral blocks, drag nodes onto
      the surface, curve block edges along feature lines, and project faces
      onto curved patches.
    </p>
    <ul>
      <li>STL loading with interactive 3D viewport</li>
      <li>Automatic patch partitioning by feature edges</li>
      <li>blockMeshDict generation, reading, and saving</li>
      <li>Block operations: edit, split, extrude, shrink, merge, remove</li>
      <li>In-memory quality metrics (non-orthogonality, skewness, aspect ratio)</li>
      <li>Session save/load (.smesh) with embedded blockMeshDict and patch STLs</li>
      <li>Undo/redo for all topology and coupling operations</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.simonmesh.SimOnMesh.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>Interactive 3D viewport with hex-block mesh over STL geometry</caption>
      <image>https://raw.githubusercontent.com/sim-on-mesh/sim-on-mesh/main/screenshots/main-viewport.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://www.simonmesh.com</url>
  <url type="bugtracker">https://github.com/sim-on-mesh/sim-on-mesh/issues</url>

  <provides>
