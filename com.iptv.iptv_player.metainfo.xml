<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.iptv.iptv_player</id>
  <name>HermesTV</name>
  <summary>Watch free live TV channels, movies and series</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="com.github.behranus">
    <name>Behranus</name>
  </developer>

  <description>
    <p>
      HermesTV is a free and open-source IPTV player that lets you watch
      live TV channels, movies and series from around the world.
    </p>
    <p>Features:</p>
    <ul>
      <li>M3U playlist and Xtream Codes IPTV support</li>
      <li>Free and legal world TV channels via iptv-org</li>
      <li>VOD — movies and TV series with poster art</li>
      <li>EPG (Electronic Program Guide) support</li>
      <li>Subtitle support — HLS embedded and external SRT/VTT/ASS</li>
      <li>Audio track selection — multi-language audio</li>
      <li>TV remote / D-pad navigation support</li>
      <li>Zorin OS inspired dark theme</li>
      <li>Works on Android, Android TV Box, and Linux desktop</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.iptv.iptv_player.desktop</launchable>

  <url type="homepage">https://github.com/Behranus/hermestv</url>
  <url type="bugtracker">https://github.com/Behranus/hermestv/issues</url>
  <url type="vcs-browser">https://github.com/Behranus/hermestv</url>

  <screenshots>
    <screenshot type="default">
      <caption>Live TV channel list with categories</caption>
      <image>https://raw.githubusercontent.com/Behranus/hermestv/main/screenshots/channels.png</image>
    </screenshot>
    <screenshot>
      <caption>VOD movie and series catalog</caption>
      <image>https://raw.githubusercontent.com/Behranus/hermestv/main/screenshots/vod.png</image>
    </screenshot>
    <screenshot>
      <caption>Player with subtitle and audio track controls</caption>
      <image>https://raw.githubusercontent.com/Behranus/hermestv/main/screenshots/player.png</image>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="dark">#141824</color>
    <color type="primary" scheme_preference="light">#3b82f6</color>
  </branding>

  <releases>
    <release version="2.1.0" date="2026-08-23">
      <description>
        <p>Donate screen, Flatpak packaging, and bug fixes.</p>
        <ul>
          <li>Added GitHub Sponsors donate screen</li>
          <li>Flatpak packaging for Linux distribution</li>
          <li>Removed premium, Turkish and Kurdish channels</li>
          <li>Disabled automatic source loading on startup</li>
          <li>Cleared all channel caches for clean install</li>
        </ul>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1">
    <content_attribute id="violence-fantasy">none</content_attribute>
    <content_attribute id="violence-realistic">none</content_attribute>
    <content_attribute id="drugs-alcohol">none</content_attribute>
    <content_attribute id="drugs-narcotics">none</content_attribute>
    <content_attribute id="sex-nudity">none</content_attribute>
    <content_attribute id="sex-themes">none</content_attribute>
    <content_attribute id="language-profanity">none</content_attribute>
    <content_attribute id="money-gambling">none</content_attribute>
  </content_rating>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>gamepad</control>
  </recommends>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
</component>
