id: net.nontrivial.ccwww
runtime: org.freedesktop.Platform
runtime-version: '25.08'
sdk: org.freedesktop.Sdk
command: ccwww
finish-args:
  - --share=network
  - --socket=x11
  - --socket=wayland
modules:
  - name: ccwww
    buildsystem: simple
    build-commands:
      # Unpack the compiled Flutter engine files directly into the sandbox
      - cp -r * /app/bin/
      - chmod +x /app/bin/ccwww

      # Install systemic assets so Linux recognizes the app environment
      - install -Dm644 net.nontrivial.ccwww.desktop /app/share/applications/net.nontrivial.ccwww.desktop
      - install -Dm644 net.nontrivial.ccwww.metainfo.xml /app/share/metainfo/net.nontrivial.ccwww.metainfo.xml
      - install -Dm644 net.nontrivial.ccwww.png /app/share/icons/hicolor/256x256/apps/net.nontrivial.ccwww.png

    sources:
      # Points directly to the release binary archive processed by Codemagic
      - type: archive
        url: https://github.com/jbearden0/net.neocaddy.ccwww/releases/download/v1.0.0/ccwww-linux.tar.gz
        sha256: "PLACEHOLDER_HASH"

      # Pull structural configuration assets right from the public git tree
      - type: file
        path: linux/net.nontrivial.ccwww.desktop
      - type: file
        path: linux/net.nontrivial.ccwww.metainfo.xml
      - type: file
        path: linux/net.nontrivial.ccwww.png
