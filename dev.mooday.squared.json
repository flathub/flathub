{
  "app-id": "dev.mooday.squared",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "dev.mooday.squared.sh",
  "finish-args": [
    "--socket=pulseaudio",
    "--device=dri",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11"
  ],
  "modules": [
    {
      "name": "squared",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "archive",
          "url": "https://gitlab.freedesktop.org/-/project/21436/uploads/fc8bd140acd7c474a777ac41d46fc498/squared-0.4.0.tar.xz",
          "sha256": "3a1d2a9e10d0afe182b06cc5c4b70f78484393ad2d3bcf16241752d552fd13c8"
        },
        {
          "type": "file",
          "url": "https://gitlab.freedesktop.org/-/project/21436/uploads/e2e784f6e7cedffd0227a500b791fbdd/squared_x86_64",
          "sha256": "d9f79ab89b5ae369aeed11c6052d402e8218cd503bf85b4a235f9c30c46a7c63"
        },
        {
          "type": "file",
          "url": "https://gitlab.freedesktop.org/-/project/21436/uploads/46f085cc163149663166bb4dbb6d14ed/squared_x86_64.pck",
          "sha256": "8a7d0304b810b2b08372e08aa9f1d233414e5d47192e2892118ac904d7792d62"
        },
        {
          "type": "script",
          "commands": [
            "cd /app/bin && exec /app/bin/squared \"$@\""
          ],
          "dest-filename": "dev.mooday.squared.sh"
        }
      ],
      "post-install": [
        "install -Dm755 ../squared_x86_64 $FLATPAK_DEST/bin/squared",
        "install -Dm644 ../squared_x86_64.pck $FLATPAK_DEST/bin/squared.pck",
        "install -Dm755 ../dev.mooday.squared.sh $FLATPAK_DEST/bin/dev.mooday.squared.sh"
      ]
    }
  ]
}
