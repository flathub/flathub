{
  "app-id": "dev.mooday.squared",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "dev.mooday.squared.sh",
  "finish-args": [
    "--socket=pulseaudio",
    "--device=dri",
    "--share=ipc",
    "--socket=x11",
    "--persist=.godot"
  ],
  "modules": [
    {
      "name": "squared",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "archive",
          "url": "https://gitlab.freedesktop.org/-/project/21436/uploads/eb7d94a1e872d0fc31bbd25b41c3c58f/squared-0.2.3.tar.xz",
          "sha256": "047de01670e46698f87bd737dd6ff9b56e3505d031cb2c956718716955fb5ada"
        },
        {
          "type": "file",
          "url": "https://gitlab.freedesktop.org/-/project/21436/uploads/2483eaaa6f424d83955aa967eb40c5c6/squared_x86_64",
          "sha256": "add04661b5ea009c3fe028dc75de015073369c9bce9e11ed19b7ca5fe5008588"
        },
        {
          "type": "file",
          "url": "https://gitlab.freedesktop.org/-/project/21436/uploads/272a7c0b9d8605fe054f927e09b31c5d/data.pck",
          "sha256": "e394d6de61f2fc55a51d681a2563f90b40627f56c5cf676d74753928fbe90230"
        },
        {
          "type": "script",
          "commands": [
            "cd /app/bin && exec /app/bin/squared \"$@\""
          ],
          "dest-filename": "dev.mooday.squared.sh"
        }
      ],
      "post-install": [
        "install -Dm755 ../squared_x86_64 $FLATPAK_DEST/bin/squared",
        "install -Dm644 ../data.pck $FLATPAK_DEST/bin/data.pck",
        "install -Dm755 ../dev.mooday.squared.sh $FLATPAK_DEST/bin/dev.mooday.squared.sh"
      ]
    }
  ]
}
