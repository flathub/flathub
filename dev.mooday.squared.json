{
  "app-id": "dev.mooday.squared",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "dev.mooday.squared.sh",
  "finish-args": [
    "--socket=pulseaudio",
    "--device=dri",
    "--share=ipc",
    "--socket=x11",
    "--persist=.godot"
  ],
  "modules": [
    {
      "name": "squared",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "archive",
          "url": "https://gitlab.freedesktop.org/-/project/21436/uploads/805346a8a3026b89585eb59021581a49/squared-0.2.0.tar.xz",
          "sha256": "fa3eb7acab9387a081d79c87a3d7b4a0a3150d837054c1f766d4ff0f05c5b835"
        },
        {
          "type": "file",
          "url": "https://gitlab.freedesktop.org/dabrain34/squared/uploads/b71cb7fd8e3b000c077282c6d1f25fd0/squared_x86_64",
          "sha256": "fd672ed5053a1a52998fa9a256347a2d91684a29fc061e4ba2d65c10919aa507"
        },
        {
          "type": "file",
          "url": "https://gitlab.freedesktop.org/dabrain34/squared/uploads/96f2b88b8f76c6f0eebc62bcbe03726a/data.pck",
          "sha256": "e3ea23f11ccf2591fb1294b380f73bdb7ffb27f56c0e7281a4f06dc980be5085"
        },
        {
          "type": "script",
          "commands": [
            "cd /app/bin && exec /app/bin/squared \"$@\""
          ],
          "dest-filename": "dev.mooday.squared.sh"
        },
        {
          "type": "patch",
          "path": "fix-appdata.patch"
        },
        {
          "type": "patch",
          "path": "fix-release-date.patch"
        },
        {
          "type": "patch",
          "path": "fix-desktop-file.patch"
        }
      ],
      "post-install": [
        "install -Dm755 ../squared_x86_64 $FLATPAK_DEST/bin/squared",
        "install -Dm644 ../data.pck $FLATPAK_DEST/bin/data.pck",
        "install -Dm755 ../dev.mooday.squared.sh $FLATPAK_DEST/bin/dev.mooday.squared.sh"
      ]
    }
  ]
}