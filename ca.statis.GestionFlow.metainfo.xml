<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ca.statis.GestionFlow</id>
  <name>GestionFlow</name>
  <name xml:lang="fr">GestionFlow</name>
  <summary>Invoicing, expenses and reports for small businesses</summary>
  <summary xml:lang="fr">Facturation, dépenses et rapports pour les PME</summary>
  <developer id="ca.statis">
    <name>Statis</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <launchable type="desktop-id">ca.statis.GestionFlow.desktop</launchable>
  <url type="homepage">https://gestionflow.net</url>
  <url type="help">https://gestionflow.net/contact</url>
  <url type="vcs-browser">https://github.com/Katrina999991/thrive-invoice-hub</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
    <content_attribute id="money-purchasing">moderate</content_attribute>
  </content_rating>
  <branding>
    <color type="primary" scheme_preference="light">#1a3c34</color>
    <color type="primary" scheme_preference="dark">#1a1f36</color>
  </branding>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
    <display_length compare="ge">768</display_length>
  </recommends>
  <requires>
    <internet>always</internet>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <categories>
    <category>Office</category>
    <category>Finance</category>
  </categories>
  <keywords>
    <keyword>invoice</keyword>
    <keyword>billing</keyword>
    <keyword>expense</keyword>
    <keyword>accounting</keyword>
    <keyword xml:lang="fr">facture</keyword>
    <keyword xml:lang="fr">dépense</keyword>
    <keyword xml:lang="fr">comptabilité</keyword>
  </keywords>
  <description>
    <p>
      GestionFlow is business-management software for freelancers, consultants,
      and small companies. Create invoices, track expenses, manage clients,
      and follow reports from one desktop app.
    </p>
    <p>
      An internet connection is required. Some features need a paid plan.
    </p>
    <p xml:lang="fr">
      GestionFlow est un logiciel de gestion pour travailleurs autonomes,
      consultants et PME. Créez des factures, suivez les dépenses, gérez
      les clients et consultez les rapports depuis une application ordinateur.
    </p>
    <p xml:lang="fr">
      Une connexion Internet est requise. Certaines fonctions nécessitent
      un forfait payant.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/Katrina999991/thrive-invoice-hub/desktop-app/public/flathub-screenshot-dashboard.png</image>
      <caption>Dashboard with invoices and quick actions</caption>
      <caption xml:lang="fr">Tableau de bord avec factures et actions rapides</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.1.1" date="2026-08-30">
      <description>
        <p>Initial public Linux and Windows desktop release.</p>
        <p xml:lang="fr">Première version publique de l'application ordinateur Linux et Windows.</p>
      </description>
    </release>
  </releases>
  <provides>
    <binary>gestionflow</binary>
  </provides>
  <update_contact>support@gestionflow.com</update_contact>
</component>
