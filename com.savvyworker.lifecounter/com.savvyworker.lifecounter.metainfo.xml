<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>com.savvyworker.lifecounter</id>

  <name>Savvy MTG Life Counter</name>
  <summary>Life counter and companion app for Magic: The Gathering</summary>

  <metadata_license>MIT</metadata_license>
  <!-- App is proprietary (closed-source, commercial subscriptions) -->
  <project_license>LicenseRef-proprietary</project_license>

  <developer id="com.savvyworker">
    <name>Marcin Ufniarz</name>
  </developer>

  <url type="homepage">https://lifecounter.savvyworker.com</url>
  <url
    type="bugtracker"
  >https://github.com/mufniarz/savvy-mtg-life-counter-releases/issues</url>

  <description>
    <p>
      Savvy MTG Life Counter is a companion app for Magic: The Gathering players.
      Track life totals for multiple players, manage commander damage, poison
      counters and other game counters all from one screen.
    </p>
    <p>Features include:</p>
    <ul>
      <li
      >Life counter supporting 2–6 players with customisable starting life</li>
      <li>Commander damage and poison counter tracking</li>
      <li>Card search and price lookup via Scryfall</li>
      <li>Deck builder with collection management</li>
      <li>Community feed with tournament results and store events</li>
      <li>Store locator to find nearby game stores</li>
      <li>Mini-games including Cardle (daily card guessing game)</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.savvyworker.lifecounter.desktop</launchable>

  <!-- OARS content rating — update if your app contains any mature content -->
  <content_rating type="oars-1.1" />

  <categories>
    <category>Game</category>
    <category>CardGame</category>
  </categories>

  <keywords>
    <keyword>MTG</keyword>
    <keyword>Magic the Gathering</keyword>
    <keyword>life counter</keyword>
    <keyword>card game</keyword>
    <keyword>deck builder</keyword>
  </keywords>

