{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKara",
  "version": "0.7.0",
  "identifier": "com.openkara.desktop",
  "mainBinaryName": "openkara",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node scripts/prepare-bundled-oauth-client.mjs && node scripts/clean-macos-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob:; connect-src 'self' https://lrclib.net https://api.lrc.cx"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "thedavidweng",
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/Assets.car": "Assets.car",
      "generated/onnxruntime": "onnxruntime",
      "generated/oauth": "oauth"
    },
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
