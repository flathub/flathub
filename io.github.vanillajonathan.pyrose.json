{
    "id": "io.github.vanillajonathan.pyrose",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "pyrose",
    "finish-args": [
        "--share=ipc",
        "--device=dri",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "cleanup": [
        "/etc",
        "/include",
        "/lib/pkgconfig",
        "/lib/systemd",
        "/libexec",
        "/share/gir-1.0",
        "/share/glade",
        "/share/xdg-terminals"
    ],
    "modules": [
        "python3-requirements.yaml",
        {
            "name": "vte",
            "buildsystem": "meson",
            "config-opts": [
                "-Ddocs=false",
                "-Dvapi=false"
            ],
            "cleanup": [
                "/share/applications"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/vte/0.84/vte-0.84.1.tar.xz",
                    "sha256": "aca1caa8478aebcdbb1d67897fb3511eb7601debae6810e16a15b6fa25f31ac8",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "vte",
                        "stable-only": true
                    }
                }
            ]
        },
        {
            "name": "pyrose",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/vanillajonathan/pyrose.git",
                    "tag": "v1.1.0",
                    "commit": "af476e949fba40ab17c307a78eeed3c8020f0d74",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ]
        }
    ]
}
