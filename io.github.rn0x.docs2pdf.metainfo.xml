<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.rn0x.docs2pdf</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Docs2PDF</name>
  <summary>Convert Word, Excel, PowerPoint files to PDF</summary>

  <developer id="io.github.rn0x">
    <name>rn0x</name>
  </developer>

  <launchable type="desktop-id">io.github.rn0x.docs2pdf.desktop</launchable>

  <description>
    <p>Docs2PDF is a desktop application that converts Word, Excel, and PowerPoint files to PDF using office2pdf.</p>
    <ul>
      <li>Drag &amp; drop or select files</li>
      <li>Batch conversion with parallel processing</li>
      <li>Multiple paper sizes and orientation</li>
      <li>PDF/A output support</li>
      <li>16 languages with RTL support</li>
      <li>Dark/Light theme</li>
    </ul>
  </description>

