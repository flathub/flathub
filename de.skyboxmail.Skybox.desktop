[Desktop Entry]
Type=Application
Name=Skybox
Comment=Mail, calendar and contacts for all your accounts
Exec=de.skyboxmail.Skybox %U
Icon=de.skyboxmail.Skybox
Terminal=false
Categories=Network;Email;
MimeType=x-scheme-handler/mailto;x-scheme-handler/skybox-desktop;
Keywords=email;mail;imap;calendar;
StartupWMClass=skybox
X-GNOME-UsesNotifications=true
