{
    "app-id": "fr.linkmauve.PyTouhou",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-nightly"
    ],
    "command": "pytouhou",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--share=ipc"
    ],
    "cleanup": [
        "*.a",
        "*.la",
        "/bin/hg",
        "/bin/setuptools-scm",
        "/bin/vcs-versioning",
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/lib/python3.13/site-packages/hg*",
        "/lib/python3.13/site-packages/mercurial*",
        "/lib/python3.13/site-packages/setuptools_scm*",
        "/lib/python3.13/site-packages/vcs_versioning*",
        "/share/bash-completion",
        "/share/zsh"
    ],
    "modules": [
        {
            "name": "vcs-versioning",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app vcs_versioning-2.2.0-py3-none-any.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/d9/4c/f638c153a62e566c3e0e43f3998f8f97d4c3daadc984bb540461eaa8edf3/vcs_versioning-2.2.0-py3-none-any.whl",
                    "sha256": "69a649bfbbe9f8134e8b15cddc7b27daa00e5eccbcb5128e060a87e94bad8255"
                }
            ]
        },
        {
            "name": "setuptools-scm",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app setuptools_scm-10.2.0-py3-none-any.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/46/b4/21180f6fbbf7ed2043bc353608c7b9cc6f7b3d342ad8c287a097e5ca8477/setuptools_scm-10.2.0-py3-none-any.whl",
                    "sha256": "6cc5ac7da8e54d74e43503be2fa023eb7a1ca820d5c318e6ae20efc48110d6c7"
                }
            ]
        },
        {
            "name": "mercurial",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-build-isolation ."
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.pythonhosted.org/packages/8f/e2/55e7cc74f4ffcce9e4d701945f61a5ab6536ff13e3eee9b1da6590731d27/mercurial-7.2.2.tar.gz",
                    "sha256": "f2ec8e7eeef0500591706d374555f0ceb118822068e75fa3b32be07dd2184f6c"
                }
            ]
        },
        {
            "name": "glfw",
            "buildsystem": "cmake-ninja",
            "config-opts": ["-DGLFW_BUILD_EXAMPLES=OFF", "-DGLFW_BUILD_TESTS=OFF", "-DGLFW_BUILD_DOCS=OFF"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/glfw/glfw/releases/download/3.4/glfw-3.4.zip",
                    "sha256": "b5ec004b2712fd08e8861dc271428f048775200a2df719ccf575143ba749a3e9"
                }
            ]
        },
        {
            "name": "sdl2_ttf",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libsdl-org/SDL_ttf/releases/download/release-2.24.0/SDL2_ttf-2.24.0.tar.gz",
                    "sha256": "0b2bf1e7b6568adbdbc9bb924643f79d9dedafe061fa1ed687d1d9ac4e453bfd"
                }
            ]
        },
        {
            "name": "pytouhou",
            "buildsystem": "simple",
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-nightly/bin",
                "env": {
                    "CARGO_HOME": "/run/build/pytouhou/cargo"
                }
            },
            "build-commands": [
                "hg init",
                "hg unbundle -u pytouhou.hg",
                "sed -i '/runner/d; /interpreters/d' Cargo.toml",
                "cd python",
                "cargo build --release",
                "cd ..",
                "install -Dm755 target/release/pytouhou /app/bin/pytouhou",
                "pip3 install --prefix=/app --no-build-isolation ."
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://linkmauve.fr/files/pytouhou.hg",
                    "sha256": "e61eface99b3dac4d70feadf59d59ca7aa28a950e0aa2e0ad264e3158c1211e0"
                },
                "pytouhou-rust.json"
            ]
        },
        {
            "name": "data",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 fr.linkmauve.PyTouhou.metainfo.xml /app/share/metainfo/fr.linkmauve.PyTouhou.metainfo.xml",
                "install -Dm644 fr.linkmauve.PyTouhou.desktop /app/share/applications/fr.linkmauve.PyTouhou.desktop",
                "install -Dm644 rust-touhou.svg /app/share/icons/hicolor/scalable/apps/fr.linkmauve.PyTouhou.svg"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "fr.linkmauve.PyTouhou.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "fr.linkmauve.PyTouhou.desktop"
                },
                {
                    "type": "file",
                    "url": "https://pytouhou.linkmauve.fr/rust-touhou.svg",
                    "sha256": "a9ce46dd7de8da509920b710a390faac7d17d112d28039d389de50c068e27bf8"
                }
            ]
        }
    ]
}
