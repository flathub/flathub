{
    "app-id": "io.github.dragonGR.Dropzone",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "dropzone",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/dropzone/cargo-home"
        }
    },
    "modules": [
        {
            "name": "dropzone",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/dragonGR/Dropzone.git",
                    "tag": "v1.0.0",
                    "commit": "df87acc924bbcfab8fdade5cd3c16fe6fd6ded90"
                }
                "cargo-sources.json"
            ]
        }
    ]
}
