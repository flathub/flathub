{
	"$schema": "https://github.com/flatpak/flatpak-builder/raw/refs/heads/main/data/flatpak-manifest.schema.json",
	"id": "io.github.ic005k.OCAuxiliaryTools",
	"runtime": "org.kde.Platform",
	"runtime-version": "5.15-25.08",
	"sdk": "org.kde.Sdk",
	"command": "launch-ocat",
	"rename-desktop-file": "default.desktop",
	"rename-icon": "icon",
	"finish-args": [
		"--share=network",
		"--share=ipc",
		"--socket=fallback-x11",
		"--socket=wayland",
		"--filesystem=/media",
		"--filesystem=/run/media",
		"--filesystem=/mnt",
		"--filesystem=xdg-config/OCAuxiliaryTools",
		"--persist=.ocat"
	],
	"modules": [
		{
			"name": "OCAuxiliaryTools",
			"builddir": true,
			"buildsystem": "qmake",
			"post-install": [
				"desktop-file-edit --set-key=Terminal --set-value=false ../default.desktop",
				"desktop-file-edit --set-key=Exec --set-value=launch-ocat ../default.desktop",
				"desktop-file-edit --set-key=Comment --set-value='Cross-platform GUI management tools for OpenCore' ../default.desktop",
				"desktop-file-edit --set-key=Categories --set-value='System;Utility;HardwareSettings' ../default.desktop",

				"mkdir -p ${FLATPAK_DEST}/share/OCAuxiliaryTools",
				"cp -r ../Database ${FLATPAK_DEST}/share/OCAuxiliaryTools",
				"rm -rf ${FLATPAK_DEST}/share/OCAuxiliaryTools/linux",
				"ln -s ../${FLATPAK_DEST}/bin ${FLATPAK_DEST}/share/OCAuxiliaryTools/linux",

				"install -Dm755 ../bin/release/OCAuxiliaryTools --target-directory ${FLATPAK_DEST}/bin",
				"install -Dm755 ../launch-ocat --target-directory ${FLATPAK_DEST}/bin",
				"install -Dm755 ../Database/linux/* --target-directory ${FLATPAK_DEST}/bin",
				"install -Dm644 ../icon.png --target-directory ${FLATPAK_DEST}/share/icons/hicolor/256x256/apps",
				"install -Dm644 ../default.desktop --target-directory ${FLATPAK_DEST}/share/applications",
				"install -Dm644 ../${FLATPAK_ID}.metainfo.xml --target-directory ${FLATPAK_DEST}/share/metainfo"
			],
			"sources": [
				{
					"type": "archive",
					"url": "https://github.com/ic005k/OCAuxiliaryTools/archive/refs/tags/20250001.zip",
					"sha256": "3b153526791e1b33cc1304690e6d6d7c12151bf344167a0dca0b19875a5a211a"
				},
				{
					"type": "file",
					"path": "./io.github.ic005k.OCAuxiliaryTools.metainfo.xml"
				},
				{
					"type": "file",
					"path": "./launch-ocat"
				}
			]
		}
	]
}
