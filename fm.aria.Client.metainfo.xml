<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>fm.aria.Client</id>

  <name>aria.fm</name>
  <summary>Native Spotify desktop client</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <developer id="dev.cmdly">
    <name>Kaylin Aurora</name>
  </developer>

  <description>
    <p>
      aria.fm is a native desktop client for Spotify, built as a Go sidecar
      paired with an Electron shell. Playback runs through librespot over a
      Rust FFI layer rather than the web player, so audio is handled natively
      instead of in a browser tab.
    </p>
    <p>Features:</p>
    <ul>
      <li>Native playback via librespot — no web player</li>
      <li>MPRIS integration, so media keys and Now Playing widgets work</li>
      <li>Radio and autoplay context resolution</li>
      <li>Synced lyrics</li>
    </ul>
    <p>
      A Spotify Premium account is required for playback. aria.fm is an
      independent project and is not affiliated with, endorsed by, or
      sponsored by Spotify.
    </p>
  </description>

  <launchable type="desktop-id">fm.aria.Client.desktop</launchable>

  <url type="homepage">https://aria.fm</url>
  <!-- Points at the site, NOT at gitlab.com/cmdly/aria.fm/-/issues, and that
       is deliberate. gitlab.com serves HTTP 404 to anonymous non-browser
       clients on issue lists — reproducible against gitlab-org/gitlab and
       inkscape/inkscape too, so it is gitlab.com policy and not a setting on
       this project (aria.fm-u96r.12). appstreamcli fetches this URL exactly
       that way, and Flathub treats the resulting url-not-reachable warning as
       fatal. https://aria.fm/support returns 200 to anything, carries the
       pre-filled bug form link, and is a better landing place for someone who
       clicked "Report an Issue" in a software centre than a repo page. -->
  <url type="bugtracker">https://aria.fm/support</url>
  <url type="vcs-browser">https://gitlab.com/cmdly/aria.fm</url>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>

  <keywords>
    <keyword>Spotify</keyword>
    <keyword>Music</keyword>
    <keyword>Player</keyword>
    <keyword>Streaming</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <internet>always</internet>
  </requires>

  <!-- Chromium renders the UI; both desktop sizes are comfortable. -->
  <recommends>
    <display_length compare="ge">768</display_length>
  </recommends>

  <content_rating type="oars-1.1">
    <content_attribute id="social-audio">intense</content_attribute>
  </content_rating>

  <!-- Served from the repo over GitLab's raw endpoint, which returns a real
       image/png content-type (checked, not assumed). Pinned to main rather than
       to a tag so the listing tracks the current UI; Flathub mirrors these into
       its own CDN at build time, so the raw endpoint is not in anyone's hot
       path after review.

       PNG rather than WebP deliberately. AppStream 1.2 does accept WebP — it
       fetches and validates one without complaint — but the software centres
       reading this file are whatever the user's distro shipped, and older
       AppStream does not. PNG costs a megabyte across the three and is
       understood by every version there has ever been.

       See "Screenshots" in packaging/README.md for how to regenerate them. -->
  <screenshots>
    <screenshot type="default">
      <caption>Your saved songs, with the player bar playing a radio station</caption>
      <image type="source" width="1600" height="1000">https://gitlab.com/cmdly/aria.fm/-/raw/main/packaging/screenshots/library.png</image>
    </screenshot>
    <screenshot>
      <caption>Every album in your library, by cover</caption>
      <image type="source" width="1600" height="1000">https://gitlab.com/cmdly/aria.fm/-/raw/main/packaging/screenshots/albums.png</image>
    </screenshot>
    <screenshot>
      <caption>The command palette, ranking your library above catalog results</caption>
      <image type="source" width="1600" height="1000">https://gitlab.com/cmdly/aria.fm/-/raw/main/packaging/screenshots/palette.png</image>
    </screenshot>
  </screenshots>

