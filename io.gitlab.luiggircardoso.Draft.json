{
    "id" : "io.gitlab.luiggircardoso.Draft",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "49",
    "sdk" : "org.gnome.Sdk",
    "command" : "draft",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-documents"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "draft",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts": [
                "-Dprofile=default"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.com/luiggircardoso/draft.git",
                    "tag" : "v1.0.0"
                }
            ],
            "post-install": [
                "glib-compile-schemas /app/share/glib-2.0/schemas"
            ]
        }
    ]
}
