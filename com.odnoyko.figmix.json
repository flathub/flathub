{
  "app-id": "com.odnoyko.figmix",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.node22"
  ],
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "25.08",
  "command": "figmix-launcher",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--env=ELECTRON_OZONE_PLATFORM_HINT=auto",
    "--env=FIGMA_LINUX_FLATPAK=1",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "build-options": {
      "append-path": "/usr/lib/sdk/node22/bin",
      "env": {
        "XDG_CACHE_HOME": "/app/flatpak-node/cache",
        "npm_config_cache": "/app/flatpak-node/npm-cache",
        "npm_config_offline": "true",
        "npm_config_legacy_peer_deps": "true",
        "ELECTRON_SKIP_BINARY_DOWNLOAD": "1",
        "HOME": "/run/build/figmix"
      }
  },
  "modules": [
    {
      "name": "figmix-npm-deps",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/flatpak-node",
        "cp -a flatpak-node/. /app/flatpak-node/"
      ],
      "sources": [
        "generated-sources.json"
      ]
    },
    {
      "name": "figmix",
      "buildsystem": "simple",
      "build-commands": [
        "npm install --offline --no-audit --legacy-peer-deps --ignore-scripts",
        "npx vite build",
        "cp src/package.json dist/package.json",
        "cp package-lock.json dist/package-lock.json",
        "cd dist && npm ci --offline --omit=dev --no-audit --legacy-peer-deps --ignore-scripts",
        "npx electron-builder --config=config/builder.json -l dir",
        "cp -a build/installers/linux-unpacked /app/main",
        "rm -rf node_modules dist build",
        "install -Dm755 flatpak/figmix-launcher.sh /app/bin/figmix-launcher",
        "install -Dm644 resources/com.odnoyko.figmix.desktop /app/share/applications/com.odnoyko.figmix.desktop",
        "install -Dm644 resources/com.odnoyko.figmix.metainfo.xml /app/share/metainfo/com.odnoyko.figmix.metainfo.xml",
        "install -Dm644 resources/icons/com.odnoyko.figmix.svg /app/share/icons/hicolor/scalable/apps/com.odnoyko.figmix.svg",
        "install -Dm644 resources/icons/com.odnoyko.figmix-symbolic.svg /app/share/icons/hicolor/symbolic/apps/com.odnoyko.figmix-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.com/Valo27/figmix.git",
          "tag": "0.1.0",
          "commit": "b3bd6aca689a063ed44998e75d3de47aadeb5e83"
        }
      ]
    },
    {
      "name": "figmix-cleanup-cache",
      "buildsystem": "simple",
      "build-commands": [
        "rm -rf /app/flatpak-node"
      ],
      "sources": []
    }
  ]
}
