<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.restorm.Restorm</id>

  <name>Restorm</name>
  <summary>Local-first API testing environment</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <developer id="dev.monsieur">
    <name>MonsieurDev</name>
  </developer>

  <description>
    <p>
      Restorm is a local-first environment to test APIs end to end: it is both
      an API client and a server. Send and inspect requests, mock and simulate
      endpoints, and chain reproducible scenarios across REST, GraphQL, gRPC,
      WebSocket, Redis, AMQP, MQTT and more.
    </p>
    <p>
      Everything stays on your own disk — no forced cloud account, no telemetry
      on your traffic — and is Git-friendly for teams.
    </p>
  </description>

  <categories>
    <category>Development</category>
    <category>Network</category>
  </categories>

  <keywords>
    <keyword>REST</keyword>
    <keyword>API</keyword>
    <keyword>HTTP</keyword>
    <keyword>GraphQL</keyword>
    <keyword>gRPC</keyword>
    <keyword>WebSocket</keyword>
  </keywords>

  <launchable type="desktop-id">app.restorm.Restorm.desktop</launchable>

  <url type="homepage">https://restorm.app</url>
  <url type="help">https://restorm.app/docs</url>

  <screenshots>
    <screenshot type="default">
      <image>https://dl.restorm.app/media/flathub/welcome-home.png</image>
      <caption>Welcome screen with recent projects</caption>
    </screenshot>
    <screenshot>
      <image>https://dl.restorm.app/media/flathub/request-editor.png</image>
      <caption>Request editor with typed parameters and live response</caption>
    </screenshot>
    <screenshot>
      <image>https://dl.restorm.app/media/flathub/scenario-editor.png</image>
      <caption>Scenario editor chaining requests on a node graph</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.0.0" date="2026-08-13">
      <description>
        <p>First public release.</p>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1" />
</component>
