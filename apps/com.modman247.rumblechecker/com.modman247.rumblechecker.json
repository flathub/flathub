{
    "id": "com.modman247.rumblechecker",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "rumble-checker",
    "finish-args": [
        "--env=PYTHONPATH=/app/lib/python3.13/site-packages",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=input",
        "--device=dri",
        "--filesystem=xdg-data"
    ],
    "modules": [
        {
            "name": "tcl",
            "buildsystem": "autotools",
            "subdir": "unix",
            "config-opts": [
                "--disable-tests",
                "--disable-zipfs"
            ],
            "post-install": [
                "chmod +w /app/lib/libtcl*.so*"
            ],
            "cleanup": [
                "/bin",
                "/lib/pkgconfig",
                "/man"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://downloads.sourceforge.net/project/tcl/Tcl/9.0.0/tcl9.0.0-src.tar.gz",
                    "sha256": "3bfda6dbaee8e9b1eeacc1511b4e18a07a91dff82d9954cdb9c729d8bca4bbb7"
                }
            ]
        },
        {
            "name": "tk",
            "buildsystem": "autotools",
            "subdir": "unix",
            "config-opts": [
                "--with-tcl=/app/lib",
                "--with-tclinclude=/app/include",
                "--disable-zipfs"
            ],
            "post-install": [
                "chmod +w /app/lib/libtcl9tk9.0.so"
            ],
            "cleanup": [
                "/bin",
                "/lib/pkgconfig",
                "/man"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://prdownloads.sourceforge.net/tcl/tk9.0.0-src.tar.gz",
                    "sha256": "f166e3c20773c82243f753cef4b091d05267cb7f87da64be88cb2ca5a2ba027e"
                }
            ]
        },
        {
            "name": "tkinter",
            "build-options": {
                "cflags": "-Wno-error=deprecated-declarations",
                "env": {
                    "TCLTK_LIBRARY": "${FLATPAK_DEST}/lib",
                    "TCLTK_INCLUDE": "${FLATPAK_DEST}/include"
                }
            },
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-deps --no-build-isolation ."
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/iwalton3/tkinter-standalone",
                    "commit": "8e78e38ef0cceb44a3a0062e1c314a4ff3f981db"
                }
            ]
        },
        {
            "name": "python-evdev",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --prefix=/app --no-deps --no-build-isolation ."
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/gvalkov/python-evdev/archive/refs/tags/v1.9.0.tar.gz",
                    "sha256": "9783a80dca381b9258f74a80a8f7be3fcd7e1c8206752bc428b1b88be22ab369"
                }
            ]
        },
        {
            "name": "rumble-checker",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 rumble_check.py /app/bin/rumble-checker",
                "install -Dm644 com.modman247.rumblechecker.desktop /app/share/applications/com.modman247.rumblechecker.desktop",
                "install -Dm644 com.modman247.rumblechecker.png /app/share/icons/hicolor/256x256/apps/com.modman247.rumblechecker.png"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "rumble_check.py"
                },
                {
                    "type": "file",
                    "path": "com.modman247.rumblechecker.png"
                },
                {
                    "type": "file",
                    "path": "com.modman247.rumblechecker.desktop"
                }
            ]
        }
    ]
}
