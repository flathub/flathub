{
  "app-id": "org.koderoots.chatqt",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "chatqt",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--talk-name=org.freedesktop.Flatpak",
    "--filesystem=~/.skills:ro",
    "--filesystem=~/.agents:ro"
  ],
  "modules": [
    {
      "name": "chatqt",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_PREFIX=/app"
      ],
      "builddir": true,
      "post-install": [
        "install -Dm0644 ../LICENSE -t /app/share/licenses/org.koderoots.chatqt"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/KodeRoots/ChatQT.git",
          "tag": "v1.0.0",
          "commit": "3ebdd28617382ba67a6f884c9c6897093cef98df"
        }
      ]
    }
  ]
}
