{
  "app-id": "org.koderoots.chatqt",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "chatqt",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "modules": [
    {
      "name": "chatqt",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DCMAKE_BUILD_TYPE=Release"],
      "builddir": true,
      "post-install": [
        "install -Dm0644 ../LICENSE -t /app/share/licenses/org.koderoots.chatqt"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/KodeRoots/ChatQT.git",
          "tag": "v1.0.1",
          "commit": "ff47bf908d7ebefea547da9e8a3cda14bbe466d3"
        }
      ]
    }
  ]
}
