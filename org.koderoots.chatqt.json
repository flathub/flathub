{
  "app-id": "org.koderoots.chatqt",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "chatqt",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "modules": [
    {
      "name": "chatqt",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DCMAKE_BUILD_TYPE=Release"],
      "builddir": true,
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/KodeRoots/ChatQT.git",
          "tag": "v1.1.0",
          "commit": "6f99caaf4062eeeb0b786cae635a0b0dd2be8c88"
        }
      ]
    }
  ]
}
