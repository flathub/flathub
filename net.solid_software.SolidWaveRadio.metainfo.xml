<component type="desktop-application">
  <id>net.solid_software.SolidWaveRadio</id>
  <name>SolidWave Radio</name>
  <summary>Internet radio with visualization and equalizer</summary>
  <summary xml:lang="de">Internet-Radio mit Visualisierung und Equalizer</summary>
  <developer_name>Matthias Stoltze</developer_name>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-2.0-only</project_license>
  <url type="homepage">https://solid-software.net</url>
  <url type="bugtracker">https://codeberg.org/thunderbird2013/SolidWaveRadio/issues</url>
  <url type="vcs-browser">https://codeberg.org/thunderbird2013/SolidWaveRadio</url>
  <description>
    <p>
      SolidWave Radio is an internet radio player built on libZCore. Browse
      stations, play streams, visualize audio, use an equalizer, and record.
    </p>
    <p xml:lang="de">
      SolidWave Radio ist ein Internet-Radio-Player auf Basis von libZCore.
      Sender suchen, Streams abspielen, Visualisierung, Equalizer und Aufnahme.
    </p>
    <ul>
      <li>Station browser and favorites</li>
      <li>Audio visualization (OpenGL)</li>
      <li>Equalizer and effects</li>
      <li>Recording</li>
    </ul>
  </description>
  <launchable type="desktop-id">net.solid_software.SolidWaveRadio.desktop</launchable>
  <provides>
    <binary>solidwave_radio</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>touch</control>
  </recommends>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <content_rating type="oars-1.1" />
