  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <name>Sparrow Wallet</name>
  <summary>Multisig Bitcoin wallet with PSBT support</summary>

  <developer id="io.github.sparrowwallet">
    <name>Sparrow Wallet</name>
  </developer>

  <description>
    <p>Sparrow is a Bitcoin wallet built around multisig, watch-only wallets and partially signed transactions.</p>
    <p>Import an account xpub or a full output descriptor, and review every input and output before signing.</p>
    <ul>
      <li>Watch-only wallets from an xpub or output descriptor</li>
      <li>PSBT creation, inspection and signing</li>
      <li>Custom derivation paths and wallet policies</li>
      <li>Connect to your own node or a public server</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.sparrowwallet.sparrow.desktop</launchable>

  <url type="homepage">https://sparrowwallet.com/</url>
