#!/bin/bash
# PoktCode Host Shell Bridge for Flatpak
# Bridges the IDE integrated terminal to the host system shell,
# providing full access to host development tools (npm, node, pnpm, yarn, python, git, cargo, etc.)

if [ -e "/.flatpak-info" ] || [ -n "$FLATPAK_ID" ]; then
    if command -v flatpak-spawn >/dev/null 2>&1; then
        HOST_SHELL="/bin/bash"
        if [ "$#" -eq 0 ]; then
            # Interactive terminal session: launch host login shell
            exec flatpak-spawn --host --watch-bus "$HOST_SHELL" -l
        else
            # Command execution or arguments
            exec flatpak-spawn --host --watch-bus "$HOST_SHELL" "$@"
        fi
    fi
fi

exec "${SHELL:-/bin/bash}" "$@"
