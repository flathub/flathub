#!/bin/sh
# JBR, libink.so and the math packages are bundled in /app; Python comes from the runtime.
set -eu
exec /app/jbr/bin/java \
    --enable-native-access=ALL-UNNAMED \
    --add-opens=java.desktop/sun.awt.X11=ALL-UNNAMED \
    --add-exports=java.desktop/sun.awt=ALL-UNNAMED \
    --add-opens=java.desktop/sun.awt.wl=ALL-UNNAMED \
    -Dvivenotes.profile=production \
    -Dvivenotes.mathPython=/usr/bin/python3 \
    -Dbyteink.ink.library=/app/lib/libink.so \
    -cp '/app/lib/*' com.vivenotes.desktop.MainKt "$@"
