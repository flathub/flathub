<component type="desktop-application">
  <id>net.silentclient.launcher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://silentclient.net/legal/terms</project_license>
  <name>Silent Client</name>
  <summary>Free Minecraft launcher with FPS boost for 1.8.9 PvP</summary>
  <description>
    <p>
      Silent Client is a free Minecraft launcher aimed at 1.8.9 PvP: higher frame
      rates, dozens of built-in mods, a fully draggable HUD and cosmetics. It
      handles the game files and Java runtime for you, and newer Minecraft
      versions work as well.
    </p>
    <p>
      This Flatpak wraps the official Linux AppImage, which is fetched from the
      Silent Client CDN when the package is installed. You need a Minecraft
      account to play.
    </p>
    <p>
      <em>Community package, not supported by Silent Client.</em>
    </p>
  </description>

  <!-- Used for previews before install; the cached icon is generated from the
       512px hicolor icon that the manifest installs. -->
  <icon type="remote" width="1332" height="1332">https://silentclient.net/assets/logo.png</icon>
  <launchable type="desktop-id">net.silentclient.launcher.desktop</launchable>
  <categories>
    <category>Game</category>
  </categories>
  <url type="homepage">https://silentclient.net/</url>
  <url type="contact">https://support.silentclient.net</url>
  <url type="faq">https://silentclient.net/#faq</url>
  <developer id="net.silentclient">
    <name>Silent Client</name>
  </developer>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-cartoon">none</content_attribute>
    <content_attribute id="violence-fantasy">mild</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
    <content_attribute id="money-purchasing">mild</content_attribute>
  </content_rating>
  <!-- Bump when the updater in net.silentclient.launcher.yml points at a new
       release. -->
  <releases>
    <release version="5.3.1" date="2026-11-13"/>
  </releases>
