<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata for the Flatpak — what Flathub's store page and GNOME
  Software / KDE Discover show. See README.md in this directory.

  The newest <release> must be `packages/desktop/package.json`'s version; a
  test holds the two to it (`__tests__/flatpak.test.ts`), because the Flathub
  bot opens its update PR from the archive's version and the store page would
  otherwise announce an older one.
-->
<component type="desktop-application">
  <id>de.skyboxmail.Skybox</id>
  <name>Skybox</name>
  <summary>Mail, calendar and contacts for all your accounts</summary>
  <developer id="de.skyboxmail">
    <name>Skybox</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://skyboxmail.de/terms</project_license>

  <description>
    <p>
      Skybox is a mail client for every account you have: IMAP, Gmail,
      Microsoft 365, iCloud and any other mail server, with calendars and
      contacts from CalDAV, CardDAV, Google and Microsoft alongside.
    </p>
    <p>
      Accounts are grouped into profiles — work, private, a club — each with a
      unified inbox across its accounts. Messages are threaded, searchable and
      cached on the device, so mail that was fetched once is readable offline.
      Mail accounts can be shared with other people, and the same accounts,
      profiles and settings are available in the Skybox apps for iPhone,
      Android, macOS and Windows, and in the browser.
    </p>
    <ul>
      <li>All mail accounts in one place, grouped into profiles</li>
      <li>Unified inbox, threads, search and offline reading</li>
      <li>Calendars with invitations and recurring events</li>
      <li>Contacts, with address completion while writing</li>
      <li>Notifications for new mail, and a tray icon</li>
      <li>Opens mailto: links as the system's mail client</li>
    </ul>
  </description>

  <launchable type="desktop-id">de.skyboxmail.Skybox.desktop</launchable>
  <provides>
    <mediatype>x-scheme-handler/mailto</mediatype>
  </provides>

  <url type="homepage">https://skyboxmail.de</url>
  <url type="help">https://skyboxmail.de</url>

  <branding>
    <color type="primary" scheme_preference="light">#2b2b2b</color>
    <color type="primary" scheme_preference="dark">#f2f2f2</color>
  </branding>

  <screenshots>
    <!--
      Taken in the Linux VM at 1600×1000 with the demo data, uploaded to this
      directory on the download host — README.md § Screenshots. Flathub
      mirrors them on merge and fails the submission while any is unreachable.
    -->
    <screenshot type="default">
      <caption>The inbox, with a message open</caption>
      <image>https://downloads.skyboxmail.de/flathub/screenshots/mail.png</image>
    </screenshot>
    <screenshot>
      <caption>Writing a message</caption>
      <image>https://downloads.skyboxmail.de/flathub/screenshots/compose.png</image>
    </screenshot>
    <screenshot>
      <caption>The calendar, week view</caption>
      <image>https://downloads.skyboxmail.de/flathub/screenshots/calendar.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
    <internet>always</internet>
  </requires>

  <releases>
    <release version="0.1.22" date="2026-10-14" />
    <release version="0.1.21" date="2026-10-12" />
  </releases>
</component>
