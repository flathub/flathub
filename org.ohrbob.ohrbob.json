{
	"app-id": "org.ohrbob.ohrbob",
	"runtime": "org.freedesktop.Platform",
	"runtime-version": "26.08",
	"sdk": "org.freedesktop.Sdk",
	"command": "org.ohrbob.ohrbob",
	"sdk-extensions": [
		"org.freedesktop.Sdk.Extension.dotnet10"
	],
	"finish-args": [
		"--share=ipc",
		"--socket=x11",
		"--socket=pulseaudio",
		"--share=network",
		"--device=dri",
		"--own-name=org.mpris.MediaPlayer2.ohrbob"
	],
	"cleanup": [
		"*.a"
	],
	"build-options": {
		"append-path": "/usr/lib/sdk/dotnet10/bin",
		"append-ld-library-path": "/usr/lib/sdk/dotnet10/lib",
		"env": {
			"DOTNET_CLI_TELEMETRY_OPTOUT": "true",
			"DOTNET_ROOT": "/usr/lib/sdk/dotnet10"
		}
	},
	"modules": [
		{
			"name": "ohrbob",
			"buildsystem": "simple",
			"build-commands": [
				"RID=\"linux-x64\"\nif [ \"$FLATPAK_ARCH\" = \"aarch64\" ]; then RID=\"linux-arm64\"; fi\ndotnet restore Ohrbob.App.Desktop/Ohrbob.App.Desktop.csproj -r \"$RID\" --source nuget-sources\ndotnet publish Ohrbob.App.Desktop/Ohrbob.App.Desktop.csproj -c Release -r \"$RID\" --self-contained true --no-restore -o /app/bin/ohrbob\n",
				"ln -s /app/bin/ohrbob/Ohrbob.App.Desktop /app/bin/org.ohrbob.ohrbob",
				"install -Dm644 org.ohrbob.ohrbob.desktop -t /app/share/applications/",
				"install -Dm644 org.ohrbob.ohrbob.metainfo.xml -t /app/share/metainfo/",
				"install -Dm644 art/ohrbob-logo.svg /app/share/icons/hicolor/scalable/apps/org.ohrbob.ohrbob.svg",
				"install -Dm644 LICENSE -t /app/share/licenses/org.ohrbob.ohrbob/"
			],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/ohrbob-org/ohrbob.app.git",
					"tag": "v0.0.5",
					"commit": "97282d01d9416a1af306bb42f304ee7eb7503507"
				},
				"nuget-sources.json"
			]
		}
	]
}
