<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.projectgamers.ProjectG</id>
  <name>Project G</name>
  <summary>Your next-gen gaming platform</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <description>
    <p>
      Project G is a modern gaming platform built for players and indie developers.
      Discover, play, and share games — all in one place.
    </p>
    <p>Features:</p>
    <ul>
      <li>Browse and play indie games directly in the platform</li>
      <li>Chat with friends and the gaming community</li>
      <li>Achievement system with unlockable rewards</li>
      <li>AI-powered platform assistant (Cyber-G)</li>
      <li>Developer studio for publishing your own games</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.projectgamers.ProjectG.desktop</launchable>

  <url type="homepage">https://pg.projectgamers240.com</url>
  <url type="bugtracker">https://pg.projectgamers240.com</url>

  <developer id="com.projectgamers">
    <name>Project Gamers</name>
  </developer>

  <provides>
    <binary>project-g</binary>
  </provides>

  <releases>
    <release version="4.0.0" date="2026-06-06">
      <description>
        <p>Initial Flathub release of Project G.</p>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">moderate</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

