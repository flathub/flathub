  <name>Articla</name>
  <summary>Desktop client for the Articla social forum (anime, games, tech, news)</summary>
  <description>
    <p>
      Articla is a desktop client for the Russian-language social forum
      <a href="https://articla.org">articla.org</a>, covering anime, manga,
      cosplay, video games, music, movies, technology, news, and random
      discussions. This Flatpak wraps the website in a standalone Electron
      application with native menus, notifications, and offline caching.
    </p>
    <p>
      Features include:
    </p>
    <ul>
      <li>Browse and participate in forums across dozens of categories</li>
      <li>Like, comment, and subscribe to posts</li>
      <li>Native desktop notifications and window chrome</li>
      <li>Dark-mode friendly interface</li>
      <li>Always-on-top optional mode and custom shortcuts</li>
    </ul>
  </description>
  <launchable type="desktop-id">org.articla.ArticlaWebapp.desktop</launchable>
  <url type="homepage">https://articla.org</url>
  <url type="source">https://github.com/flathub/org.articla.ArticlaWebapp</url>
