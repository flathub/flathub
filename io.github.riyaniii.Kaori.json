{
    "id": "io.github.riyaniii.Kaori",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.openjdk21"
    ],
    "command": "kaori",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--env=PATH=/app/jre/bin:/app/bin:/usr/bin"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        "python3-gql.json",
        "python3-diskcache.json",
        "python3-babel.json",
        {
            "name": "openjdk",
            "buildsystem": "simple",
            "build-commands": [
                "/usr/lib/sdk/openjdk21/install.sh"
            ]
        },
        {
            "name": "kaori",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
				    "type": "git",
				    "url": "https://github.com/riyaniii/Kaori.git",
				    "tag": "0.9.4",
				    "commit": "15996168329552ef5ac2bfc61cf63fc0a242ff21"
				}
            ]
        }
    ]
}
