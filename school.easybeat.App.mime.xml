<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-guitar-pro">
    <comment>Guitar Pro score</comment>
    <!-- Guitar Pro 7+ files are zip archives: without this, content sniffing reports application/zip -->
    <sub-class-of type="application/zip"/>
    <glob pattern="*.gp" weight="80"/>
    <glob pattern="*.gp3" weight="80"/>
    <glob pattern="*.gp4" weight="80"/>
    <glob pattern="*.gp5" weight="80"/>
    <glob pattern="*.gpx" weight="80"/>
  </mime-type>
  <mime-type type="application/x-easybeat-score">
    <comment>EasyBeat score</comment>
    <glob pattern="*.tp"/>
  </mime-type>
  <mime-type type="application/x-capella">
    <comment>Capella score</comment>
    <glob pattern="*.cap"/>
  </mime-type>
  <mime-type type="application/vnd.recordare.musicxml+xml">
    <comment>MusicXML score</comment>
    <glob pattern="*.musicxml"/>
  </mime-type>
</mime-info>
